<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs in the user's project (dotnet exec with its deps.json), not in FerretSharp: net8.0, EF Core only to compile
       against. ADR 0009. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>FerretSharp.ModelHost</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile only: at run time the user's EF Core assemblies are used (none are copied next to the host). The lowest
         supported EF Core: .NET binds to a higher assembly version, never to a lower one. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" VersionOverride="8.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <!-- EF Core 8.0.0 brings Microsoft.Extensions.Caching.Memory 8.0.0 (GHSA-qj66-m88j-hmgj). Never shipped (compile only,
         as above), but the report of vulnerable packages listed it and hid real hits (review 3.54.0, A21). -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" VersionOverride="8.0.1" ExcludeAssets="runtime" PrivateAssets="all" />
    <!-- Shipped next to the host and resolved from its folder (the project's deps.json does not know it). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" />
    <!-- Scripting 4.11 needs exactly its own Roslyn; the central version (5.x, for the Core) would pin it higher. Roslyn from
         4.12 on brings System.Reflection.Metadata 9.0, which .NET 8 cannot load (WP-41). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.11.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\FerretSharp.Core\ClrModel\Host\ModelExport.cs" Link="ModelExport.cs" />
    <Compile Include="..\FerretSharp.Core\ClrModel\Host\LinqProtocol.cs" Link="LinqProtocol.cs" />
  </ItemGroup>

</Project>
