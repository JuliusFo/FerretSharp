<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Thin WPF host: generic host, logging, window chrome and the BlazorWebView. The UI lives in FerretSharp.UI. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- BlazorWebView's WebView2CompositionControl needs the WinRT projection (Microsoft.Windows.SDK.NET). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>FerretSharp.App</RootNamespace>
    <AssemblyName>FerretSharp</AssemblyName>
    <!-- Generated by tools/icon/New-AppIcon.ps1 -->
    <ApplicationIcon>Assets\ferretsharp.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\ferretsharp.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Framework.Win32.CredentialManager" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FerretSharp.Core\FerretSharp.Core.csproj" />
    <ProjectReference Include="..\FerretSharp.UI\FerretSharp.UI.csproj" />
    <!-- Built, not referenced: it runs in the user's project with its runtime (ADR 0009). Neither the app's runtime
         identifier nor its output folder must reach it. -->
    <ProjectReference Include="..\FerretSharp.ModelHost\FerretSharp.ModelHost.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Private="false"
                      GlobalPropertiesToRemove="$(ModelHostRemovedProperties)" />
  </ItemGroup>

  <PropertyGroup>
    <ModelHostRemovedProperties>RuntimeIdentifier;SelfContained;OutputPath;OutDir;PublishDir;_CommandLineDefinedOutputPath</ModelHostRemovedProperties>
  </PropertyGroup>

  <!-- FerretSharp.ModelHost ships in the subfolder "modelhost" (build and publish). -->
  <Target Name="CollectModelHost">
    <MSBuild Projects="..\FerretSharp.ModelHost\FerretSharp.ModelHost.csproj" Targets="GetTargetPath" RemoveProperties="$(ModelHostRemovedProperties)">
      <Output TaskParameter="TargetOutputs" ItemName="_ModelHostTarget" />
    </MSBuild>
    <PropertyGroup>
      <_ModelHostDirectory>@(_ModelHostTarget->'%(RootDir)%(Directory)')</_ModelHostDirectory>
    </PropertyGroup>
    <!-- The host and what it brings itself (Roslyn for the LINQ console, with its message translations in culture
         folders); EF Core and the provider come from the user's project. -->
    <ItemGroup>
      <_ModelHostFiles Include="$(_ModelHostDirectory)**\*.dll" />
      <_ModelHostFiles Include="$(_ModelHostDirectory)FerretSharp.ModelHost.pdb" />
    </ItemGroup>
  </Target>

  <Target Name="CopyModelHost" AfterTargets="Build" DependsOnTargets="CollectModelHost">
    <Copy SourceFiles="@(_ModelHostFiles)" DestinationFiles="@(_ModelHostFiles->'$(OutDir)modelhost\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishModelHost" AfterTargets="Publish" DependsOnTargets="CollectModelHost">
    <Copy SourceFiles="@(_ModelHostFiles)" DestinationFiles="@(_ModelHostFiles->'$(PublishDir)modelhost\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
