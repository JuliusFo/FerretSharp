<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Thin WPF host: generic host, logging, window chrome and the BlazorWebView. The UI lives in FerretSharp.UI. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- BlazorWebView's WebView2CompositionControl needs the WinRT projection (Microsoft.Windows.SDK.NET). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>FerretSharp.App</RootNamespace>
    <AssemblyName>FerretSharp</AssemblyName>
    <!-- Generated by tools/icon/New-AppIcon.ps1 -->
    <ApplicationIcon>Assets\ferretsharp.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\ferretsharp.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Framework.Win32.CredentialManager" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FerretSharp.Core\FerretSharp.Core.csproj" />
    <ProjectReference Include="..\FerretSharp.UI\FerretSharp.UI.csproj" />
  </ItemGroup>

</Project>
