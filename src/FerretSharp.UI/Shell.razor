@* Root component hosted by the BlazorWebView: layout, pages, keyboard shortcuts. What happens to workspaces and their
   changes is WorkspaceLifecycle's job; the bars and dialogs are components of their own (R2). *@
@using FerretSharp.Core.Connections
@using FerretSharp.UI.State
@implements IAsyncDisposable
@inject ConnectionManager Connections
@inject ActiveConnection Active
@inject WorkspaceManager Workspaces
@inject RecentConnections Recent
@inject ConnectionKeepAlive KeepAlive
@inject FerretSharp.Core.Settings.AppSettingsService Settings
@inject ExitGuard ExitGuard
@inject FerretSharp.Core.ClrModel.ClrModelManager Models
@inject PresentationService Presentations
@inject IJSRuntime JS
@inject FerretSharp.Core.Workspaces.SqlHistoryStore SqlHistory
@inject ILoggerFactory LoggerFactory

<CascadingValue Value="_state" IsFixed="true">
<CascadingValue Value="_lifecycle" IsFixed="true">
    <div class="app @(_lifecycle.IsProd ? "is-prod" : "")">
        <header class="topbar">
            <div class="brand">Ferret<span>Sharp</span></div>
            @if (Active.Status != ConnectionStatus.Disconnected)
            {
                <button class="icon-btn ghost @(_state.Page == ShellPage.Connections ? "active" : "")" title="Alle Verbindungen"
                        @onclick="ToggleHome">@Icons.Home</button>
            }
            <ConnectionSwitcher />
            @if (Active.IsConnected)
            {
                <WorkspaceBar />
            }
            <div class="topbar-right">
                <button class="icon-btn ghost @(_state.Page == ShellPage.Compare ? "active" : "")" title="Schema-Vergleich"
                        @onclick="() => ToggleSidePage(ShellPage.Compare)">@Icons.Compare</button>
                <button class="icon-btn ghost @(_state.Page == ShellPage.Settings ? "active" : "")" title="Einstellungen"
                        @onclick="() => ToggleSidePage(ShellPage.Settings)">@Icons.Settings</button>
                <WorkspaceBadge Lifecycle="_lifecycle" />
            </div>
        </header>

        <ConnectionLostBanner Lifecycle="_lifecycle" />

        <div class="body">
            @if (ShowExplorer && Active.IsConnected)
            {
                <Explorer />
            }

            <main class="content">
                <ErrorBoundary @ref="_errorBoundary">
                    <ChildContent>
                        @* Tabs of all open workspaces stay mounted while connected (also behind the overview), so grids keep
                           their state. Restored tabs mount when first shown. *@
                        @if (Active.IsConnected)
                        {
                            <div class="workarea @(ShowExplorer ? "" : "hidden")">
                                <TabBar Lifecycle="_lifecycle" />
                                <div class="pages">
                                    @foreach (var workspace in _state.Workspaces)
                                    {
                                        foreach (var tab in workspace.Tabs.Where(t => t.Visited))
                                        {
                                            <div class="page @(workspace == _state.ActiveWorkspace && tab == workspace.ActiveTab ? "active" : "")" @key="tab.Id">
                                                <TabFrame OnClose="() => _lifecycle.CloseTab(tab)">
                                                    @if (tab is TableTab tableTab)
                                                    {
                                                        <TabView Tab="tableTab" />
                                                    }
                                                    else if (tab is LinqTab linqTab)
                                                    {
                                                        <LinqView Tab="linqTab" />
                                                    }
                                                    else if (tab is SqlTab sqlTab)
                                                    {
                                                        <SqlView Tab="sqlTab" />
                                                    }
                                                </TabFrame>
                                            </div>
                                        }
                                    }
                                    @if (_state.Tabs.Count == 0)
                                    {
                                        <EmptyState Title="Tabelle auswählen" Text="@(HasLinkedProject
                                            ? "Links eine Tabelle oder View wählen – oder mit „+ SQL“ (Ctrl+Shift+Q) SQL schreiben, mit „+ LINQ“ eine Query aus dem C#-Code ausführen. Ctrl+Enter wendet Filter an, F5 lädt neu."
                                            : "Links eine Tabelle oder View wählen – oder mit „+ SQL“ (Ctrl+Shift+Q) SQL schreiben. Ctrl+Enter wendet Filter an, F5 lädt neu.")" />
                                    }
                                </div>
                            </div>
                        }

                        @if (_state.Page == ShellPage.Settings)
                        {
                            <SettingsPage OnBack="LeaveSidePage" />
                        }
                        else if (_state.Page == ShellPage.Compare)
                        {
                            <SchemaComparePage OnBack="LeaveSidePage" />
                        }
                        else if (_state.Page == ShellPage.Model && Active.IsConnected)
                        {
                            <ModelPage />
                        }
                        else if (!ShowExplorer)
                        {
                            <ConnectionsPage />
                        }
                        else if (Active.Status == ConnectionStatus.Connecting && Active.Profile is { } connecting)
                        {
                            <EmptyState Title="@($"Verbinde mit {connecting.Name} …")" Text="@connecting.Address.Display">
                                <span class="spinner"></span>
                                <button class="btn" @onclick="Active.CancelPendingConnect">Abbrechen</button>
                            </EmptyState>
                        }
                        else if (Active.Status == ConnectionStatus.Failed && Active.Profile is { } failed)
                        {
                            <EmptyState Title="@($"Verbindung zu {failed.Name} fehlgeschlagen")" IsError="true">
                                <div class="error-detail">
                                    @if (Active.Error?.ErrorCode is { } errorCode)
                                    {
                                        <span class="code">@errorCode</span>
                                    }
                                    <span>@Active.Error?.Message</span>
                                </div>
                                <div class="button-row">
                                    <button class="btn primary" @onclick="() => _state.Connect(failed)">Erneut versuchen</button>
                                    <button class="btn" @onclick="() => _state.EditConnection(failed)">Bearbeiten</button>
                                    <button class="btn ghost" @onclick="_state.ShowConnections">Zur Übersicht</button>
                                </div>
                            </EmptyState>
                        }
                    </ChildContent>
                    <ErrorContent Context="exception">
                        <EmptyState Title="Da ist etwas schiefgelaufen" Text="@exception.Message" IsError="true">
                            <div class="button-row">
                                <button class="btn primary" @onclick="RecoverFromError">Weiter</button>
                                <button class="btn" title="Falls „Weiter“ wieder hierher führt" @onclick="CloseTabsAfterErrorAsync">Tabs schließen</button>
                            </div>
                        </EmptyState>
                    </ErrorContent>
                </ErrorBoundary>
            </main>
        </div>

        <StatusBar Lifecycle="_lifecycle" />
    </div>

    <DialogHost Lifecycle="_lifecycle" />
</CascadingValue>
</CascadingValue>

@code {
    private const string SwitcherShortcut = "ctrl+shift+o";
    private const string ApplyFiltersShortcut = "ctrl+enter";
    private const string RefreshShortcut = "f5"; // also stops the WebView from reloading the page
    private const string FindColumnShortcut = "ctrl+f"; // the browser's find would miss columns the grid has not rendered
    private const string BackShortcut = "alt+arrowleft"; // also keeps the WebView from navigating back
    private const string ForwardShortcut = "alt+arrowright";
    private const string FlushShortcut = "ctrl+s"; // write pending changes (no commit)
    private const string CommitShortcut = "ctrl+shift+enter";
    private const string LinqShortcut = "ctrl+shift+l"; // new LINQ console (WP-13)
    private const string SqlShortcut = "ctrl+shift+q"; // new SQL editor (WP-17)
    private const string ScriptShortcut = "alt+x"; // SQL editor: run the whole script (as in DBeaver)

    private readonly ShellState _state = new();
    private WorkspaceEditing _editing = null!;
    private WorkspaceLifecycle _lifecycle = null!;
    private ErrorBoundary? _errorBoundary;
    private IJSObjectReference? _shortcuts;
    private DotNetObjectReference<Shell>? _selfRef;
    /// <summary>Where settings or the schema comparison were opened from, to go back there.</summary>
    private ShellPage _pageBefore = ShellPage.Connections;

    /// <summary>The active connection has a C# project: LINQ consoles can be opened (WP-13).</summary>
    private bool HasLinkedProject => Models.State.Link is not null;

    private bool ShowExplorer => _state.Page == ShellPage.Explorer && Active.Status != ConnectionStatus.Disconnected;

    protected override async Task OnInitializedAsync()
    {
        _editing = new WorkspaceEditing(_state, Workspaces, Active, Settings, LoggerFactory.CreateLogger<WorkspaceEditing>());
        _lifecycle = new WorkspaceLifecycle(_state, Workspaces, Active, Connections, SqlHistory, _editing, LoggerFactory.CreateLogger<WorkspaceLifecycle>());
        ExitGuard.CanExit = () => _lifecycle.CanExit;
        ExitGuard.RequestExit = () => InvokeAsync(() => _lifecycle.RequestExitAsync(ExitGuard.ApproveExit));
        _state.Changed += OnChanged;
        _state.Dirty += _lifecycle.SaveTabs;
        _state.ConnectRequested += OnConnectRequested;
        Connections.Changed += OnChanged;
        Active.Changed += OnConnectionOrWorkspacesChanged;
        Workspaces.Changed += OnConnectionOrWorkspacesChanged;
        Models.Changed += OnChanged;
        Presentations.Changed += OnChanged;
        KeepAlive.ConnectionLost += OnKeepAliveLost;
        KeepAlive.Start();
        await Connections.LoadAsync(CancellationToken.None);
        await Recent.LoadAsync(CancellationToken.None);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            _shortcuts = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/FerretSharp.UI/js/shortcuts.js");
            await _shortcuts.InvokeVoidAsync("register", _selfRef, new[]
            {
                SwitcherShortcut, ApplyFiltersShortcut, RefreshShortcut, FindColumnShortcut, BackShortcut, ForwardShortcut, FlushShortcut, CommitShortcut, LinqShortcut,
                SqlShortcut, ScriptShortcut,
            });
        }
    }

    /// <param name="modalOpen">
    /// A dialog is open (shortcuts.js looks for a visible <c>.modal-backdrop</c>, which every dialog renders through
    /// ModalFrame): shortcuts must not act behind it – Ctrl+S while the LOB editor is open, F5 behind the plan dialog.
    /// </param>
    [JSInvokable]
    public void OnShortcut(string combo, bool modalOpen)
    {
        if (modalOpen)
        {
            return;
        }

        // Writing and committing need an editable connection and an active workspace.
        if (combo is FlushShortcut or CommitShortcut)
        {
            if (_state.ActiveWorkspace is { } workspace && Workspaces.IsWritable(workspace.WorkspaceId) && _state.Page == ShellPage.Explorer)
            {
                _ = combo == FlushShortcut ? _editing.FlushAsync(workspace) : _lifecycle.RequestCommitAsync(workspace);
            }

            return;
        }

        switch (combo)
        {
            case SwitcherShortcut:
                _state.OpenSwitcher();
                break;
            case ApplyFiltersShortcut:
                _state.RequestTabCommand(TabCommand.ApplyFilters);
                break;
            case RefreshShortcut:
                _state.RequestTabCommand(TabCommand.Refresh);
                break;
            case FindColumnShortcut:
                _state.RequestTabCommand(TabCommand.FindColumn);
                break;
            case BackShortcut:
                _state.GoBack();
                break;
            case ForwardShortcut:
                _state.GoForward();
                break;
            case ScriptShortcut when _state.Page == ShellPage.Explorer:
                _state.RequestTabCommand(TabCommand.RunScript);
                break;
            case SqlShortcut when Active.IsConnected && _state.Page == ShellPage.Explorer:
                _state.OpenSql();
                break;
            case LinqShortcut when HasLinkedProject && _state.Page == ShellPage.Explorer:
                _state.OpenLinq();
                break;
        }
    }

    /// <summary>Raised by <see cref="ShellState.Connect"/> from anywhere; the lifecycle asks about open changes first.</summary>
    private void OnConnectRequested(ConnectionProfile profile) => InvokeAsync(() => _lifecycle.ConnectAsync(profile));

    private void OnConnectionOrWorkspacesChanged() => InvokeAsync(() =>
    {
        if (Active.IsConnected && Active.Schema is { } schema && Workspaces.Profile?.Id == Active.Profile?.Id)
        {
            _state.SyncWorkspaces(Workspaces.Open, Workspaces.Active?.Id, schema);
        }
        else if (_state.Workspaces.Count > 0)
        {
            _state.ClearWorkspaces();
        }

        StateHasChanged();
    });

    /// <summary>The keep-alive found a session gone: same banner as a failed query, without waiting for the next click.</summary>
    private void OnKeepAliveLost(DatabaseException error) => InvokeAsync(() => _state.ReportFailure(error));

    /// <summary>Settings and the schema comparison: open from anywhere, the same button goes back.</summary>
    private void ToggleSidePage(ShellPage page)
    {
        if (_state.Page == page)
        {
            LeaveSidePage();
            return;
        }

        if (_state.Page is not (ShellPage.Settings or ShellPage.Compare))
        {
            _pageBefore = _state.Page;
        }

        if (page == ShellPage.Compare)
        {
            _state.ShowCompare();
        }
        else
        {
            _state.ShowSettings();
        }
    }

    /// <summary>Back to where the user came from; the explorer only if still connected.</summary>
    private void LeaveSidePage()
    {
        if (_pageBefore == ShellPage.Explorer && Active.Status != ConnectionStatus.Disconnected)
        {
            _state.ShowExplorer();
        }
        else
        {
            _state.ShowConnections();
        }
    }

    private void ToggleHome()
    {
        if (_state.Page == ShellPage.Connections)
        {
            _state.ShowExplorer();
        }
        else
        {
            _state.ShowConnections();
        }
    }

    /// <summary>Errors of a tab's view stay in its <see cref="TabFrame"/>; this one is outside the tabs – show them again.</summary>
    private void RecoverFromError() => _errorBoundary?.Recover();

    /// <summary>If the tab bar itself keeps failing: close the active workspace's tabs, asking first if they hold changes.</summary>
    private Task CloseTabsAfterErrorAsync() =>
        _lifecycle.GuardAsync("Tabs schließen", _state.ActiveWorkspace is { } active ? [active] : [], () =>
        {
            _state.CloseAllTabs();
            _errorBoundary?.Recover();
            return Task.CompletedTask;
        });

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        ExitGuard.CanExit = null;
        ExitGuard.RequestExit = null;
        _state.Changed -= OnChanged;
        _state.Dirty -= _lifecycle.SaveTabs;
        _state.ConnectRequested -= OnConnectRequested;
        Connections.Changed -= OnChanged;
        Active.Changed -= OnConnectionOrWorkspacesChanged;
        Workspaces.Changed -= OnConnectionOrWorkspacesChanged;
        Models.Changed -= OnChanged;
        Presentations.Changed -= OnChanged;
        KeepAlive.ConnectionLost -= OnKeepAliveLost;
        if (_shortcuts is not null)
        {
            try
            {
                await _shortcuts.InvokeVoidAsync("unregister");
                await _shortcuts.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _selfRef?.Dispose();
    }
}
