@* Root component hosted by the BlazorWebView. *@
@using FerretSharp.Core.Connections
@using FerretSharp.UI.State
@implements IAsyncDisposable
@inject ConnectionManager Connections
@inject ActiveConnection Active
@inject WorkspaceManager Workspaces
@inject RecentConnections Recent
@inject IJSRuntime JS

<CascadingValue Value="_state" IsFixed="true">
    <div class="app @(IsProdActive ? "is-prod" : "")">
        <header class="topbar">
            <div class="brand">Ferret<span>Sharp</span></div>
            @if (Active.Status != ConnectionStatus.Disconnected)
            {
                <button class="icon-btn ghost @(_state.Page == ShellPage.Connections ? "active" : "")" title="Alle Verbindungen"
                        @onclick="ToggleHome">@Icons.Home</button>
            }
            <ConnectionSwitcher />
            @if (Active.IsConnected)
            {
                <WorkspaceBar />
            }
            <div class="topbar-right">
                @if (IsProdActive)
                {
                    <span class="badge badge-prod">PROD · READ-ONLY</span>
                }
                else
                {
                    <span class="badge">READ-ONLY</span>
                }
            </div>
        </header>

        <div class="body">
            @if (ShowExplorer && Active.IsConnected)
            {
                <Explorer />
            }

            <main class="content">
                <ErrorBoundary @ref="_errorBoundary">
                    <ChildContent>
                        @* Tabs of all open workspaces stay mounted while connected (also behind the overview), so grids keep
                           their state. Restored tabs mount when first shown. *@
                        @if (Active.IsConnected)
                        {
                            <div class="workarea @(ShowExplorer ? "" : "hidden")">
                                @if (_state.Tabs.Count > 0)
                                {
                                    <nav class="tabs">
                                        @foreach (var tab in _state.Tabs)
                                        {
                                            var t = tab;
                                            <div class="tab @(t == _state.ActiveTab ? "active" : "")" title="@t.Table.Owner.@t.Table.Name"
                                                 @onclick="() => _state.ActivateTab(t)" @onmouseup="e => CloseOnMiddleClick(e, t)">
                                                @Icons.For(t.Table.Kind)
                                                <span class="tab-name">@t.Table.DisplayName</span>
                                                @if (t.ActiveFilterCount > 0)
                                                {
                                                    <span class="filter-pill">@t.ActiveFilterCount Filter</span>
                                                }
                                                <button class="tab-close" title="Schließen" @onclick:stopPropagation="true" @onclick="() => _state.CloseTab(t)">✕</button>
                                            </div>
                                        }
                                    </nav>
                                }
                                <div class="pages">
                                    @foreach (var workspace in _state.Workspaces)
                                    {
                                        foreach (var tab in workspace.Tabs.Where(t => t.Visited))
                                        {
                                            <div class="page @(workspace == _state.ActiveWorkspace && tab == workspace.ActiveTab ? "active" : "")" @key="tab.Id">
                                                <TabView Tab="tab" />
                                            </div>
                                        }
                                    }
                                    @if (_state.Tabs.Count == 0)
                                    {
                                        <EmptyState Title="Tabelle auswählen" Text="Links eine Tabelle oder View wählen. Ctrl+Enter wendet Filter an, F5 lädt neu." />
                                    }
                                </div>
                            </div>
                        }

                        @if (!ShowExplorer)
                        {
                            <ConnectionsPage />
                        }
                        else if (Active.Status == ConnectionStatus.Connecting && Active.Profile is { } connecting)
                        {
                            <EmptyState Title="@($"Verbinde mit {connecting.Name} …")" Text="@connecting.Address.Display">
                                <span class="spinner"></span>
                                <button class="btn" @onclick="Active.CancelPendingConnect">Abbrechen</button>
                            </EmptyState>
                        }
                        else if (Active.Status == ConnectionStatus.Failed && Active.Profile is { } failed)
                        {
                            <EmptyState Title="@($"Verbindung zu {failed.Name} fehlgeschlagen")" IsError="true">
                                <div class="error-detail">
                                    @if (Active.Error?.ErrorCode is { } errorCode)
                                    {
                                        <span class="code">@errorCode</span>
                                    }
                                    <span>@Active.Error?.Message</span>
                                </div>
                                <div class="button-row">
                                    <button class="btn primary" @onclick="() => _state.Connect(failed)">Erneut versuchen</button>
                                    <button class="btn" @onclick="() => _state.EditConnection(failed)">Bearbeiten</button>
                                    <button class="btn ghost" @onclick="_state.ShowConnections">Zur Übersicht</button>
                                </div>
                            </EmptyState>
                        }
                    </ChildContent>
                    <ErrorContent Context="exception">
                        <EmptyState Title="Da ist etwas schiefgelaufen" Text="@exception.Message" IsError="true">
                            <button class="btn" @onclick="RecoverFromError">Weiter</button>
                        </EmptyState>
                    </ErrorContent>
                </ErrorBoundary>
            </main>
        </div>

        <footer class="statusbar">
            @if (Connections.LoadError is { } loadError)
            {
                <span class="item error" title="@loadError"><span class="dot err"></span> Verbindungen konnten nicht geladen werden</span>
            }
            else
            {
                @switch (Active.Status)
                {
                    case ConnectionStatus.Connected:
                        <span class="item"><span class="dot ok"></span> Verbunden</span>
                        <span class="item">@Active.Profile?.Name</span>
                        @if (Workspaces.Active is { } workspace)
                        {
                            <span class="item" title="Jeder Workspace fragt über eine eigene Oracle-Session ab (ACTION = Workspace-Name).">Workspace „@workspace.Name“ · eigene Session</span>
                        }
                        <span class="item">Oracle @Active.ServerVersion</span>
                        <span class="item">Schema @Active.Schema?.Owner · @(Active.Schema?.Tables.Count ?? 0) Objekte</span>
                        <button class="status-btn" @onclick="DisconnectAsync">Trennen</button>
                        break;
                    case ConnectionStatus.Connecting:
                        <span class="item"><span class="spinner small"></span> Verbinde mit @Active.Profile?.Name …</span>
                        break;
                    case ConnectionStatus.Failed:
                        <span class="item error"><span class="dot err"></span> Verbindung fehlgeschlagen</span>
                        break;
                    default:
                        <span class="item"><span class="dot"></span> Nicht verbunden</span>
                        break;
                }
            }
            @if (Workspaces.SaveError is { } saveError)
            {
                <span class="item error" title="@saveError"><span class="dot err"></span> Workspace nicht gespeichert</span>
            }
            @if (Workspaces.LoadErrors.Count > 0)
            {
                <span class="item error" title="@string.Join(Environment.NewLine, Workspaces.LoadErrors)">
                    <span class="dot err"></span> @(Workspaces.LoadErrors.Count == 1 ? "1 Workspace-Datei" : $"{Workspaces.LoadErrors.Count} Workspace-Dateien") nicht lesbar
                </span>
            }
            <span class="spacer"></span>
            <span class="item">@Version</span>
        </footer>
    </div>

    @if (_state.ConnectionDialog is { } request)
    {
        <ConnectionDialog @key="request" Request="request" OnClose="_state.CloseConnectionDialog" />
    }

    @if (_state.PendingDelete is { } pending)
    {
        <ConfirmDialog Title="Verbindung löschen" ConfirmLabel="Löschen" Danger="true"
                       OnConfirm="() => DeleteAsync(pending)" OnCancel="_state.CancelDelete">
            Verbindung <strong>@pending.Name</strong> (@pending.Address.Display) wirklich löschen?
            Das gespeicherte Passwort wird ebenfalls entfernt.
        </ConfirmDialog>
    }
</CascadingValue>

@code {
    private const string SwitcherShortcut = "ctrl+shift+o";
    private const string ApplyFiltersShortcut = "ctrl+enter";
    private const string RefreshShortcut = "f5"; // also stops the WebView from reloading the page

    private static readonly string Version =
        "v" + (typeof(Shell).Assembly.GetName().Version?.ToString(3) ?? "0.0.0");

    private readonly ShellState _state = new();
    private ErrorBoundary? _errorBoundary;
    private IJSObjectReference? _shortcuts;
    private DotNetObjectReference<Shell>? _selfRef;

    private bool ShowExplorer => _state.Page == ShellPage.Explorer && Active.Status != ConnectionStatus.Disconnected;

    private bool IsProdActive => Active.Profile?.Kind == ConnectionKind.Prod
                                 && Active.Status is ConnectionStatus.Connected or ConnectionStatus.Connecting;

    protected override async Task OnInitializedAsync()
    {
        _state.Changed += OnChanged;
        _state.Dirty += SaveTabs;
        _state.ConnectRequested += OnConnectRequested;
        Connections.Changed += OnChanged;
        Active.Changed += OnConnectionOrWorkspacesChanged;
        Workspaces.Changed += OnConnectionOrWorkspacesChanged;
        await Connections.LoadAsync(CancellationToken.None);
        await Recent.LoadAsync(CancellationToken.None);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            _shortcuts = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/FerretSharp.UI/js/shortcuts.js");
            await _shortcuts.InvokeVoidAsync("register", _selfRef, new[] { SwitcherShortcut, ApplyFiltersShortcut, RefreshShortcut });
        }
    }

    [JSInvokable]
    public void OnShortcut(string combo)
    {
        if (_state.ConnectionDialog is not null || _state.PendingDelete is not null)
        {
            return;
        }

        switch (combo)
        {
            case SwitcherShortcut:
                _state.OpenSwitcher();
                break;
            case ApplyFiltersShortcut:
                _state.RequestTabCommand(TabCommand.ApplyFilters);
                break;
            case RefreshShortcut:
                _state.RequestTabCommand(TabCommand.Refresh);
                break;
        }
    }

    private void CloseOnMiddleClick(MouseEventArgs e, TableTab tab)
    {
        if (e.Button == 1)
        {
            _state.CloseTab(tab);
        }
    }

    /// <summary>Runs off the UI thread; ActiveConnection reports progress through its Changed event.</summary>
    private void OnConnectRequested(ConnectionProfile profile)
    {
        SaveTabs();
        _state.ClearWorkspaces();
        _ = Task.Run(() => Active.ConnectAsync(profile, CancellationToken.None));
    }

    /// <summary>Hands the tabs of every open workspace to the manager, which saves what changed (debounced).</summary>
    private void SaveTabs()
    {
        foreach (var workspace in _state.Workspaces)
        {
            Workspaces.UpdateTabs(workspace.WorkspaceId, workspace.Tabs.Select(t => t.ToState()).ToList(), workspace.ActiveIndex);
        }
    }

    private void OnConnectionOrWorkspacesChanged() => InvokeAsync(() =>
    {
        if (Active.IsConnected && Active.Schema is { } schema && Workspaces.Profile?.Id == Active.Profile?.Id)
        {
            _state.SyncWorkspaces(Workspaces.Open, Workspaces.Active?.Id, schema);
        }
        else if (_state.Workspaces.Count > 0)
        {
            _state.ClearWorkspaces();
        }

        StateHasChanged();
    });

    private void ToggleHome()
    {
        if (_state.Page == ShellPage.Connections)
        {
            _state.ShowExplorer();
        }
        else
        {
            _state.ShowConnections();
        }
    }

    private async Task DisconnectAsync()
    {
        SaveTabs();
        await Active.DisconnectAsync();
        _state.ClearWorkspaces();
        _state.ShowConnections();
    }

    private async Task DeleteAsync(ConnectionProfile profile)
    {
        _state.CancelDelete();
        if (Active.Profile?.Id == profile.Id)
        {
            await DisconnectAsync();
        }

        await Connections.DeleteAsync(profile.Id, CancellationToken.None);
        await Workspaces.DeleteForConnectionAsync(profile.Id);
    }

    private void RecoverFromError()
    {
        _state.CloseAllTabs();
        _errorBoundary?.Recover();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        _state.Changed -= OnChanged;
        _state.Dirty -= SaveTabs;
        _state.ConnectRequested -= OnConnectRequested;
        Connections.Changed -= OnChanged;
        Active.Changed -= OnConnectionOrWorkspacesChanged;
        Workspaces.Changed -= OnConnectionOrWorkspacesChanged;
        if (_shortcuts is not null)
        {
            try
            {
                await _shortcuts.InvokeVoidAsync("unregister");
                await _shortcuts.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _selfRef?.Dispose();
    }
}
