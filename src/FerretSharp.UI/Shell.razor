@* Root component hosted by the BlazorWebView. *@
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Data
@using FerretSharp.UI.State
@implements IAsyncDisposable
@inject ConnectionManager Connections
@inject ActiveConnection Active
@inject WorkspaceManager Workspaces
@inject RecentConnections Recent
@inject ConnectionKeepAlive KeepAlive
@inject FerretSharp.Core.Settings.AppSettingsService Settings
@inject ExitGuard ExitGuard
@inject FerretSharp.Core.ClrModel.ClrModelManager Models
@inject PresentationService Presentations
@inject IJSRuntime JS
@inject FerretSharp.Core.Workspaces.SqlHistoryStore SqlHistory

<CascadingValue Value="_state" IsFixed="true">
    <div class="app @(IsProdActive ? "is-prod" : "")">
        <header class="topbar">
            <div class="brand">Ferret<span>Sharp</span></div>
            @if (Active.Status != ConnectionStatus.Disconnected)
            {
                <button class="icon-btn ghost @(_state.Page == ShellPage.Connections ? "active" : "")" title="Alle Verbindungen"
                        @onclick="ToggleHome">@Icons.Home</button>
            }
            <ConnectionSwitcher />
            @if (Active.IsConnected)
            {
                <WorkspaceBar />
            }
            <div class="topbar-right">
                <button class="icon-btn ghost @(_state.Page == ShellPage.Settings ? "active" : "")" title="Einstellungen"
                        @onclick="ToggleSettings">@Icons.Settings</button>
                @if (Active.Profile is { } badgeProfile && Active.Status != ConnectionStatus.Disconnected)
                {
                    @if (badgeProfile.ReadOnly && Active.IsConnected && Workspaces.Active is { } badgeWorkspace)
                    {
                        // Read-only profile: the badge shows (and switches) the lock of the active workspace (WP-10).
                        var unlocked = Workspaces.IsUnlocked(badgeWorkspace.Id);
                        <button class="badge badge-btn @(IsProdActive ? "badge-prod" : "") @(unlocked ? "unlocked" : "")"
                                title="@(unlocked ? $"Workspace „{badgeWorkspace.Name}“ ist zum Schreiben freigeschaltet – klicken zum Sperren." : $"{ReadOnlyTooltip} Klicken, um den Workspace „{badgeWorkspace.Name}“ zum Schreiben freizuschalten.")"
                                @onclick="() => unlocked ? LockWorkspaceAsync(badgeWorkspace.Id) : RequestUnlockAsync(badgeWorkspace.Id)">
                            @(IsProdActive ? "PROD · " : "")@(unlocked ? "FREIGESCHALTET" : "READ-ONLY")
                        </button>
                    }
                    else
                    {
                        <span class="badge @(IsProdActive ? "badge-prod" : "") @(badgeProfile.ReadOnly ? "" : "editable")" title="@ReadOnlyTooltip">
                            @(IsProdActive ? "PROD · " : "")@(badgeProfile.ReadOnly ? "READ-ONLY" : "BEARBEITBAR")
                        </span>
                    }
                }
            </div>
        </header>

        @if (_state.ConnectionLost is { } lost && Active.IsConnected && Active.Profile is { } lostProfile)
        {
            <div class="lost-banner" role="alert">
                <span class="dot err"></span>
                <span class="grow">
                    <strong>Verbindung zur Datenbank verloren.</strong>
                    @lost.Display
                    @if (Workspaces.Active is { } lostWorkspace && Workspaces.TransactionOf(lostWorkspace.Id) is { Mode: TransactionMode.ReadWrite })
                    {
                        <strong> Die offene Transaktion ist verloren – nicht committete Änderungen sind weg.</strong>
                    }
                    <span class="muted">„Neu verbinden“ stellt alle Workspaces mit ihren Tabs und Filtern wieder her.</span>
                </span>
                <button class="btn primary" @onclick="() => Reconnect(lostProfile)">Neu verbinden</button>
                <button class="btn ghost" @onclick="() => _state.ShowError(lost)">Details</button>
                <button class="btn ghost" @onclick="DisconnectAsync">Trennen</button>
            </div>
        }

        <div class="body">
            @if (ShowExplorer && Active.IsConnected)
            {
                <Explorer />
            }

            <main class="content">
                <ErrorBoundary @ref="_errorBoundary">
                    <ChildContent>
                        @* Tabs of all open workspaces stay mounted while connected (also behind the overview), so grids keep
                           their state. Restored tabs mount when first shown. *@
                        @if (Active.IsConnected)
                        {
                            <div class="workarea @(ShowExplorer ? "" : "hidden")">
                                <nav class="tabs">
                                    @foreach (var tab in _state.Tabs)
                                    {
                                        var w = tab;
                                        @if (w is TableTab t)
                                        {
                                            // Several tabs of one table (FK jumps) are told apart by their filters.
                                            var summary = _state.Tabs.OfType<TableTab>().Count(o => o.Table.Ref == t.Table.Ref) > 1 ? t.FilterSummary(presentation: PresentationOf(t)) : null;
                                            <div class="tab @(t == _state.ActiveTab ? "active" : "")" title="@TabTooltip(t)"
                                                 @onclick="() => _state.ActivateTab(t)" @onmouseup="e => CloseOnMiddleClick(e, t)">
                                                @Icons.For(t.Table.Kind)
                                                <span class="tab-name">@t.Table.DisplayName</span>
                                                @if (t.Changes is { HasChanges: true } tabChanges)
                                                {
                                                    <span class="dot @(tabChanges.PendingCount > 0 ? "pending" : "flushed")"
                                                          title="@($"{tabChanges.PendingCount} ausstehend · {tabChanges.FlushedCount} geschrieben")"></span>
                                                }
                                                @if (summary is not null)
                                                {
                                                    <span class="tab-filter">@summary</span>
                                                }
                                                else if (t.ActiveFilterCount > 0)
                                                {
                                                    <span class="filter-pill">@t.ActiveFilterCount Filter</span>
                                                }
                                                <button class="tab-close" title="Schließen" @onclick:stopPropagation="true" @onclick="() => CloseTab(t)">✕</button>
                                            </div>
                                        }
                                        else if (w is LinqTab linq)
                                        {
                                            <div class="tab linq @(linq == _state.ActiveTab ? "active" : "")" title="@(_renamingTab == linq ? null : "LINQ-Konsole – C# gegen den DbContext des verknüpften Projekts · Doppelklick: umbenennen")"
                                                 @onclick="e => OnTitledTabClick(e, linq)" @onmouseup="e => CloseOnMiddleClick(e, linq)">
                                                @Icons.Code
                                                @TabTitle(linq)
                                                <button class="tab-close" title="Schließen" @onclick:stopPropagation="true" @onclick="() => CloseTab(linq)">✕</button>
                                            </div>
                                        }
                                        else if (w is SqlTab sql)
                                        {
                                            <div class="tab sql @(sql == _state.ActiveTab ? "active" : "")" title="@(_renamingTab == sql ? null : "SQL-Editor – Statements in der Session dieses Workspaces · Doppelklick: umbenennen")"
                                                 @onclick="e => OnTitledTabClick(e, sql)" @onmouseup="e => CloseOnMiddleClick(e, sql)">
                                                @Icons.Database
                                                @TabTitle(sql)
                                                <button class="tab-close" title="Schließen" @onclick:stopPropagation="true" @onclick="() => CloseTab(sql)">✕</button>
                                            </div>
                                        }
                                    }
                                    <button class="tab-new" title="Neuer SQL-Editor: Statements in der Session dieses Workspaces (Ctrl+Shift+Q)"
                                            @onclick="() => _state.OpenSql()">+ SQL</button>
                                    @if (HasLinkedProject)
                                    {
                                        <button class="tab-new" title="Neue LINQ-Konsole: C# gegen den DbContext des verknüpften Projekts (Ctrl+Shift+L)"
                                                @onclick="() => _state.OpenLinq()">+ LINQ</button>
                                    }
                                </nav>
                                <div class="pages">
                                    @foreach (var workspace in _state.Workspaces)
                                    {
                                        foreach (var tab in workspace.Tabs.Where(t => t.Visited))
                                        {
                                            <div class="page @(workspace == _state.ActiveWorkspace && tab == workspace.ActiveTab ? "active" : "")" @key="tab.Id">
                                                <TabFrame OnClose="() => CloseTab(tab)">
                                                    @if (tab is TableTab tableTab)
                                                    {
                                                        <TabView Tab="tableTab" />
                                                    }
                                                    else if (tab is LinqTab linqTab)
                                                    {
                                                        <LinqView Tab="linqTab" />
                                                    }
                                                    else if (tab is SqlTab sqlTab)
                                                    {
                                                        <SqlView Tab="sqlTab" />
                                                    }
                                                </TabFrame>
                                            </div>
                                        }
                                    }
                                    @if (_state.Tabs.Count == 0)
                                    {
                                        <EmptyState Title="Tabelle auswählen" Text="@(HasLinkedProject
                                            ? "Links eine Tabelle oder View wählen – oder mit „+ SQL“ (Ctrl+Shift+Q) SQL schreiben, mit „+ LINQ“ eine Query aus dem C#-Code ausführen. Ctrl+Enter wendet Filter an, F5 lädt neu."
                                            : "Links eine Tabelle oder View wählen – oder mit „+ SQL“ (Ctrl+Shift+Q) SQL schreiben. Ctrl+Enter wendet Filter an, F5 lädt neu.")" />
                                    }
                                </div>
                            </div>
                        }

                        @if (_state.Page == ShellPage.Settings)
                        {
                            <SettingsPage OnBack="LeaveSettings" />
                        }
                        else if (_state.Page == ShellPage.Model && Active.IsConnected)
                        {
                            <ModelPage />
                        }
                        else if (!ShowExplorer)
                        {
                            <ConnectionsPage />
                        }
                        else if (Active.Status == ConnectionStatus.Connecting && Active.Profile is { } connecting)
                        {
                            <EmptyState Title="@($"Verbinde mit {connecting.Name} …")" Text="@connecting.Address.Display">
                                <span class="spinner"></span>
                                <button class="btn" @onclick="Active.CancelPendingConnect">Abbrechen</button>
                            </EmptyState>
                        }
                        else if (Active.Status == ConnectionStatus.Failed && Active.Profile is { } failed)
                        {
                            <EmptyState Title="@($"Verbindung zu {failed.Name} fehlgeschlagen")" IsError="true">
                                <div class="error-detail">
                                    @if (Active.Error?.ErrorCode is { } errorCode)
                                    {
                                        <span class="code">@errorCode</span>
                                    }
                                    <span>@Active.Error?.Message</span>
                                </div>
                                <div class="button-row">
                                    <button class="btn primary" @onclick="() => _state.Connect(failed)">Erneut versuchen</button>
                                    <button class="btn" @onclick="() => _state.EditConnection(failed)">Bearbeiten</button>
                                    <button class="btn ghost" @onclick="_state.ShowConnections">Zur Übersicht</button>
                                </div>
                            </EmptyState>
                        }
                    </ChildContent>
                    <ErrorContent Context="exception">
                        <EmptyState Title="Da ist etwas schiefgelaufen" Text="@exception.Message" IsError="true">
                            <div class="button-row">
                                <button class="btn primary" @onclick="RecoverFromError">Weiter</button>
                                <button class="btn" title="Falls „Weiter“ wieder hierher führt" @onclick="CloseTabsAfterErrorAsync">Tabs schließen</button>
                            </div>
                        </EmptyState>
                    </ErrorContent>
                </ErrorBoundary>
            </main>
        </div>

        <footer class="statusbar">
            @if (Connections.LoadError is { } loadError)
            {
                <span class="item error" title="@loadError"><span class="dot err"></span> Verbindungen konnten nicht geladen werden</span>
            }
            else
            {
                @switch (Active.Status)
                {
                    case ConnectionStatus.Connected when _state.ConnectionLost is not null:
                        <span class="item error"><span class="dot err"></span> Verbindung verloren</span>
                        <span class="item">@Active.Profile?.Name</span>
                        <button class="status-btn" @onclick="() => Reconnect(Active.Profile!)">Neu verbinden</button>
                        break;
                    case ConnectionStatus.Connected:
                        <span class="item"><span class="dot ok"></span> Verbunden</span>
                        <span class="item shrink" title="@Active.Profile?.Name">@Active.Profile?.Name</span>
                        @if (Workspaces.Active is { } workspace)
                        {
                            <span class="item shrink" title="Workspace „@workspace.Name“ – fragt über eine eigene Oracle-Session ab (ACTION = Workspace-Name).">Workspace „@workspace.Name“</span>
                            @if (Active.Profile?.ReadOnly == true && !Workspaces.IsUnlocked(workspace.Id))
                            {
                                <span class="item" title="Die Workspace-Sessions laufen in einer READ ONLY-Transaktion: Oracle selbst lehnt jede Änderung ab.">schreibgeschützt (Oracle)</span>
                                <button class="status-btn" title="Diesen Workspace zum Schreiben freischalten" @onclick="() => _state.RequestUnlock(workspace.Id)">Freischalten …</button>
                            }
                            else
                            {
                                @if (Workspaces.IsUnlocked(workspace.Id))
                                {
                                    <span class="item unlocked-item" title="Oracle schützt diesen Workspace nicht mehr; die anderen Workspaces bleiben gesperrt.">freigeschaltet</span>
                                    <button class="status-btn" title="Wieder sperren (offene Änderungen vorher committen oder verwerfen)" @onclick="() => LockWorkspaceAsync(workspace.Id)">Sperren</button>
                                }
                                @if (_state.ActiveWorkspace is { } editTabs && _editing.SummaryOf(editTabs) is { HasWork: true } edits)
                                {
                                    @EditStatus(editTabs, edits)
                                }
                            }
                        }
                        @ModelStatus()
                        <span class="item shrink shrink-more" title="Oracle @Active.ServerVersion">Oracle @Active.ServerVersion</span>
                        <span class="item shrink shrink-more" title="Schema @Active.Schema?.Owner · @(Active.Schema?.Tables.Count ?? 0) Objekte">Schema @Active.Schema?.Owner · @(Active.Schema?.Tables.Count ?? 0) Objekte</span>
                        <button class="status-btn" @onclick="DisconnectAsync">Trennen</button>
                        break;
                    case ConnectionStatus.Connecting:
                        <span class="item"><span class="spinner small"></span> Verbinde mit @Active.Profile?.Name …</span>
                        break;
                    case ConnectionStatus.Failed:
                        <span class="item error"><span class="dot err"></span> Verbindung fehlgeschlagen</span>
                        break;
                    default:
                        <span class="item"><span class="dot"></span> Nicht verbunden</span>
                        break;
                }
            }
            @if (Workspaces.SaveError is { } saveError)
            {
                <span class="item error" title="@saveError"><span class="dot err"></span> Workspace nicht gespeichert</span>
            }
            @if (Workspaces.LoadErrors.Count > 0)
            {
                <span class="item error" title="@string.Join(Environment.NewLine, Workspaces.LoadErrors)">
                    <span class="dot err"></span> @(Workspaces.LoadErrors.Count == 1 ? "1 Workspace-Datei" : $"{Workspaces.LoadErrors.Count} Workspace-Dateien") nicht lesbar
                </span>
            }
            <span class="spacer"></span>
            <span class="item">@Version</span>
        </footer>
    </div>

    @if (_state.ConnectionDialog is { } request)
    {
        <ConnectionDialog @key="request" Request="request" OnClose="_state.CloseConnectionDialog" />
    }

    @if (_state.ErrorDetails is { } error)
    {
        <ErrorDialog @key="error" Error="error" Mask="@(Active.Profile?.Kind == ConnectionKind.Prod)" OnClose="_state.CloseError" />
    }

    @if (_state.Notice is { } notice)
    {
        <div class="toast @(notice.Warnings.Count > 0 ? "warn" : "")" role="status" @key="notice">
            <div class="toast-text">@notice.Text</div>
            @foreach (var warning in notice.Warnings)
            {
                <div class="toast-warning">⚠ @warning</div>
            }
            <button class="icon-btn ghost toast-close" title="Schließen" @onclick="() => _state.DismissNotice(notice)">✕</button>
        </div>
    }

    @if (_editing.Problem is { } problem)
    {
        <WriteProblemDialog @key="problem" Problem="problem" Wait="Settings.Current.LockWaitSeconds" OnChoice="_editing.ResolveAsync" />
    }

    @if (_state.PendingLeave is { } leave)
    {
        <LeaveDialog @key="leave" Request="leave" Busy="_editing.Busy"
                     Items="@(leave.WorkspaceIds.Select(id => (WorkspaceName(id), _editing.SummaryOf(_state.Workspaces.First(w => w.WorkspaceId == id)))).ToList())"
                     OnCommit="() => LeaveAsync(commit: true)" OnDiscard="() => LeaveAsync(commit: false)" OnCancel="_state.CloseLeave" />
    }

    @if (_confirmRollback is { } rollbackTabs)
    {
        <ConfirmDialog Title="Rollback" ConfirmLabel="Alles verwerfen" Danger="true"
                       OnConfirm="() => RollbackAsync(rollbackTabs)" OnCancel="() => _confirmRollback = null">
            Alle Änderungen in <strong>@WorkspaceName(rollbackTabs.WorkspaceId)</strong> verwerfen – die geschriebenen
            (Rollback der Transaktion) und die ausstehenden? Das lässt sich nicht rückgängig machen.
        </ConfirmDialog>
    }

    @if (_confirmCommit is { } commitTabs)
    {
        <ConfirmDialog Title="Commit auf Produktion" ConfirmLabel="Committen" Danger="true"
                       OnConfirm="() => CommitAsync(commitTabs)" OnCancel="() => _confirmCommit = null">
            Die Änderungen in <strong>@WorkspaceName(commitTabs.WorkspaceId)</strong>
            (@_editing.SummaryOf(commitTabs).Pending ausstehend · @_editing.SummaryOf(commitTabs).Flushed geschrieben)
            werden in <strong>@Active.Profile?.Name</strong> committed und sind danach für alle sichtbar.
        </ConfirmDialog>
    }

    @if (_state.PendingUnlock is { } unlockId && Active.Profile is { } unlockProfile && Workspaces.Find(unlockId) is { } unlockWorkspace)
    {
        <UnlockDialog @key="unlockId" Profile="unlockProfile" WorkspaceName="@unlockWorkspace.Name"
                      OnConfirm="() => UnlockAsync(unlockId)" OnCancel="_state.CloseUnlock" />
    }

    @if (_confirmCloseTab is { } closingTab)
    {
        <ConfirmDialog Title="Tab schließen" ConfirmLabel="Verwerfen und schließen" Danger="true"
                       OnConfirm="() => ConfirmCloseTab(closingTab)" OnCancel="() => _confirmCloseTab = null">
            <strong>@closingTab.Table.DisplayName</strong> hat @closingTab.Changes!.PendingCount ausstehende Änderung(en), die noch nicht
            geschrieben sind. Sie gehen beim Schließen verloren. Bereits geschriebene Änderungen bleiben in der Transaktion des Workspaces.
        </ConfirmDialog>
    }

    @if (_pendingSql is { } pendingSql)
    {
        <SqlPreview Sql="@pendingSql" Parameters="NoParameters" Error="@null" OnClose="() => _pendingSql = null" />
    }

    @if (_state.PendingDelete is { } pending)
    {
        <ConfirmDialog Title="Verbindung löschen" ConfirmLabel="Löschen" Danger="true"
                       OnConfirm="() => DeleteAsync(pending)" OnCancel="_state.CancelDelete">
            Verbindung <strong>@pending.Name</strong> (@pending.Address.Display) wirklich löschen?
            Das gespeicherte Passwort wird ebenfalls entfernt.
        </ConfirmDialog>
    }
</CascadingValue>

@code {
    private const string SwitcherShortcut = "ctrl+shift+o";
    private const string ApplyFiltersShortcut = "ctrl+enter";
    private const string RefreshShortcut = "f5"; // also stops the WebView from reloading the page
    private const string FindColumnShortcut = "ctrl+f"; // the browser's find would miss columns the grid has not rendered
    private const string BackShortcut = "alt+arrowleft"; // also keeps the WebView from navigating back
    private const string ForwardShortcut = "alt+arrowright";
    private const string FlushShortcut = "ctrl+s"; // write pending changes (no commit)
    private const string CommitShortcut = "ctrl+shift+enter";
    private const string LinqShortcut = "ctrl+shift+l"; // new LINQ console (WP-13)
    private const string SqlShortcut = "ctrl+shift+q"; // new SQL editor (WP-17)
    private const string ScriptShortcut = "alt+x"; // SQL editor: run the whole script (as in DBeaver)

    /// <summary>An open writing transaction older than this is shown as a warning: it holds row locks.</summary>
    private static readonly TimeSpan LongTransaction = TimeSpan.FromMinutes(10);

    private static readonly string Version =
        "v" + (typeof(Shell).Assembly.GetName().Version?.ToString(3) ?? "0.0.0");

    private static readonly IReadOnlyList<FerretSharp.Core.Query.QueryParameter> NoParameters = [];

    private readonly ShellState _state = new();
    private WorkspaceEditing _editing = null!;
    private WorkspaceTabs? _confirmRollback;
    private WorkspaceTabs? _confirmCommit;
    private TableTab? _confirmCloseTab;
    private string? _pendingSql;
    private bool _connectionGone; // "Neu verbinden" after a loss: the old transactions no longer exist
    private Timer? _ticker;
    private Notice? _scheduledNotice;
    private ErrorBoundary? _errorBoundary;
    private IJSObjectReference? _shortcuts;
    private DotNetObjectReference<Shell>? _selfRef;

    /// <summary>The active connection has a C# project: LINQ consoles can be opened (WP-13).</summary>
    private bool HasLinkedProject => Models.State.Link is not null;

    private bool ShowExplorer => _state.Page == ShellPage.Explorer && Active.Status != ConnectionStatus.Disconnected;

    private bool IsProdActive => Active.Profile?.Kind == ConnectionKind.Prod
                                 && Active.Status is ConnectionStatus.Connected or ConnectionStatus.Connecting;

    private string ReadOnlyTooltip => Active.Profile?.ReadOnly == true
        ? "Schreibgeschützte Verbindung: Oracle selbst lehnt jede Änderung ab (READ ONLY-Transaktion)."
        : "Bearbeiten möglich: Änderungen laufen in einer Transaktion pro Workspace und sind für andere erst nach dem Commit sichtbar.";

    /// <summary>Status bar segment of the active workspace while it has uncommitted work.</summary>
    private RenderFragment EditStatus(WorkspaceTabs workspace, EditSummary edits)
    {
        var age = edits.Transaction is { Mode: TransactionMode.ReadWrite, StartedAt: { } started } ? DateTimeOffset.Now - started : (TimeSpan?)null;
        return @<text>
            <span class="item tx @(age > LongTransaction ? "warn" : "")"
                  title="@(age > LongTransaction ? "Die Transaktion ist lange offen und hält Zeilensperren – andere warten auf diese Zeilen." : "Ausstehend: nur hier. Geschrieben: in der Transaktion, Zeilen gesperrt, für andere unsichtbar bis zum Commit.")">
                <span class="dot @(edits.Pending > 0 ? "pending" : "flushed")"></span>
                @(age is { } a ? $"Tx seit {Age(a)} · " : "")@edits.Pending ausstehend · @edits.Flushed geschrieben
            </span>
            @if (edits.Actions.Count > 0)
            {
                <span class="item tx" title="@ActionsTooltip(edits.Actions)">@(edits.Actions.Count == 1 ? "1 Aktion" : $"{edits.Actions.Count} Aktionen") nicht committet</span>
            }
            <span class="status-group">
            <button class="status-btn" title="Ausstehende Änderungen schreiben (Ctrl+S) – noch kein Commit" disabled="@(_editing.Busy || edits.Pending == 0)" @onclick="() => _editing.FlushAsync(workspace)">Schreiben</button>
            <button class="status-btn" title="@(edits.Actions is [.., var last] ? $"Zurücknehmen: {last.Display} ({SourceOf(last)})" : "Nichts zurückzunehmen")"
                    disabled="@(_editing.Busy || !edits.CanUndo)" @onclick="() => _editing.UndoLastAsync(workspace)">↶</button>
            <button class="status-btn" title="Ausstehende Änderungen als SQL anzeigen" disabled="@(edits.Pending == 0)" @onclick="() => _pendingSql = _editing.DescribePending(workspace)">SQL</button>
            <button class="status-btn commit" title="Schreiben und committen (Ctrl+Shift+Enter)" disabled="@_editing.Busy" @onclick="() => RequestCommit(workspace)">Commit</button>
            <button class="status-btn danger" title="Alles verwerfen" disabled="@_editing.Busy" @onclick="() => _confirmRollback = workspace">Rollback</button>
            </span>
        </text>;
    }

    /// <summary>The uncommitted writes, newest first – ↶ takes back the first one listed.</summary>
    private static string ActionsTooltip(IReadOnlyList<WriteAction> actions) =>
        "Nicht committet, neueste zuerst (↶ nimmt die oberste zurück):" + Environment.NewLine
        + string.Join(Environment.NewLine, actions.Reverse().Select(a => $"{a.At.ToLocalTime():HH:mm:ss}  {a.Display} ({SourceOf(a)})"));

    private static string SourceOf(WriteAction action) => action.Kind == WriteActionKind.Grid ? "Grid" : "SQL/LINQ";

    /// <summary>Status bar: the C# model of the linked project (WP-11); opens the model page.</summary>
    private RenderFragment ModelStatus()
    {
        var state = Models.State;
        if (state.Link is null)
        {
            return @<text></text>;
        }

        if (state.Phase == FerretSharp.Core.ClrModel.ClrModelPhase.Loading)
        {
            return @<button class="item status-link shrink" title="@(state.Step ?? "Lese das C#-Modell") …" @onclick="_state.ShowModel"><span class="spinner small"></span> C# · @(state.Step ?? "lädt") …</button>;
        }

        if (state.Phase == FerretSharp.Core.ClrModel.ClrModelPhase.Failed)
        {
            return @<button class="item status-link error" title="@state.Error?.Message" @onclick="_state.ShowModel"><span class="dot err"></span> C#-Modell</button>;
        }

        if (state.Mapping is not { } mapping)
        {
            return @<text></text>;
        }

        var stale = state.Output?.IsStale == true;
        var text = $"C# · {mapping.MappedEntityCount} Entities" + (mapping.Issues.Count > 0 ? $" · {mapping.Issues.Count} Abw." : "") + (stale ? " · Build veraltet" : "");
        var title = (stale ? "Der Quelltext ist neuer als der Build. " : "") + $"{mapping.Issues.Count} Abweichungen zwischen Modell und Datenbank – Details";
        return @<button class="item status-link shrink @(stale ? "warn" : "")" title="@title" @onclick="_state.ShowModel">@text</button>;
    }

    private static string Age(TimeSpan age) => age.TotalMinutes < 1 ? "< 1 min" : $"{(int)age.TotalMinutes} min";

    private string WorkspaceName(Guid workspaceId) => Workspaces.Find(workspaceId)?.Name ?? "Workspace";

    private Task RequestUnlockAsync(Guid workspaceId)
    {
        _state.RequestUnlock(workspaceId);
        return Task.CompletedTask;
    }

    /// <summary>Unlocks the workspace (WP-10) and reloads its tabs: they showed the read-only snapshot.</summary>
    private async Task UnlockAsync(Guid workspaceId)
    {
        _state.CloseUnlock();
        try
        {
            await Workspaces.UnlockAsync(workspaceId, CancellationToken.None);
            foreach (var tab in _state.Workspaces.FirstOrDefault(w => w.WorkspaceId == workspaceId)?.Tabs ?? [])
            {
                _state.RequestTabCommand(tab, TabCommand.Reload);
            }

            _state.Notify($"Workspace „{WorkspaceName(workspaceId)}“ ist zum Schreiben freigeschaltet.");
        }
        catch (DatabaseException ex)
        {
            _state.ReportFailure(ex);
            _state.ShowError(ex);
        }
    }

    /// <summary>Locks the workspace again – after asking what happens to its uncommitted changes.</summary>
    private Task LockWorkspaceAsync(Guid workspaceId) =>
        GuardAsync("Workspace sperren", _state.Workspaces.Where(w => w.WorkspaceId == workspaceId).ToList(), async () =>
        {
            try
            {
                await Workspaces.LockAsync(workspaceId, CancellationToken.None);
                _state.Notify($"Workspace „{WorkspaceName(workspaceId)}“ ist wieder schreibgeschützt.");
            }
            catch (InvalidOperationException ex)
            {
                _state.Notify(ex.Message);
            }
            catch (DatabaseException ex)
            {
                _state.ReportFailure(ex);
                _state.ShowError(ex);
            }
        });

    /// <summary>Commits right away, on Prod only after a confirmation.</summary>
    private Task RequestCommit(WorkspaceTabs workspace)
    {
        if (IsProdActive)
        {
            _confirmCommit = workspace;
            StateHasChanged(); // also reached from the shortcut, outside a Blazor event
            return Task.CompletedTask;
        }

        return _editing.CommitAsync(workspace);
    }

    private async Task CommitAsync(WorkspaceTabs workspace)
    {
        _confirmCommit = null;
        await _editing.CommitAsync(workspace);
    }

    private async Task RollbackAsync(WorkspaceTabs workspace)
    {
        _confirmRollback = null;
        await _editing.RollbackAsync(workspace);
    }

    /// <summary>Asks before <paramref name="then"/> if workspaces have uncommitted work; runs it right away otherwise.</summary>
    private Task GuardAsync(string what, IReadOnlyList<WorkspaceTabs> scope, Func<Task> then)
    {
        var withWork = scope.Where(w => _editing.SummaryOf(w).HasWork).Select(w => w.WorkspaceId).ToList();
        if (withWork.Count == 0 || _state.ConnectionLost is not null || _connectionGone)
        {
            return then();
        }

        _state.ConfirmLeave(new LeaveRequest(what, withWork, then));
        return Task.CompletedTask;
    }

    /// <summary>Leave dialog: commit or discard every listed workspace, then continue (only if all succeeded).</summary>
    private async Task LeaveAsync(bool commit)
    {
        if (_state.PendingLeave is not { } leave)
        {
            return;
        }

        foreach (var id in leave.WorkspaceIds)
        {
            if (_state.Workspaces.FirstOrDefault(w => w.WorkspaceId == id) is not { } workspace)
            {
                continue;
            }

            if (!(commit ? await _editing.CommitAsync(workspace) : await _editing.RollbackAsync(workspace)))
            {
                _state.CloseLeave(); // a write problem dialog (or error) explains why; nothing is left behind half done
                return;
            }
        }

        _state.CloseLeave();
        await leave.Continue();
    }

    protected override async Task OnInitializedAsync()
    {
        _editing = new WorkspaceEditing(_state, Workspaces, Active, Settings);
        _state.Guard = (what, ids, then) => GuardAsync(what, _state.Workspaces.Where(w => ids.Contains(w.WorkspaceId)).ToList(), then);
        _state.LockWorkspace = LockWorkspaceAsync;
        ExitGuard.CanExit = () => _editing.WithWork().Count == 0 || _state.ConnectionLost is not null;
        ExitGuard.RequestExit = () => InvokeAsync(() => GuardAsync("FerretSharp beenden", _state.Workspaces, () =>
        {
            ExitGuard.ApproveExit();
            return Task.CompletedTask;
        }));
        // The age of an open transaction in the status bar.
        _ticker = new Timer(_ => InvokeAsync(() =>
        {
            if (_editing.WithWork().Count > 0)
            {
                StateHasChanged();
            }
        }), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
        _state.Changed += OnChanged;
        _state.Dirty += SaveTabs;
        _state.ConnectRequested += OnConnectRequested;
        Connections.Changed += OnChanged;
        Active.Changed += OnConnectionOrWorkspacesChanged;
        Workspaces.Changed += OnConnectionOrWorkspacesChanged;
        Models.Changed += OnChanged;
        Presentations.Changed += OnChanged;
        KeepAlive.ConnectionLost += OnKeepAliveLost;
        KeepAlive.Start();
        await Connections.LoadAsync(CancellationToken.None);
        await Recent.LoadAsync(CancellationToken.None);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            _shortcuts = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/FerretSharp.UI/js/shortcuts.js");
            await _shortcuts.InvokeVoidAsync("register", _selfRef, new[]
            {
                SwitcherShortcut, ApplyFiltersShortcut, RefreshShortcut, FindColumnShortcut, BackShortcut, ForwardShortcut, FlushShortcut, CommitShortcut, LinqShortcut,
                SqlShortcut, ScriptShortcut,
            });
        }
    }

    /// <param name="modalOpen">
    /// A dialog is open (shortcuts.js looks for a visible <c>.modal-backdrop</c>, which every dialog renders): shortcuts must
    /// not act behind it – Ctrl+S while the LOB editor is open, F5 behind the plan dialog. Asking the page instead of
    /// listing the dialogs here also covers the dialogs that tabs open themselves.
    /// </param>
    [JSInvokable]
    public void OnShortcut(string combo, bool modalOpen)
    {
        if (modalOpen)
        {
            return;
        }

        // Writing and committing need an editable connection and an active workspace.
        if (combo is FlushShortcut or CommitShortcut)
        {
            if (_state.ActiveWorkspace is { } workspace && Workspaces.IsWritable(workspace.WorkspaceId) && _state.Page == ShellPage.Explorer)
            {
                _ = combo == FlushShortcut ? _editing.FlushAsync(workspace) : RequestCommit(workspace);
            }

            return;
        }

        switch (combo)
        {
            case SwitcherShortcut:
                _state.OpenSwitcher();
                break;
            case ApplyFiltersShortcut:
                _state.RequestTabCommand(TabCommand.ApplyFilters);
                break;
            case RefreshShortcut:
                _state.RequestTabCommand(TabCommand.Refresh);
                break;
            case FindColumnShortcut:
                _state.RequestTabCommand(TabCommand.FindColumn);
                break;
            case BackShortcut:
                _state.GoBack();
                break;
            case ForwardShortcut:
                _state.GoForward();
                break;
            case ScriptShortcut when _state.Page == ShellPage.Explorer:
                _state.RequestTabCommand(TabCommand.RunScript);
                break;
            case SqlShortcut when Active.IsConnected && _state.Page == ShellPage.Explorer:
                _state.OpenSql();
                break;
            case LinqShortcut when HasLinkedProject && _state.Page == ShellPage.Explorer:
                _state.OpenLinq();
                break;
        }
    }

    /// <summary>Owner.table plus the active filters, so several tabs of the same table can be told apart.</summary>
    private string TabTooltip(TableTab tab)
    {
        var filters = tab.FilterTexts(PresentationOf(tab)).ToList();
        var entity = Presentations.ShownEntityNameOf(tab.Table.Ref) is { } name ? $" · Entity {name}" : "";
        return $"{tab.Table.Owner}.{tab.Table.Name}{entity}" + (filters.Count > 0 ? Environment.NewLine + string.Join(Environment.NewLine, filters) : "");
    }

    /// <summary>Enum and bool filter values by their C# names, once the tab knows its table's structure.</summary>
    private FerretSharp.Core.ClrModel.TablePresentation? PresentationOf(TableTab tab) =>
        tab.Details is { } details ? Presentations.For(details) : null;

    /// <summary>The SQL or LINQ tab whose title is being edited in the tab bar.</summary>
    private WorkspaceTab? _renamingTab;

    /// <summary>
    /// Double click renames a SQL or LINQ tab. Not via @ondblclick: in the WPF host a real double click never fires it
    /// (see CLAUDE.md, like the workspace chips).
    /// </summary>
    private void OnTitledTabClick(MouseEventArgs e, WorkspaceTab tab)
    {
        _state.ActivateTab(tab);
        if (e.Detail >= 2)
        {
            _renamingTab = tab;
        }
    }

    private RenderFragment TabTitle<T>(T tab) where T : WorkspaceTab, ITitledTab => _renamingTab == tab
        ? @<TitleEditor Value="@tab.Title" Class="tab-rename" OnCommit="name => { _renamingTab = null; _state.RenameTab(tab, name); }"
                        OnCancel="() => _renamingTab = null" />
        : @<span class="tab-name">@tab.Title</span>;

    private void CloseOnMiddleClick(MouseEventArgs e, WorkspaceTab tab)
    {
        if (e.Button == 1)
        {
            CloseTab(tab);
        }
    }

    /// <summary>A tab with pending changes asks first; its flushed changes stay in the workspace's transaction.</summary>
    private void CloseTab(WorkspaceTab tab)
    {
        if (tab is TableTab { Changes.PendingCount: > 0 } table)
        {
            _confirmCloseTab = table;
        }
        else
        {
            _state.CloseTab(tab);
        }
    }

    private void ConfirmCloseTab(TableTab tab)
    {
        _confirmCloseTab = null;
        _state.CloseTab(tab);
    }

    /// <summary>Runs off the UI thread; ActiveConnection reports progress through its Changed event.</summary>
    /// <summary>Connecting closes the current connection: uncommitted work is confirmed first (not after it was lost).</summary>
    private void OnConnectRequested(ConnectionProfile profile) => InvokeAsync(() =>
        GuardAsync($"Verbindung zu {profile.Name} öffnen", _state.Workspaces, () =>
        {
            _connectionGone = false;
            SaveTabs();
            _state.ClearWorkspaces();
            _ = Task.Run(() => Active.ConnectAsync(profile, CancellationToken.None));
            return Task.CompletedTask;
        }));

    /// <summary>"Neu verbinden" after the connection was lost: its transactions are gone, nothing left to confirm.</summary>
    private void Reconnect(ConnectionProfile profile)
    {
        _connectionGone = true;
        foreach (var workspace in _state.Workspaces)
        {
            _editing.Forget(workspace.WorkspaceId);
        }

        _state.Connect(profile);
    }

    /// <summary>Hands the tabs of every open workspace to the manager, which saves what changed (debounced).</summary>
    private void SaveTabs()
    {
        foreach (var workspace in _state.Workspaces)
        {
            Workspaces.UpdateTabs(workspace.WorkspaceId, workspace.Tabs.Select(t => t.ToState(workspace.Tabs)).ToList(), workspace.ActiveIndex);
        }
    }

    private void OnConnectionOrWorkspacesChanged() => InvokeAsync(() =>
    {
        if (Active.IsConnected && Active.Schema is { } schema && Workspaces.Profile?.Id == Active.Profile?.Id)
        {
            _state.SyncWorkspaces(Workspaces.Open, Workspaces.Active?.Id, schema);
        }
        else if (_state.Workspaces.Count > 0)
        {
            _state.ClearWorkspaces();
        }

        StateHasChanged();
    });

    /// <summary>The keep-alive found a session gone: same banner as a failed query, without waiting for the next click.</summary>
    private void OnKeepAliveLost(DatabaseException error) => InvokeAsync(() => _state.ReportFailure(error));

    private ShellPage _pageBeforeSettings = ShellPage.Connections;

    private void ToggleSettings()
    {
        if (_state.Page == ShellPage.Settings)
        {
            LeaveSettings();
        }
        else
        {
            _pageBeforeSettings = _state.Page;
            _state.ShowSettings();
        }
    }

    /// <summary>Back to where the user came from; the explorer only if still connected.</summary>
    private void LeaveSettings()
    {
        if (_pageBeforeSettings == ShellPage.Explorer && Active.Status != ConnectionStatus.Disconnected)
        {
            _state.ShowExplorer();
        }
        else
        {
            _state.ShowConnections();
        }
    }

    private void ToggleHome()
    {
        if (_state.Page == ShellPage.Connections)
        {
            _state.ShowExplorer();
        }
        else
        {
            _state.ShowConnections();
        }
    }

    private Task DisconnectAsync() => GuardAsync("Verbindung trennen", _state.Workspaces, DisconnectCoreAsync);

    private async Task DisconnectCoreAsync()
    {
        SaveTabs();
        _state.ClearConnectionLost();
        await Active.DisconnectAsync();
        _state.ClearWorkspaces();
        _state.ShowConnections();
    }

    private Task DeleteAsync(ConnectionProfile profile)
    {
        _state.CancelDelete();
        if (Active.Profile?.Id != profile.Id)
        {
            return DeleteCoreAsync(profile);
        }

        return GuardAsync("Verbindung löschen", _state.Workspaces, async () =>
        {
            await DisconnectCoreAsync();
            await DeleteCoreAsync(profile);
        });
    }

    private async Task DeleteCoreAsync(ConnectionProfile profile)
    {
        await Connections.DeleteAsync(profile.Id, CancellationToken.None);
        await Workspaces.DeleteForConnectionAsync(profile.Id);
        SqlHistory.Delete(profile.Id);
    }

    /// <summary>Errors of a tab's view stay in its <see cref="TabFrame"/>; this one is outside the tabs – show them again.</summary>
    private void RecoverFromError() => _errorBoundary?.Recover();

    /// <summary>If the tab bar itself keeps failing: close the active workspace's tabs, asking first if they hold changes.</summary>
    private Task CloseTabsAfterErrorAsync() =>
        GuardAsync("Tabs schließen", _state.ActiveWorkspace is { } active ? [active] : [], () =>
        {
            _state.CloseAllTabs();
            _errorBoundary?.Recover();
            return Task.CompletedTask;
        });

    private void OnChanged()
    {
        if (_state.Notice is { } notice && notice != _scheduledNotice)
        {
            _scheduledNotice = notice;
            _ = DismissLaterAsync(notice);
        }

        InvokeAsync(StateHasChanged);
    }

    /// <summary>Toasts disappear by themselves; with warnings they stay longer.</summary>
    private async Task DismissLaterAsync(Notice notice)
    {
        await Task.Delay(notice.Warnings.Count > 0 ? TimeSpan.FromSeconds(12) : TimeSpan.FromSeconds(5));
        await InvokeAsync(() => _state.DismissNotice(notice));
    }

    public async ValueTask DisposeAsync()
    {
        if (_ticker is not null)
        {
            await _ticker.DisposeAsync();
        }

        ExitGuard.CanExit = null;
        ExitGuard.RequestExit = null;
        _state.Changed -= OnChanged;
        _state.Dirty -= SaveTabs;
        _state.ConnectRequested -= OnConnectRequested;
        Connections.Changed -= OnChanged;
        Active.Changed -= OnConnectionOrWorkspacesChanged;
        Workspaces.Changed -= OnConnectionOrWorkspacesChanged;
        Models.Changed -= OnChanged;
        Presentations.Changed -= OnChanged;
        KeepAlive.ConnectionLost -= OnKeepAliveLost;
        if (_shortcuts is not null)
        {
            try
            {
                await _shortcuts.InvokeVoidAsync("unregister");
                await _shortcuts.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _selfRef?.Dispose();
    }
}
