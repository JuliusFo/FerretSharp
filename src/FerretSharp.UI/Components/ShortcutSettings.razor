@* Settings › Shortcuts (WP-25): every shortcut in one list – the changeable ones with "Change" (press the keys) and
   "Reset", the fixed ones greyed out. Doubles as the overview of which key does what. Changes apply at once. *@
@implements IAsyncDisposable
@inject ShortcutService Shortcuts
@inject IJSRuntime JS
@inject ILogger<ShortcutSettings> Logger

<div class="settings-note shortcut-intro">
    @ShellText.Shortcuts_Intro
</div>

@foreach (var group in Groups)
{
    <section class="settings-section">
        <h2>@group</h2>
        @foreach (var definition in ShortcutMap.Definitions.Where(d => d.Group == group))
        {
            var action = definition.Action;
            var chord = Map.Chord(action);
            <div class="settings-row shortcut-row" data-action="@action">
                <div class="settings-label">
                    <span>@definition.Label</span>
                    @if (definition.Hint is not null)
                    {
                        <span class="hint">@definition.Hint</span>
                    }
                </div>
                <div class="shortcut-keys">
                    @if (_recording == action)
                    {
                        <span class="shortcut-recording">@ShellText.Shortcuts_PressKeys</span>
                        <button class="btn ghost" @onclick="CancelRecordAsync">@CommonText.Cancel</button>
                    }
                    else
                    {
                        @if (chord is not null)
                        {
                            <kbd>@chord.KbdLabel</kbd>
                        }
                        else
                        {
                            <span class="shortcut-none">@ShellText.Shortcuts_None</span>
                        }

                        @if (!Map.IsDefault(action))
                        {
                            <span class="shortcut-changed">@ShellText.Shortcuts_Changed</span>
                        }

                        <button class="btn ghost" disabled="@(_recording is not null)" @onclick="() => RecordAsync(action)">@ShellText.Shortcuts_Change</button>
                        <button class="btn ghost" disabled="@(_recording is not null || Map.IsDefault(action))"
                                title="@TextFormat.Format(ShellText.Shortcuts_DefaultTitle, definition.DefaultChord.Label)" @onclick="() => ResetAsync(action)">@CommonText.Reset</button>
                    }
                </div>
            </div>
            @if (_proposal is { } proposal && proposal.Action == action)
            {
                <div class="settings-note shortcut-message @(proposal.Check.Error is null ? "warn" : "error")" role="alert">
                    @if (proposal.Check.Error is { } error)
                    {
                        <span>@TextFormat.Format(ShellText.Shortcuts_NotPossible, proposal.Chord.Label, error)</span>
                        <button class="btn ghost" @onclick="Dismiss">@CommonText.Ok</button>
                    }
                    else
                    {
                        <span>
                            @if (proposal.Check.Conflict is { } other)
                            {
                                <span>@(TextFormat.Format(ShellText.Shortcuts_Conflict, proposal.Chord.Label, ShortcutMap.Definition(other).Label) + " ")</span>
                            }
                            @proposal.Check.Warning
                        </span>
                        <button class="btn primary" @onclick="AcceptAsync">@CommonText.Apply</button>
                        <button class="btn ghost" @onclick="Dismiss">@CommonText.Cancel</button>
                    }
                </div>
            }
        }
        @foreach (var fixedKey in ShortcutMap.Fixed.Where(f => f.Group == group))
        {
            <div class="settings-row shortcut-row fixed" title="@ShellText.Shortcuts_FixedTitle">
                <div class="settings-label">
                    <span>@fixedKey.Label</span>
                    @if (fixedKey.Hint is not null)
                    {
                        <span class="hint">@fixedKey.Hint</span>
                    }
                </div>
                <div class="shortcut-keys">
                    <kbd>@fixedKey.Keys</kbd>
                    <span class="shortcut-fixed">@ShellText.Shortcuts_Fixed</span>
                </div>
            </div>
        }
    </section>
}

<div class="shortcut-reset-all">
    @if (_confirmResetAll)
    {
        <span>@ShellText.Shortcuts_ResetAllQuestion</span>
        <button class="btn danger-solid" @onclick="ResetAllAsync">@CommonText.Reset</button>
        <button class="btn ghost" @onclick="() => _confirmResetAll = false">@CommonText.Cancel</button>
    }
    else
    {
        <button class="btn" disabled="@(!Map.HasChanges || _recording is not null)" @onclick="() => _confirmResetAll = true">@ShellText.Shortcuts_ResetAll</button>
    }
</div>

@code {
    // A property, not a static field: the group names are localized texts and would keep the language of the first render.
    private static string[] Groups =>
        [..ShortcutMap.Definitions.Select(d => d.Group).Concat(ShortcutMap.Fixed.Select(f => f.Group)).Distinct()];

    private IJSObjectReference? _module;
    private ShortcutAction? _recording;
    private Proposal? _proposal;
    private bool _confirmResetAll;
    private bool _disposed;

    /// <summary>A key combination that needs a word from the user before it is taken (or cannot be taken at all).</summary>
    private sealed record Proposal(ShortcutAction Action, KeyChord Chord, ShortcutCheck Check);

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    private ShortcutMap Map => Shortcuts.Map;

    protected override void OnInitialized() => Shortcuts.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task RecordAsync(ShortcutAction action)
    {
        _proposal = null;
        _confirmResetAll = false;
        _recording = action;
        string? combo;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/FerretSharp.UI/js/shortcuts.js");
            combo = _disposed ? null : await _module.InvokeAsync<string?>("record");
        }
        catch (JSDisconnectedException)
        {
            return;
        }
        finally
        {
            _recording = null;
        }

        if (_disposed || KeyChord.Parse(combo) is not { } chord || chord == Map.Chord(action))
        {
            return;
        }

        var check = Map.Check(action, chord);
        if (check.IsFine)
        {
            await SaveAsync(() => Shortcuts.SetAsync(action, chord));
        }
        else
        {
            _proposal = new Proposal(action, chord, check);
        }
    }

    private async Task CancelRecordAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("cancelRecord");
        }
    }

    private async Task AcceptAsync()
    {
        if (_proposal is { Check.Error: null } proposal)
        {
            _proposal = null;
            await SaveAsync(() => Shortcuts.SetAsync(proposal.Action, proposal.Chord));
        }
    }

    private void Dismiss() => _proposal = null;

    private Task ResetAsync(ShortcutAction action)
    {
        _proposal = null;
        return SaveAsync(() => Shortcuts.ResetAsync(action));
    }

    private Task ResetAllAsync()
    {
        _proposal = null;
        _confirmResetAll = false;
        return SaveAsync(Shortcuts.ResetAllAsync);
    }

    private async Task SaveAsync(Func<Task> change)
    {
        try
        {
            await change();
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            Logger.LogWarning(ex, "Shortcuts not saved");
            Shell.Notify(TextFormat.Format(ShellText.Settings_NotSaved, ex.Message));
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Shortcuts.Changed -= OnChanged;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("cancelRecord");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
