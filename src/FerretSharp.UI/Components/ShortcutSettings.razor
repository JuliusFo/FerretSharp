@* Settings › Tastenkürzel (WP-25): every shortcut in one list – the changeable ones with "Ändern" (press the keys) and
   "Zurücksetzen", the fixed ones greyed out. Doubles as the overview of which key does what. Changes apply at once. *@
@implements IAsyncDisposable
@inject ShortcutService Shortcuts
@inject IJSRuntime JS
@inject ILogger<ShortcutSettings> Logger

<div class="settings-note shortcut-intro">
    Änderungen gelten sofort. „Ändern“ und dann die neue Tastenkombination drücken, Esc bricht ab. Kürzel mit Ctrl, Alt oder
    eine F-Taste; ausgegraute sind fest.
</div>

@foreach (var group in Groups)
{
    <section class="settings-section">
        <h2>@group</h2>
        @foreach (var definition in ShortcutMap.Definitions.Where(d => d.Group == group))
        {
            var action = definition.Action;
            var chord = Map.Chord(action);
            <div class="settings-row shortcut-row" data-action="@action">
                <div class="settings-label">
                    <span>@definition.Label</span>
                    @if (definition.Hint is not null)
                    {
                        <span class="hint">@definition.Hint</span>
                    }
                </div>
                <div class="shortcut-keys">
                    @if (_recording == action)
                    {
                        <span class="shortcut-recording">Tastenkombination drücken …</span>
                        <button class="btn ghost" @onclick="CancelRecordAsync">Abbrechen</button>
                    }
                    else
                    {
                        @if (chord is not null)
                        {
                            <kbd>@chord.KbdLabel</kbd>
                        }
                        else
                        {
                            <span class="muted">nicht belegt</span>
                        }

                        @if (!Map.IsDefault(action))
                        {
                            <span class="shortcut-changed">geändert</span>
                        }

                        <button class="btn ghost" disabled="@(_recording is not null)" @onclick="() => RecordAsync(action)">Ändern</button>
                        <button class="btn ghost" disabled="@(_recording is not null || Map.IsDefault(action))"
                                title="@($"Standard: {definition.DefaultChord.Label}")" @onclick="() => ResetAsync(action)">Zurücksetzen</button>
                    }
                </div>
            </div>
            @if (_proposal is { } proposal && proposal.Action == action)
            {
                <div class="settings-note shortcut-message @(proposal.Check.Error is null ? "warn" : "error")" role="alert">
                    @if (proposal.Check.Error is { } error)
                    {
                        <span>@proposal.Chord.Label geht nicht: @error</span>
                        <button class="btn ghost" @onclick="Dismiss">OK</button>
                    }
                    else
                    {
                        <span>
                            @if (proposal.Check.Conflict is { } other)
                            {
                                <span>@proposal.Chord.Label ist schon „@ShortcutMap.Definition(other).Label“ – übernehmen nimmt es dort weg. </span>
                            }
                            @proposal.Check.Warning
                        </span>
                        <button class="btn primary" @onclick="AcceptAsync">Übernehmen</button>
                        <button class="btn ghost" @onclick="Dismiss">Abbrechen</button>
                    }
                </div>
            }
        }
        @foreach (var fixedKey in ShortcutMap.Fixed.Where(f => f.Group == group))
        {
            <div class="settings-row shortcut-row fixed" title="Fest – nicht änderbar">
                <div class="settings-label">
                    <span>@fixedKey.Label</span>
                    @if (fixedKey.Hint is not null)
                    {
                        <span class="hint">@fixedKey.Hint</span>
                    }
                </div>
                <div class="shortcut-keys">
                    <kbd>@fixedKey.Keys</kbd>
                    <span class="shortcut-fixed">fest</span>
                </div>
            </div>
        }
    </section>
}

<div class="shortcut-reset-all">
    @if (_confirmResetAll)
    {
        <span>Alle Kürzel auf die Standardbelegung zurücksetzen?</span>
        <button class="btn danger-solid" @onclick="ResetAllAsync">Zurücksetzen</button>
        <button class="btn ghost" @onclick="() => _confirmResetAll = false">Abbrechen</button>
    }
    else
    {
        <button class="btn" disabled="@(!Map.HasChanges || _recording is not null)" @onclick="() => _confirmResetAll = true">Alle zurücksetzen</button>
    }
</div>

@code {
    private static readonly string[] Groups =
        [.. ShortcutMap.Definitions.Select(d => d.Group).Concat(ShortcutMap.Fixed.Select(f => f.Group)).Distinct()];

    private IJSObjectReference? _module;
    private ShortcutAction? _recording;
    private Proposal? _proposal;
    private bool _confirmResetAll;
    private bool _disposed;

    /// <summary>A key combination that needs a word from the user before it is taken (or cannot be taken at all).</summary>
    private sealed record Proposal(ShortcutAction Action, KeyChord Chord, ShortcutCheck Check);

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    private ShortcutMap Map => Shortcuts.Map;

    protected override void OnInitialized() => Shortcuts.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task RecordAsync(ShortcutAction action)
    {
        _proposal = null;
        _confirmResetAll = false;
        _recording = action;
        string? combo;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/FerretSharp.UI/js/shortcuts.js");
            combo = _disposed ? null : await _module.InvokeAsync<string?>("record");
        }
        catch (JSDisconnectedException)
        {
            return;
        }
        finally
        {
            _recording = null;
        }

        if (_disposed || KeyChord.Parse(combo) is not { } chord || chord == Map.Chord(action))
        {
            return;
        }

        var check = Map.Check(action, chord);
        if (check.IsFine)
        {
            await SaveAsync(() => Shortcuts.SetAsync(action, chord));
        }
        else
        {
            _proposal = new Proposal(action, chord, check);
        }
    }

    private async Task CancelRecordAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("cancelRecord");
        }
    }

    private async Task AcceptAsync()
    {
        if (_proposal is { Check.Error: null } proposal)
        {
            _proposal = null;
            await SaveAsync(() => Shortcuts.SetAsync(proposal.Action, proposal.Chord));
        }
    }

    private void Dismiss() => _proposal = null;

    private Task ResetAsync(ShortcutAction action)
    {
        _proposal = null;
        return SaveAsync(() => Shortcuts.ResetAsync(action));
    }

    private Task ResetAllAsync()
    {
        _proposal = null;
        _confirmResetAll = false;
        return SaveAsync(Shortcuts.ResetAllAsync);
    }

    private async Task SaveAsync(Func<Task> change)
    {
        try
        {
            await change();
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            Logger.LogWarning(ex, "Shortcuts not saved");
            Shell.Notify($"Einstellung angewendet, aber nicht gespeichert: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Shortcuts.Changed -= OnChanged;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("cancelRecord");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
