@using FerretSharp.Core.Connections
@using FerretSharp.UI.State
@implements IDisposable
@inject ConnectionManager Connections
@inject IConnectionTester Tester
@inject IFileOpenService Files

<div class="modal-backdrop" @onkeydown="OnKeyDown">
    <div class="modal dialog" role="dialog" aria-label="@Title">
        <header>
            <span>@Title</span>
            <button class="icon-btn ghost" title="Schließen" @onclick="CancelAsync">✕</button>
        </header>

        <div class="dialog-body form-grid">
            <label for="cn-name">Name</label>
            <div>
                <input id="cn-name" class="field @Invalid(ConnectionField.Name)" @ref="_nameInput"
                       @bind="Form.Name" @bind:event="oninput" placeholder="z. B. ERP Test" />
                <FieldError Errors="Errors" Field="@ConnectionField.Name" />
            </div>

            <label for="cn-group">Gruppe</label>
            <div>
                <input id="cn-group" class="field" list="cn-groups" @bind="Form.Group" @bind:event="oninput"
                       placeholder="z. B. Projekt oder Kunde – optional" autocomplete="off" />
                <datalist id="cn-groups">
                    @foreach (var group in ConnectionSearch.GroupNames(Connections.Profiles))
                    {
                        <option value="@group"></option>
                    }
                </datalist>
            </div>

            <label>Umgebung</label>
            <div class="segmented">
                @foreach (var kind in ConnectionKindInfo.All)
                {
                    <button class="seg @ConnectionKindInfo.CssClass(kind) @(Form.Kind == kind ? "active" : "")"
                            @onclick="() => Form.Kind = kind">
                        <span class="dot"></span>@ConnectionKindInfo.Label(kind)
                    </button>
                }
            </div>

            <label>Adresse</label>
            <div class="segmented">
                <button class="seg @(Form.Mode == AddressMode.HostPort ? "active" : "")" @onclick="() => Form.Mode = AddressMode.HostPort">Host / Port</button>
                <button class="seg @(Form.Mode == AddressMode.TnsAlias ? "active" : "")" @onclick="() => Form.Mode = AddressMode.TnsAlias">TNS-Alias</button>
            </div>

            @if (Form.Mode == AddressMode.HostPort)
            {
                <label for="cn-host">Host</label>
                <div>
                    <div class="row">
                        <input id="cn-host" class="field grow @Invalid(ConnectionField.Host)" @bind="Form.Host" @bind:event="oninput" placeholder="db01.example.com" />
                        <span class="row-label">Port</span>
                        <input class="field port @Invalid(ConnectionField.Port)" @bind="Form.Port" @bind:event="oninput" />
                    </div>
                    <FieldError Errors="Errors" Field="@ConnectionField.Host" />
                    <FieldError Errors="Errors" Field="@ConnectionField.Port" />
                </div>

                <label>Datenbank</label>
                <div>
                    <div class="row">
                        <div class="segmented small">
                            <button class="seg @(!Form.UseSid ? "active" : "")" @onclick="() => Form.UseSid = false">Service Name</button>
                            <button class="seg @(Form.UseSid ? "active" : "")" @onclick="() => Form.UseSid = true">SID</button>
                        </div>
                        @if (Form.UseSid)
                        {
                            <input class="field grow @Invalid(ConnectionField.ServiceOrSid)" @bind="Form.Sid" @bind:event="oninput" placeholder="ORCL" />
                        }
                        else
                        {
                            <input class="field grow @Invalid(ConnectionField.ServiceOrSid)" @bind="Form.ServiceName" @bind:event="oninput" placeholder="ORCLPDB1" />
                        }
                    </div>
                    <FieldError Errors="Errors" Field="@ConnectionField.ServiceOrSid" />
                </div>
            }
            else
            {
                <label for="cn-alias">TNS-Alias</label>
                <div>
                    <input id="cn-alias" class="field @Invalid(ConnectionField.Alias)" @bind="Form.Alias" @bind:event="oninput" placeholder="ERP_TEST" />
                    <FieldError Errors="Errors" Field="@ConnectionField.Alias" />
                </div>

                <label for="cn-tns">TNS_ADMIN</label>
                <input id="cn-tns" class="field mono" @bind="Form.TnsAdminPath" @bind:event="oninput"
                       placeholder="Ordner der tnsnames.ora – leer = Umgebungsvariable TNS_ADMIN" />
            }

            <label for="cn-user">Benutzer</label>
            <div>
                <input id="cn-user" class="field @Invalid(ConnectionField.User)" @bind="Form.User" @bind:event="oninput" autocomplete="off" />
                <FieldError Errors="Errors" Field="@ConnectionField.User" />
            </div>

            <label for="cn-password">Passwort</label>
            <div>
                <input id="cn-password" type="password" class="field @Invalid(PasswordField)" @bind="Form.Password" @bind:event="oninput"
                       placeholder="@PasswordPlaceholder" autocomplete="new-password" />
                <FieldError Errors="Errors" Field="@PasswordField" />
                <div class="hint small">Wird im Windows-Anmeldeinformationsspeicher abgelegt, nie in der Verbindungsdatei.</div>
            </div>

            <label for="cn-schema">Schema</label>
            <input id="cn-schema" class="field" @bind="Form.DefaultSchema" @bind:event="oninput" placeholder="leer = Schema des Benutzers" />

            <span></span>
            <label class="check">
                <input type="checkbox" checked="@Form.ReadOnly" @onchange="e => Form.SetReadOnly(e.Value is true)" />
                Schreibgeschützt
                <span class="hint">· Oracle selbst lehnt Änderungen ab (READ ONLY-Transaktion)</span>
            </label>

            <div class="form-section">C#-Modell <span class="hint">· optional: Entity- und Property-Namen aus dem eigenen EF-Core-Projekt</span></div>

            <label for="cn-clr">Projekt</label>
            <div>
                <div class="field-with-button">
                    <input id="cn-clr" class="field mono @Invalid(ConnectionField.ClrProject)" @bind="Form.ClrProjectFile" @bind:event="oninput"
                           placeholder="…\Data\Data.csproj – das Projekt mit dem DbContext" spellcheck="false" />
                    <button class="btn" title="Projektdatei auswählen" @onclick="PickProjectAsync">…</button>
                </div>
                <FieldError Errors="Errors" Field="@ConnectionField.ClrProject" />
                <div class="hint small">FerretSharp liest das Modell aus dem vorhandenen Build (EF Core 8 oder neuer) – ohne den Startcode der Anwendung und ohne Datenbankverbindung.</div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Form.ClrProjectFile))
            {
                <label for="cn-clr-config">Build</label>
                <select id="cn-clr-config" class="field narrow" @bind="Form.ClrConfiguration">
                    <option value="Debug">Debug</option>
                    <option value="Release">Release</option>
                </select>

                <label for="cn-clr-context">DbContext</label>
                <input id="cn-clr-context" class="field mono" @bind="Form.ClrContextType" @bind:event="oninput"
                       placeholder="leer = der einzige DbContext im Projekt" spellcheck="false" />
            }
        </div>

        @if (_testing || _testResult is not null || _testCancelled)
        {
            <div class="test-result @(_testResult switch { { Success: true } => "ok", { Success: false } => "error", _ => "" })">
                @if (_testing)
                {
                    <span class="spinner"></span>
                    <span>Verbinde …</span>
                }
                else if (_testCancelled)
                {
                    <span>Test abgebrochen.</span>
                }
                else if (_testResult is { Success: true } ok)
                {
                    <span class="dot ok"></span>
                    <span>Verbunden in @Milliseconds(ok.Elapsed) ms · Oracle @ok.ServerVersion</span>
                }
                else if (_testResult is { } failed)
                {
                    <span class="code">@(failed.ErrorCode ?? "Fehler")</span>
                    <span>@failed.Message</span>
                }
            </div>
        }

        @if (_saveError is not null)
        {
            <div class="test-result error"><span>@_saveError</span></div>
        }

        <footer>
            @if (!Form.IsNew)
            {
                <button class="btn ghost danger" @onclick="DeleteAsync">Löschen …</button>
            }
            <span class="spacer"></span>
            @if (_testing)
            {
                <button class="btn" @onclick="CancelTest">Test abbrechen</button>
            }
            else
            {
                <button class="btn" @onclick="TestAsync">Verbindung testen</button>
            }
            <button class="btn ghost" @onclick="CancelAsync">Abbrechen</button>
            <button class="btn primary" @onclick="SaveAsync" disabled="@_saving">Speichern</button>
        </footer>
    </div>
</div>

@code {
    private const string PasswordField = "Password";

    private ElementReference _nameInput;
    private bool _submitted;
    private bool _testing;
    private bool _testCancelled;
    private bool _saving;
    private string? _saveError;
    private ConnectionTestResult? _testResult;
    private CancellationTokenSource? _testCts;

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [Parameter, EditorRequired]
    public ConnectionDialogRequest Request { get; set; } = new(ConnectionDialogMode.New, null);

    [Parameter]
    public EventCallback OnClose { get; set; }

    private ConnectionForm Form { get; set; } = new();

    private string Title => Request.Mode switch
    {
        ConnectionDialogMode.Edit => "Verbindung bearbeiten",
        ConnectionDialogMode.Duplicate => "Verbindung duplizieren",
        _ => "Neue Verbindung",
    };

    /// <summary>The edited profile (edit) or the original (duplicate) has a stored password that can be reused.</summary>
    private bool HasStoredPassword { get; set; }

    private string PasswordPlaceholder => !HasStoredPassword ? ""
        : Request.Mode == ConnectionDialogMode.Duplicate ? "wie im Original" : "unverändert";

    private IReadOnlyDictionary<string, string> Errors => _submitted ? Validate() : new Dictionary<string, string>();

    protected override void OnInitialized()
    {
        Form = Request switch
        {
            { Mode: ConnectionDialogMode.Edit, Profile: { } p } => ConnectionForm.FromProfile(p),
            { Mode: ConnectionDialogMode.Duplicate, Profile: { } p } => ConnectionForm.Duplicate(p),
            _ => new ConnectionForm(),
        };
        HasStoredPassword = Form.PasswordSourceId is { } source && Connections.HasPassword(source);
    }

    /// <summary>The typed password, otherwise the stored one of the edited/original profile.</summary>
    private string? EffectivePassword() =>
        Form.Password.Length > 0 ? Form.Password
        : Form.PasswordSourceId is { } source ? Connections.GetPassword(source)
        : null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _nameInput.FocusAsync();
        }
    }

    private Dictionary<string, string> Validate()
    {
        var errors = new Dictionary<string, string>(Form.ToProfile().Errors);
        if (Form.Password.Length == 0 && !HasStoredPassword)
        {
            errors[PasswordField] = "Passwort fehlt.";
        }

        return errors;
    }

    private string Invalid(string field) => Errors.ContainsKey(field) ? "invalid" : "";

    private async Task PickProjectAsync()
    {
        if (await Files.PickAsync("C#-Projekt", ["csproj"], Form.ClrProjectFile) is { } path)
        {
            Form.ClrProjectFile = path;
        }
    }

    private async Task TestAsync()
    {
        _submitted = true;
        if (Validate().Count > 0)
        {
            return;
        }

        var profile = Form.ToProfile().Profile;
        var password = EffectivePassword() ?? "";

        _testCts = new CancellationTokenSource();
        _testing = true;
        _testCancelled = false;
        _testResult = null;
        try
        {
            var token = _testCts.Token;
            _testResult = await Task.Run(() => Tester.TestAsync(profile, password, token), token);
        }
        catch (OperationCanceledException)
        {
            _testCancelled = true;
        }
        finally
        {
            _testing = false;
            _testCts.Dispose();
            _testCts = null;
        }
    }

    private void CancelTest() => _testCts?.Cancel();

    private async Task SaveAsync()
    {
        _submitted = true;
        _saveError = null;
        if (Validate().Count > 0)
        {
            return;
        }

        _saving = true;
        try
        {
            var profile = Form.ToProfile().Profile;
            // Edit: null keeps the stored password. New/duplicate: always store one (a duplicate inherits the original's).
            var newPassword = Form.IsNew ? EffectivePassword() : Form.Password.Length > 0 ? Form.Password : null;
            await Connections.SaveAsync(profile, newPassword, CancellationToken.None);
            await CloseAsync();
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or ArgumentException or InvalidOperationException)
        {
            _saveError = $"Speichern fehlgeschlagen: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>
    /// Hands over to the shell's delete (as the "⋯" menu does): it confirms, disconnects first if this is the active
    /// connection (guarding open changes) and removes the connection's workspaces and SQL history too.
    /// </summary>
    private async Task DeleteAsync()
    {
        var profile = Connections.Profiles.FirstOrDefault(p => p.Id == Form.Id);
        await CloseAsync();
        if (profile is not null)
        {
            Shell.RequestDelete(profile);
        }
    }

    private async Task CancelAsync() => await CloseAsync();

    private async Task CloseAsync()
    {
        CancelTest();
        await OnClose.InvokeAsync();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CloseAsync();
        }
    }

    private static string Milliseconds(TimeSpan elapsed) => elapsed.TotalMilliseconds.ToString("N0", CultureInfo.CurrentCulture);

    public void Dispose()
    {
        _testCts?.Cancel();
        _testCts?.Dispose();
    }
}
