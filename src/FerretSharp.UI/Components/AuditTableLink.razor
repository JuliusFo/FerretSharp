@* The audit table's name in the audit line (WP-26): a link that opens it. *@
@using FerretSharp.Core.Audit

<button class="link-btn mono" title="@SchemaViewText.Audit_OpenTable" @onclick="() => Open(Names)">@Names.AuditTable.Name</button>

@code {
    [Parameter, EditorRequired]
    public AuditNames Names { get; set; } = null!;

    [Parameter, EditorRequired]
    public Action<AuditNames> Open { get; set; } = null!;
}
