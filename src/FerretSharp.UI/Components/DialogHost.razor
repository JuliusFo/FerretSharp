@* The dialogs and the toast of the shell (R2, out of Shell.razor): what ShellState and WorkspaceLifecycle ask for. Dialogs
   of a tab (plan, LOB, SQL preview) stay with the tab. *@
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Settings
@inject AppSettingsService Settings

@if (Shell.ConnectionDialog is { } request)
{
    <ConnectionDialog @key="request" Request="request" OnClose="Shell.CloseConnectionDialog" />
}

@if (Shell.ErrorDetails is { } error)
{
    <ErrorDialog @key="error" Error="error" Mask="@(Active.Profile?.Kind == ConnectionKind.Prod)" OnClose="Shell.CloseError" />
}

@if (Shell.Notice is { } notice)
{
    <div class="toast @(notice.Warnings.Count > 0 ? "warn" : "")" role="status" @key="notice">
        <div class="toast-text">@notice.Text</div>
        @foreach (var warning in notice.Warnings)
        {
            <div class="toast-warning">⚠ @warning</div>
        }
        <button class="icon-btn ghost toast-close" title="@CommonText.Close" @onclick="() => Shell.DismissNotice(notice)">✕</button>
    </div>
}

@if (Editing.Problem is { } problem)
{
    <WriteProblemDialog @key="problem" Problem="problem" Wait="Settings.Current.LockWaitSeconds" OnChoice="Editing.ResolveAsync" />
}

@if (Lifecycle.PendingLeave is { } leave)
{
    <LeaveDialog @key="leave" Request="leave" Busy="leave.WorkspaceIds.Any(Editing.IsBusy)"
                 Items="@LeaveItems(leave)"
                 OnCommit="() => Lifecycle.LeaveAsync(commit: true)" OnDiscard="() => Lifecycle.LeaveAsync(commit: false)" OnCancel="Lifecycle.CancelLeave" />
}

@if (Lifecycle.ConfirmRollback is { } rollbackTabs)
{
    <ConfirmDialog Title="Rollback" ConfirmLabel="@ShellText.DiscardAll" Danger="true"
                   OnConfirm="() => Lifecycle.RollbackAsync(rollbackTabs)" OnCancel="Lifecycle.CancelConfirmation">
        <Fmt Text="@ShellText.Dialogs_RollbackQuestion"><Arg0><strong>@Lifecycle.WorkspaceName(rollbackTabs.WorkspaceId)</strong></Arg0></Fmt>
    </ConfirmDialog>
}

@if (Lifecycle.ConfirmCommit is { } commitTabs)
{
    var commitSummary = Editing.SummaryOf(commitTabs);
    <ConfirmDialog Title="@ShellText.Dialogs_CommitProdTitle" ConfirmLabel="@ShellText.CommitButton" Danger="true"
                   OnConfirm="() => Lifecycle.CommitAsync(commitTabs)" OnCancel="Lifecycle.CancelConfirmation">
        <Fmt Text="@ShellText.Dialogs_CommitProdText">
            <Arg0><strong>@Lifecycle.WorkspaceName(commitTabs.WorkspaceId)</strong></Arg0>
            <Arg1>@commitSummary.Pending</Arg1>
            <Arg2>@commitSummary.Flushed</Arg2>
            <Arg3><strong>@Active.Profile?.Name</strong></Arg3>
        </Fmt>
    </ConfirmDialog>
}

@if (Shell.PendingUnlock is { } unlockId && Active.Profile is { } unlockProfile && Shell.Workspaces.Any(w => w.WorkspaceId == unlockId))
{
    <UnlockDialog @key="unlockId" Profile="unlockProfile" WorkspaceName="@Lifecycle.WorkspaceName(unlockId)"
                  OnConfirm="() => Lifecycle.UnlockAsync(unlockId)" OnCancel="Shell.CloseUnlock" />
}

@if (Lifecycle.ConfirmCloseTab is { } closingTab)
{
    var pendingCount = closingTab.Changes!.PendingCount;
    <ConfirmDialog Title="@ShellText.CloseTab" ConfirmLabel="@ShellText.Dialogs_DiscardAndClose" Danger="true"
                   OnConfirm="() => Lifecycle.CloseTabConfirmed(closingTab)" OnCancel="Lifecycle.CancelConfirmation">
        <Fmt Text="@(pendingCount == 1 ? ShellText.Dialogs_CloseTabTextOne : ShellText.Dialogs_CloseTabTextOther)">
            <Arg0>@pendingCount</Arg0>
            <Arg1><strong>@closingTab.Table.DisplayName</strong></Arg1>
        </Fmt>
    </ConfirmDialog>
}

@if (Lifecycle.PendingSql is { } pendingSql)
{
    <SqlPreview Sql="@pendingSql" Parameters="NoParameters" Error="@null" OnClose="Lifecycle.ClosePendingSql" />
}

@if (Shell.PendingDelete is { } pending)
{
    <ConfirmDialog Title="@ShellText.Connection_Delete" ConfirmLabel="@CommonText.Delete" Danger="true"
                   OnConfirm="() => Lifecycle.DeleteAsync(pending)" OnCancel="Shell.CancelDelete">
        <Fmt Text="@ShellText.Dialogs_DeleteConnectionText"><Arg0><strong>@pending.Name</strong></Arg0><Arg1>@pending.Address.Display</Arg1></Fmt>
    </ConfirmDialog>
}

@code {
    [CascadingParameter]
    public ActiveConnection Active { get; set; } = null!;

    private static readonly IReadOnlyList<FerretSharp.Core.Query.QueryParameter> NoParameters = [];

    private Notice? _scheduledNotice;

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    /// <summary>A parameter (not only cascaded), so the dialogs render again whenever the shell does.</summary>
    [Parameter, EditorRequired]
    public WorkspaceLifecycle Lifecycle { get; set; } = null!;

    private WorkspaceEditing Editing => Lifecycle.Editing;

    /// <summary>
    /// The workspaces the leave dialog lists – of any open connection (exiting, disconnecting one in the background), not
    /// only the shown one's.
    /// </summary>
    private IReadOnlyList<(string Name, EditSummary Summary)> LeaveItems(LeaveRequest leave) =>
        leave.WorkspaceIds
            .Select(Shell.FindWorkspace)
            .OfType<WorkspaceTabs>()
            .Select(w => (Lifecycle.WorkspaceName(w.WorkspaceId), Editing.SummaryOf(w)))
            .ToList();

    /// <summary>Toasts disappear by themselves; with warnings they stay longer.</summary>
    protected override void OnParametersSet()
    {
        if (Shell.Notice is { } notice && notice != _scheduledNotice)
        {
            _scheduledNotice = notice;
            _ = DismissLaterAsync(notice);
        }
    }

    private async Task DismissLaterAsync(Notice notice)
    {
        await Task.Delay(notice.Warnings.Count > 0 ? TimeSpan.FromSeconds(12) : TimeSpan.FromSeconds(5));
        await InvokeAsync(() => Shell.DismissNotice(notice));
    }
}
