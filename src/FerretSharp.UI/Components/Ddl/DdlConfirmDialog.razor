@* Confirmation before DDL of the table designer (WP-23) – what the SQL editor asks before DDL (WP-22): the statements, Prod,
   other writers, and the uncommitted changes that are discarded first. *@
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Query
@inject AppSettingsService Settings

@{ var discard = Lifecycle.OpenTransactionOf(WorkspaceId); }
<ConfirmDialog Title="@SqlEditorText.SqlView_ConfirmDdlTitle"
               ConfirmLabel="@(discard is null ? CommonText.Run : SqlEditorText.SqlView_DiscardAndRun)" Danger="true"
               OnConfirm="() => OnConfirm.InvokeAsync(discard?.Workspace)" OnCancel="OnCancel">
    <DdlStatementList Statements="Statements" />
    @foreach (var note in Notes)
    {
        <p class="hint">⚠ @note</p>
    }
    @if (Active.Profile is { Kind: ConnectionKind.Prod } profile)
    {
        <p><Fmt Text="@SqlEditorText.SqlView_ConfirmProd"><Arg0><strong>@ConnectionLabel.Of(profile, Settings.Current)</strong></Arg0></Fmt></p>
    }
    <DdlWarnings WorkspaceId="WorkspaceId" Discard="discard" />
</ConfirmDialog>

@code {
    [CascadingParameter]
    public WorkspaceLifecycle Lifecycle { get; set; } = null!;

    [CascadingParameter]
    public ActiveConnection Active { get; set; } = null!;

    [Parameter, EditorRequired]
    public Guid WorkspaceId { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<string> Statements { get; set; } = [];

    /// <summary>What to know before running, e.g. code using a dropped column (WP-40).</summary>
    [Parameter]
    public IReadOnlyList<string> Notes { get; set; } = [];

    /// <summary>Run: with the workspace whose uncommitted changes are rolled back first, if it has any.</summary>
    [Parameter]
    public EventCallback<WorkspaceTabs?> OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }
}
