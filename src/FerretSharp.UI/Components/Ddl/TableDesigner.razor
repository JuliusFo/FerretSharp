@* Edit mode of the "Columns" view (WP-23, stage 2): the columns and constraints of an existing table as editable rows. The
   DDL below follows every change (TableDesign); what needs a look at the data – NULLs before NOT NULL, values before a
   type change, rows before a mandatory new column – is counted in the tab's workspace. Run, open in the SQL editor or save
   it through DdlDraftPanel; new columns of a table the C# model maps get their property line to copy. *@
@using FerretSharp.Core.Audit
@using FerretSharp.Core.ClrModel
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Design
@using FerretSharp.Core.Schema
@using FerretSharp.Core.Workspaces
@inherits FerretComponent
@implements IDisposable
@inject ILogger<TableDesigner> Logger
@inject AuditTemplateSource AuditTemplates

@if (_designer is not { } designer)
{
    <DetailStatus Loading="_loadError is null" Error="_loadError" Text="@SchemaViewText.Designer_Loading" />
}
else
{
    var (draft, inputProblems) = designer.ToDraft();
    var context = new DesignContext(designer.Table, _constraints, _indexes, _incoming) { Referenced = designer.Referenced };
    var plan = NewTab is { } created
        ? TableDesign.PlanNew(created.Table, draft, designer.Referenced, TakenNames)
        : TableDesign.Plan(context, draft, new DataFacts(_facts));
    var audit = AuditTemplates.For(Active.Profile);
    plan = WithAudit(designer, draft, plan, audit);
    var counting = _counting.Count > 0 || _auditCounting.Count > 0;
    <section class="designer">
        @if (Tab?.Changes is { PendingCount: > 0 } or { FlushedCount: > 0 })
        {
            <p class="hint small">@Icons.Warning @SchemaViewText.Designer_TabHasChanges</p>
        }
        <table class="columns designer-columns">
            <thead>
                <tr>
                    <th class="num">#</th><th>@SchemaViewText.Head_Name</th><th>@SchemaViewText.Head_Type</th><th>@SchemaViewText.Designer_Size</th>
                    <th>@SchemaViewText.Designer_Scale</th><th>CHAR</th><th>NOT NULL</th><th>@SchemaViewText.Head_Default</th><th>ON NULL</th>
                    <th>@SchemaViewText.Columns_Comment</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var column in designer.Columns)
                {
                    var c = column;
                    var locked = c.Dropped || c.OnlyNameAndComment;
                    <tr class="@(c.Dropped ? "dropped" : c.IsNew ? "new" : c.IsChanged ? "changed" : "")" @key="c">
                        <td class="num">@(c.Before?.Position.ToString(CultureInfo.CurrentCulture) ?? "+")</td>
                        <td class="name-cell"><input class="field mono" spellcheck="false" disabled="@c.Dropped" @bind="c.Name" @bind:event="oninput" aria-label="@SchemaViewText.Head_Name" /></td>
                        <td>
                            <select class="field" disabled="@locked" @bind="c.Type" aria-label="@SchemaViewText.Head_Type">
                                @foreach (var type in TypesFor(c))
                                {
                                    <option value="@type">@type</option>
                                }
                            </select>
                        </td>
                        <td><input class="field mono narrow" disabled="@(locked || !c.HasSize)" @bind="c.Size" @bind:event="oninput" aria-label="@SchemaViewText.Designer_Size" /></td>
                        <td><input class="field mono narrow" disabled="@(locked || !c.HasScale)" @bind="c.Scale" @bind:event="oninput" aria-label="@SchemaViewText.Designer_Scale" /></td>
                        <td class="check-cell"><input type="checkbox" disabled="@(locked || !c.HasSemantics)" checked="@c.ShowsCharSemantics" @onchange="e => c.CharSemantics = e.Value is true" title="@SchemaViewText.Designer_CharSemantics" /></td>
                        <td class="check-cell"><input type="checkbox" disabled="@(locked || c.Identity)" @bind="c.NotNull" title="NOT NULL" /></td>
                        <td class="default-cell"><input class="field mono" spellcheck="false" disabled="@(locked || c.Identity)" @bind="c.Default" @bind:event="oninput" aria-label="@SchemaViewText.Head_Default" /></td>
                        <td class="check-cell"><input type="checkbox" disabled="@(locked || c.Identity)" @bind="c.DefaultOnNull" title="@SchemaViewText.Designer_DefaultOnNull" /></td>
                        <td class="comment-cell"><input class="field" disabled="@c.Dropped" @bind="c.Comment" @bind:event="oninput" aria-label="@SchemaViewText.Columns_Comment" /></td>
                        <td class="row-actions"><span>
                            @if (c.IsNew)
                            {
                                <label class="check" title="GENERATED BY DEFAULT AS IDENTITY"><input type="checkbox" @bind="c.Identity" /> ID</label>
                            }
                            <button class="icon-btn" title="@(c.Dropped ? SchemaViewText.Designer_Restore : SchemaViewText.Designer_Drop)" @onclick="() => designer.ToggleDrop(c)">@(c.Dropped ? Icons.Undo : Icons.Close)</button>
                        </span></td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="designer-add">
            <button class="btn" @onclick="() => designer.AddColumn()"><span class="plus">+</span> @SchemaViewText.Designer_AddColumn</button>
        </div>

        <h2>@SchemaViewText.Designer_Constraints</h2>
        @if (designer.Existing.Count > 0)
        {
            <ul class="designer-constraints">
                @foreach (var constraint in designer.Existing)
                {
                    var name = constraint.Name;
                    var dropped = designer.DroppedConstraints.Contains(name);
                    <li class="@(dropped ? "dropped" : "")">
                        <span class="fs-badge @BadgeCss(constraint.Type)">@Kind(constraint.Type)</span>
                        <span class="mono">@name</span>
                        <span class="muted mono">@Describe(constraint)</span>
                        <button class="icon-btn" title="@(dropped ? SchemaViewText.Designer_Restore : SchemaViewText.Designer_Drop)"
                                @onclick="() => designer.ToggleDropConstraint(name)">@(dropped ? Icons.Undo : Icons.Close)</button>
                    </li>
                }
            </ul>
        }
        @foreach (var added in designer.AddedConstraints)
        {
            var a = added;
            <div class="designer-constraint" @key="a">
                <select class="field" value="@a.Type" @onchange="e => SetType(designer, a, e.Value)" aria-label="@SchemaViewText.Head_Type">
                    <option value="@ConstraintType.PrimaryKey">PRIMARY KEY</option>
                    <option value="@ConstraintType.Unique">UNIQUE</option>
                    <option value="@ConstraintType.ForeignKey">FOREIGN KEY</option>
                    <option value="@ConstraintType.Check">CHECK</option>
                </select>
                <input class="field mono" spellcheck="false" value="@a.Name" @oninput="e => a.Name = (string?)e.Value ?? string.Empty"
                       @onchange="() => designer.SuggestName(a)" aria-label="@SchemaViewText.Head_Name" />
                <span class="index-draft-columns">
                    @for (var i = 0; i < a.Columns.Count; i++)
                    {
                        var at = i;
                        <span class="index-draft-column">
                            <span class="mono">@a.Columns[at]</span>
                            <button class="icon-btn" title="@SchemaViewText.Indexes_ColumnRemove" @onclick="() => designer.RemoveColumn(a, at)">@Icons.Close</button>
                        </span>
                    }
                    @{ var free = designer.ColumnNames.Where(n => !a.Columns.Contains(n)).ToList(); }
                    @if (free.Count > 0)
                    {
                        <select class="field" @key="@($"{a.Columns.Count}-{free.Count}")" @onchange="e => designer.AddColumn(a, (string?)e.Value)" aria-label="@SchemaViewText.Indexes_ColumnAdd">
                            <option value="" selected>@SchemaViewText.Indexes_ColumnAdd</option>
                            @foreach (var name in free)
                            {
                                <option value="@name">@name</option>
                            }
                        </select>
                    }
                </span>
                @if (a.Type == ConstraintType.Check)
                {
                    <input class="field mono grow" spellcheck="false" placeholder="@SchemaViewText.Designer_CheckPlaceholder" @bind="a.Condition" @bind:event="oninput" aria-label="CHECK" />
                }
                else if (a.Type == ConstraintType.ForeignKey)
                {
                    <span class="designer-fk">
                        @Icons.ArrowRight <select class="field" value="@(a.References is { } r ? $"{r.Owner}.{r.Name}" : "")" @onchange="e => ReferenceAsync(designer, a, (string?)e.Value)" aria-label="@SchemaViewText.Designer_References">
                            <option value="">@SchemaViewText.Designer_ChooseTable</option>
                            @foreach (var table in Tables)
                            {
                                <option value="@($"{table.Owner}.{table.Name}")">@table.DisplayName</option>
                            }
                        </select>
                        @if (a.References is { } references && designer.ColumnsOf(references) is { } targetColumns)
                        {
                            @for (var i = 0; i < a.Columns.Count; i++)
                            {
                                var at = i;
                                <select class="field" @key="@($"{references}-{at}-{a.ReferencedColumns.ElementAtOrDefault(at)}")" value="@a.ReferencedColumns.ElementAtOrDefault(at)"
                                        @onchange="e => a.SetReferenced(at, (string?)e.Value)" aria-label="@SchemaViewText.Designer_References">
                                    @foreach (var target in targetColumns)
                                    {
                                        <option value="@target">@target</option>
                                    }
                                </select>
                            }
                        }
                        <select class="field" @bind="a.DeleteRule" aria-label="ON DELETE">
                            <option value="">ON DELETE –</option>
                            <option value="CASCADE">ON DELETE CASCADE</option>
                            <option value="SET NULL">ON DELETE SET NULL</option>
                        </select>
                        <label class="check"><input type="checkbox" @bind="a.WithIndex" /> @SchemaViewText.Designer_WithIndex</label>
                    </span>
                }
                <button class="icon-btn" title="@SchemaViewText.Designer_Drop" @onclick="() => designer.AddedConstraints.Remove(a)">@Icons.Close</button>
            </div>
        }
        <div class="designer-add">
            <button class="btn" @onclick="() => designer.AddConstraint(ConstraintType.Unique)"><span class="plus">+</span> @SchemaViewText.Designer_AddConstraint</button>
        </div>

        <div class="designer-audit">
            <label class="check" title="@SchemaViewText.Audit_DesignerTitle">
                <input type="checkbox" checked="@(designer.WithAudit == true)" @onchange="e => designer.WithAudit = e.Value is true" />
                @(_audit?.AuditTable is not null ? SchemaViewText.Audit_DesignerSync : SchemaViewText.Audit_DesignerCreate)
            </label>
            @if (audit.Template is { } template && AuditTable is { } auditTable)
            {
                var names = template.NamesFor(auditTable);
                <span class="muted mono" title="@AuditTemplateLabel.Of(audit)">@names.AuditTable.Name · @names.Trigger</span>
            }
            else if (audit.Errors.Count > 0)
            {
                <span class="hint small" title="@($"{AuditTemplateLabel.Of(audit)}\n{string.Join("\n", audit.Errors)}")">@Icons.Warning @SchemaViewText.Audit_TemplateBroken</span>
            }
        </div>

        @if (counting)
        {
            <p class="hint small"><span class="spinner"></span> @SchemaViewText.Designer_Counting</p>
        }
        @{ var usageNotes = UsageNotes(designer); }
        <DdlDraftPanel WorkspaceId="WorkspaceId" Steps="@(counting ? [] : plan.Steps)" Problems="@(inputProblems.Concat(plan.Problems).ToList())"
                       Warnings="@(plan.Warnings.Concat(usageNotes).ToList())" ConfirmNotes="usageNotes"
                       FileName="@($"{DateTime.Now:yyyy-MM-dd}_{(NewTab?.Table.Name ?? Details.Table.Name)}.sql")" OnRan="OnRanAsync" OnFailed="OnFailedAsync" Ended="OnEnded" Earlier="_failure" OnClose="CloseAsync" />

        @if (PropertyLines(designer) is { Count: > 0 } suggestions)
        {
            <h2>@TextFormat.Format(SchemaViewText.Designer_CSharpHeading, ClrModelMapping.ShortName(Models.Mapping!.EntityOf(Details.Table.Ref)!.Entity.ClrType))</h2>
            <PropertySuggestions Suggestions="suggestions" />
        }
    </section>
}

@code {
    private ColumnDesigner? _designer;

    /// <summary>How the last run failed: shown in the panel until it runs again.</summary>
    private DdlRunResult? _failure;
    private DatabaseException? _loadError;
    private IReadOnlyList<ConstraintInfo> _constraints = [];
    private IReadOnlyList<IndexInfo> _indexes = [];
    private IReadOnlyList<ForeignKeyInfo> _incoming = [];

    private readonly Dictionary<DataQuestion, long> _facts = [];
    private readonly HashSet<DataQuestion> _counting = [];
    private readonly HashSet<DataQuestion> _failed = [];

    /// <summary>What the schema has of the table's audit objects (WP-26); null while loading or for a new table.</summary>
    private AuditState? _audit;

    // Counts about the existing audit table (its rows: may a new column be NOT NULL?), apart from the table's own.
    private readonly Dictionary<DataQuestion, long> _auditFacts = [];
    private readonly HashSet<DataQuestion> _auditCounting = [];
    private readonly HashSet<DataQuestion> _auditFailed = [];

    /// <summary>Opened for the audit table (WP-26: "Create audit…"/"Bring audit up to date" in the columns view or explorer).</summary>
    [Parameter]
    public bool StartWithAudit { get; set; }
    private readonly CancellationTokenSource _cts = new();
    private bool _disposed;

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [CascadingParameter]
    public ActiveConnection Active { get; set; } = null!;

    [CascadingParameter]
    public WorkspaceManager Workspaces { get; set; } = null!;

    [CascadingParameter]
    public ClrModelManager Models { get; set; } = null!;

    [CascadingParameter]
    public CodeUsageService Usage { get; set; } = null!;

    /// <summary>Code using a column that is dropped or renamed (WP-40); empty until the index is read or without a model.</summary>
    private IReadOnlyList<string> UsageNotes(ColumnDesigner designer) =>
        Models.Mapping is { } mapping && Usage.State.Result is { } usage && NewTab is null
            ? CodeUsageRows.DropNotes(mapping, usage.Index, Details.Table.Ref, designer.Columns
                .Where(c => c.Before is not null && (c.Dropped || c.Name.Trim() != c.Before.Name))
                .Select(c => (c.Before!.Name, c.Dropped ? null : (string?)c.Name.Trim())))
            : [];

    [Parameter, EditorRequired]
    public TableDetails Details { get; set; } = null!;

    [Parameter, EditorRequired]
    public Guid WorkspaceId { get; set; }

    /// <summary>The tab: uncommitted changes in it keep its old structure after DDL (WP-22).</summary>
    [Parameter]
    public TableTab? Tab { get; set; }

    /// <summary>The DDL ran: the edit mode ends, the tab's views reload.</summary>
    [Parameter]
    public EventCallback OnRan { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private IEnumerable<TableSummary> Tables => (Active.Schema?.Tables ?? []).Where(t => t.Kind == TableKind.Table && t.Synonym is null);

    /// <summary>A new table (WP-23, stage 3): the designer works on the tab's draft of it; nothing to load or count.</summary>
    [Parameter]
    public NewTableTab? NewTab { get; set; }

    /// <summary>Names a new table cannot have: the schema's tables, views, synonyms and PL/SQL units.</summary>
    private IEnumerable<string> TakenNames =>
        (Active.Schema?.Tables.Select(t => t.Synonym?.Name ?? t.Name) ?? []).Concat(Active.Schema?.PlSqlObjects.Select(u => u.Name) ?? []);

    protected override async Task OnInitializedAsync()
    {
        if (NewTab is { } created)
        {
            (_designer, _failure) = (created.Designer, created.Failure);
            return;
        }

        _failure = Tab?.Designer?.Failure;
        if (Models.Mapping?.EntityOf(Details.Table.Ref) is not null)
        {
            Fire(async () =>
            {
                await Usage.EnsureAsync(_cts.Token); // for the warnings on dropping a column used in code
                StateHasChanged();
            });
        }

        await LoadAsync(Tab?.Designer?.Draft);
    }

    /// <summary>
    /// The table as the database has it now – not the tab's structure, which a tab with uncommitted changes keeps after
    /// DDL – with its constraints and indexes; a draft from before (a run that stopped halfway) is laid over it.
    /// </summary>
    private async Task LoadAsync(ColumnDesigner? previous)
    {
        if (_disposed || Active.Schema is not { } schema)
        {
            return;
        }

        var token = _cts.Token;
        var loaded = await Shell.RunDbAsync(Logger, Active, async () =>
            (await schema.GetDetailsAsync(Details.Table, token), await schema.GetConstraintsAsync(Details.Table.Ref, token),
             await schema.GetIndexesAsync(Details.Table.Ref, token)), token);
        if (!loaded.Succeeded)
        {
            _loadError = loaded.Error ?? new DatabaseException(SqlEditorText.Run_Canceled);
            return;
        }

        var (table, constraints, indexes) = loaded.Value;
        (_constraints, _indexes) = (constraints, indexes);
        _incoming = schema.IncomingOf(Details.Table.Ref).Where(f => f.Source == FkSource.Declared).ToList();
        _designer = previous?.Rebase(table, constraints) ?? new ColumnDesigner(table, constraints);
        _facts.Clear(); // the data may have changed with the DDL
        _failed.Clear();
        if (Tab is not null)
        {
            Tab.Designer = new DesignerSession(_designer, _failure);
        }

        await LoadAuditAsync(schema, token);
    }

    /// <summary>
    /// The table's audit table and trigger by the template's names (WP-26). The box is on if there is an audit table (or
    /// the view was opened for it); off otherwise – most tables have none, and that is no fault.
    /// </summary>
    private async Task LoadAuditAsync(SchemaCache schema, CancellationToken token)
    {
        _audit = null;
        _auditFacts.Clear();
        _auditFailed.Clear();
        if (AuditTemplates.For(Active.Profile).Template is { } template)
        {
            var loaded = await Shell.RunDbAsync(Logger, Active, () => AuditLoader.LoadAsync(schema, template.NamesFor(Details.Table.Ref), token), token);
            if (_disposed)
            {
                return;
            }

            _audit = loaded.Value ?? AuditState.None;
        }

        if (_designer is { } designer)
        {
            designer.WithAudit ??= StartWithAudit || _audit?.AuditTable is not null; // a choice of the user stays (R5 review)
        }
    }

    /// <summary>The table the audit objects belong to: this one, or the new table once it has a name.</summary>
    private TableRef? AuditTable => NewTab is { } created
        ? created.Table.Name.Trim().Length > 0 ? created.Table.Ref : null
        : Details.Table.Ref;

    /// <summary>The designer's plan with the audit table and trigger, if the box is on (WP-26): one script, checked as one.</summary>
    private DesignPlan WithAudit(ColumnDesigner designer, TableDraft draft, DesignPlan plan, AuditTemplateLoad audit)
    {
        if (designer.WithAudit != true || AuditTable is not { } table)
        {
            return plan;
        }

        if (audit.Template is not { } template)
        {
            return new DesignPlan(plan.Steps, [.. plan.Problems, SchemaViewText.Audit_TemplateBroken, .. audit.Errors], plan.Warnings);
        }

        if (NewTab is null && _audit is null)
        {
            return plan; // still loading what the schema has
        }

        var (columns, renamed) = AuditPlanner.After(draft);
        var taken = NewTab is null ? TakenNames : TakenNames.Append(table.Name);
        var auditPlan = AuditPlanner.Plan(template, table, columns, _audit ?? AuditState.None, new DataFacts(_auditFacts), renamed, taken);
        return AuditPlanner.Combine(plan, auditPlan);
    }

    /// <summary>
    /// A statement failed: what ran before it stays. The draft is laid over the table as it is now, so it holds only what
    /// is still to do – here, and after the tab rebuilt its views (the session stays in the tab with the failure).
    /// </summary>
    private async Task OnFailedAsync(DdlRunResult result)
    {
        // Rebuilt meanwhile (the DDL changed the structure): the new view took the draft and the failure from the tab.
        if (_disposed)
        {
            return;
        }

        _failure = result;
        if (NewTab is { } created)
        {
            // The table exists once CREATE TABLE ran: the rest of the draft goes on as an edit of it, in its own tab.
            if (result.Ran.Count > 0)
            {
                OpenCreated(created, new DesignerSession(created.Designer, result));
            }

            return;
        }

        if (result.Ran.Count > 0 && _designer is { } designer)
        {
            await LoadAsync(designer);
        }
    }

    /// <summary>
    /// Before the schema is reloaded: after a failure the draft and the failure go into the tab, for a rebuilt view to
    /// reopen with; after a run that succeeded nothing does (R4a: the rebuilt view reopened in edit mode with the failure of
    /// an earlier run). A new table opens its tab after the reload (<see cref="OnRanAsync"/>).
    /// </summary>
    private void OnEnded(DdlRunResult result)
    {
        if (result.Succeeded)
        {
            if (NewTab is null && Tab is not null)
            {
                Tab.Designer = null;
            }
        }
        else if (NewTab is not null)
        {
            NewTab.Failure = result;
        }
        else if (Tab is not null && _designer is not null)
        {
            Tab.Designer = new DesignerSession(_designer, result);
        }
    }

    /// <summary>The new table as a table tab on its columns – with what is left of the draft, if a statement after CREATE failed.</summary>
    private void OpenCreated(NewTableTab created, DesignerSession? rest)
    {
        if (Active.Schema?.Find(created.Table.Ref) is { } summary && Shell.OpenTable(summary, TabMode.Structure) is { } tab)
        {
            tab.Designer = rest;
        }

        Shell.CloseTab(created);
    }

    private async Task CloseAsync()
    {
        if (Tab is not null)
        {
            Tab.Designer = null;
        }

        await OnClose.InvokeAsync();
    }

    /// <summary>What the plan needs to know about the data and nobody counted yet: counted in the tab's workspace.</summary>
    protected override void OnAfterRender(bool firstRender)
    {
        if (_designer is null || NewTab is not null) // a new table has no rows to count
        {
            return;
        }

        var draft = _designer.ToDraft().Draft;
        var missing = TableDesign.Questions(_designer.Table, draft)
            .Where(q => !_facts.ContainsKey(q) && !_counting.Contains(q) && !_failed.Contains(q)).ToList();
        if (missing.Count > 0)
        {
            _counting.UnionWith(missing);
            Fire(() => CountAsync(_designer.Table, missing, _facts, _counting, _failed));
        }

        // The existing audit table: its rows decide whether a new column may be NOT NULL (WP-26).
        if (_designer.WithAudit == true && _audit is { AuditTable: { } auditTable } state && AuditTemplates.For(Active.Profile).Template is { } template)
        {
            var (columns, renamed) = AuditPlanner.After(draft);
            var auditMissing = AuditPlanner.Questions(template, Details.Table.Ref, columns, state, renamed)
                .Where(q => !_auditFacts.ContainsKey(q) && !_auditCounting.Contains(q) && !_auditFailed.Contains(q)).ToList();
            if (auditMissing.Count > 0)
            {
                _auditCounting.UnionWith(auditMissing);
                Fire(() => CountAsync(auditTable, auditMissing, _auditFacts, _auditCounting, _auditFailed));
            }
        }
    }

    private async Task CountAsync(TableDetails table, IReadOnlyList<DataQuestion> questions, Dictionary<DataQuestion, long> facts,
        HashSet<DataQuestion> counting, HashSet<DataQuestion> failed)
    {
        if (_disposed)
        {
            return;
        }

        var token = _cts.Token;
        var counted = await Shell.RunDbAsync(Logger, Active, async () =>
        {
            var data = await Workspaces.GetDataAsync(WorkspaceId, token);
            return await TableDesign.CountAsync(data, table, questions, token);
        }, token);
        if (token.IsCancellationRequested)
        {
            return;
        }

        foreach (var question in questions)
        {
            counting.Remove(question);
            if (counted.Value?.Of(question) is { } count)
            {
                facts[question] = count;
            }
            else
            {
                failed.Add(question); // unknown: the plan warns instead of deciding
            }
        }

        StateHasChanged();
    }

    /// <summary>The offered types, and a column's own type if it is none of them (INTERVAL, XMLTYPE …).</summary>
    private static IEnumerable<string> TypesFor(DesignColumn column) =>
        DesignColumn.Types.Contains(column.Type) ? DesignColumn.Types : [column.Type, .. DesignColumn.Types];

    private static void SetType(ColumnDesigner designer, DesignConstraint constraint, object? value)
    {
        if (Enum.TryParse<ConstraintType>(value as string, out var type))
        {
            designer.SetType(constraint, type);
        }
    }

    /// <summary>The foreign key references another table; its structure is loaded once, for its key and column types.</summary>
    private async Task ReferenceAsync(ColumnDesigner designer, DesignConstraint constraint, string? value)
    {
        var references = Tables.FirstOrDefault(t => $"{t.Owner}.{t.Name}" == value)?.Ref;
        designer.Reference(constraint, references);
        if (references is null || designer.Referenced.ContainsKey(references) || Active.Schema is not { } schema || schema.Find(references) is not { } summary)
        {
            return;
        }

        var loaded = await Shell.RunDbAsync(Logger, Active, () => schema.GetDetailsAsync(summary, _cts.Token), _cts.Token);
        if (loaded.Value is { } details && !_disposed)
        {
            designer.Learn(details);
        }
    }
    /// <summary>Property lines for the new columns, if the C# model maps this table.</summary>
    private IReadOnlyList<PropertySuggestion> PropertyLines(ColumnDesigner designer)
    {
        if (NewTab is not null || Models.Mapping is not { } mapping || mapping.EntityOf(Details.Table.Ref) is null)
        {
            return [];
        }

        return designer.Columns.Where(c => c.IsNew && !c.Dropped && c.Name.Trim().Length > 0)
            .Select(c => c.ToColumn().Column).OfType<ColumnInfo>()
            .Select(c => PropertyCode.Suggest(mapping.Model, c))
            .ToList();
    }

    private async Task OnRanAsync()
    {
        if (NewTab is { } created)
        {
            OpenCreated(created, null);
            return;
        }

        if (Tab is not null)
        {
            Tab.Designer = null;
        }

        await OnRan.InvokeAsync();
    }

    private static string Kind(ConstraintType type) => type switch
    {
        ConstraintType.PrimaryKey => "PK",
        ConstraintType.Unique => "UK",
        ConstraintType.ForeignKey => "FK",
        _ => "CHECK",
    };

    private static string BadgeCss(ConstraintType type) => type switch
    {
        ConstraintType.PrimaryKey => "pk",
        ConstraintType.Unique => "uk",
        ConstraintType.ForeignKey => "fk",
        _ => "",
    };

    private static string Describe(ConstraintInfo constraint) => constraint.Type switch
    {
        ConstraintType.Check => constraint.Condition ?? "",
        ConstraintType.ForeignKey => $"({string.Join(", ", constraint.Columns)}) → {constraint.References?.Name} ({string.Join(", ", constraint.ReferencedColumns)})",
        _ => $"({string.Join(", ", constraint.Columns)})",
    };

    public void Dispose()
    {
        _disposed = true;
        _cts.Cancel();
        _cts.Dispose();
    }
}
