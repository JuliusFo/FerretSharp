@* "Spalten" view: the columns with type, NULL, default, flags and comment, filterable (Ctrl+F); for views also the definition. *@
@using FerretSharp.Core.ClrModel
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Query
@using FerretSharp.Core.Schema
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ShortcutService Shortcuts

@{
    var fkColumns = (Active.Schema?.OutgoingOf(Details.Table.Ref) ?? [])
        .SelectMany(f => f.FromColumns.Select(c => (Column: c, Fk: f)))
        .ToLookup(x => x.Column, x => x.Fk);
    var uniqueColumns = Details.UniqueKeys.SelectMany(k => k).ToHashSet();
    // Filtering keeps the schema order: this is a table of the columns, not a list of search hits.
    var shown = ColumnSearch.Find(Details.Columns, _columnQuery).Order().Select(i => Details.Columns[i]).ToList();
    var filtering = !string.IsNullOrWhiteSpace(_columnQuery);
    // C# model of the linked project (WP-11): entity of this table and the property of each column.
    var mapping = Models.Mapping;
    var entity = mapping?.EntityOf(Details.Table.Ref);
}

<section>
    <div class="structure-columns-head">
        <h2>
            Spalten
            <span class="count">@(filtering ? $"{shown.Count} von {Details.Columns.Count}" : Details.Columns.Count.ToString(CultureInfo.CurrentCulture))</span>
        </h2>
        @if (entity is not null)
        {
            <span class="entity-name" title="@entity.Entity.ClrType – aus dem C#-Modell">
                Entity <strong>@ClrModelMapping.ShortName(entity.Entity.ClrType)</strong>
            </span>
        }
        <SearchBox @ref="_filter" Class="structure-filter" Placeholder="@($"Spalten filtern …{Shortcuts.Hint(ShortcutAction.FindColumn)}")" @bind-Value="_columnQuery" />
    </div>
    <table class="columns">
        <thead>
            <tr>
                <th class="num">#</th><th>Name</th><th>Typ</th>
                @if (entity is not null)
                {
                    <th>Property</th><th>C#-Typ</th>
                }
                <th>Null</th><th>Default</th><th></th><th>Kommentar</th>
            </tr>
        </thead>
        <tbody>
            @if (shown.Count == 0)
            {
                <tr><td colspan="@(entity is null ? 7 : 9)" class="muted">Keine Spalte passt zu „@_columnQuery“.</td></tr>
            }
            @foreach (var column in shown)
            {
                <tr>
                    <td class="num">@column.Position</td>
                    <td class="name">
                        @column.Name
                        @if (Details.PrimaryKey.Contains(column.Name))
                        {
                            <span class="fs-badge pk" title="Primärschlüssel">PK</span>
                        }
                        else if (uniqueColumns.Contains(column.Name))
                        {
                            <span class="fs-badge uk" title="Unique Key">UK</span>
                        }
                        @foreach (var fk in fkColumns[column.Name])
                        {
                            @if (fk.Source == FkSource.ClrModel)
                            {
                                <span class="fs-badge fk model" title="@fk.Name → @fk.To (aus dem C#-Modell, ohne Constraint)">FK</span>
                            }
                            else
                            {
                                <span class="fs-badge fk" title="@fk.Name → @fk.To">FK</span>
                            }
                        }
                    </td>
                    <td class="mono">@column.DisplayType</td>
                    @if (entity is not null)
                    {
                        var property = mapping!.PropertyOf(Details.Table.Ref, column.Name);
                        @if (property is null)
                        {
                            <td class="muted" title="Keine Property im C#-Modell">–</td>
                            <td></td>
                        }
                        else
                        {
                            var mismatches = mapping.MismatchesOf(Details.Table.Ref, column.Name).ToList();
                            <td class="mono property">
                                @property.Name@(property.IsShadow ? " (Shadow)" : "")
                                @if (mismatches.Count > 0)
                                {
                                    var worst = mismatches.Min(m => m.Severity);
                                    <span class="mismatch-sev @ModelMismatches.Css(worst)"
                                          title="@string.Join("\n", mismatches.Select(m => $"{ModelMismatches.KindText(m.Kind)}: {m.Message}"))">@string.Join(" · ", mismatches.Select(m => ModelMismatches.KindText(m.Kind)))</span>
                                }
                            </td>
                            <td class="mono clr-type" title="@ValuesTitle(property)">
                                @TablePresentation.ClrTypeText(property)
                                @if (property.Converter is { } converter)
                                {
                                    <span class="converter">@converter</span>
                                }
                                else if (property.Values is not null)
                                {
                                    <span class="converter">Enum als Zahl</span>
                                }
                            </td>
                        }
                    }
                    <td>@(column.Nullable ? "" : "NOT NULL")</td>
                    <td class="mono default" title="@(column.IsVirtual ? "Ausdruck der virtuellen Spalte" : null)">@column.Default</td>
                    <td class="flags">@Flags(column)</td>
                    <td class="comment">@column.Comment</td>
                </tr>
            }
        </tbody>
    </table>
</section>

@if (Details.Definition is { } definition)
{
    <section>
        <h2>Definition</h2>
        <SqlCode Sql="@definition" Class="definition" />
        @if (Details.DefinitionTruncated)
        {
            <p class="muted">Gekürzt – die Definition ist länger als 32.767 Zeichen.</p>
        }
    </section>
}

@code {
    [CascadingParameter]
    public ActiveConnection Active { get; set; } = null!;

    [CascadingParameter]
    public ClrModelManager Models { get; set; } = null!;

    private SearchBox? _filter;
    private DomModule? _dom;

    /// <summary>dom.js, imported on first use; does nothing once disposed (<see cref="DomModule"/>).</summary>
    private DomModule Dom => _dom ??= new(JS);
    private string _columnQuery = "";

    [Parameter, EditorRequired]
    public TableDetails Details { get; set; } = null!;

    protected override void OnInitialized() => Models.Changed += OnModelChanged;

    private void OnModelChanged() => InvokeAsync(StateHasChanged);

    /// <summary>Enum members (or true/false) with what the project stores for them, as a tooltip.</summary>
    private static string? ValuesTitle(PropertyExport property) => property.Values is { } values
        ? string.Join("\n", values.Select(v => $"{v.Name}{(v.DisplayName is { } display ? $" „{display}“" : "")} = {v.ProviderValue ?? "?"}"))
        : null;

    private static string Flags(ColumnInfo column) => string.Join(" · ", new[]
    {
        column.IsIdentity ? "IDENTITY" : null,
        column.IsVirtual ? "VIRTUAL" : null,
        column.DefaultOnNull ? "DEFAULT ON NULL" : null,
    }.OfType<string>());

    /// <summary>Ctrl+F: focuses the column filter and selects its text.</summary>
    public async Task FocusFilterAsync()
    {
        if (_filter is not null)
        {
            await Dom.InvokeVoidAsync("focusAndSelect", _filter.Input);
        }
    }

    public async ValueTask DisposeAsync()
    {
        Models.Changed -= OnModelChanged;
        await Dom.DisposeAsync();
    }
}
