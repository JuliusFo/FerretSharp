@* Matching columns with a keyboard highlight. The search input belongs to the parent (ColumnPicker, ColumnJump),
   which forwards the arrow keys and Enter via Move and PickHighlightedAsync. *@
@using FerretSharp.Core.ClrModel
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Query
@using FerretSharp.Core.Schema
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="col-list">
    @if (_matches.Count == 0)
    {
        <div class="popover-empty">Keine Spalte passt zu „@Query“.</div>
    }
    @for (var i = 0; i < _matches.Count; i++)
    {
        var position = i;
        var column = Details.Columns[_matches[i]];
        var label = _presentation.LabelOf(_matches[i]);
        <div id="@ItemId(position)" class="col-item @(position == _highlight ? "highlight" : "") @(_matches[i] == Current ? "current" : "")" title="@column.Comment"
             @onmousedown="() => PickAsync(position)" @onmousedown:preventDefault="true" @onmouseenter="() => _highlight = position">
            <span class="col-item-name">@label.Name</span>
            @if (label.AlternateName is { } alternate)
            {
                <span class="col-item-clr">@alternate</span>
            }
            @if (Details.PrimaryKey.Contains(column.Name))
            {
                <span class="fs-badge pk">PK</span>
            }
            @if (_foreignKeyColumns.Contains(column.Name))
            {
                <span class="fs-badge fk">FK</span>
            }
            <span class="col-item-type">@(label.ClrType is { } clrType ? $"{clrType} · {column.DisplayType}" : column.DisplayType)</span>
        </div>
    }
</div>

@code {
    [CascadingParameter]
    public ActiveConnection Active { get; set; } = null!;

    [CascadingParameter]
    public PresentationService Presentations { get; set; } = null!;

    private readonly string _id = "cols-" + Guid.NewGuid().ToString("N");
    private IReadOnlyList<int> _matches = [];
    private TablePresentation _presentation = null!;
    private HashSet<string> _foreignKeyColumns = [];
    private string? _lastQuery;
    private int _highlight;
    private bool _scrollToHighlight;
    private DomModule? _dom;

    /// <summary>dom.js, imported on first use; does nothing once disposed (<see cref="DomModule"/>).</summary>
    private DomModule Dom => _dom ??= new(JS);

    [Parameter, EditorRequired]
    public TableDetails Details { get; set; } = null!;

    [Parameter]
    public string Query { get; set; } = "";

    /// <summary>Column (index into <c>Details.Columns</c>) marked and highlighted while the query is empty.</summary>
    [Parameter]
    public int? Current { get; set; }

    [Parameter]
    public EventCallback<int> OnPick { get; set; }

    private string ItemId(int position) => _id + "-" + position.ToString(CultureInfo.InvariantCulture);

    protected override void OnInitialized()
    {
        _foreignKeyColumns = Active.Schema?.OutgoingOf(Details.Table.Ref).SelectMany(f => f.FromColumns).ToHashSet() ?? [];
        _presentation = Presentations.For(Details);
    }

    protected override void OnParametersSet()
    {
        if (Query == _lastQuery)
        {
            return;
        }

        _lastQuery = Query;
        // Property names of the C# model are found too (WP-12).
        _matches = ColumnSearch.Find(Details.Columns, Query, _presentation.SearchNameOf);
        var current = string.IsNullOrWhiteSpace(Query) && Current is { } c ? IndexOf(c) : -1;
        _highlight = Math.Max(current, 0);
        _scrollToHighlight = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollToHighlight && _matches.Count > 0)
        {
            _scrollToHighlight = false;
            await Dom.InvokeVoidAsync("scrollIntoViewById", ItemId(_highlight));
        }
    }

    public void Move(int delta)
    {
        _highlight = Math.Clamp(_highlight + delta, 0, Math.Max(0, _matches.Count - 1));
        _scrollToHighlight = true;
        StateHasChanged();
    }

    /// <summary>Picks the highlighted column; false if nothing matches.</summary>
    public async Task<bool> PickHighlightedAsync()
    {
        if (_matches.Count == 0)
        {
            return false;
        }

        await OnPick.InvokeAsync(_matches[_highlight]);
        return true;
    }

    private Task PickAsync(int position) => OnPick.InvokeAsync(_matches[position]);

    private int IndexOf(int column)
    {
        for (var i = 0; i < _matches.Count; i++)
        {
            if (_matches[i] == column)
            {
                return i;
            }
        }

        return -1;
    }

    public async ValueTask DisposeAsync()
    {
        await Dom.DisposeAsync();
    }
}
