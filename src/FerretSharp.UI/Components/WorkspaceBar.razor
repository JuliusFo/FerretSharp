@* Workspaces of the active connection: click activates, double-click or "⋯" renames, × or middle-click closes. *@
@using FerretSharp.Core.Workspaces
@using FerretSharp.UI.State
@implements IAsyncDisposable
@inject WorkspaceManager Workspaces
@inject IJSRuntime JS

<div class="workspaces">
    @{ var open = Workspaces.Open; var activeId = Workspaces.Active?.Id; }
    @foreach (var workspace in open)
    {
        var w = workspace;
        <div class="ws @(w.Id == activeId ? "active" : "")" title="@(_renaming == w.Id ? null : "Doppelklick oder ⋯: umbenennen · Mittelklick: schließen")"
             @onclick="e => OnChipClick(e, w)" @onmouseup="e => CloseOnMiddleClick(e, w)">
            @if (_renaming == w.Id)
            {
                <input class="ws-rename" @ref="_renameInput" maxlength="@Workspace.MaxNameLength" @bind="_renameText" @bind:event="oninput"
                       @onkeydown="OnRenameKeyDown" @onblur="CommitRename" @onclick:stopPropagation="true" />
            }
            else
            {
                <span class="ws-name">@w.Name</span>
                <button class="ws-more" title="Aktionen" @onclick:stopPropagation="true" @onclick="e => OpenActions(e, w)">⋯</button>
            }
            @if (open.Count > 1 && _renaming != w.Id)
            {
                <button class="ws-close" title="Workspace schließen (Zustand bleibt gespeichert)"
                        @onclick:stopPropagation="true" @onclick="() => CloseAsync(w)">✕</button>
            }
        </div>
    }

    <div class="ws-menu-anchor">
        <button class="ws-add @(_menuOpen ? "open" : "")" title="Workspace hinzufügen oder wieder öffnen" @onclick="ToggleMenu">+</button>
        @if (_menuOpen)
        {
            <div class="popover-backdrop" @onclick="() => _menuOpen = false"></div>
            <div class="popover ws-pop" @onkeydown="OnMenuKeyDown">
                <div class="popover-list">
                    <button class="menu-item" @onclick="CreateAsync"><span class="plus">+</span> Neuer Workspace</button>
                    @{ var closed = Workspaces.Closed; }
                    @if (closed.Count > 0)
                    {
                        <div class="group-head-btn static">Geschlossen</div>
                        @foreach (var workspace in closed)
                        {
                            var w = workspace;
                            <div class="ws-closed">
                                <button class="menu-item" title="Wieder öffnen" @onclick="() => ReopenAsync(w)">
                                    <span class="ws-name">@w.Name</span>
                                    <span class="ws-meta">@TabCount(w) · @w.LastActive.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)</span>
                                </button>
                                <button class="icon-btn ghost ws-delete" title="Endgültig löschen" @onclick="() => _pendingDelete = w">✕</button>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>
</div>

@if (_actionsFor is { } target)
{
    <div class="overlay" @onclick="CloseActions" @oncontextmenu="CloseActions" @oncontextmenu:preventDefault="true"></div>
    <div class="menu" style="left:@Px(_actionsX);top:@Px(_actionsY)" tabindex="-1" @ref="_actionsMenu" @onkeydown="OnActionsKeyDown">
        <button class="menu-item" @onclick="() => RunAction(() => StartRename(target))">Umbenennen</button>
        <button class="menu-item" disabled="@(Workspaces.Open.Count <= 1)"
                title="@(Workspaces.Open.Count <= 1 ? "Der letzte offene Workspace bleibt offen." : "Zustand bleibt gespeichert, über + wieder öffnen")"
                @onclick="() => RunActionAsync(() => CloseAsync(target))">Schließen</button>
        <div class="menu-sep"></div>
        <button class="menu-item" @onclick="() => RunActionAsync(CreateAsync)"><span class="plus">+</span> Neuer Workspace</button>
    </div>
}

@if (_pendingDelete is { } pending)
{
    <ConfirmDialog Title="Workspace löschen" ConfirmLabel="Löschen" Danger="true"
                   OnConfirm="() => DeleteAsync(pending)" OnCancel="() => _pendingDelete = null">
        Workspace <strong>@pending.Name</strong> mit @TabCount(pending) und allen Filtern endgültig löschen?
    </ConfirmDialog>
}

@code {
    private ElementReference _renameInput;
    private Guid? _renaming;
    private bool _focusRename;
    private IJSObjectReference? _dom;
    private string _renameText = "";
    private bool _menuOpen;
    private Workspace? _pendingDelete;

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    protected override void OnInitialized() => Workspaces.Changed += OnChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusRename)
        {
            _focusRename = false;
            // Select the whole name, so typing replaces it.
            _dom ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/FerretSharp.UI/js/dom.js");
            await _dom.InvokeVoidAsync("focusAndSelect", _renameInput);
        }

        if (_focusActions && _actionsFor is not null)
        {
            _focusActions = false;
            await _actionsMenu.FocusAsync();
        }
    }

    private static string TabCount(Workspace workspace) => workspace.Tabs.Count == 1 ? "1 Tab" : $"{workspace.Tabs.Count} Tabs";

    private Workspace? _actionsFor;
    private double _actionsX;
    private double _actionsY;
    private ElementReference _actionsMenu;
    private bool _focusActions;

    /// <summary>"⋯" on a chip: rename, close, new – like the "⋯" menu of the connections.</summary>
    private void OpenActions(MouseEventArgs e, Workspace workspace)
    {
        _menuOpen = false;
        _actionsFor = workspace;
        _actionsX = Math.Max(8, e.ClientX - 16);
        _actionsY = e.ClientY + 12;
        _focusActions = true; // Escape closes
    }

    private void CloseActions() => _actionsFor = null;

    private void OnActionsKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseActions();
        }
    }

    private void RunAction(Action action)
    {
        CloseActions();
        action();
    }

    private async Task RunActionAsync(Func<Task> action)
    {
        CloseActions();
        await action();
    }

    private static string Px(double value) => value.ToString("0", CultureInfo.InvariantCulture) + "px";

    private void Activate(Workspace workspace)
    {
        Workspaces.Activate(workspace.Id);
        Shell.ShowExplorer();
    }

    /// <summary>
    /// Double click renames. Not via @ondblclick: in the WPF host a real double click reaches the WebView with a
    /// duplicated mousedown, the click count jumps to 3 and dblclick never fires (see CLAUDE.md).
    /// </summary>
    private void OnChipClick(MouseEventArgs e, Workspace workspace)
    {
        if (e.Detail >= 2)
        {
            StartRename(workspace);
        }
        else
        {
            Activate(workspace);
        }
    }

    private void StartRename(Workspace workspace)
    {
        _renaming = workspace.Id;
        _renameText = workspace.Name;
        _focusRename = true;
    }

    private void CommitRename()
    {
        if (_renaming is { } id && Workspace.NormalizeName(_renameText) is { } name)
        {
            Workspaces.Rename(id, name);
        }

        _renaming = null;
    }

    private void OnRenameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            CommitRename();
        }
        else if (e.Key == "Escape")
        {
            _renaming = null;
        }
    }

    /// <summary>Closing ends the workspace's session: uncommitted changes are committed or discarded first.</summary>
    private async Task CloseAsync(Workspace workspace)
    {
        if (Workspaces.Open.Count > 1)
        {
            await Shell.GuardAsync($"Workspace „{workspace.Name}“ schließen", [workspace.Id], () => Workspaces.CloseAsync(workspace.Id));
        }
    }

    private async Task CloseOnMiddleClick(MouseEventArgs e, Workspace workspace)
    {
        if (e.Button == 1)
        {
            await CloseAsync(workspace);
        }
    }

    private void ToggleMenu() => _menuOpen = !_menuOpen;

    private void OnMenuKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _menuOpen = false;
        }
    }

    private async Task CreateAsync()
    {
        _menuOpen = false;
        var workspace = await Workspaces.CreateAsync();
        Shell.ShowExplorer();
        StartRename(workspace);
    }

    private async Task ReopenAsync(Workspace workspace)
    {
        _menuOpen = false;
        await Workspaces.ReopenAsync(workspace.Id);
        Shell.ShowExplorer();
    }

    private async Task DeleteAsync(Workspace workspace)
    {
        _pendingDelete = null;
        await Workspaces.DeleteAsync(workspace.Id);
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Workspaces.Changed -= OnChanged;
        if (_dom is not null)
        {
            try
            {
                await _dom.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
