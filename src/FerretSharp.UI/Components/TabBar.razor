@* The tabs of the active workspace (R2, out of Shell.razor): table tabs with their filters and change dot, PL/SQL tabs, SQL and LINQ
   tabs that can be renamed, and the buttons for new SQL/LINQ tabs. *@
@using FerretSharp.Core.ClrModel
@implements IAsyncDisposable
@inject ShortcutService Shortcuts
@inject IJSRuntime JS

<nav class="tabs">
    @foreach (var tab in Shell.Tabs)
    {
        var tooltip = tab switch
        {
            TableTab table => TabTooltip(table),
            PlSqlTab plSql => TextFormat.Format(ShellText.TabBar_PlSqlTitle, ExplorerList.KindLabel(plSql.Unit.Kind), plSql.Unit.Owner, plSql.Unit.Name),
            _ when _renaming == tab => null,
            LinqTab => ShellText.TabBar_LinqTitle,
            _ => ShellText.TabBar_SqlTitle,
        };
        <div class="tab @KindClass(tab) @(tab == Shell.ActiveTab ? "active" : "")" title="@tooltip"
             @onclick="e => OnClick(e, tab)" @onmouseup="e => CloseOnMiddleClick(e, tab)">
            @switch (tab)
            {
                case TableTab table:
                    @Icons.For(table.Table.Kind)
                    <span class="tab-name">@table.Table.DisplayName</span>
                    @if (table.Changes is { HasChanges: true } changes)
                    {
                        <span class="dot @(changes.PendingCount > 0 ? "pending" : "flushed")"
                              title="@TextFormat.Format(ShellText.Changes_PendingWritten, changes.PendingCount, changes.FlushedCount)"></span>
                    }
                    @if (FilterSummaryOf(table) is { } summary)
                    {
                        <span class="tab-filter">@summary</span>
                    }
                    else if (table.ActiveFilterCount > 0)
                    {
                        <span class="filter-pill">@TextFormat.Plural(table.ActiveFilterCount, ShellText.TabBar_FiltersOne, ShellText.TabBar_FiltersOther)</span>
                    }
                    break;
                case PlSqlTab plSql:
                    @Icons.For(plSql.Unit.Kind)
                    <span class="tab-name">@plSql.Unit.DisplayName</span>
                    @if (plSql.Unit.IsInvalid)
                    {
                        <span class="dot err" title="@ShellText.TabBar_Invalid"></span>
                    }
                    break;
                case ITitledTab titled:
                    @(tab is LinqTab ? Icons.Code : Icons.Database)
                    @if (_renaming == tab)
                    {
                        <TitleEditor Value="@titled.Title" Class="tab-rename" OnCommit="name => Rename(tab, name)" OnCancel="() => _renaming = null" />
                    }
                    else
                    {
                        <span class="tab-name">@titled.Title</span>
                    }
                    break;
            }
            <button class="tab-close" title="@TextFormat.Format(ShellText.TabBar_CloseTitle, Shortcuts.Hint(ShortcutAction.CloseTab))"
                    @onmousedown:preventDefault="true" @onclick:stopPropagation="true" @onclick="() => CloseAsync(tab)">✕</button>
        </div>
    }
    <button class="tab-new" title="@TextFormat.Format(ShellText.TabBar_NewSqlTitle, Shortcuts.Hint(ShortcutAction.NewSql))"
            @onclick="() => Shell.OpenSql()">+ SQL</button>
    @if (Models.State.Link is not null)
    {
        <button class="tab-new" title="@TextFormat.Format(ShellText.TabBar_NewLinqTitle, Shortcuts.Hint(ShortcutAction.NewLinq))"
                @onclick="() => Shell.OpenLinq()">+ LINQ</button>
    }
</nav>

@code {
    [CascadingParameter]
    public PresentationService Presentations { get; set; } = null!;

    [CascadingParameter]
    public ClrModelManager Models { get; set; } = null!;

    /// <summary>The SQL or LINQ tab whose title is being edited.</summary>
    private WorkspaceTab? _renaming;

    /// <summary>shortcuts.js, imported on the first close of a table tab (is a grid cell being edited?).</summary>
    private IJSObjectReference? _shortcuts;

    private bool _disposed;

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    /// <summary>A parameter (not only cascaded), so the bar renders again whenever the shell does.</summary>
    [Parameter, EditorRequired]
    public WorkspaceLifecycle Lifecycle { get; set; } = null!;

    private static string KindClass(WorkspaceTab tab) => tab switch
    {
        LinqTab => "linq",
        SqlTab => "sql",
        PlSqlTab => "plsql",
        _ => "",
    };

    /// <summary>
    /// Double click renames a SQL or LINQ tab. Not via @@ondblclick: in the WPF host a real double click never fires it
    /// (see src/FerretSharp.UI/CLAUDE.md, like the workspace chips).
    /// </summary>
    private void OnClick(MouseEventArgs e, WorkspaceTab tab)
    {
        Shell.ActivateTab(tab);
        if (tab is ITitledTab && e.Detail >= 2)
        {
            _renaming = tab;
        }
    }

    private void Rename(WorkspaceTab tab, string name)
    {
        _renaming = null;
        if (tab is ITitledTab titled)
        {
            Shell.RenameTab(titled, name);
        }
    }

    private async Task CloseOnMiddleClick(MouseEventArgs e, WorkspaceTab tab)
    {
        if (e.Button == 1)
        {
            await CloseAsync(tab);
        }
    }

    /// <summary>
    /// ✕ or middle click. The ✕ leaves the focus where it is (mousedown without default): a grid cell being edited would
    /// otherwise end its input only after the click had closed the tab. So the editor is still open here, shortcuts.js
    /// can tell, and closing asks first instead of dropping the typed value.
    /// </summary>
    private async Task CloseAsync(WorkspaceTab tab)
    {
        var cellEditing = false;
        if (tab is TableTab && tab == Shell.ActiveTab)
        {
            try
            {
                _shortcuts ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/FerretSharp.UI/js/shortcuts.js");
                cellEditing = await _shortcuts.InvokeAsync<bool>("cellEditing");
            }
            catch (JSDisconnectedException)
            {
                return;
            }

            if (_disposed)
            {
                return;
            }
        }

        Lifecycle.CloseTab(tab, cellEditing);
    }

    /// <summary>Several tabs of one table (FK jumps) are told apart by their filters.</summary>
    private string? FilterSummaryOf(TableTab tab) =>
        Shell.Tabs.OfType<TableTab>().Count(o => o.Table.Ref == tab.Table.Ref) > 1 ? tab.FilterSummary(presentation: PresentationOf(tab)) : null;

    /// <summary>Owner.table plus the active filters, so several tabs of the same table can be told apart.</summary>
    private string TabTooltip(TableTab tab)
    {
        var filters = tab.FilterTexts(PresentationOf(tab)).ToList();
        var entity = Presentations.ShownEntityNameOf(tab.Table.Ref) is { } name ? $" · Entity {name}" : "";
        return $"{tab.Table.Owner}.{tab.Table.Name}{entity}" + (filters.Count > 0 ? Environment.NewLine + string.Join(Environment.NewLine, filters) : "");
    }

    /// <summary>Enum and bool filter values by their C# names, once the tab knows its table's structure.</summary>
    private TablePresentation? PresentationOf(TableTab tab) => tab.Details is { } details ? Presentations.For(details) : null;

    /// <summary>The presentation subscribed to: the shown connection's, which changes on a switch.</summary>
    private PresentationService? _presentations;

    /// <summary>A new model or name setting: titles and tooltips follow (the shell no longer renders for it).</summary>
    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_presentations, Presentations))
        {
            if (_presentations is not null)
            {
                _presentations.Changed -= OnPresentationChanged;
            }

            _presentations = Presentations;
            _presentations.Changed += OnPresentationChanged;
        }
    }

    private void OnPresentationChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_presentations is not null)
        {
            _presentations.Changed -= OnPresentationChanged;
        }

        if (_shortcuts is not null)
        {
            try
            {
                await _shortcuts.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
