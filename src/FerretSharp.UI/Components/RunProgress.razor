@* Where the result will appear while a statement runs (SQL editor, LINQ console): what runs, for how long (ticking each
   second), "Cancel". A cancel Oracle does not answer within a few seconds (a VPN may swallow it) offers to give up the
   workspace's session – after saying what that discards. After a few seconds it also says what the session waits for and
   how far a long operation is (WP-52, SessionWatch); without rights on the V$ views, a writing statement names the other
   workspaces with uncommitted changes instead. One instance per statement (keyed by the caller). *@
@using FerretSharp.Core.Query
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Data
@inherits FerretComponent
@implements IDisposable
@inject ConnectionHub Hub
@inject AppSettingsService Settings
@inject ILogger<RunProgress> Logger

<div class="run-progress" role="status">
    <div class="run-head">
        <span class="spinner"></span>
        <strong>@Title</strong>
        <span class="run-clock" title="@SqlEditorText.Run_Elapsed">@Clock(Now - Started)</span>
    </div>
    @if (Detail is not null)
    {
        <div class="run-detail" title="@Detail">@SqlScript.OneLine(Detail)</div>
    }
    @if (ScriptStarted is { } script)
    {
        <div class="run-meta">@TextFormat.Format(SqlEditorText.Run_ScriptRunningFor, Clock(Now - script))</div>
    }
    @if (_watch?.Latest is { } activity)
    {
        @if (activity.Wait is { } wait)
        {
            var own = SessionActivityText.OwnOf(Hub, wait.Blocker?.ClientInfo, Active.Profile?.Id ?? Guid.Empty, Settings.Current);
            <div class="run-wait">
                <span>@SessionActivityText.Wait(wait, own)</span>
                @if (own is not null)
                {
                    <button class="btn" title="@SqlEditorText.Run_ShowWorkspaceTitle" @onclick="() => ShowWorkspace(own)">@SqlEditorText.Run_ShowWorkspace</button>
                }
            </div>
        }
        @if (activity.Progress is { } progress)
        {
            <div class="run-longop">
                <div class="run-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@progress.Percent">
                    <span style="width: @(progress.Percent)%"></span>
                </div>
                <span class="run-meta">@SessionActivityText.Progress(progress)</span>
            </div>
        }
    }
    else if (_watch is { Unavailable: true } && MayWaitForLock && SessionActivityText.OpenElsewhere(OpenElsewhere) is { } elsewhere)
    {
        <div class="run-meta">@elsewhere</div>
    }
    @if (Hint is not null && Now - Started >= HintAfter)
    {
        <div class="run-meta">@Hint</div>
    }

    <div class="run-actions">
        @if (_resetting)
        {
            <span class="run-meta"><span class="spinner small"></span> @SqlEditorText.Run_Disconnecting</span>
        }
        else if (_cancelledAt is null)
        {
            @if (OnCancel.HasDelegate)
            {
                <button class="btn" @onclick="CancelAsync">@CommonText.Cancel</button>
            }
        }
        else if (!Stuck)
        {
            <span class="run-meta">@SqlEditorText.Run_Canceling</span>
        }
        else if (_confirmReset)
        {
            <div class="run-stuck">
                <p>@LossText</p>
                <div class="run-buttons">
                    <button class="btn danger-solid" @onclick="ResetAsync">@SqlEditorText.Run_DisconnectSession</button>
                    <button class="btn" @onclick="() => _confirmReset = false">@SqlEditorText.Run_KeepWaiting</button>
                </div>
            </div>
        }
        else
        {
            <div class="run-stuck">
                <p>@TextFormat.Format(Database ? SqlEditorText.Run_StuckDatabase : SqlEditorText.Run_Stuck, Clock(Now - _cancelledAt.Value))</p>
                @if (Database)
                {
                    <div class="run-buttons">
                        <button class="btn danger" title="@SqlEditorText.Run_DisconnectSessionTitle"
                                @onclick="AskResetAsync">@SqlEditorText.Run_DisconnectSessionAsk</button>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    /// <summary>How long a cancel may take before giving up the session is offered.</summary>
    private static readonly TimeSpan StuckAfter = TimeSpan.FromSeconds(5);

    private readonly CancellationTokenSource _ticks = new();
    private DateTimeOffset? _cancelledAt;
    private bool _confirmReset;
    private bool _resetting;

    [CascadingParameter]
    public WorkspaceManager Workspaces { get; set; } = null!;

    [CascadingParameter]
    public WorkspaceLifecycle Lifecycle { get; set; } = null!;

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [CascadingParameter]
    public ActiveConnection Active { get; set; } = null!;

    private SessionWatch? _watch;

    [Parameter, EditorRequired]
    public Guid WorkspaceId { get; set; }

    /// <summary>"Query running", "Statement 3 of 7 · UPDATE".</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    /// <summary>The statement in one line (cut off by the layout).</summary>
    [Parameter]
    public string? Detail { get; set; }

    [Parameter, EditorRequired]
    public DateTimeOffset Started { get; set; }

    /// <summary>Start of the whole script (several statements); null for one statement.</summary>
    [Parameter]
    public DateTimeOffset? ScriptStarted { get; set; }

    /// <summary>What may be going on if it takes longer (WP-22: DDL waiting for another transaction); shown after a few seconds.</summary>
    [Parameter]
    public string? Hint { get; set; }

    private static readonly TimeSpan HintAfter = TimeSpan.FromSeconds(3);

    /// <summary>Asks the caller to cancel; without a handler there is no button.</summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    /// <summary>The database is at work (not the C# translation): giving up the session can end it.</summary>
    [Parameter]
    public bool Database { get; set; } = true;

    /// <summary>
    /// The statement writes (DML, DDL): it may wait for a lock of another session. Reads never do in Oracle, so only these
    /// name the other workspaces with uncommitted changes when the V$ views cannot say who holds the lock (WP-52).
    /// </summary>
    [Parameter]
    public bool MayWaitForLock { get; set; }

    private static DateTimeOffset Now => DateTimeOffset.Now;

    private bool Stuck => _cancelledAt is { } at && Now - at >= StuckAfter;

    protected override void OnInitialized()
    {
        _ = TickAsync(_ticks.Token);
        if (Database)
        {
            _watch = SessionWatch.For(Shell, Logger, Active, Workspaces, WorkspaceId, () => _ = InvokeAsync(StateHasChanged));
            Fire(_watch.RunAsync);
        }
    }

    private void ShowWorkspace(OwnWorkspace own)
    {
        if (Hub.Find(own.ConnectionId) is { } scope)
        {
            Hub.ShowWorkspace(scope, own.WorkspaceId);
            Shell.ShowExplorer();
        }
    }

    /// <summary>The other workspaces of this connection with uncommitted writes (read without their sessions' help).</summary>
    private IReadOnlyList<string> OpenElsewhere => Workspaces.Open
        .Where(w => w.Id != WorkspaceId && Workspaces.TransactionOf(w.Id) is { Mode: TransactionMode.ReadWrite } && Workspaces.ActionsOf(w.Id).Count > 0)
        .Select(w => w.Name)
        .ToList();

    /// <summary>Renders once a second: the clock, and "Disconnect session" once the cancel is overdue.</summary>
    private async Task TickAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task CancelAsync()
    {
        _cancelledAt = Now;
        await OnCancel.InvokeAsync();
    }

    /// <summary>Asks only if something would be lost: statement writes of the open transaction.</summary>
    private Task AskResetAsync()
    {
        if (LostActions.Count > 0)
        {
            _confirmReset = true;
            return Task.CompletedTask;
        }

        return ResetAsync();
    }

    private async Task ResetAsync()
    {
        _confirmReset = false;
        _resetting = true;
        await Lifecycle.ResetSessionAsync(WorkspaceId);
        _resetting = false; // normally the statement has ended and this panel is gone by now
    }

    /// <summary>The uncommitted writes of the workspace's transaction (read without the session, which is busy).</summary>
    private IReadOnlyList<WriteAction> LostActions =>
        Workspaces.TransactionOf(WorkspaceId) is { Mode: TransactionMode.ReadWrite } ? Workspaces.ActionsOf(WorkspaceId) : [];

    private string LossText
    {
        get
        {
            var actions = LostActions;
            var statements = actions.Count(a => a.Kind != WriteActionKind.Grid);
            var grid = actions.Count - statements;
            var parts = new List<string> { TextFormat.Plural(actions.Count, SqlEditorText.Run_LossOne, SqlEditorText.Run_LossOther) };
            if (statements > 0)
            {
                parts.Add(TextFormat.Plural(statements, SqlEditorText.Run_LossStatementsOne, SqlEditorText.Run_LossStatementsOther));
            }

            if (grid > 0)
            {
                parts.Add(SqlEditorText.Run_LossGrid);
            }

            return string.Join(" ", parts);
        }
    }

    private static string Clock(TimeSpan elapsed) => TimeText.Clock(elapsed);

    public void Dispose()
    {
        _ticks.Cancel();
        _ticks.Dispose();
        _watch?.Dispose();
    }
}
