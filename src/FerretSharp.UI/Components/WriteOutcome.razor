@* What became of a statement's write in the workspace's transaction (R3b; was written twice, in the SQL editor and the
   LINQ console): still open, taken back with ↶, or ended by commit or rollback. *@

@switch (Fate)
{
    case WriteFate.Open:
        <p><Fmt Text="@GridText.Outcome_Open"><Arg0><strong>@RowsText</strong></Arg0><Arg1>@Detail</Arg1></Fmt></p>
        break;
    case WriteFate.Undone:
        <p class="muted">@TextFormat.Format(GridText.Outcome_Undone, RowsText, Detail)</p>
        break;
    default:
        <p class="muted">@TextFormat.Format(GridText.Outcome_Ended, RowsText, Detail)</p>
        break;
}

@code {
    [Parameter, EditorRequired]
    public int Rows { get; set; }

    [Parameter, EditorRequired]
    public WriteFate Fate { get; set; }

    /// <summary>After the row count, e.g. " (UPDATE · 12 ms)"; empty if there is nothing to add.</summary>
    [Parameter]
    public string Detail { get; set; } = "";

    /// <summary>"3 rows changed".</summary>
    private string RowsText => TextFormat.Plural(Rows, GridText.Outcome_RowsChangedOne, GridText.Outcome_RowsChangedOther);
}
