@* "C# ▾" at the filter bar (WP-15): the filters as LINQ over the entity – copied or opened in a new LINQ console. *@
@using FerretSharp.Core.ClrModel
@using FerretSharp.Core.Data
@using FerretSharp.Core.Query
@using FerretSharp.Core.Schema
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ShortcutService Shortcuts

<button class="btn ghost" title="@TextFormat.Format(SqlEditorText.LinqMenu_Title, Presentations.For(Details).EntityName)" @onclick="OpenAsync">C# ▾</button>

@if (_menu is { } menu)
{
    @* A PopoverMenu (Escape, focus, kept inside the window – review 3.31.0, A22). *@
    <PopoverMenu X="menu.X" Y="menu.Y" ViewportWidth="menu.Width" ViewportHeight="menu.Height" Width="MenuWidth" EstimatedHeight="90" OnClose="Close">
        <button class="menu-item" title="@SqlEditorText.LinqMenu_CopyTitle" @onclick="CopyAsync">@SqlEditorText.LinqMenu_Copy</button>
        <button class="menu-item" title="@(Shortcuts.Label(ShortcutAction.ApplyFilters) is { } key ? TextFormat.Format(SqlEditorText.LinqMenu_OpenConsoleTitleWithKey, key) : SqlEditorText.LinqMenu_OpenConsoleTitle)"
                @onclick="OpenConsole">@SqlEditorText.LinqMenu_OpenConsole</button>
    </PopoverMenu>
}

@code {
    [CascadingParameter]
    public PresentationService Presentations { get; set; } = null!;

    private const double MenuWidth = 220;

    private MenuAt? _menu;
    private bool _disposed;
    private DomModule? _dom;

    /// <summary>dom.js, imported on first use; does nothing once disposed (<see cref="DomModule"/>).</summary>
    private DomModule Dom => _dom ??= new(JS);

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [Parameter, EditorRequired]
    public TableDetails Details { get; set; } = null!;

    /// <summary>The filters to translate (as the SQL preview takes them: edited if valid, else applied).</summary>
    [Parameter, EditorRequired]
    public Func<IReadOnlyList<FilterCondition>> Filters { get; set; } = null!;

    private async Task OpenAsync(MouseEventArgs e)
    {
        var size = await Dom.InvokeAsync<double[]>("viewportSize");
        if (_disposed || size is not [var width, var height])
        {
            return;
        }

        _menu = new MenuAt(Math.Max(8, e.ClientX - MenuWidth + 40), e.ClientY + 14, width, height);
    }

    private void Close() => _menu = null;

    private sealed record MenuAt(double X, double Y, double Width, double Height);

    private ExportText Build(string? source = null)
    {
        var presentation = Presentations.For(Details);
        return LinqFilter.Build(presentation, Filters(), source is null ? null : LinqFilter.Source(presentation));
    }

    private async Task CopyAsync()
    {
        _menu = null;
        var linq = Build();
        if (linq.Text.Length == 0)
        {
            Shell.Notify(SqlEditorText.LinqMenu_NoFilters);
            return;
        }

        var copied = await Dom.CopyTextAsync(linq.Text);
        Shell.Notify(copied
            ? TextFormat.Plural(linq.Rows, SqlEditorText.LinqMenu_CopiedOne, SqlEditorText.LinqMenu_CopiedOther)
            : CommonText.ClipboardUnavailable, linq.Warnings);
    }

    private void OpenConsole()
    {
        _menu = null;
        var linq = Build(source: "db");
        Shell.OpenLinq(linq.Text);
        if (linq.Warnings.Count > 0)
        {
            Shell.Notify(TextFormat.Plural(linq.Rows, SqlEditorText.LinqMenu_AdoptedOne, SqlEditorText.LinqMenu_AdoptedOther), linq.Warnings);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await Dom.DisposeAsync();
    }
}
