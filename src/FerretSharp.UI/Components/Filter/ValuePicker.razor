@* Filter value of an enum or converted bool column (WP-12): pick members by their C# name; the filter gets their
   database values, so the SQL stays as before. "in" picks several (checkboxes), "=" and "≠" one. Values that are no
   member (typed before the model was loaded, from an FK jump) stay and can be removed. The field on top searches the
   list and takes a value the C# model does not know (ValuePickerItems). *@
@using FerretSharp.Core.ClrModel
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="valpick">
    <button type="button" class="field value valpick-field @(Selected.Count == 0 ? "valpick-unset" : "")" title="@Summary" @ref="_button"
            @onclick="Toggle" @onkeydown="OnKeyDown" @onkeydown:preventDefault="_open">
        <span class="valpick-text">@(Selected.Count == 0 ? (Multiple ? GridText.ValuePicker_ChooseValues : GridText.ValuePicker_ChooseValue) : Summary)</span>
        <span class="valpick-caret">@Icons.ChevronDown</span>
    </button>
    @if (_open)
    {
        <div class="popover-backdrop" @onclick="Close"></div>
        @* Escape with text clears the search (SearchBox) and goes no further; in the empty field it closes the list. *@
        <div class="popover valpick-pop" id="@_id" @onkeydown="OnKeyDown">
            <SearchBox @ref="_search" Class="popover-search ctx-filter valpick-search" Value="@_typed" ValueChanged="OnTyped"
                       Placeholder="@GridText.ValuePicker_Search" Title="@GridText.ValuePicker_SearchTitle" />
            <div class="valpick-list" role="listbox" aria-multiselectable="@(Multiple ? "true" : "false")">
                @for (var i = 0; i < _items.Count; i++)
                {
                    var item = _items[i];
                    var position = i;
                    var selected = Selected.Contains(item.Value);
                    <div id="@($"{_id}-{position}")" class="valpick-item @(position == _highlight ? "highlight" : "") @(selected ? "selected" : "") @(item.Unknown ? "unknown" : "")"
                         role="option" aria-selected="@(selected ? "true" : "false")"
                         @onmousedown="() => PickAsync(item)" @onmousedown:preventDefault="true" @onmouseenter="() => _highlight = position">
                        @if (Multiple)
                        {
                            <input type="checkbox" tabindex="-1" checked="@selected" />
                        }
                        <span class="valpick-name">@item.Name</span>
                        <span class="valpick-db">@item.Detail</span>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private IReadOnlyList<ValuePickerItem> _items = [];
    private bool _open;
    private int _highlight;
    private string _typed = "";
    private ElementReference _button;
    private SearchBox? _search;
    private readonly string _id = "valpick-" + Guid.NewGuid().ToString("N");
    private DomModule? _dom;
    private bool _focusSearch;
    private bool _focusButton;
    private bool _scrollToHighlight;

    private DomModule Dom => _dom ??= new(JS);

    [Parameter, EditorRequired]
    public ValueTable Values { get; set; } = null!;

    /// <summary>The filter text: one database value, or several separated by <see cref="FilterRow.ListSeparator"/>.</summary>
    [Parameter, EditorRequired]
    public string Value { get; set; } = "";

    /// <summary>"in": several values.</summary>
    [Parameter]
    public bool Multiple { get; set; }

    [Parameter]
    public EventCallback<string> OnChange { get; set; }

    /// <summary>The selected values as option values (normalized: "2,0" becomes "2").</summary>
    private List<string> Selected => Value
        .Split(FilterRow.ListSeparator, StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
        .Select(v => Values.FindOption(v)?.Value ?? v)
        .Distinct(StringComparer.Ordinal)
        .Take(Multiple ? int.MaxValue : 1)
        .ToList();

    private string Summary => string.Join(", ", Selected.Select(v => Values.Options.FirstOrDefault(o => o.Value == v)?.Name ?? v));

    protected override void OnParametersSet() => _items = ValuePickerItems.Of(Values, Selected, _typed);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusSearch && _search is not null)
        {
            _focusSearch = false;
            await _search.FocusAsync();
            await Dom.InvokeVoidAsync("arrowsMoveList", _id);
        }
        else if (_scrollToHighlight)
        {
            // ↑ ↓ beyond the visible part of the list (review 3.54.0, A25): Enter took an entry nobody saw.
            _scrollToHighlight = false;
            await Dom.InvokeVoidAsync("scrollIntoViewById", $"{_id}-{_highlight}");
        }
        else if (_focusButton)
        {
            _focusButton = false;
            await _button.FocusAsync();
        }
    }

    private void Toggle()
    {
        if (_open)
        {
            Close();
            return;
        }

        _open = true;
        _focusSearch = true;
        Type("");
        var first = Selected.FirstOrDefault();
        _highlight = Math.Max(0, _items.ToList().FindIndex(i => i.Value == first));
    }

    private void Close() => _open = false;

    /// <summary>Closed from the keyboard: the button gets the focus back, the search field it was in is gone.</summary>
    private void CloseToButton()
    {
        Close();
        _focusButton = true;
    }

    private void OnTyped(string text)
    {
        Type(text);
        _highlight = 0;
    }

    private void Type(string text)
    {
        _typed = text;
        _items = ValuePickerItems.Of(Values, Selected, _typed);
    }

    private async Task PickAsync(ValuePickerItem item)
    {
        List<string> values;
        if (Multiple)
        {
            values = Selected;
            if (!values.Remove(item.Value))
            {
                values.Add(item.Value);
            }

            // Keep the members' order, values without a member last.
            values = [.. Values.Options.Select(o => o.Value).Where(values.Contains), .. values.Where(v => Values.Options.All(o => o.Value != v))];
            // The list as it will be with the new values: a typed value stays highlighted where it now stands.
            _typed = "";
            _items = ValuePickerItems.Of(Values, values, _typed);
            _highlight = Math.Max(0, _items.ToList().FindIndex(i => i.Value == item.Value));
        }
        else
        {
            values = [item.Value];
            CloseToButton();
        }

        await OnChange.InvokeAsync(string.Join(FilterRow.ListSeparator + " ", values));
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (!_open)
        {
            // Enter and Space click the button anyway.
            if (e.Key == "ArrowDown")
            {
                Toggle();
            }

            return;
        }

        switch (e.Key)
        {
            case "ArrowDown":
                _highlight = Math.Min(_highlight + 1, _items.Count - 1);
                _scrollToHighlight = true;
                break;
            case "ArrowUp":
                _highlight = Math.Max(_highlight - 1, 0);
                _scrollToHighlight = true;
                break;
            case "Enter" when _items.Count > 0:
                // "in" stays open to pick more; Esc closes.
                await PickAsync(_items[Math.Min(_highlight, _items.Count - 1)]);
                break;
            case "Escape":
                CloseToButton();
                break;
            case "Tab":
                Close();
                break;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_dom is not null)
        {
            await _dom.DisposeAsync();
        }
    }
}
