@using FerretSharp.Core.Connections
@using FerretSharp.UI.State
@implements IDisposable
@inject ConnectionManager Connections
@inject ActiveConnection Active
@inject RecentConnections Recent

<div class="connections-page">
    <div class="page-head">
        <h1>Verbindungen <span class="count">@Connections.Profiles.Count</span></h1>
        <div class="search grow">
            @Icons.Search
            <input placeholder="Suchen nach Name, Gruppe, Host, Benutzer …" @bind="_query" @bind:event="oninput" />
        </div>
        <button class="btn primary" @onclick="Shell.NewConnection"><span class="plus">+</span> Neue Verbindung</button>
    </div>

    @if (Connections.Profiles.Count == 0)
    {
        <EmptyState Title="Willkommen bei FerretSharp" Text="Lege zuerst eine Oracle-Verbindung an.">
            <button class="btn primary" @onclick="Shell.NewConnection">Verbindung hinzufügen</button>
        </EmptyState>
    }
    else
    {
        var groups = ConnectionSearch.Group(Connections.Profiles, _query);
        @if (groups.Count == 0)
        {
            <div class="page-hint">Keine Verbindung passt zu „@_query“.</div>
        }

        <div class="conn-table">
            @foreach (var group in groups)
            {
                var key = group.Name ?? "";
                var collapsed = string.IsNullOrWhiteSpace(_query) && _collapsed.Contains(key);
                <section class="conn-group">
                    <button class="group-head-btn" @onclick="() => ToggleGroup(key)">
                        <span class="chev @(collapsed ? "closed" : "")">▾</span>
                        <span>@(group.Name ?? "Ohne Gruppe")</span>
                        <span class="count">@group.Profiles.Count</span>
                    </button>

                    @if (!collapsed)
                    {
                        foreach (var profile in group.Profiles)
                        {
                            var p = profile;
                            <div class="conn-line @ConnectionKindInfo.CssClass(p.Kind)" title="Doppelklick zum Verbinden"
                                 @ondblclick="() => Shell.Connect(p)">
                                <span class="dot"></span>
                                <span class="name">
                                    @p.Name
                                    @if (Active.Profile?.Id == p.Id && Active.IsConnected)
                                    {
                                        <span class="connected-tag">verbunden</span>
                                    }
                                </span>
                                <span class="kind-badge">@ConnectionKindInfo.Short(p.Kind)</span>
                                <span class="addr">@p.Address.Display@(p.Address is TnsAliasAddress ? " (TNS)" : "")</span>
                                <span class="user">@p.User@(p.DefaultSchema is { } schema ? $" → {schema}" : "")</span>
                                <span class="last-used">@LastUsedText(p)</span>
                                <ConnectionActionsMenu Profile="p" />
                            </div>
                        }
                    }
                </section>
            }
        </div>
    }
</div>

@code {
    private readonly HashSet<string> _collapsed = [];
    private string _query = "";

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    protected override void OnInitialized()
    {
        Connections.Changed += OnConnectionsChanged;
        Active.Changed += OnConnectionsChanged;
    }

    private string LastUsedText(ConnectionProfile profile)
    {
        if (!Recent.LastUsed.TryGetValue(profile.Id, out var lastUsed))
        {
            return "";
        }

        var local = lastUsed.ToLocalTime();
        var days = (DateTime.Today - local.Date).Days;
        return days switch
        {
            0 => $"heute {local:HH:mm}",
            1 => $"gestern {local:HH:mm}",
            < 7 => $"vor {days} Tagen",
            _ => local.ToString("dd.MM.yyyy", CultureInfo.CurrentCulture),
        };
    }

    private void ToggleGroup(string key)
    {
        if (!_collapsed.Remove(key))
        {
            _collapsed.Add(key);
        }
    }

    private void OnConnectionsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Connections.Changed -= OnConnectionsChanged;
        Active.Changed -= OnConnectionsChanged;
    }
}
