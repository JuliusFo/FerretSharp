@* Both directions of ALL_DEPENDENCIES for the "Dependencies" views of tables and PL/SQL units: tables, views and
   PL/SQL units the schema knows (own or through a synonym) are links. *@
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Schema

<section>
    <h2>@SchemaViewText.Dependencies_Uses <span class="count">@Dependencies.Uses.Count</span></h2>
    @if (Dependencies.Uses.Count == 0)
    {
        <p class="muted">@(NoUses ?? SchemaViewText.Dependencies_NoneFound)</p>
    }
    @foreach (var d in Dependencies.Uses)
    {
        @Row(d)
    }
</section>

<section>
    <h2>@SchemaViewText.Dependencies_UsedBy <span class="count">@Dependencies.UsedBy.Count</span></h2>
    @if (Dependencies.UsedBy.Count == 0)
    {
        <p class="muted">@TextFormat.Format(SchemaViewText.Dependencies_NoUsedBy, Subject)</p>
    }
    @foreach (var d in Dependencies.UsedBy)
    {
        @Row(d)
    }
</section>

<p class="muted">@(Active.Profile?.User is { } user ? TextFormat.Format(SchemaViewText.Dependencies_OnlyAccessibleTo, user) : SchemaViewText.Dependencies_OnlyAccessible)</p>

@code {
    [CascadingParameter]
    public ActiveConnection Active { get; set; } = null!;

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [Parameter, EditorRequired]
    public ObjectDependencies Dependencies { get; set; } = null!;

    /// <summary>Owner of the object shown: names of the same schema go without owner.</summary>
    [Parameter, EditorRequired]
    public string Owner { get; set; } = "";

    /// <summary>The name of the object shown ("Kein Objekt verwendet …").</summary>
    [Parameter, EditorRequired]
    public string Subject { get; set; } = "";

    /// <summary>Shown when the object uses nothing; null for “no dependencies found”.</summary>
    [Parameter]
    public string? NoUses { get; set; }

    private RenderFragment Row(DependencyInfo d) =>
        @<div class="relation dependency">
            <span class="chip">@d.Type</span>
            @if (IsTable(d) && Active.Schema?.Find(new TableRef(d.Owner, d.Name)) is not null)
            {
                <TableLink Target="new TableRef(d.Owner, d.Name)" />
            }
            else if (Active.Schema?.FindPlSql(d.Owner, d.Name, d.Type) is { } unit)
            {
                <button class="link" title="@PlSqlTitle(unit, d.Type)" @onclick="() => OpenPlSql(unit, d.Type)">@PlSqlLabel(unit)</button>
            }
            else
            {
                <span class="mono">@(d.Owner == Owner ? d.Name : $"{d.Owner}.{d.Name}")</span>
            }
            @if (d.IsInvalid)
            {
                <span class="chip invalid" title="@InvalidStatusText.For(d.Type)">@SchemaViewText.InvalidChip</span>
            }
        </div>;

    private static bool IsTable(DependencyInfo d) => d.Type is "TABLE" or "VIEW" or "MATERIALIZED VIEW";

    /// <summary>A package body opens the body view, everything else the source (a package: its specification).</summary>
    private void OpenPlSql(PlSqlObjectSummary unit, string objectType) =>
        Shell.OpenPlSql(unit, PlSqlKinds.Of(objectType) is { Part: PlSqlPart.Body } ? PlSqlView.Body : PlSqlView.Source);

    private string PlSqlLabel(PlSqlObjectSummary unit) =>
        unit.Synonym is not null || unit.Owner == Active.Schema?.Owner ? unit.DisplayName : unit.Ref.ToString();

    private static string PlSqlTitle(PlSqlObjectSummary unit, string objectType) =>
        (objectType == "PACKAGE BODY", unit.Synonym) switch
        {
            (true, { } synonym) => TextFormat.Format(SchemaViewText.Dependencies_ShowBodyViaSynonym, synonym.Name, unit.Ref),
            (false, { } synonym) => TextFormat.Format(SchemaViewText.Dependencies_ShowSourceViaSynonym, synonym.Name, unit.Ref),
            (true, null) => SchemaViewText.Dependencies_ShowBody,
            (false, null) => SchemaViewText.Dependencies_ShowSource,
        };
}
