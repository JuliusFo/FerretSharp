@* Vertical A–Z (+ #) index; letters without entries are disabled. *@

<nav class="letters" aria-label="Buchstabenindex">
    @foreach (var letter in Letters)
    {
        var l = letter;
        <button disabled="@(!Available.Contains(l))" title="@Title(l)" @onclick="() => OnJump.InvokeAsync(l)">@l</button>
    }
</nav>

@code {
    /// <summary>Group key for names that do not start with A–Z (quoted identifiers like "1_Import" or "Übersicht").</summary>
    public const char Other = ExplorerList.Other;

    private static readonly char[] Letters = [.. Enumerable.Range('A', 26).Select(c => (char)c), Other];

    [Parameter, EditorRequired]
    public IReadOnlySet<char> Available { get; set; } = new HashSet<char>();

    [Parameter]
    public EventCallback<char> OnJump { get; set; }

    public static char KeyOf(string name) => ExplorerList.KeyOf(name);

    private static string Title(char letter) => letter == Other ? "Sonstige (Sonderzeichen, Ziffern, Kleinbuchstaben)" : letter.ToString();
}
