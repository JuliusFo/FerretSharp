@* "Constraints" view: primary/unique/foreign keys and checks with their state, the row key and the incoming foreign keys. *@
@using FerretSharp.Core.Query
@using FerretSharp.Core.Schema
@inherits DetailViewBase<IReadOnlyList<ConstraintInfo>>

<DetailStatus Loading="Loading && Data is null" Error="Error" Text="@SchemaViewText.Constraints_Loading" />

@if (Data is { } all)
{
    var shown = all.Where(c => !c.IsColumnNotNull).ToList();
    var notNull = all.Count - shown.Count;
    <section>
        <h2>@SchemaViewText.Constraints_Heading <span class="count">@shown.Count</span></h2>
        @if (shown.Count == 0)
        {
            <p class="muted">@SchemaViewText.Constraints_None</p>
        }
        else
        {
            <table class="columns constraints">
                <thead>
                    <tr><th>@SchemaViewText.Constraints_Type</th><th>@SchemaViewText.Head_Name</th><th>@SchemaViewText.Head_Columns</th><th>@SchemaViewText.Constraints_ConditionOrTarget</th><th>@SchemaViewText.Head_Status</th></tr>
                </thead>
                <tbody>
                    @foreach (var c in shown)
                    {
                        <tr class="@(c.Enabled ? "" : "disabled")">
                            <td><span class="con-type @TypeClass(c.Type)">@TypeLabel(c.Type)</span></td>
                            <td class="mono @(c.GeneratedName ? "generated" : "")" title="@(c.GeneratedName ? SchemaViewText.Constraints_GeneratedName : null)">@c.Name</td>
                            <td class="mono">@string.Join(", ", c.Columns)</td>
                            <td>
                                @if (c.References is { } target)
                                {
                                    <span class="arrow">→</span>
                                    <TableLink Target="target" />
                                    <span class="mono">(@string.Join(", ", c.ReferencedColumns))</span>
                                    @if (c.DeleteRule is { } rule && rule != "NO ACTION")
                                    {
                                        <span class="muted"> · ON DELETE @rule</span>
                                    }
                                }
                                else if (c.Condition is { } condition)
                                {
                                    <code class="condition">@condition</code>
                                }
                            </td>
                            <td class="state">@State(c)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        @if (notNull > 0)
        {
            <p class="muted">@TextFormat.Plural(notNull, SchemaViewText.Constraints_NotNullOne, SchemaViewText.Constraints_NotNullOther)</p>
        }
        <p class="muted">@TextFormat.Format(SchemaViewText.Constraints_RowKey, RowKeyText)</p>
    </section>
}

<section>
    <h2>@SchemaViewText.Constraints_ReferencedBy <span class="count">@Incoming.Count</span></h2>
    @if (Incoming.Count == 0)
    {
        <p class="muted">@SchemaViewText.Constraints_NoIncoming</p>
    }
    @foreach (var fk in Incoming)
    {
        <div class="relation">
            <TableLink Target="fk.From" />
            <span class="mono">(@string.Join(", ", fk.FromColumns))</span>
            <span class="arrow">→</span>
            <span class="mono">(@string.Join(", ", fk.ToColumns))</span>
            <span class="muted constraint">@fk.Name</span>
        </div>
    }
</section>

@if (ModelOutgoing.Count + ModelIncoming.Count > 0)
{
    <section>
        <h2>@SchemaViewText.Constraints_ModelRelations <span class="count">@(ModelOutgoing.Count + ModelIncoming.Count)</span></h2>
        <p class="muted">@SchemaViewText.Constraints_ModelRelationsHint</p>
        @foreach (var fk in ModelOutgoing)
        {
            <div class="relation">
                <span class="mono">(@string.Join(", ", fk.FromColumns))</span>
                <span class="arrow">→</span>
                <TableLink Target="fk.To" />
                <span class="mono">(@string.Join(", ", fk.ToColumns))</span>
                <span class="muted constraint">@fk.Name</span>
            </div>
        }
        @foreach (var fk in ModelIncoming)
        {
            <div class="relation">
                <TableLink Target="fk.From" />
                <span class="mono">(@string.Join(", ", fk.FromColumns))</span>
                <span class="arrow">→</span>
                <span class="mono">(@string.Join(", ", fk.ToColumns))</span>
                <span class="muted constraint">@fk.Name</span>
            </div>
        }
    </section>
}

@code {
    private IReadOnlyList<ForeignKeyInfo> Incoming =>
        Active.Schema?.IncomingOf(Table.Ref).Where(f => f.Source != FkSource.ClrModel).ToList() ?? [];

    private IReadOnlyList<ForeignKeyInfo> ModelOutgoing =>
        Active.Schema?.OutgoingOf(Table.Ref).Where(f => f.Source == FkSource.ClrModel).ToList() ?? [];

    private IReadOnlyList<ForeignKeyInfo> ModelIncoming =>
        Active.Schema?.IncomingOf(Table.Ref).Where(f => f.Source == FkSource.ClrModel).ToList() ?? [];

    /// <summary>How rows of this object will be identified (docs/architecture.md 1.5): PK, otherwise ROWID, views without PK: none.</summary>
    private string RowKeyText => QueryBuilder.RowKeyOf(Details) switch
    {
        RowKeyKind.PrimaryKey => TextFormat.Format(SchemaViewText.Constraints_RowKeyPrimary, string.Join(", ", Details.PrimaryKey)),
        RowKeyKind.RowId => Details.IsIndexOrganized ? "UROWID" : "ROWID",
        _ => SchemaViewText.Constraints_RowKeyNone,
    };

    private static string TypeLabel(ConstraintType type) => type switch
    {
        ConstraintType.PrimaryKey => "PRIMARY KEY",
        ConstraintType.Unique => "UNIQUE",
        ConstraintType.ForeignKey => "FOREIGN KEY",
        ConstraintType.Check => "CHECK",
        ConstraintType.ViewCheckOption => "CHECK OPTION",
        ConstraintType.ViewReadOnly => "READ ONLY",
        _ => SchemaViewText.Constraints_TypeOther,
    };

    private static string TypeClass(ConstraintType type) => type switch
    {
        ConstraintType.PrimaryKey => "pk",
        ConstraintType.Unique => "uk",
        ConstraintType.ForeignKey => "fk",
        _ => "",
    };

    private static string State(ConstraintInfo c) => string.Join(" · ", new[]
    {
        c.Enabled ? SchemaViewText.Constraints_Enabled : SchemaViewText.Constraints_Disabled,
        c.Enabled && !c.Validated ? SchemaViewText.Constraints_NotValidated : null,
        c.Deferrable ? (c.InitiallyDeferred ? "deferrable, deferred" : "deferrable") : null,
    }.OfType<string>());

    protected override Task<IReadOnlyList<ConstraintInfo>> LoadAsync(SchemaCache schema, CancellationToken cancellationToken) =>
        schema.GetConstraintsAsync(Table.Ref, cancellationToken);
}
