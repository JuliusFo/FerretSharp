@* A Monaco editor (ADR 0011): C# in the LINQ console (markers show Roslyn's diagnostics), SQL in the SQL editor; both
   with completion from .NET. The text belongs to the parent: changes come back through OnChange, SetTextAsync replaces it. *@
@using FerretSharp.Core.ClrModel
@implements IAsyncDisposable
@inject IJSRuntime JS

<div id="@_id" class="monaco-host @Class"></div>

@code {
    private readonly string _id = "monaco-" + Guid.NewGuid().ToString("N");
    private IJSObjectReference? _module;
    private DotNetObjectReference<MonacoEditor>? _selfRef;
    private IReadOnlyList<LinqDiagnostic>? _shownMarkers;

    /// <summary>Set first thing in <see cref="DisposeAsync"/>; a start or a call still waiting then does nothing more.</summary>
    private bool _disposed;

    /// <summary>Text when the editor is created; afterwards the editor owns it.</summary>
    [Parameter]
    public string Text { get; set; } = "";

    [Parameter]
    public EventCallback<string> OnChange { get; set; }

    /// <summary>No line numbers, no folding: for the few lines of variables.</summary>
    [Parameter]
    public bool Minimal { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public string? Class { get; set; }

    /// <summary>Diagnostics of this editor's section.</summary>
    [Parameter]
    public IReadOnlyList<LinqDiagnostic> Markers { get; set; } = [];

    /// <summary>Monaco language id: <c>csharp</c> or <c>sql</c>.</summary>
    [Parameter]
    public string Language { get; set; } = "csharp";

    /// <summary>Completion items for (text, cursor offset); null = no completion from .NET.</summary>
    [Parameter]
    public Func<string, int, Task<IReadOnlyList<CompletionItem>>>? Completion { get; set; }

    /// <param name="Kind">Picks the icon: SQL (<c>Table</c>, <c>Column</c> …) or C# (<c>Property</c>, <c>ExtensionMethod</c> …).</param>
    /// <param name="Rank">Lower comes first; Monaco still ranks by how well an item matches what was typed.</param>
    public sealed record CompletionItem(string Label, string InsertText, string Kind, string? Detail, int Rank);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/FerretSharp.UI/js/monaco.js");
            if (_disposed)
            {
                await QuietlyAsync(() => module.DisposeAsync().AsTask()); // tab closed while the module loaded
                return;
            }

            _module = module;
            await CallAsync("create", _id, _selfRef, Text,
                new { language = Language, minimal = Minimal, placeholder = Placeholder, completion = Completion is not null });
        }

        if (_module is not null && !ReferenceEquals(_shownMarkers, Markers))
        {
            _shownMarkers = Markers;
            await CallAsync("setMarkers", _id, Markers.Select(m => new
            {
                line = m.Line, column = m.Column, endLine = m.EndLine, endColumn = m.EndColumn, severity = m.Severity, message = $"{m.Id}: {m.Message}",
            }));
        }
    }

    /// <summary>
    /// Every call into monaco.js: nothing once the editor is disposed. The parent often calls after a long wait (a
    /// statement that ran for minutes) – by then the tab may be closed, and the call must not fail the closed tab.
    /// </summary>
    private Task CallAsync(string identifier, params object?[] args) =>
        _disposed || _module is not { } module ? Task.CompletedTask : QuietlyAsync(() => module.InvokeVoidAsync(identifier, args).AsTask());

    private async Task<T?> CallAsync<T>(string identifier, params object?[] args)
    {
        var result = default(T);
        if (!_disposed && _module is { } module)
        {
            await QuietlyAsync(async () => result = await module.InvokeAsync<T>(identifier, args));
        }

        return result;
    }

    /// <summary>Runs a JS call; failures because the editor or the page went away meanwhile are no error.</summary>
    private async Task QuietlyAsync(Func<Task> call)
    {
        try
        {
            await call();
        }
        catch (Exception ex) when (ex is JSDisconnectedException || (_disposed && ex is ObjectDisposedException or JSException))
        {
        }
    }

    [JSInvokable]
    public Task OnTextChanged(string elementId, string text) => OnChange.InvokeAsync(text);

    /// <summary>Monaco's completion provider asks; the kind goes as text (Table, Column …) for the icon.</summary>
    [JSInvokable]
    public async Task<object[]> OnComplete(string elementId, string text, int offset)
    {
        if (Completion is null)
        {
            return [];
        }

        var items = await Completion(text, offset);
        return items.Select(i => (object)new { label = i.Label, insertText = i.InsertText, kind = i.Kind, detail = i.Detail, rank = i.Rank }).ToArray();
    }

    /// <summary>The text with selection start and end (equal without a selection) as offsets; null if the editor is gone.</summary>
    public Task<EditorRunContext?> GetRunContextAsync() => CallAsync<EditorRunContext?>("getRunContext", _id);

    /// <summary>Briefly highlights a range (the statement that runs).</summary>
    public Task FlashAsync(int start, int length) => CallAsync("flash", _id, start, length);

    /// <summary>Marks ranges by text offset (SQL errors); an empty list clears them.</summary>
    public Task SetOffsetMarkersAsync(IEnumerable<EditorMarker> markers) =>
        CallAsync("setOffsetMarkers", _id, markers.Select(m => new { start = m.Start, length = m.Length, severity = m.Severity, message = m.Message }));

    public Task RevealOffsetAsync(int offset) => CallAsync("revealOffset", _id, offset);

    public sealed record EditorRunContext(string Text, int Start, int End);

    public sealed record EditorMarker(int Start, int Length, string Severity, string Message);

    public Task SetTextAsync(string text) => CallAsync("setText", _id, text);

    /// <summary>The current text, also what the debounce has not reported yet (run right after typing).</summary>
    public Task<string?> GetTextAsync() => CallAsync<string?>("getText", _id);

    public Task RevealAsync(int line, int column) => CallAsync("reveal", _id, line, column);

    public Task FindAsync() => CallAsync("find", _id);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is { } module)
        {
            await QuietlyAsync(async () =>
            {
                await module.InvokeVoidAsync("destroy", _id);
                await module.DisposeAsync();
            });
        }

        _selfRef?.Dispose();
    }
}
