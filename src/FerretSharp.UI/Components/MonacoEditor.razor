@* A Monaco editor (ADR 0011): C# in the LINQ console (markers show Roslyn's diagnostics), SQL in the SQL editor; both
   with completion from .NET. The text belongs to the parent: changes come back through OnChange, SetTextAsync replaces it. *@
@using FerretSharp.Core.ClrModel
@implements IAsyncDisposable
@inject IJSRuntime JS

<div id="@_id" class="monaco-host @Class"></div>

@code {
    private readonly string _id = "monaco-" + Guid.NewGuid().ToString("N");
    private IJSObjectReference? _module;
    private DotNetObjectReference<MonacoEditor>? _selfRef;
    private IReadOnlyList<LinqDiagnostic>? _shownMarkers;

    /// <summary>Text when the editor is created; afterwards the editor owns it.</summary>
    [Parameter]
    public string Text { get; set; } = "";

    [Parameter]
    public EventCallback<string> OnChange { get; set; }

    /// <summary>No line numbers, no folding: for the few lines of variables.</summary>
    [Parameter]
    public bool Minimal { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public string? Class { get; set; }

    /// <summary>Diagnostics of this editor's section.</summary>
    [Parameter]
    public IReadOnlyList<LinqDiagnostic> Markers { get; set; } = [];

    /// <summary>Monaco language id: <c>csharp</c> or <c>sql</c>.</summary>
    [Parameter]
    public string Language { get; set; } = "csharp";

    /// <summary>Completion items for (text, cursor offset); null = no completion from .NET.</summary>
    [Parameter]
    public Func<string, int, Task<IReadOnlyList<CompletionItem>>>? Completion { get; set; }

    /// <param name="Kind">Picks the icon: SQL (<c>Table</c>, <c>Column</c> …) or C# (<c>Property</c>, <c>ExtensionMethod</c> …).</param>
    /// <param name="Rank">Lower comes first; Monaco still ranks by how well an item matches what was typed.</param>
    public sealed record CompletionItem(string Label, string InsertText, string Kind, string? Detail, int Rank);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/FerretSharp.UI/js/monaco.js");
            await _module.InvokeVoidAsync("create", _id, _selfRef, Text,
                new { language = Language, minimal = Minimal, placeholder = Placeholder, completion = Completion is not null });
        }

        if (_module is not null && !ReferenceEquals(_shownMarkers, Markers))
        {
            _shownMarkers = Markers;
            await _module.InvokeVoidAsync("setMarkers", _id, Markers.Select(m => new
            {
                line = m.Line, column = m.Column, endLine = m.EndLine, endColumn = m.EndColumn, severity = m.Severity, message = $"{m.Id}: {m.Message}",
            }));
        }
    }

    [JSInvokable]
    public Task OnTextChanged(string elementId, string text) => OnChange.InvokeAsync(text);

    /// <summary>Monaco's completion provider asks; the kind goes as text (Table, Column …) for the icon.</summary>
    [JSInvokable]
    public async Task<object[]> OnComplete(string elementId, string text, int offset)
    {
        if (Completion is null)
        {
            return [];
        }

        var items = await Completion(text, offset);
        return items.Select(i => (object)new { label = i.Label, insertText = i.InsertText, kind = i.Kind, detail = i.Detail, rank = i.Rank }).ToArray();
    }

    /// <summary>The text with selection start and end (equal without a selection) as offsets.</summary>
    public async Task<EditorRunContext?> GetRunContextAsync() =>
        _module is null ? null : await _module.InvokeAsync<EditorRunContext?>("getRunContext", _id);

    /// <summary>Briefly highlights a range (the statement that runs).</summary>
    public async Task FlashAsync(int start, int length)
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("flash", _id, start, length);
        }
    }

    /// <summary>Marks ranges by text offset (SQL errors); an empty list clears them.</summary>
    public async Task SetOffsetMarkersAsync(IEnumerable<EditorMarker> markers)
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("setOffsetMarkers", _id,
                markers.Select(m => new { start = m.Start, length = m.Length, severity = m.Severity, message = m.Message }));
        }
    }

    public async Task RevealOffsetAsync(int offset)
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("revealOffset", _id, offset);
        }
    }

    public sealed record EditorRunContext(string Text, int Start, int End);

    public sealed record EditorMarker(int Start, int Length, string Severity, string Message);

    public async Task SetTextAsync(string text)
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("setText", _id, text);
        }
    }

    /// <summary>The current text, also what the debounce has not reported yet (run right after typing).</summary>
    public async Task<string?> GetTextAsync() => _module is null ? null : await _module.InvokeAsync<string?>("getText", _id);

    public async Task RevealAsync(int line, int column)
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("reveal", _id, line, column);
        }
    }

    public async Task FindAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("find", _id);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("destroy", _id);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _selfRef?.Dispose();
    }
}
