@* Unlock one workspace of a read-only profile for writing (WP-10). On Prod the user types the connection's name
   (the user's decision), elsewhere a plain confirmation is enough. *@
@using FerretSharp.Core.Connections

<ModalFrame Label="@ShellText.Unlock_Title" Class="confirm unlock-dialog" Alert="true" OnCancel="OnCancel">
    <header><span>@ShellText.Unlock_Title</span></header>
    <div class="dialog-body">
        <p>
            <Fmt Text="@ShellText.Unlock_Question"><Arg0><strong>@WorkspaceName</strong></Arg0><Arg1><strong>@Profile.Name</strong></Arg1></Fmt>
        </p>
        <ul class="unlock-facts">
            <li><Fmt Text="@(IsProd ? ShellText.Unlock_CommitFactProd : ShellText.Unlock_CommitFact)"><Arg0><strong>Commit</strong></Arg0></Fmt></li>
            <li>@ShellText.Unlock_OthersStayLocked</li>
            <li>@ShellText.Unlock_LockedAgainWhen</li>
        </ul>
        @if (IsProd)
        {
            <label class="unlock-confirm">
                <Fmt Text="@ShellText.Unlock_TypeName"><Arg0><strong>@Profile.Name</strong></Arg0></Fmt>
                <input @ref="_input" class="field" spellcheck="false" autocomplete="off" @bind="_typed" @bind:event="oninput"
                       @onkeydown="OnInputKeyDown" aria-label="@ShellText.Unlock_NameLabel" />
            </label>
        }
    </div>
    <footer>
        <span class="spacer"></span>
        <button class="btn ghost" @ref="_cancelButton" @onclick="OnCancel">@CommonText.Cancel</button>
        <button class="btn danger-solid" disabled="@(!Confirmed)" @onclick="ConfirmAsync">@ShellText.Unlock_Unlock</button>
    </footer>
</ModalFrame>

@code {
    private ElementReference _input;
    private ElementReference _cancelButton;
    private string _typed = "";

    [Parameter, EditorRequired]
    public ConnectionProfile Profile { get; set; } = null!;

    [Parameter, EditorRequired]
    public string WorkspaceName { get; set; } = "";

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private bool IsProd => Profile.Kind == ConnectionKind.Prod;

    /// <summary>Exactly the name (surrounding blanks do not count), like GitHub's "type the repository name".</summary>
    private bool Confirmed => !IsProd || _typed.Trim() == Profile.Name.Trim();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Prod: straight into the name field; otherwise the safe option, so Enter does not unlock by accident.
            await (IsProd ? _input : _cancelButton).FocusAsync();
        }
    }

    private async Task ConfirmAsync()
    {
        if (Confirmed)
        {
            await OnConfirm.InvokeAsync();
        }
    }

    private async Task OnInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ConfirmAsync();
        }
    }
}
