@* "Dependencies" of a PL/SQL unit (WP-28): what it uses (a package: specification and body) and what uses it. *@
@using FerretSharp.Core.Schema
@inherits PlSqlViewBase<ObjectDependencies>

<DetailStatus Loading="Loading && Data is null" Error="Error" Text="@SchemaViewText.Dependencies_Loading" />

@if (Data is { } dependencies)
{
    <DependencyList Dependencies="dependencies" Owner="@Unit.Owner" Subject="@Unit.DisplayName" />
}

@code {
    protected override Task<ObjectDependencies> LoadAsync(SchemaCache schema, CancellationToken cancellationToken) =>
        schema.GetDependenciesAsync(Unit, cancellationToken);
}
