@* Right-click menu of a column header: pin the column to the left or release it. *@
@using FerretSharp.Core.Schema
@using FerretSharp.UI.State
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="popover-backdrop" @onclick="CloseAsync" @oncontextmenu="CloseAsync" @oncontextmenu:preventDefault="true"></div>
<div id="@_id" class="popover ctx-menu" style="@Position" tabindex="-1" @onkeydown="OnKeyDown" @oncontextmenu:preventDefault="true">
    <div class="ctx-head">
        <span class="ctx-col">@Column.Name</span>
        <span class="ctx-value">@Column.DisplayType</span>
    </div>
    @if (Details.PrimaryKey.Contains(Column.Name))
    {
        <button class="menu-item" disabled title="Der Primärschlüssel steht immer vorne">Angeheftet (Primärschlüssel)</button>
    }
    else
    {
        <button class="menu-item" @onclick="ToggleAsync">@(Pinned ? "Spalte lösen" : "Spalte links anheften")</button>
    }
</div>

@code {
    private const double MenuWidth = 280;
    private const double MenuHeight = 90;

    private readonly string _id = "colmenu-" + Guid.NewGuid().ToString("N");
    private IJSObjectReference? _dom;

    [Parameter, EditorRequired]
    public ColumnMenuRequest Request { get; set; } = null!;

    [Parameter, EditorRequired]
    public TableDetails Details { get; set; } = null!;

    /// <summary>Whether the column is currently pinned.</summary>
    [Parameter]
    public bool Pinned { get; set; }

    [Parameter]
    public EventCallback<int> OnTogglePin { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private ColumnInfo Column => Details.Columns[Request.Column];

    /// <summary>At the mouse position, kept inside the window.</summary>
    private string Position
    {
        get
        {
            var left = Math.Max(8, Math.Min(Request.X, Request.ViewportWidth - MenuWidth - 8));
            var top = Math.Max(8, Math.Min(Request.Y, Request.ViewportHeight - MenuHeight - 8));
            return FormattableString.Invariant($"position: fixed; left: {left:0}px; top: {top:0}px; width: {MenuWidth:0}px;");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dom = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/FerretSharp.UI/js/dom.js");
            await _dom.InvokeVoidAsync("focusById", _id); // Escape closes
        }
    }

    private async Task ToggleAsync()
    {
        await OnClose.InvokeAsync();
        await OnTogglePin.InvokeAsync(Request.Column);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CloseAsync();
        }
    }

    private Task CloseAsync() => OnClose.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        if (_dom is not null)
        {
            try
            {
                await _dom.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
