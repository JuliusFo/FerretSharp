@* Right-click menu of a grid cell: copy the value, jump along foreign keys from the selected rows (outgoing and incoming with counts). *@
@using FerretSharp.Core.ClrModel
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Data
@using FerretSharp.Core.Forms
@using FerretSharp.Core.Oracle
@using FerretSharp.Core.Query
@using FerretSharp.Core.Schema
@inherits FerretComponent
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IFileSaveService Files
@inject ILogger<GridContextMenu> Logger

<PopoverMenu X="Request.X" Y="Request.Y" ViewportWidth="Request.ViewportWidth" ViewportHeight="Request.ViewportHeight"
             Width="MenuWidth" EstimatedHeight="EstimatedHeight" OnClose="CloseAsync">
    <div class="ctx-head">
        <span class="ctx-col">@Column.Name</span>
        <span class="ctx-value @(Request.CellText is null ? "fs-null" : "")">@(Request.CellText ?? "NULL")</span>
    </div>
    <button class="menu-item" disabled="@(Request.CellText is null)" @onclick="() => Export.CopyValueAsync(Column, Request.Row.Values[Request.Column])">Wert kopieren</button>
    @if (_cell is { } cell)
    {
        <button class="menu-item" disabled="@(cell.Code is null)" title="@(cell.Problem ?? cell.Code)" @onclick="() => Export.CopyTextAsync(cell.Code!)">
            Als C#-Wert kopieren
        </button>
    }
    @if (OracleTypeMapper.IsLob(Column))
    {
        <button class="menu-item" title="Den ganzen Wert ansehen, als Datei speichern@(CanEdit ? " oder ändern" : "") (auch Doppelklick)" @onclick="OpenLobAsync">
            Inhalt öffnen …
        </button>
    }
    @if (!Details.PrimaryKey.Contains(Column.Name))
    {
        <button class="menu-item" @onclick="TogglePinAsync">@(Pinned ? "Spalte lösen" : "Spalte links anheften")</button>
    }
    @if (CompareCount > 1)
    {
        <button class="menu-item" disabled="@(CompareCount > RowComparison.MaxRows)"
                title="@(CompareCount > RowComparison.MaxRows ? $"Höchstens {RowComparison.MaxRows} Zeilen nebeneinander" : "Die markierten Zeilen nebeneinander, Unterschiede markiert (Alt+Enter)")"
                @onclick="CompareAsync">
            Markierte vergleichen <span class="ctx-meta">@RowsText(CompareCount)</span>
        </button>
    }
    else
    {
        <button class="menu-item" title="Alle Spalten der Zeile untereinander, neben dem Grid (Alt+Enter)" @onclick="OpenFormAsync">Als Formular</button>
    }

    @if (CanEdit && Tab.Changes is { } changes)
    {
        var selected = Request.Selected.Select(r => changes.Find(r.Key)).ToList();
        <div class="group-head-btn static">Bearbeiten · @RowsText(Request.Selected.Count)</div>
        @if (selected.Any(c => c?.Deleted is null))
        {
            <button class="menu-item danger" title="Wird mit „Schreiben“ (Ctrl+S) gelöscht" @onclick="() => EditRowsAsync(OnDeleteRows)">Zeile löschen</button>
        }
        @if (selected.Any(c => c is { HasPending: true }))
        {
            <button class="menu-item" title="Ausstehende Änderungen dieser Zeilen verwerfen (auch ein noch nicht geschriebenes Löschen)" @onclick="() => EditRowsAsync(OnRevertRows)">
                Ausstehende Änderungen verwerfen
            </button>
        }
    }

    <div class="group-head-btn static">Export · @RowsText(Request.Selected.Count)</div>
    <button class="menu-item" title="Tabulator-getrennt mit Kopfzeile – lässt sich direkt in Excel einfügen" @onclick="CopyTableAsync">Als Tabelle kopieren</button>
    <button class="menu-item" title="INSERT-Statements (werden nie ausgeführt)" @onclick="CopyInsertAsync">Als INSERT kopieren</button>
    <button class="menu-item" title="Semikolon-getrennt, UTF-8 – öffnet sich direkt in Excel" @onclick="SaveCsvAsync">Als CSV speichern …</button>
    <button class="menu-item" @onclick="SaveInsertAsync">Als INSERT-Skript speichern …</button>

    @if (_presentation.Entity is not null)
    {
        var seed = CSharpRows.HasDataUnavailable(_presentation);
        <div class="group-head-btn static">C# · @_presentation.EntityName · @RowsText(Request.Selected.Count)</div>
        <button class="menu-item" title="Objektinitialisierer mit Property-Namen und Enum-Membern (NULL-Werte weggelassen)" @onclick="CopyObjectsAsync">Als C#-Objekte kopieren</button>
        <button class="menu-item" disabled="@(seed is not null)" title="@(seed ?? "builder.HasData(…) für die IEntityTypeConfiguration")" @onclick="CopySeedAsync">Als HasData kopieren</button>
    }

    @if (_outgoing.Count > 0)
    {
        <div class="group-head-btn static">Verweist auf@(JumpRowsText)</div>
        @foreach (var jump in _outgoing)
        {
            <FkJumpItem Jump="jump" Related="InvolvesColumn(jump)" OnJump="JumpAsync" />
        }
    }

    @if (_incoming.Count > 0)
    {
        <div class="group-head-btn static">Referenziert von@(JumpRowsText)</div>
        @foreach (var jump in _incoming)
        {
            <FkJumpItem Jump="jump" Count="_counts.Of(jump)" Related="InvolvesColumn(jump)" OnJump="JumpAsync" />
        }
    }

    @if (_outgoing.Count == 0 && _incoming.Count == 0)
    {
        <div class="ctx-empty">Keine Fremdschlüssel an dieser Tabelle.</div>
    }
    else if (Request.MissingRows > 0)
    {
        <div class="ctx-note">@RowsText(Request.MissingRows) der Auswahl nicht mehr geladen – bei den Sprüngen nicht berücksichtigt.</div>
    }
</PopoverMenu>

@code {
    [CascadingParameter]
    public ActiveConnection Active { get; set; } = null!;

    [CascadingParameter]
    public WorkspaceManager Workspaces { get; set; } = null!;

    [CascadingParameter]
    public PresentationService Presentations { get; set; } = null!;

    private const double MenuWidth = 400;
    private const double ItemHeight = 44;

    private readonly CancellationTokenSource _cts = new();
    private readonly FkCounts _counts = new();
    private IReadOnlyList<FkJump> _outgoing = [];
    private IReadOnlyList<FkJump> _incoming = [];
    private DomModule? _dom;
    private ExportActions? _export;

    /// <summary>dom.js for the clipboard, imported on first use (<see cref="DomModule"/>).</summary>
    private DomModule Dom => _dom ??= new(JS);

    private ExportActions Export => _export ??= new(Shell, Dom, Files, Request.MissingRows, CloseAsync);
    private TablePresentation _presentation = null!;

    /// <summary>The clicked cell as C# (WP-15); null if the table has no entity.</summary>
    private CSharpValue? _cell;

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [Parameter, EditorRequired]
    public GridContextMenuRequest Request { get; set; } = null!;

    [Parameter, EditorRequired]
    public TableTab Tab { get; set; } = null!;

    [Parameter, EditorRequired]
    public TableDetails Details { get; set; } = null!;

    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>Whether the clicked column is currently pinned.</summary>
    [Parameter]
    public bool Pinned { get; set; }

    [Parameter]
    public EventCallback<int> OnTogglePin { get; set; }

    /// <summary>Grid row indexes of the selected rows to mark for deletion.</summary>
    [Parameter]
    public EventCallback<IReadOnlyList<int>> OnDeleteRows { get; set; }

    /// <summary>Grid row indexes of the selected rows whose pending changes to drop.</summary>
    [Parameter]
    public EventCallback<IReadOnlyList<int>> OnRevertRows { get; set; }

    /// <summary>The workspace may write and the table can be edited (rows can be deleted, changes reverted).</summary>
    [Parameter]
    public bool CanEdit { get; set; }

    [Parameter]
    public EventCallback OnOpenLob { get; set; }

    /// <summary>Shows the clicked row in the form beside the grid (WP-21).</summary>
    [Parameter]
    public EventCallback OnOpenForm { get; set; }

    /// <summary>Compares the selected rows (grid indexes) side by side (WP-21).</summary>
    [Parameter]
    public EventCallback<IReadOnlyList<int>> OnCompare { get; set; }

    /// <summary>Loaded selected rows; the comparison needs their values.</summary>
    private int CompareCount => Request.Selected.Count;

    private async Task OpenFormAsync()
    {
        await CloseAsync();
        await OnOpenForm.InvokeAsync();
    }

    private async Task CompareAsync()
    {
        var rows = Request.SelectedIndexes ?? [];
        await CloseAsync();
        await OnCompare.InvokeAsync(rows);
    }

    private async Task OpenLobAsync()
    {
        await CloseAsync();
        await OnOpenLob.InvokeAsync();
    }

    private async Task EditRowsAsync(EventCallback<IReadOnlyList<int>> action)
    {
        var rows = Request.SelectedIndexes ?? [];
        await CloseAsync();
        await action.InvokeAsync(rows);
    }

    private ColumnInfo Column => Details.Columns[Request.Column];

    /// <summary>
    /// FK jumps start from all selected rows (a right-click into a selection keeps it); rows no longer loaded are left
    /// out and mentioned below the jumps.
    /// </summary>
    private IReadOnlyList<RowData> JumpRows => Request.Selected.Count > 0 ? Request.Selected : [Request.Row];

    /// <summary>" · 3 Zeilen" after the jump headings if several rows are selected; nothing for one row.</summary>
    private string JumpRowsText => Request.Selected.Count + Request.MissingRows > 1 ? $" · {RowsText(JumpRows.Count)}" : "";

    /// <summary>For the first placement; dom.js keepInViewport corrects it once rendered.</summary>
    private double EstimatedHeight => 336 + ItemHeight * (_outgoing.Count + _incoming.Count) + (_cell is null ? 0 : 128) + (Request.MissingRows > 0 ? 40 : 0);

    protected override void OnInitialized()
    {
        _presentation = Presentations.For(Details);
        _cell = _presentation.Entity is null ? null : CSharpRows.Cell(_presentation, Request.Column, Request.Row.Values[Request.Column]);
        if (Active.Schema is not { } schema)
        {
            return;
        }

        var row = Details.Table.Ref;
        var jumps = FkNavigation.JumpsFor(Details, JumpRows, schema.OutgoingOf(row), schema.IncomingOf(row));
        // FKs over the clicked column first: that is usually the one the user means.
        _outgoing = jumps.Where(j => j.Direction == JumpDirection.Outgoing).OrderByDescending(InvolvesColumn).ToList();
        _incoming = jumps.Where(j => j.Direction == JumpDirection.Incoming).OrderByDescending(InvolvesColumn).ToList();
        // One after the other: they share the workspace's session. Closing the menu cancels the rest.
        var token = _cts.Token;
        Fire(() => _counts.CountAsync(Shell, Logger, Active, Workspaces, Tab.WorkspaceId, _incoming, () => InvokeAsync(StateHasChanged), token));
    }

    private bool InvolvesColumn(FkJump jump) =>
        (jump.Direction == JumpDirection.Outgoing ? jump.ForeignKey.FromColumns : jump.ForeignKey.ToColumns).Contains(Column.Name);

    private TableSummary SummaryOf(TableRef table) => FkTargets.SummaryOf(Active, table);

    private async Task JumpAsync(FkJump jump)
    {
        Shell.OpenFiltered(SummaryOf(jump.Table), jump.Filters);
        await CloseAsync();
    }

    private async Task TogglePinAsync()
    {
        await CloseAsync();
        await OnTogglePin.InvokeAsync(Request.Column);
    }

    private static string RowsText(int rows) => ExportActions.RowsText(rows);

    private Task CopyTableAsync() =>
        Export.CopyAsync(DelimitedExport.Build(Details, Request.Selected, DelimitedExport.ClipboardSeparator), "als Tabelle kopiert");

    private Task CopyInsertAsync() => Export.CopyAsync(InsertExport.Build(Details, Request.Selected), "als INSERT kopiert");

    private Task CopyObjectsAsync() => Export.CopyAsync(CSharpRows.Initializers(_presentation, Request.Selected), "als C#-Objekte kopiert");

    private Task CopySeedAsync() => Export.CopyAsync(CSharpRows.HasData(_presentation, Request.Selected), "als HasData kopiert");

    private Task SaveCsvAsync() =>
        Export.SaveAsync(
            DelimitedExport.Build(Details, Request.Selected, DelimitedExport.CsvSeparator), Details.Table.DisplayName + ".csv", "CSV (Semikolon)", utf8Bom: true);

    private Task SaveInsertAsync() =>
        Export.SaveAsync(InsertExport.Build(Details, Request.Selected), Details.Table.DisplayName + ".sql", "SQL-Skript", utf8Bom: false);

    private async Task CloseAsync()
    {
        await _cts.CancelAsync();
        await OnClose.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync();
        _cts.Dispose();
        await Dom.DisposeAsync();
    }
}
