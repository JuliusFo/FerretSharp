@using FerretSharp.Core.Connections
@using FerretSharp.Core.Schema
@using FerretSharp.Core.Settings
@using FerretSharp.UI.State
@implements IAsyncDisposable
@inject ActiveConnection Active
@inject PresentationService Presentation
@inject IJSRuntime JS
@inject ILogger<Explorer> Logger

<aside class="sidebar explorer">
    <div class="sidebar-head">
        <div class="schema-row">
            <span class="schema">@(Schema?.Owner ?? "–")</span>
            <span class="muted">@CountText</span>
            <button class="icon-btn ghost" title="Schema neu laden" disabled="@(_refreshing || Schema is null)" @onclick="RefreshAsync">
                <span class="@(_refreshing ? "spin" : "")">@Icons.Refresh</span>
            </button>
        </div>
        <div class="search">
            @Icons.Search
            <input placeholder="Tabelle suchen …" @bind="_query" @bind:event="oninput" disabled="@(Schema is null)" />
        </div>
    </div>

    @if (_refreshError is not null)
    {
        <div class="sidebar-error">@_refreshError</div>
    }

    <div class="sidebar-body">
        @{ var groups = Groups(); }
        <LetterIndexBar Available="groups.Keys.ToHashSet()" OnJump="JumpAsync" />

        <div class="table-list">
            @if (Schema is not null && groups.Count == 0)
            {
                <div class="sidebar-empty">@(string.IsNullOrWhiteSpace(_query) ? "Das Schema enthält keine Tabellen oder Views." : $"Nichts gefunden für „{_query}“.")</div>
            }
            @foreach (var (letter, tables) in groups)
            {
                <div id="tbl-grp-@(letter == LetterIndexBar.Other ? "other" : letter.ToString())">
                    <div class="group-head">@letter</div>
                    @foreach (var table in tables)
                    {
                        var t = table;
                        var entity = Presentation.ShownEntityNameOf(t.Ref);
                        var front = entity is not null && Presentation.Names == ClrNameDisplay.Front;
                        <button class="table-item @((Shell.ActiveTab as TableTab)?.Table.Ref == t.Ref ? "active" : "") @(IsOpen(t) ? "open" : "") @(t.IsInvalid ? "invalid" : "")" title="@Tooltip(t, entity)"
                                @onclick="() => Shell.OpenTable(t)">
                            @Icons.For(t.Kind)
                            <span class="name">@(front ? entity : t.DisplayName)</span>
                            @if (entity is not null)
                            {
                                <span class="clr-name">@(front ? t.DisplayName : entity)</span>
                            }
                            @if (t.Synonym is not null)
                            {
                                <span class="kind-tag syn">SYN</span>
                            }
                            @if (t.Kind != TableKind.Table)
                            {
                                <span class="kind-tag">@(t.Kind == TableKind.View ? "VIEW" : "MVIEW")</span>
                            }
                        </button>
                    }
                </div>
            }
        </div>
    </div>
</aside>

@code {
    private IJSObjectReference? _dom;
    private string _query = "";
    private bool _refreshing;
    private string? _refreshError;

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    private SchemaCache? Schema => Active.Schema;

    private string CountText => Schema is null ? "" : Schema.Tables.Count == 1 ? "1 Objekt" : $"{Schema.Tables.Count:N0} Objekte";

    protected override void OnInitialized()
    {
        Active.Changed += OnChanged;
        Shell.Changed += OnChanged;
        _presentationVersion = Presentation.Version;
        Presentation.Changed += OnPresentationChanged;
    }

    /// <summary>Renders the whole table list again only if the entity names beside the tables changed.</summary>
    private void OnPresentationChanged() => InvokeAsync(() =>
    {
        if (Presentation.NamesChangedSince(_presentationVersion))
        {
            StateHasChanged();
        }

        _presentationVersion = Presentation.Version;
    });

    private int _presentationVersion;

    private SortedDictionary<char, List<TableSummary>> Groups()
    {
        // A–Z first, "#" (other) last.
        var result = new SortedDictionary<char, List<TableSummary>>(
            Comparer<char>.Create((a, b) => SortKey(a).CompareTo(SortKey(b))));
        if (Schema is null)
        {
            return result;
        }

        foreach (var table in Schema.Tables)
        {
            var query = _query.Trim();
            // The entity name is found as well, unless C# names are switched off.
            if (query.Length > 0
                && !table.DisplayName.Contains(query, StringComparison.OrdinalIgnoreCase)
                && !table.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
                && Presentation.ShownEntityNameOf(table.Ref)?.Contains(query, StringComparison.OrdinalIgnoreCase) != true)
            {
                continue;
            }

            var key = LetterIndexBar.KeyOf(table.DisplayName);
            if (!result.TryGetValue(key, out var list))
            {
                result[key] = list = [];
            }

            list.Add(table);
        }

        return result;
    }

    private bool IsOpen(TableSummary table) => Shell.Tabs.OfType<TableTab>().Any(t => t.Table.Ref == table.Ref);

    private static int SortKey(char letter) => letter == LetterIndexBar.Other ? int.MaxValue : letter;

    private async Task JumpAsync(char letter)
    {
        _dom ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/FerretSharp.UI/js/dom.js");
        await _dom.InvokeVoidAsync("scrollIntoViewById", $"tbl-grp-{(letter == LetterIndexBar.Other ? "other" : letter.ToString())}", "start");
    }

    private async Task RefreshAsync()
    {
        if (Schema is not { } schema)
        {
            return;
        }

        _refreshing = true;
        _refreshError = null;
        var result = await Shell.RunDbAsync(Logger, Active.Profile, () => schema.RefreshAsync(CancellationToken.None));
        _refreshing = false;
        if (result.Succeeded)
        {
            Shell.RemoveTabsWhere(tab => schema.Find(tab.Table.Ref) is null);
        }

        _refreshError = result.Error?.Display;
    }

    private static string Tooltip(TableSummary table, string? entity)
    {
        var text = Tooltip(table);
        return entity is null ? text : $"{text}{Environment.NewLine}Entity {entity}";
    }

    private static string Tooltip(TableSummary table)
    {
        var kind = table.Kind switch
        {
            TableKind.View => "View",
            TableKind.MaterializedView => "Materialized View",
            _ => "Tabelle",
        };
        var text = table.Synonym is { } synonym
            ? $"{(synonym.IsPublic ? "Öffentliches Synonym" : "Synonym")} → {table.Owner}.{table.Name} ({kind})"
            : kind;
        return table.IsInvalid ? text + Environment.NewLine + InvalidStatusText.For(ObjectType(table.Kind)) : text;
    }

    private static string ObjectType(TableKind kind) => kind switch
    {
        TableKind.View => "VIEW",
        TableKind.MaterializedView => "MATERIALIZED VIEW",
        _ => "TABLE",
    };

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Active.Changed -= OnChanged;
        Shell.Changed -= OnChanged;
        Presentation.Changed -= OnPresentationChanged;
        if (_dom is not null)
        {
            try
            {
                await _dom.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
