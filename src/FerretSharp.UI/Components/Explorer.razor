@using FerretSharp.Core.Connections
@using FerretSharp.Core.Schema
@using FerretSharp.Core.Settings
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<Explorer> Logger

<aside class="sidebar explorer">
    <div class="sidebar-head">
        <div class="schema-row">
            <span class="schema">@(Schema?.Owner ?? "–")</span>
            <span class="muted">@CountText</span>
            <button class="icon-btn ghost" title="@SchemaViewText.Explorer_ReloadSchema" disabled="@(_refreshing || Schema is null)" @onclick="RefreshAsync">
                <span class="@(_refreshing ? "spin" : "")">@Icons.Refresh</span>
            </button>
        </div>
        <div class="segmented small explorer-sections" role="tablist">
            <button class="seg @(_section == ExplorerSection.Tables ? "active" : "")" role="tab" aria-selected="@(_section == ExplorerSection.Tables ? "true" : "false")"
                    title="@SchemaViewText.Explorer_TablesTitle" @onclick="() => SetSection(ExplorerSection.Tables)">@SchemaViewText.Explorer_Tables</button>
            <button class="seg @(_section == ExplorerSection.PlSql ? "active" : "")" role="tab" aria-selected="@(_section == ExplorerSection.PlSql ? "true" : "false")"
                    title="@SchemaViewText.Explorer_PlSqlTitle" @onclick="() => SetSection(ExplorerSection.PlSql)">
                PL/SQL
                @if (Schema is { } schema && schema.PlSqlObjects.Any(u => u.IsInvalid))
                {
                    <span class="seg-count bad" title="@SchemaViewText.Explorer_InvalidObjects">@schema.PlSqlObjects.Count(u => u.IsInvalid)</span>
                }
            </button>
        </div>
        <div class="explorer-search" @onkeydown="OnSearchKeyAsync">
            <SearchBox @bind-Value="_query" Placeholder="@Placeholder" Disabled="@(Schema is null)" />
            @if (_section == ExplorerSection.PlSql)
            {
                <button class="btn ghost source-toggle @(_inSource ? "active" : "")" aria-pressed="@(_inSource ? "true" : "false")"
                        title="@SchemaViewText.Explorer_SourceSearchTitle" disabled="@(Schema is null)"
                        @onclick="ToggleSourceSearch">@SchemaViewText.Explorer_Source</button>
            }
        </div>
        @if (OtherSectionHits() is { } other)
        {
            <button class="link-btn other-hits" @onclick="() => SetSection(other.Section)">@other.Text</button>
        }
    </div>

    @if (_refreshError is not null)
    {
        <div class="sidebar-error">@_refreshError</div>
    }

    @if (_section == ExplorerSection.PlSql && _inSource)
    {
        <div class="sidebar-body">
            <div class="table-list source-hits">
                @SourceResults()
            </div>
        </div>
    }
    else
    {
        <div class="sidebar-body">
            @{ var letters = _section == ExplorerSection.Tables ? TableGroups() : null; }
            @{ var units = _section == ExplorerSection.PlSql ? PlSqlGroups() : null; }
            <LetterIndexBar Available="@((letters?.Keys.AsEnumerable() ?? units!.Keys).ToHashSet())" OnJump="JumpAsync" />

            <div class="table-list">
                @if (letters is not null)
                {
                    @if (Schema is not null && letters.Count == 0)
                    {
                        <div class="sidebar-empty">@(string.IsNullOrWhiteSpace(_query) ? SchemaViewText.Explorer_NoTables : TextFormat.Format(SchemaViewText.Explorer_NothingFound, _query))</div>
                    }
                    @foreach (var (letter, tables) in letters)
                    {
                        <div id="@GroupId(letter)">
                            <div class="group-head">@letter</div>
                            @foreach (var table in tables)
                            {
                                @TableItem(table)
                            }
                        </div>
                    }
                }
                else if (units is not null)
                {
                    @if (Schema is not null && units.Count == 0)
                    {
                        <div class="sidebar-empty">@(string.IsNullOrWhiteSpace(_query) ? SchemaViewText.Explorer_NoPlSql : TextFormat.Format(SchemaViewText.Explorer_NothingFound, _query))</div>
                    }
                    @foreach (var (letter, list) in units)
                    {
                        <div id="@GroupId(letter)">
                            <div class="group-head">@letter</div>
                            @foreach (var unit in list)
                            {
                                @PlSqlItem(unit)
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }
</aside>

@code {
    private int _presentationVersion;
    [CascadingParameter]
    public ActiveConnection Active { get; set; } = null!;

    /// <summary>The connection this explorer belongs to: a schema refresh only touches its workspaces' tabs.</summary>
    [CascadingParameter]
    public ConnectionScope Scope { get; set; } = null!;

    [CascadingParameter]
    public PresentationService Presentation { get; set; } = null!;

    private DomModule? _dom;

    /// <summary>dom.js, imported on first use; does nothing once disposed (<see cref="DomModule"/>).</summary>
    private DomModule Dom => _dom ??= new(JS);
    private string _query = "";
    private bool _refreshing;
    private string? _refreshError;

    /// <summary>Tables or PL/SQL; kept per connection while it is open (the explorer stays mounted), not saved.</summary>
    private ExplorerSection _section;

    /// <summary>In the PL/SQL section: the search field searches the source (Enter) instead of filtering by name.</summary>
    private bool _inSource;
    private string? _searchedFor;
    private IReadOnlyList<SourceHit>? _hits;
    private string? _searchError;
    private CancellationTokenSource? _searchCts;

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [CascadingParameter]
    public WorkspaceLifecycle Lifecycle { get; set; } = null!;

    private SchemaCache? Schema => Active.Schema;

    private string CountText
    {
        get
        {
            if (Schema is not { } schema)
            {
                return "";
            }

            var count = _section == ExplorerSection.Tables ? schema.Tables.Count : schema.PlSqlObjects.Count;
            return TextFormat.Plural(count, SchemaViewText.Explorer_ObjectCountOne, SchemaViewText.Explorer_ObjectCountOther);
        }
    }

    private string Placeholder => _section switch
    {
        ExplorerSection.PlSql when _inSource => SchemaViewText.Explorer_SearchSourcePlaceholder,
        ExplorerSection.PlSql => SchemaViewText.Explorer_SearchPlSqlPlaceholder,
        _ => SchemaViewText.Explorer_SearchTablePlaceholder,
    };

    protected override void OnInitialized()
    {
        Active.Changed += OnChanged;
        Shell.Changed += OnChanged;
        _presentationVersion = Presentation.Version;
        Presentation.Changed += OnPresentationChanged;
    }

    /// <summary>Renders the whole table list again only if the entity names beside the tables changed.</summary>
    private void OnPresentationChanged() => InvokeAsync(() =>
    {
        if (Presentation.NamesChangedSince(_presentationVersion))
        {
            StateHasChanged();
        }

        _presentationVersion = Presentation.Version;
    });

    private RenderFragment TableItem(TableSummary t)
    {
        var entity = Presentation.ShownEntityNameOf(t.Ref);
        var front = entity is not null && Presentation.Names == ClrNameDisplay.Front;
        return @<button class="table-item @((Shell.ActiveTab as TableTab)?.Table.Ref == t.Ref ? "active" : "") @(IsOpen(t) ? "open" : "") @(t.IsInvalid ? "invalid" : "")" title="@Tooltip(t, entity)"
                        @onclick="() => Shell.OpenTable(t)">
                    @Icons.For(t.Kind)
                    <span class="name">@(front ? entity : t.DisplayName)</span>
                    @if (entity is not null)
                    {
                        <span class="clr-name">@(front ? t.DisplayName : entity)</span>
                    }
                    @if (t.Synonym is not null)
                    {
                        <span class="kind-tag syn">SYN</span>
                    }
                    @if (t.Kind != TableKind.Table)
                    {
                        <span class="kind-tag">@(t.Kind == TableKind.View ? "VIEW" : "MVIEW")</span>
                    }
                </button>;
    }

    private RenderFragment PlSqlItem(PlSqlObjectSummary u) =>
        @<button class="table-item @((Shell.ActiveTab as PlSqlTab)?.Unit.Ref == u.Ref ? "active" : "") @(IsOpen(u) ? "open" : "") @(u.IsInvalid ? "invalid" : "") @(u.IsDisabled ? "disabled-unit" : "")"
                 title="@Tooltip(u)" @onclick="() => Shell.OpenPlSql(u)">
            @Icons.For(u.Kind)
            <span class="name">@u.DisplayName</span>
            @if (u.Synonym is not null)
            {
                <span class="kind-tag syn">SYN</span>
            }
            <span class="kind-tag">@ExplorerList.Tag(u.Kind)</span>
        </button>;

    private RenderFragment SourceResults() => __builder =>
    {
        if (_searchCts is not null)
        {
            <div class="sidebar-empty">
                <span class="spinner"></span> @TextFormat.Format(SchemaViewText.Explorer_Searching, _searchedFor)
                <button class="btn ghost" @onclick="CancelSearch">@CommonText.Cancel</button>
            </div>
        }
        else if (_searchError is not null)
        {
            <div class="sidebar-error">@_searchError</div>
        }
        else if (_hits is null)
        {
            <div class="sidebar-empty">@TextFormat.Format(SchemaViewText.Explorer_SourceSearchHint, Schema?.Owner, SourceSearch.MinLength)</div>
        }
        else if (_hits.Count == 0)
        {
            <div class="sidebar-empty">@TextFormat.Format(SchemaViewText.Explorer_NoSourceHit, _searchedFor)</div>
        }
        else
        {
            <div class="hits-summary muted">
                @(_hits.Count >= SourceSearch.Limit ? TextFormat.Format(SchemaViewText.Explorer_HitsLimited, SourceSearch.Limit) : TextFormat.Plural(_hits.Count, SchemaViewText.Explorer_HitLinesOne, SchemaViewText.Explorer_HitLinesOther))
            </div>
            foreach (var group in SourceSearch.Group(_hits))
            {
                var unit = Schema?.FindPlSql(group.Key.Unit);
                <div class="hit-group">
                    <div class="hit-head" title="@group.Key.Unit">
                        @Icons.For(group.Key.Unit.Kind)
                        <span class="name">@group.Key.Unit.Name</span>
                        @if (group.Key.Unit.Kind == PlSqlKind.Package)
                        {
                            <span class="kind-tag">@(group.Key.Part == PlSqlPart.Body ? "BODY" : "SPEC")</span>
                        }
                    </div>
                    @foreach (var hit in group)
                    {
                        <button class="source-hit" title="@hit.Text.Trim()" disabled="@(unit is null)" @onclick="() => OpenHit(unit!, hit)">
                            <span class="line-no">@hit.Line</span>
                            <span class="line-text">@hit.Text.Trim()</span>
                        </button>
                    }
                </div>
            }
        }
    };

    private SortedDictionary<char, List<TableSummary>> TableGroups()
    {
        if (Schema is null)
        {
            return ExplorerList.Group<TableSummary>([], t => t.DisplayName);
        }

        // The entity name is found as well, unless C# names are switched off.
        return ExplorerList.Group(Schema.Tables.Where(TableMatches), t => t.DisplayName);
    }

    private bool TableMatches(TableSummary table) =>
        ExplorerList.Matches(_query, table.DisplayName, table.Name, Presentation.ShownEntityNameOf(table.Ref));

    private SortedDictionary<char, List<PlSqlObjectSummary>> PlSqlGroups() =>
        ExplorerList.Group(ExplorerList.Filter(Schema?.PlSqlObjects ?? [], _query), u => u.DisplayName);

    /// <summary>"3 Treffer unter PL/SQL": the name search finds nothing here but something in the other section.</summary>
    private (ExplorerSection Section, string Text)? OtherSectionHits()
    {
        if (Schema is not { } schema || string.IsNullOrWhiteSpace(_query) || _inSource && _section == ExplorerSection.PlSql)
        {
            return null;
        }

        var (other, count) = _section == ExplorerSection.Tables
            ? (ExplorerSection.PlSql, ExplorerList.Filter(schema.PlSqlObjects, _query).Count())
            : (ExplorerSection.Tables, schema.Tables.Count(TableMatches));
        if (count == 0)
        {
            return null;
        }

        return (other, other == ExplorerSection.PlSql
            ? TextFormat.Plural(count, SchemaViewText.Explorer_HitsInPlSqlOne, SchemaViewText.Explorer_HitsInPlSqlOther)
            : TextFormat.Plural(count, SchemaViewText.Explorer_HitsInTablesOne, SchemaViewText.Explorer_HitsInTablesOther));
    }

    private bool IsOpen(TableSummary table) => Shell.Tabs.OfType<TableTab>().Any(t => t.Table.Ref == table.Ref);

    private bool IsOpen(PlSqlObjectSummary unit) => Shell.Tabs.OfType<PlSqlTab>().Any(t => t.Unit.Ref == unit.Ref);

    private static string GroupId(char letter) => $"tbl-grp-{(letter == LetterIndexBar.Other ? "other" : letter.ToString())}";

    private void SetSection(ExplorerSection section) => _section = section;

    private void ToggleSourceSearch() => _inSource = !_inSource;

    private async Task JumpAsync(char letter)
    {
        await Dom.InvokeVoidAsync("scrollIntoViewById", GroupId(letter), "start");
    }

    private async Task OnSearchKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && _section == ExplorerSection.PlSql && _inSource)
        {
            await SearchSourceAsync();
        }
    }

    /// <summary>Searches the schema's PL/SQL source on the explorer session; cancellable, at most <see cref="SourceSearch.Limit"/> lines.</summary>
    private async Task SearchSourceAsync()
    {
        var text = _query.Trim();
        if (Schema is not { } schema || _searchCts is not null)
        {
            return;
        }

        if (text.Length < SourceSearch.MinLength)
        {
            _searchError = TextFormat.Format(SchemaViewText.Explorer_SourceSearchTooShort, SourceSearch.MinLength);
            return;
        }

        var cts = _searchCts = new CancellationTokenSource();
        _searchedFor = text;
        _searchError = null;
        StateHasChanged();
        var result = await Shell.RunDbAsync(Logger, Active, () => schema.SearchSourceAsync(text, SourceSearch.Limit, cts.Token), cts.Token);
        _searchCts = null;
        cts.Dispose();
        if (result.Succeeded)
        {
            _hits = result.Value;
        }
        else if (result.Error is { } error)
        {
            _searchError = error.Display;
        }
    }

    private void CancelSearch() => _searchCts?.Cancel();

    private void OpenHit(PlSqlObjectSummary unit, SourceHit hit) =>
        Shell.OpenPlSql(unit, at: new SourcePosition(hit.Part, hit.Line, SourceSearch.ColumnOf(hit.Text, _searchedFor ?? "")));

    private async Task RefreshAsync()
    {
        if (Schema is null)
        {
            return;
        }

        _refreshing = true;
        _refreshError = null;

        // WP-22: also the structure of open tabs and the C# model match follow, as after DDL.
        var result = await Lifecycle.RefreshSchemaAsync(Scope);
        _refreshing = false;
        _refreshError = result.Error?.Display;
        if (result.Warnings is { Count: > 0 } warnings)
        {
            Shell.Notify(SchemaViewText.Explorer_SchemaReloaded, warnings);
        }
    }

    private static string Tooltip(TableSummary table, string? entity)
    {
        var text = Tooltip(table);
        return entity is null ? text : text + Environment.NewLine + TextFormat.Format(SchemaViewText.Explorer_EntityTooltip, entity);
    }

    private static string Tooltip(TableSummary table)
    {
        var kind = table.Kind switch
        {
            TableKind.View => SchemaViewText.Explorer_KindView,
            TableKind.MaterializedView => SchemaViewText.Explorer_KindMaterializedView,
            _ => SchemaViewText.Explorer_KindTable,
        };
        var text = table.Synonym is { } synonym ? SynonymTooltip(synonym, $"{table.Owner}.{table.Name}", kind) : kind;
        return table.IsInvalid ? text + Environment.NewLine + InvalidStatusText.For(ObjectType(table.Kind)) : text;
    }

    private static string Tooltip(PlSqlObjectSummary unit)
    {
        var kind = ExplorerList.KindLabel(unit.Kind);
        var text = unit.Synonym is { } synonym ? SynonymTooltip(synonym, $"{unit.Owner}.{unit.Name}", kind) : kind;
        if (unit.IsDisabled)
        {
            text += Environment.NewLine + SchemaViewText.Explorer_TriggerDisabled;
        }

        if (unit.Status == "INVALID")
        {
            text += Environment.NewLine + InvalidStatusText.For(unit.ObjectType());
        }
        else if (unit.BodyStatus == "INVALID")
        {
            text += Environment.NewLine + TextFormat.Format(SchemaViewText.Explorer_BodyInvalid, InvalidStatusText.For("PACKAGE BODY"));
        }

        return text;
    }

    private static string SynonymTooltip(SynonymInfo synonym, string target, string kind) =>
        TextFormat.Format(synonym.IsPublic ? SchemaViewText.Explorer_PublicSynonymTooltip : SchemaViewText.Explorer_SynonymTooltip, target, kind);

    private static string ObjectType(TableKind kind) => kind switch
    {
        TableKind.View => "VIEW",
        TableKind.MaterializedView => "MATERIALIZED VIEW",
        _ => "TABLE",
    };

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Active.Changed -= OnChanged;
        Shell.Changed -= OnChanged;
        Presentation.Changed -= OnPresentationChanged;
        _searchCts?.Cancel();
        await Dom.DisposeAsync();
    }
}
