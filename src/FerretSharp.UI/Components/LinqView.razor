@* LINQ console tab (WP-13, ADR 0011): C# against the linked project's DbContext. The model host turns it into the SQL
   EF would send; FerretSharp runs that in the workspace's session – reading always, writing (ExecuteUpdate/Delete) only
   on writable workspaces and only after the user pressed "Ausführen" below the statement. *@
@using FerretSharp.Core.ClrModel
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Data
@using FerretSharp.Core.Query
@using FerretSharp.UI.State
@implements IDisposable
@inject LinqConsoleService Console
@inject WorkspaceManager Workspaces
@inject ActiveConnection Active
@inject ILogger<LinqView> Logger

<div class="linqview">
    <div class="tab-toolbar">
        @Icons.Code
        <TabTitle Tab="Tab" />
        @if (Console.State.Phase == LinqConsolePhase.Starting || Console.State.IsReloading)
        {
            <span class="spinner small"></span>
        }
        <span class="linq-console @ConsoleClass" title="@ConsoleTitle">@ConsoleText</span>
        @if (Console.State.Phase == LinqConsolePhase.Starting && !_running)
        {
            <button class="btn ghost" title="Den Start des Hilfsprozesses abbrechen – „Ausführen“ startet ihn erneut" @onclick="Console.CancelStart">Abbrechen</button>
        }
        <span class="spacer"></span>
        @if (_running)
        {
            <span class="spinner small"></span>
            <button class="btn ghost" @onclick="Cancel">Abbrechen</button>
        }
        <button class="btn primary" disabled="@(_running || Console.State.Phase == LinqConsolePhase.NotLinked)" @onclick="RunAsync"
                title="Code übersetzen und das SQL im Workspace ausführen (lesend; Schreiben erst nach Bestätigung)">
            ▶ Ausführen <kbd>Ctrl ↵</kbd>
        </button>
    </div>

    <div class="linq-editors">
        <div class="linq-label">
            Variablen
            <span class="hint">Werte, die die Query braucht – z. B. <code>var kundeId = 4711;</code>. <code>_context</code>, <code>db</code> und <code>ct</code> kennt FerretSharp selbst.</span>
        </div>
        <MonacoEditor @ref="_variablesEditor" Minimal="true" Class="linq-variables" Text="@Tab.Variables" OnChange="OnVariablesChanged" Completion="CompleteVariablesAsync"
                      Markers="Markers(LinqProtocol.VariablesSection)" Placeholder="// var kundeId = 4711;" />
        <div class="linq-label">
            Query
            <span class="hint">Direkt aus dem Code kopieren; <code>return</code> liefert das Ergebnis.</span>
        </div>
        <MonacoEditor @ref="_codeEditor" Class="linq-code" Text="@Tab.Code" OnChange="OnCodeChanged" Completion="CompleteCodeAsync" Markers="Markers(LinqProtocol.CodeSection)"
                      Placeholder="return await db.Kunden.Where(k => k.KundeId == kundeId).ToListAsync(ct);" />
    </div>

    <div class="linq-output">
        @if (_error is not null)
        {
            <div class="tab-error" title="@_errorDetail">@_error</div>
        }

        @if (Tab.LastRun is { } run)
        {
            @if (run.UnknownNames.Count > 0)
            {
                <div class="linq-notice">
                    <strong>@(run.UnknownNames.Count == 1 ? "Ein Name ist unbekannt" : $"{run.UnknownNames.Count} Namen sind unbekannt")</strong>
                    – Vorschlag für die Variablen (Werte anpassen, dann erneut ausführen):
                    <pre class="linq-declarations">@string.Join("\n", run.UnknownNames.Select(u => u.Declaration))</pre>
                    <button class="btn" @onclick="AdoptDeclarationsAsync">In die Variablen übernehmen</button>
                </div>
            }

            var problems = run.Diagnostics.OrderByDescending(d => d.Severity == "error").ToList();
            @if (problems.Count > 0)
            {
                <ul class="linq-diagnostics">
                    @foreach (var d in problems)
                    {
                        var diagnostic = d;
                        <li class="@diagnostic.Severity" @onclick="() => RevealAsync(diagnostic)" title="Zur Stelle springen">
                            <span class="where">@(diagnostic.Section == LinqProtocol.CodeSection ? "Query" : "Variablen") @diagnostic.Line:@diagnostic.Column</span>
                            <span class="id">@diagnostic.Id</span>
                            @diagnostic.Message
                        </li>
                    }
                </ul>
            }

            @if (run.Commands.Count == 0 && run.UnknownNames.Count == 0 && !run.HasErrors)
            {
                <div class="linq-notice muted">
                    Kein SQL – der Code hat keine Abfrage ausgeführt.
                    @if (run.Exception is { } thrown)
                    {
                        <span class="error">Ausnahme: @thrown</span>
                    }
                </div>
            }

            @if (run.Commands.Count > 0)
            {
                var command = run.Commands[Math.Clamp(Tab.SelectedCommand, 0, run.Commands.Count - 1)];
                var kind = LinqStatements.KindOf(command);
                <div class="linq-commands">
                    @if (run.Commands.Count > 1)
                    {
                        @for (var i = 0; i < run.Commands.Count; i++)
                        {
                            var index = i;
                            <button class="chip-btn @(index == Tab.SelectedCommand ? "active" : "")" @onclick="() => SelectCommand(index)">
                                @(index + 1) · @FirstWord(run.Commands[index].Sql)
                            </button>
                        }
                    }
                    <span class="muted">@(run.ResultType is { } type ? $"Ergebnis {type} · " : "")übersetzt in @ResultFooter.Ms(run.Elapsed)</span>
                    <span class="spacer"></span>
                    @if (kind == LinqCommandKind.Query && _query is not null)
                    {
                        <button class="btn ghost" title="Ausführungsplan des Kommandos – geschätzt oder tatsächlich (mit den Bind-Werten aus dem Code)"
                                @onclick="() => _planOpen = true">Plan</button>
                    }
                    <button class="btn ghost" @onclick="() => _showSql = !_showSql">@Icons.Code @(_showSql ? "SQL ausblenden" : "SQL")</button>
                </div>

                @if (_showSql || kind != LinqCommandKind.Query)
                {
                    <div class="linq-sql">
                        <SqlCode Sql="@command.Sql" Class="linq-sql-code" />
                        @if (command.Parameters.Count > 0)
                        {
                            <div class="linq-params">
                                @foreach (var p in command.Parameters)
                                {
                                    <span><code>:@p.Name</code> = @(p.Value ?? "NULL") <span class="muted">@p.OracleType</span></span>
                                }
                            </div>
                        }
                    </div>
                }

                @switch (kind)
                {
                    case LinqCommandKind.Query when _query is not null:
                        <div class="grid-host">
                            <SqlResultGrid @key="_runKey" WorkspaceId="Tab.WorkspaceId" Query="_query" OnStatus="OnGridStatus" />
                        </div>
                        <ResultFooter Status="_grid">
                            <ErrorActions Context="error">
                                @if (error.ErrorCode == "ORA-00904")
                                {
                                    @* The model maps a column the database does not have (yet): the model page lists such drift. *@
                                    <button class="btn ghost" title="Das C#-Modell kennt eine Spalte, die es in der Datenbank nicht gibt"
                                            @onclick="Shell.ShowModel">Modell-Abgleich öffnen</button>
                                }
                            </ErrorActions>
                        </ResultFooter>
                        break;
                    case LinqCommandKind.Write:
                        <div class="linq-write">
                            @if (_written is { } written)
                            {
                                var rows = written.Rows == 1 ? "1 Zeile" : $"{written.Rows:N0} Zeilen";
                                @switch (WorkspaceEditing.FateOf(Workspaces, Tab.WorkspaceId, written.Id, _writtenIn))
                                {
                                    case WriteFate.Open:
                                        <p><strong>@rows geändert</strong> – in der Transaktion des Workspaces. Committen, verwerfen oder zurücknehmen (↶) über die Statusleiste.</p>
                                        break;
                                    case WriteFate.Undone:
                                        <p class="muted">@rows geändert – inzwischen zurückgenommen (↶).</p>
                                        break;
                                    default:
                                        <p class="muted">@rows geändert – die Transaktion ist inzwischen beendet (Commit oder Rollback).</p>
                                        break;
                                }
                            }
                            else if (Workspaces.IsWritable(Tab.WorkspaceId))
                            {
                                <p>Dieses Statement ändert Daten. Es läuft in der Transaktion des Workspaces und bleibt bis zum Commit für andere unsichtbar.</p>
                                <button class="btn danger-solid" disabled="@_running" @onclick="RequestWriteAsync">Im Workspace ausführen</button>
                            }
                            else
                            {
                                <p>Der Workspace ist schreibgeschützt – das Statement wird nicht ausgeführt.</p>
                                <button class="btn" @onclick="() => Shell.RequestUnlock(Tab.WorkspaceId)">Workspace freischalten …</button>
                            }
                        </div>
                        break;
                    case LinqCommandKind.Unsupported:
                        <div class="linq-notice muted">
                            FerretSharp führt nur Abfragen sowie UPDATE und DELETE aus <code>ExecuteUpdate</code>/<code>ExecuteDelete</code> aus –
                            dieses Kommando wird nur angezeigt.
                        </div>
                        break;
                }
            }
        }
        else if (_error is null)
        {
            <EmptyState Title="LINQ gegen den DbContext"
                        Text="Eine Query aus dem Code einfügen und mit Ctrl+Enter ausführen. FerretSharp zeigt das SQL, das EF daraus macht, und das Ergebnis aus der Session dieses Workspaces." />
        }
    </div>
</div>

@if (_confirmWrite && Active.Profile is { } prodProfile)
{
    <ConfirmDialog Title="Ändern auf Produktion" ConfirmLabel="Ausführen" Danger="true" OnConfirm="WriteAsync" OnCancel="() => _confirmWrite = false">
        Das Statement aus <strong>@Tab.Title</strong> ändert Daten in <strong>@prodProfile.Name</strong> – in der Transaktion des Workspaces,
        sichtbar für andere erst nach dem Commit.
    </ConfirmDialog>
}

@if (_planOpen && _query is { } planQuery)
{
    <PlanDialog Query="planQuery" WorkspaceId="Tab.WorkspaceId" Title="@($"{Tab.Title} · Kommando {Tab.SelectedCommand + 1}")" OnClose="() => _planOpen = false" />
}

@code {
    private MonacoEditor? _variablesEditor;
    private bool _planOpen;
    private MonacoEditor? _codeEditor;
    private CancellationTokenSource? _cts;
    private bool _confirmWrite; // Prod: asked before writing
    private bool _running;
    private bool _showSql;
    private string? _error;
    private string? _errorDetail;
    private QuerySpec? _query;
    private int _runKey;
    private SqlGridStatus? _grid;
    private WriteAction? _written;

    /// <summary>Start of the transaction <see cref="_written"/> ran in (to tell undo from commit/rollback).</summary>
    private DateTimeOffset? _writtenIn;

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [Parameter, EditorRequired]
    public LinqTab Tab { get; set; } = null!;

    protected override void OnInitialized()
    {
        Console.Changed += OnConsoleChanged;
        Shell.TabCommandRequested += OnTabCommand;
        _ = Console.WarmUpAsync(); // the host loads the model while the user writes
        if (Tab.LastRun is not null)
        {
            ShowCommand(); // mounted again (workspace switch): show the last result
        }
    }

    private string ConsoleText => Console.State switch
    {
        { Phase: LinqConsolePhase.NotLinked } => "kein C#-Projekt verknüpft",
        { Phase: LinqConsolePhase.Starting, Step: { } step } => step + " …",
        { Phase: LinqConsolePhase.Starting } => "startet …",
        { Phase: LinqConsolePhase.Ready, Step: { } step } => step + " …",
        { Phase: LinqConsolePhase.Ready, Error: not null } => "bereit (vorheriger Build)",
        { Phase: LinqConsolePhase.Ready } => "bereit",
        { Phase: LinqConsolePhase.Failed, Error: { } error } => "Fehler: " + error.Message,
        _ => "startet beim Ausführen",
    };

    private string ConsoleClass => Console.State switch
    {
        { Phase: LinqConsolePhase.Ready, Error: not null } => "warn",
        { Phase: LinqConsolePhase.Ready } => "ready",
        { Phase: LinqConsolePhase.Failed or LinqConsolePhase.NotLinked } => "failed",
        _ => "",
    };

    private string ConsoleTitle => Console.State switch
    {
        { Phase: LinqConsolePhase.Ready, Error: { } error } => error.Message + (error.Detail is { } detail ? Environment.NewLine + Environment.NewLine + detail : ""),
        { Error.Detail: { } detail } => detail,
        { IsReloading: true } => "Ein neuer Build wird im Hintergrund geladen; bis er bereit ist, übersetzt die Konsole mit dem vorherigen.",
        _ => "Der Hilfsprozess lädt das Projekt einmal und übersetzt dann jede Query in das SQL, das EF senden würde – ohne Datenbank. "
             + "Nach einem Build lädt er die neue Version automatisch.",
    };

    /// <summary>
    /// The run's diagnostics of a section – the same list until the next run: the editor sends markers to Monaco whenever
    /// it gets another list, and the tab renders on every console state change.
    /// </summary>
    private IReadOnlyList<LinqDiagnostic> Markers(string section)
    {
        if (!ReferenceEquals(_markersOf, Tab.LastRun))
        {
            _markersOf = Tab.LastRun;
            _markers.Clear();
        }

        if (!_markers.TryGetValue(section, out var markers))
        {
            markers = Tab.LastRun?.Diagnostics.Where(d => d.Section == section).ToList() ?? [];
            _markers[section] = markers;
        }

        return markers;
    }

    private LinqRunResult? _markersOf;
    private readonly Dictionary<string, IReadOnlyList<LinqDiagnostic>> _markers = [];

    private void OnVariablesChanged(string text)
    {
        Tab.Variables = text;
        Shell.MarkDirty();
    }

    private void OnCodeChanged(string text)
    {
        Tab.Code = text;
        Shell.MarkDirty();
    }

    /// <summary>Completion from the console's host (WP-19); the other section comes from the tab (at most 250 ms old).</summary>
    private Task<IReadOnlyList<MonacoEditor.CompletionItem>> CompleteCodeAsync(string code, int offset) =>
        CompleteAsync(code, Tab.Variables, LinqProtocol.CodeSection, offset);

    private Task<IReadOnlyList<MonacoEditor.CompletionItem>> CompleteVariablesAsync(string variables, int offset) =>
        CompleteAsync(Tab.Code, variables, LinqProtocol.VariablesSection, offset);

    private async Task<IReadOnlyList<MonacoEditor.CompletionItem>> CompleteAsync(string code, string variables, string section, int offset)
    {
        // Off the UI thread: reading the host's answer (up to 3000 items at the start of a word) must not hold up typing.
        return await Task.Run(async () =>
        {
            var items = await Console.CompleteAsync(code, variables, section, offset);
            return (IReadOnlyList<MonacoEditor.CompletionItem>)items.Select(i => new MonacoEditor.CompletionItem(i.Label, i.InsertText, i.Kind, i.Detail, i.Rank)).ToList();
        });
    }

    private void OnTabCommand(WorkspaceTab tab, TabCommand command)
    {
        if (tab != Tab)
        {
            return;
        }

        switch (command)
        {
            case TabCommand.ApplyFilters or TabCommand.Refresh:
                _ = InvokeAsync(RunAsync);
                break;
            case TabCommand.FindColumn when _codeEditor is not null:
                _ = InvokeAsync(_codeEditor.FindAsync);
                break;
        }
    }

    private async Task RunAsync()
    {
        if (_running)
        {
            return;
        }

        // The editors report changes debounced: take what they hold right now.
        Tab.Code = await (_codeEditor?.GetTextAsync() ?? Task.FromResult<string?>(null)) ?? Tab.Code;
        Tab.Variables = await (_variablesEditor?.GetTextAsync() ?? Task.FromResult<string?>(null)) ?? Tab.Variables;
        Shell.MarkDirty();

        _running = true;
        _error = null;
        _errorDetail = null;
        _written = null;
        _cts = new CancellationTokenSource();
        StateHasChanged();
        try
        {
            var code = Tab.Code;
            var variables = Tab.Variables;
            var token = _cts.Token;
            Tab.LastRun = await Task.Run(() => Console.RunAsync(code, variables, token), token);
            Tab.SelectedCommand = Math.Max(0, Tab.LastRun.Commands.ToList().FindIndex(c => LinqStatements.KindOf(c) != LinqCommandKind.Unsupported));
            ShowCommand();
        }
        catch (OperationCanceledException)
        {
            _error = "Abgebrochen.";
        }
        catch (ClrModelException ex)
        {
            _error = ex.Message;
            _errorDetail = ex.Detail;
        }
        finally
        {
            _running = false;
            _cts?.Dispose();
            _cts = null;
            // Started from a shortcut (Ctrl+Enter), not a UI event: Blazor does not render on its own afterwards.
            StateHasChanged();
        }
    }

    /// <summary>The selected command: a query goes to a new result grid.</summary>
    private void ShowCommand()
    {
        _written = null;
        _grid = null;
        if (Tab.LastRun is { Commands.Count: > 0 } run)
        {
            var command = run.Commands[Math.Clamp(Tab.SelectedCommand, 0, run.Commands.Count - 1)];
            _query = LinqStatements.KindOf(command) == LinqCommandKind.Query ? LinqStatements.ToQuery(command) : null;
            _runKey++;
        }
        else
        {
            _query = null;
        }
    }

    private void SelectCommand(int index)
    {
        Tab.SelectedCommand = index;
        ShowCommand();
    }

    private void Cancel() => _cts?.Cancel();

    private void OnGridStatus(SqlGridStatus status) => _grid = status;

    /// <summary>The button below the statement; on Prod it asks once more, like DML in the SQL editor (WP-17).</summary>
    private Task RequestWriteAsync()
    {
        if (Active.Profile?.Kind == ConnectionKind.Prod)
        {
            _confirmWrite = true;
            return Task.CompletedTask;
        }

        return WriteAsync();
    }

    /// <summary>ExecuteUpdate/ExecuteDelete: the user confirmed by pressing the button below the statement. "Abbrechen" stops it.</summary>
    private async Task WriteAsync()
    {
        _confirmWrite = false;
        if (Tab.LastRun is not { } run || !Workspaces.IsWritable(Tab.WorkspaceId))
        {
            return;
        }

        var statement = LinqStatements.ToQuery(run.Commands[Tab.SelectedCommand]);
        _running = true;
        _error = null;
        using var cts = _cts = new CancellationTokenSource();
        var token = cts.Token;
        var result = await Shell.RunDbAsync(Logger, Active.Profile, async () =>
            await (await Workspaces.GetEditorAsync(Tab.WorkspaceId, token)).ExecuteAsync(statement, token), token);
        _running = false;
        _cts = null;
        if (result.Cancelled)
        {
            _error = "Abgebrochen – das Statement wurde zurückgenommen.";
            return;
        }

        _error = result.Error?.Display;
        if (result.Value is not { } written)
        {
            return;
        }

        (_written, _writtenIn) = (written, Workspaces.TransactionOf(Tab.WorkspaceId)?.StartedAt);
        // Table tabs of the workspace may show the changed rows: they fetch them again from the transaction.
        foreach (var tab in Shell.Workspaces.FirstOrDefault(w => w.WorkspaceId == Tab.WorkspaceId)?.TableTabs ?? [])
        {
            Shell.RequestTabCommand(tab, TabCommand.Reload);
        }

        Shell.NotifyChanged(); // status bar: open transaction, commit/rollback
    }

    /// <summary>Appends the suggested declarations to the variables and puts the cursor on the first of them.</summary>
    private async Task AdoptDeclarationsAsync()
    {
        if (Tab.LastRun is not { UnknownNames.Count: > 0 } run || _variablesEditor is null)
        {
            return;
        }

        var existing = (await _variablesEditor.GetTextAsync() ?? Tab.Variables).TrimEnd();
        var firstLine = existing.Length == 0 ? 1 : existing.Split('\n').Length + 1;
        Tab.Variables = (existing.Length == 0 ? "" : existing + "\n") + string.Join("\n", run.UnknownNames.Select(u => u.Declaration));
        await _variablesEditor.SetTextAsync(Tab.Variables);
        Tab.LastRun = run with { UnknownNames = [] };
        Shell.MarkDirty();
        await _variablesEditor.RevealAsync(firstLine, 1);
    }

    private Task RevealAsync(LinqDiagnostic diagnostic) =>
        (diagnostic.Section == LinqProtocol.CodeSection ? _codeEditor : _variablesEditor)?.RevealAsync(diagnostic.Line, diagnostic.Column) ?? Task.CompletedTask;

    private static string FirstWord(string sql) => sql.TrimStart().Split([' ', '\n', '\r'], 2)[0].ToUpperInvariant();

    private void OnConsoleChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Console.Changed -= OnConsoleChanged;
        Shell.TabCommandRequested -= OnTabCommand;
        _cts?.Cancel();
    }
}
