@using FerretSharp.Core.ClrModel
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Data
@using FerretSharp.Core.Forms
@using FerretSharp.Core.Oracle
@using FerretSharp.Core.Query
@using FerretSharp.Core.Schema
@inherits FerretComponent
@implements IDisposable
@inject ILogger<TabView> Logger
@inject ShortcutService Shortcuts
@inject AppSettingsService Settings
@inject ConnectionHub Hub

<div class="tabview">
    <div class="tab-toolbar">
        @if (Tab.BackTarget(Shell.Tabs) is { } back)
        {
            <button class="btn ghost nav-btn" title="@TextFormat.Format(SchemaViewText.Tab_BackTo, NavLabel(back), Shortcuts.Hint(ShortcutAction.Back))" @onclick="Shell.GoBack">← @back.Table.DisplayName</button>
        }
        @if (Tab.ForwardTarget(Shell.Tabs) is { } forward)
        {
            <button class="btn ghost nav-btn" title="@TextFormat.Format(SchemaViewText.Tab_ForwardTo, NavLabel(forward), Shortcuts.Hint(ShortcutAction.Forward))" @onclick="Shell.GoForward">@forward.Table.DisplayName →</button>
        }
        <div class="segmented small" role="tablist">
            @foreach (var (mode, label) in Modes)
            {
                var m = mode;
                <button class="seg @(Tab.Mode == m ? "active" : "")" role="tab" aria-selected="@(Tab.Mode == m ? "true" : "false")"
                        @onclick="() => SetMode(m)">@label</button>
            }
        </div>
        <span class="toolbar-title">
            @if (Tab.Table.Synonym is { } synonym)
            {
                @TextFormat.Format(synonym.IsPublic ? SchemaViewText.PublicSynonymTo : SchemaViewText.SynonymTo, synonym.Name, $"{Tab.Table.Owner}.{Tab.Table.Name}")
            }
            else
            {
                @($"{Tab.Table.Owner}.{Tab.Table.Name}")
            }
        </span>
        <span class="spacer"></span>
        @if (Tab.Mode == TabMode.Data && _details is not null)
        {
            @if (Tab.Changes is not null && _grid?.CanEdit == true)
            {
                <button class="btn ghost" title="@TextFormat.Format(SchemaViewText.Tab_AddRowTitle, Shortcuts.Hint(ShortcutAction.Flush))" @onclick="AddRowAsync">@SchemaViewText.Tab_AddRow</button>
            }
            <button class="btn ghost @(Tab.FormOpen ? "active" : "")" aria-pressed="@(Tab.FormOpen ? "true" : "false")"
                    title="@(Shortcuts.Label(ShortcutAction.ToggleForm) is { } key ? TextFormat.Format(SchemaViewText.Tab_FormTitleWithKey, key) : SchemaViewText.Tab_FormTitle)" @onclick="ToggleForm">
                @SchemaViewText.Tab_Form <Kbd Action="ShortcutAction.ToggleForm" />
            </button>
            <ColumnJump @ref="_jump" Details="_details" OnJump="c => _pendingJump = c" />
        }
        @if (_details is not null && Tab.Mode != TabMode.Structure)
        {
            <button class="icon-btn ghost" title="@(CommonText.Reload + Shortcuts.Hint(ShortcutAction.Refresh))" @onclick="RefreshViewAsync">@Icons.Refresh</button>
        }
    </div>

    @if (_loadError is not null)
    {
        <div class="tab-error">
            <span>@_loadError.Display</span>
            <button class="link-btn" @onclick="() => Shell.ShowError(_loadError, Active.Profile?.MasksValues == true)">@CommonText.Details</button>
        </div>
    }
    else if (_details is null)
    {
        <div class="structure-loading padded"><span class="spinner"></span> @SchemaViewText.Tab_LoadingStructure</div>
    }
    else
    {
        <div class="tab-data @(Tab.Mode == TabMode.Data ? "" : "hidden")">
            <FilterBar Tab="Tab" Details="_details" OnApply="() => ApplyFiltersAsync()" OnApplyPreset="ApplyFiltersAsync" OnShowSql="ShowSql" OnShowPlan="ShowPlan" />
            @if (Tab.Error is not null)
            {
                <div class="tab-error">
                    <span>@Tab.Error</span>
                    @if (Tab.Failure is { } failure)
                    {
                        <button class="link-btn" @onclick="() => Shell.ShowError(failure, Active.Profile?.MasksValues == true)">@CommonText.Details</button>
                    }
                </div>
            }
            <div class="grid-split">
                <div class="grid-host">
                    <FerretGrid @ref="_grid" Tab="Tab" Details="_details" OnPageLoaded="OnPageLoadedAsync" OnLoadingShown="StateHasChanged"
                                OnContextMenu="r => _menu = r" OnColumnMenu="r => _columnMenu = r"
                                OnLobOpen="r => _lob = r" OnEditableChanged="StateHasChanged" OnFormRequested="OnFormRequested" />
                </div>
                @if (Tab.FormOpen)
                {
                    <RowFormPanel @ref="_form" Tab="Tab" Details="_details" Grid="_grid" OnClose="CloseFormAsync" />
                }
            </div>
            <TabFooter @ref="_footer" Tab="Tab" Details="_details" Grid="_grid" Loading="_grid?.LoadingFirstPage == true" />
        </div>

        @* Detail views mount when first shown and then stay (like the grid), so switching back costs no query. *@
        @if (_visited.Any(m => m != TabMode.Data))
        {
            <div class="tab-details @(Tab.Mode == TabMode.Data ? "hidden" : "")">
                <ObjectHeader Details="_details" Version="_version" />
                <div class="details-body">
                    @foreach (var (mode, _) in Modes.Where(m => m.Mode != TabMode.Data && _visited.Contains(m.Mode)))
                    {
                        <div class="structure @(Tab.Mode == mode ? "" : "hidden")" @key="mode">
                            @switch (mode)
                            {
                                case TabMode.Structure:
                                    <ColumnsView @ref="_columns" Details="_details" WorkspaceId="Tab.WorkspaceId" Tab="Tab" Shown="IsShown(TabMode.Structure)" OnSchemaChanged="() => _version++" />
                                    break;
                                case TabMode.Constraints:
                                    <ConstraintsView Details="_details" Version="_version" />
                                    break;
                                case TabMode.Indexes:
                                    <IndexesView Details="_details" Version="_version" WorkspaceId="Tab.WorkspaceId" OnSchemaChanged="() => _version++" />
                                    break;
                                case TabMode.Dependencies:
                                    <DependenciesView Details="_details" Version="_version" />
                                    break;
                                case TabMode.Relations:
                                    <RelationsView Details="_details" Version="_version" />
                                    break;
                                case TabMode.Ddl:
                                    <DdlView Details="_details" Version="_version" />
                                    break;
                                case TabMode.Usage:
                                    <UsageView Details="_details" Shown="IsShown(TabMode.Usage)" />
                                    break;
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@if (_menu is { } menu && _details is not null)
{
    <GridContextMenu @key="menu" Request="menu" Tab="Tab" Details="_details" Names="@(_grid?.Names ?? Core.Display.DisplayNames.None)" OnClose="() => _menu = null"
                     CanEdit="@(_grid?.CanEdit == true && Tab.Changes is not null)"
                     Pinned="@(_grid?.IsPinned(menu.Column) == true)" OnTogglePin="TogglePinAsync"
                     OnDeleteRows="rows => _grid?.ChangeRowsAsync(rows, delete: true) ?? Task.CompletedTask"
                     OnRevertRows="rows => _grid?.ChangeRowsAsync(rows, delete: false) ?? Task.CompletedTask"
                     OnOpenLob="() => _grid?.OpenLobAsync(menu.RowIndex, menu.Column) ?? Task.CompletedTask"
                     OnOpenForm="() => OpenFormAsync(menu.RowIndex, menu.Column)" OnCompare="Compare"
                     OnFillMarks="fill => _grid?.FillAsync(menu.Marks!.Marks, fill) ?? Task.CompletedTask" OnSetValue="r => _setValue = r"
                     CopyUnavailable="@CopyUnavailable" OnCopyToConnection="() => OpenCopy(menu)" />
}

@if (_copy is { } copy)
{
    <SubgraphCopyDialog @key="copy" Draft="copy" SourceHasTransaction="@(Workspaces.ActionsOf(Tab.WorkspaceId).Count > 0)" OnClose="() => _copy = null" />
}

@if (_setValue is { } setValue && _details is not null)
{
    <SetValueDialog @key="setValue" Request="setValue" Details="_details" Tab="Tab" OnApply="ApplySetValueAsync" OnClose="() => _setValue = null" />
}

@if (_compare is { } compare && _details is not null)
{
    <RowCompareDialog Title="@_details.Table.DisplayName" Presentation="Presentations.For(_details)" Order="ColumnPinning.DisplayOrder(_details, Tab.PinnedColumns)"
                      KeyText="r => r.KeyText(_details)" KeyTitle="@string.Join(", ", _details.PrimaryKey)" Rows="compare.Rows" Missing="compare.Missing"
                      OnClose="() => _compare = null" OnShow="ShowComparedRowAsync" />
}

@if (_lob is { } lob && _details is not null)
{
    <LobEditorDialog @key="lob" Request="lob" Details="_details" Tab="Tab"
                     CanEdit="@LobEditable(lob)" ReadOnlyReason="@LobReadOnlyReason(lob)"
                     OnApply="(loaded, value) => _grid?.SetLobAsync(lob, loaded, value) ?? Task.FromResult<string?>(null)"
                     OnClose="() => _lob = null" />
}

@if (_columnMenu is { } columnMenu && _details is not null)
{
    <ColumnMenu @key="columnMenu" Request="columnMenu" Details="_details" Tab="Tab" OnClose="() => _columnMenu = null"
                Pinned="@(_grid?.IsPinned(columnMenu.Column) == true)" OnTogglePin="TogglePinAsync"
                OnMarkColumn="column => _grid?.MarkColumnAsync(column) ?? Task.CompletedTask" />
}

@if (_sql is { } sql)
{
    <SqlPreviewDialog Sql="@sql.Sql" Parameters="sql.Parameters" Error="@sql.Error" OnClose="() => _sql = null"
                OnOpenInEditor="() => OpenInSqlEditor(sql.Sql, sql.Parameters)" />
}

@if (_plan is { } planQuery)
{
    <PlanDialog Query="planQuery.FirstPage" WholeQuery="planQuery.Whole" WorkspaceId="Tab.WorkspaceId" Title="@Tab.Table.DisplayName" OnClose="() => _plan = null" />
}

@code {
    private PresentationWatch _presentation = null!;

    [CascadingParameter]
    public ActiveConnection Active { get; set; } = null!;

    [CascadingParameter]
    public WorkspaceManager Workspaces { get; set; } = null!;

    [CascadingParameter]
    public PresentationService Presentations { get; set; } = null!;

    private TableDetails? _details;
    private (QuerySpec FirstPage, QuerySpec Whole)? _plan;
    private DatabaseException? _loadError;
    private FerretGrid? _grid;
    private TabFooter? _footer;
    private (string Sql, IReadOnlyList<QueryParameter> Parameters, string? Error)? _sql;
    private GridContextMenuRequest? _menu;
    private FerretGrid.LobRequest? _lob;

    /// <summary>The LOB editor may change the value: writable workspace, editable column, row not marked for deletion.</summary>
    private bool LobEditable(FerretGrid.LobRequest lob) => LobReadOnlyReason(lob) is null;

    private string? LobReadOnlyReason(FerretGrid.LobRequest lob)
    {
        if (_grid?.CanEdit != true || Tab.Changes is not { } changes)
        {
            return Workspaces.IsWritable(Tab.WorkspaceId)
                ? SchemaViewText.Tab_TableNotEditable
                : DataText.WorkspaceReadOnlyUnlockToEdit;
        }

        if (OracleTypeMapper.NotEditableReason(_details!, _details!.Columns[lob.Column], newRow: lob.NewRow is not null) is { } reason)
        {
            return reason;
        }

        return lob.Row is { } row && changes.Find(row.Key)?.Deleted is not null ? DataText.RowMarkedForDeletion : null;
    }
    private ColumnMenuRequest? _columnMenu;
    private ColumnJump? _jump;
    private RowFormPanel? _form;
    private RowCompareRequest? _compare;

    /// <summary>"Set value…" of the cell menu, open (WP-59).</summary>
    private SetValueRequest? _setValue;

    /// <summary>"Copy to another connection…" of the cell menu, open (WP-42).</summary>
    private SubgraphCopyDraft? _copy;

    /// <summary>Why the rows cannot be copied to another connection; null if they can.</summary>
    private string? CopyUnavailable =>
        _details?.Table.Kind != TableKind.Table ? GridText.GridMenu_CopyToConnectionView
        : CopyTargets.Targets(Hub, Active, Settings.Current).Count == 0 ? GridText.GridMenu_CopyToConnectionNone
        : null;

    /// <summary>The copy of the selected rows (or the clicked one) into a workspace of another open connection (WP-42).</summary>
    private void OpenCopy(GridContextMenuRequest menu)
    {
        if (_details is null || Active.Schema is not { } schema || Active.Profile is not { } profile)
        {
            return;
        }

        var workspace = Tab.WorkspaceId;
        _copy = new SubgraphCopyDraft(
            ConnectionLabel.Of(profile, Settings.Current), schema.Owner, Core.Relations.RelationGraph.Of(schema), _details,
            [.. menu.JumpRows.Select(r => r.Key)],
            ct => Workspaces.GetDataAsync(workspace, ct),
            async (table, ct) => schema.Find(table) is { } summary ? await schema.GetDetailsAsync(summary, ct) : null,
            CopyTargets.Targets(Hub, Active, Settings.Current));
    }

    /// <summary>The value of "Set value…" for its cells; the dialog closes itself once it is set (its OnClose).</summary>
    private async Task<string?> ApplySetValueAsync(string text)
    {
        if (_setValue is not { } request || _grid is null)
        {
            return null;
        }

        return request.Marks is { } marks
            ? await _grid.FillMarksAsync(marks, text)
            : await _grid.FillRowsAsync(request.Rows, request.Column, CellFill.Value(text));
    }

    private ColumnsView? _columns;
    private int? _pendingJump; // scrolled to after the search list has closed, so the grid cell keeps the focus
    private readonly HashSet<TabMode> _visited = [];
    private int _version; // F5 in a detail view: incremented, the detail views reload

    /// <summary>"Usage" only with a linked C# project (WP-40): without one there is no code to search.</summary>
    private IReadOnlyList<(TabMode Mode, string Label)> Modes =>
        TabModeLabels.All.Where(m => m.Mode != TabMode.Usage || Models.State.Link is not null || Tab.Mode == TabMode.Usage).ToList();

    [CascadingParameter]
    public ClrModelManager Models { get; set; } = null!;

    /// <summary>
    /// The view is what the user sees now: the tab's mode, the active tab of the shown connection, the explorer page. Views
    /// stay mounted once visited; only a shown one reads the code usage index (review of WP-40: hidden ones rebuilt it after
    /// every build of the project).
    /// </summary>
    private bool IsShown(TabMode mode) => Tab.Mode == mode && ReferenceEquals(Shell.ActiveTab, Tab) && Shell.Page == ShellPage.Explorer;

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [Parameter, EditorRequired]
    public TableTab Tab { get; set; } = null!;

    private string NavLabel(TableTab tab) =>
        tab.FilterSummary(maxLength: 80, tab.Details is { } details ? Presentations.For(details) : null) is { } filters
            ? $"{tab.Table.DisplayName} ({filters})"
            : tab.Table.DisplayName;

    /// <summary>
    /// The C# model or the name setting changed: filter bar (member lists) and labels follow – only if this table reads
    /// differently (after a build most tables do not, and every mounted tab of every workspace would render).
    /// </summary>
    private void OnPresentationChanged() => InvokeAsync(() =>
    {
        if (_presentation.ChangedFor(Tab.Table.Ref))
        {
            StateHasChanged();
        }
    });

    protected override async Task OnInitializedAsync()
    {
        Shell.TabCommandRequested += OnTabCommand;
        _presentation = new PresentationWatch(Presentations);
        Presentations.Changed += OnPresentationChanged;
        if (Active.Schema is not { } schema)
        {
            return;
        }

        var table = Tab.Table;
        var result = await Shell.RunDbAsync(Logger, Active, () => schema.GetDetailsAsync(table, CancellationToken.None));
        _loadError = result.Error;
        if (result.Succeeded)
        {
            var fitting = Tab.FitToStructure;
            _details = Tab.UseStructure(result.Value!);
            if (fitting)
            {
                // A link's rows were fitted (WP-37): the tab header counts the enabled ones, and the tab is saved so.
                Shell.NotifyChanged();
                Shell.MarkDirty();
            }
        }
    }

    /// <summary>The mode may also change from outside (a table link opens the structure of an open tab).</summary>
    protected override void OnParametersSet() => _visited.Add(Tab.Mode);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingJump is { } column && _grid is not null)
        {
            _pendingJump = null;
            await _grid.JumpToColumnAsync(column);
            _form?.RevealColumn(column);
        }
    }

    private void SetMode(TabMode mode)
    {
        Tab.Mode = mode;
        _visited.Add(mode);
        Shell.NotifyChanged();
    }

    /// <param name="sorts">A filter preset's sort order (WP-37); null keeps the grid's.</param>
    private async Task ApplyFiltersAsync(IReadOnlyList<SortSpec>? sorts = null)
    {
        if (_details is null)
        {
            return;
        }

        if (Tab.ValidFilters(_details) is not { } conditions)
        {
            return;
        }

        Tab.AppliedFilters = conditions;
        Shell.NotifyChanged(); // filter count in the tab header
        await RefreshAsync(sorts is null || sorts.SequenceEqual(Tab.Sorts) ? null : sorts);
    }

    /// <summary>F5 / reload button: the grid in the data view, the detail views otherwise (columns come with the schema).</summary>
    private Task RefreshViewAsync()
    {
        if (Tab.Mode == TabMode.Data)
        {
            return RefreshAsync();
        }

        _version++;
        return Task.CompletedTask;
    }

    /// <param name="sorts">A new sort order; the grid then reloads by sorting (one query).</param>
    private async Task RefreshAsync(IReadOnlyList<SortSpec>? sorts = null)
    {
        _footer?.Reset();
        Tab.Error = null;
        Tab.Failure = null;
        Tab.FirstVisibleRow = null;
        Shell.MarkDirty();
        if (_grid is null)
        {
            Tab.Sorts = sorts ?? Tab.Sorts; // the grid takes them when it is created
        }
        else if (sorts is null)
        {
            await _grid.RefreshAsync();
        }
        else
        {
            await _grid.RefreshAsync(sorts);
        }
    }

    /// <summary>The form beside the grid (WP-21): open or close; saved with the tab.</summary>
    private void ToggleForm()
    {
        Tab.FormOpen = !Tab.FormOpen;
        Shell.MarkDirty();
    }

    private Task CloseFormAsync()
    {
        Tab.FormOpen = false;
        Shell.MarkDirty();
        return _grid?.FocusRowAsync(_grid.Focused ?? new GridCell(0, null, null), keepFocus: false) ?? Task.CompletedTask;
    }

    /// <summary>Opens the form on a row (context menu, a compared row's heading).</summary>
    private async Task OpenFormAsync(int rowIndex, int? column)
    {
        Tab.FormOpen = true;
        Shell.MarkDirty();
        StateHasChanged();
        if (_grid is not null)
        {
            await _grid.FocusRowAsync(new GridCell(rowIndex, null, column), keepFocus: false);
        }
    }

    /// <summary>Alt+Enter in the grid: several selected rows are compared, otherwise the form opens or closes.</summary>
    private Task OnFormRequested(FerretGrid.FormRequest request)
    {
        if (request.Selected.Count > 1)
        {
            Compare(request.Selected);
            return Task.CompletedTask;
        }

        if (Tab.FormOpen)
        {
            return CloseFormAsync();
        }

        Tab.FormOpen = true;
        Shell.MarkDirty();
        return Task.CompletedTask;
    }

    /// <summary>The selected rows side by side; rows no longer loaded are counted, not compared.</summary>
    private void Compare(IReadOnlyList<int> selected)
    {
        if (_grid is null)
        {
            return;
        }

        var (request, refusal) = RowCompareRequest.Of(selected, _grid.RowAt);
        if (refusal is not null)
        {
            Shell.Notify(refusal);
        }

        _compare = request;
    }

    private Task ShowComparedRowAsync(int rowIndex)
    {
        _compare = null;
        return OpenFormAsync(rowIndex, null);
    }

    /// <summary>"+ Row": with the form open the new row is filled there, otherwise in the grid.</summary>
    private async Task AddRowAsync()
    {
        if (_grid is null)
        {
            return;
        }

        if (Tab.FormOpen && _form is not null)
        {
            _form.FocusFirstFieldOfNewRow();
            await _grid.AddRowAsync(inGrid: false);
        }
        else
        {
            await _grid.AddRowAsync();
        }
    }

    private async Task TogglePinAsync(int column)
    {
        if (_grid is not null)
        {
            await _grid.TogglePinAsync(column);
        }
    }

    /// <summary>"In SQL-Editor öffnen": the statement in a new SQL tab, its bind values as variables (WP-17).</summary>
    private void OpenInSqlEditor(string sql, IReadOnlyList<QueryParameter> parameters)
    {
        _sql = null;
        Shell.OpenSql(sql + ";\n", parameters.Select(SqlBinds.FromParameter).ToList());
    }

    /// <summary>
    /// Shows the statement for the filters as currently edited (or the applied ones if the edit is invalid): the grid's own,
    /// or <c>SELECT t.*</c> as the setting says (<see cref="FilterStatement"/>).
    /// </summary>
    private void ShowSql()
    {
        if (_details is null)
        {
            return;
        }

        var edited = Tab.EditedFilters();
        var filters = QueryBuilder.Validate(_details, edited).Count == 0 ? edited : Tab.AppliedFilters;
        try
        {
            var query = FilterStatement.Of(_details, filters, Tab.Sorts, Settings.Current.FilterSql);
            _sql = (query.Sql, query.Parameters, null);
        }
        catch (QueryValidationException ex)
        {
            _sql = ("", [], ex.Message);
        }
    }

    /// <summary>The plan of the grid's query: the applied filters and sorting, first page (WP-14).</summary>
    private void ShowPlan()
    {
        if (_details is null)
        {
            return;
        }

        try
        {
            var query = QueryBuilder.BuildSelect(_details, Tab.AppliedFilters, Tab.Sorts, new PageSpec(0, IDataAccess.ActualPlanPageSize));
            // "Ganzes Ergebnis" means all rows of the filter, not the grid's first page: the same query without the limit.
            var whole = QueryBuilder.BuildSelect(_details, Tab.AppliedFilters, Tab.Sorts, new PageSpec(0, int.MaxValue));
            _plan = (new QuerySpec(query.Sql, query.Parameters), new QuerySpec(whole.Sql, whole.Parameters));
        }
        catch (QueryValidationException ex)
        {
            _sql = ("", [], ex.Message);
        }
    }

    /// <summary>A page arrived: the footer counts, and a row the change overview asked for may be there now.</summary>
    private async Task OnPageLoadedAsync()
    {
        StateHasChanged();
        await FocusRequestedRowAsync(lastTry: true);
    }

    /// <summary>
    /// Focuses the row the change overview asked for (WP-30), once the grid has it; on the last try a row that is not
    /// among the loaded ones is reported instead.
    /// </summary>
    private async Task FocusRequestedRowAsync(bool lastTry)
    {
        if (Tab.FocusRequest is not { } row || _grid is null)
        {
            return;
        }

        if (await _grid.FocusChangeAsync(row))
        {
            Tab.FocusRequest = null;
        }
        else if (lastTry)
        {
            Tab.FocusRequest = null;
            Shell.Notify(GridText.Changes_RowNotLoaded);
        }
    }

    private void OnTabCommand(WorkspaceTab tab, TabCommand command)
    {
        if (tab != Tab)
        {
            return;
        }

        if (command is TabCommand.ApplyFilters or TabCommand.Refresh or TabCommand.Reload)
        {
            // An open cell menu holds row indexes of the rows before (review 3.44.0, A3): a script of the workspace that
            // reloaded the table made "Delete rows" and "Revert" hit other rows.
            _menu = null;
        }

        Fire(async () =>
        {
            switch (command)
            {
                case TabCommand.ApplyFilters:
                    await ApplyFiltersAsync();
                    break;
                case TabCommand.Refresh:
                    await RefreshViewAsync();
                    break;
                case TabCommand.Reload when _grid is not null:
                    await _grid.ReloadAsync();
                    break;
                case TabCommand.FindColumn when Tab.Mode == TabMode.Data:
                    if (_form is not null && await _form.ContainsFocusAsync())
                    {
                        _form.FocusSearch();
                    }
                    else
                    {
                        _jump?.Open();
                    }

                    break;
                case TabCommand.FindColumn when Tab.Mode == TabMode.Structure && _columns is not null:
                    await _columns.FocusFilterAsync();
                    break;
                case TabCommand.FocusRow:
                    SetMode(TabMode.Data);
                    await FocusRequestedRowAsync(lastTry: Tab.RowsLoaded > 0 || Tab.AllRowsLoaded);
                    break;
            }

            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Shell.TabCommandRequested -= OnTabCommand;
        Presentations.Changed -= OnPresentationChanged;
    }
}
