@* Right-click menu of a grid cell: copy the value (also as C#), open a LOB, pin the column, the form or the comparison of
   the selected rows, delete or revert them, export them or the clicked column's values (ExportMenuItems) or copy a link,
   C# objects and seed data, and jump along foreign keys from them (outgoing and incoming with counts). Inside marked cells
   or columns (WP-58) their group comes first, and the row's entries take the clicked row; on a writable workspace one value,
   NULL or the top row's values for them, or one value for a column of the selected rows (WP-59). *@
@using FerretSharp.Core.ClrModel
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Data
@using FerretSharp.Core.Display
@using FerretSharp.Core.Forms
@using FerretSharp.Core.Oracle
@using FerretSharp.Core.Query
@using FerretSharp.Core.Schema
@inherits FerretComponent
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IFileSaveService Files
@inject ShortcutService Shortcuts
@inject ILogger<GridContextMenu> Logger

<PopoverMenu X="Request.X" Y="Request.Y" ViewportWidth="Request.ViewportWidth" ViewportHeight="Request.ViewportHeight"
             Width="MenuWidth" EstimatedHeight="EstimatedHeight" OnClose="CloseAsync">
    <div class="ctx-head">
        <span class="ctx-col">@Column.Name</span>
        <span class="ctx-value @(Request.CellText is null ? "fs-null" : "")">@(Request.CellText ?? "NULL")</span>
    </div>
    <button class="menu-item" disabled="@(Request.CellText is null)" @onclick="() => Export.CopyValueAsync(Column, Request.Row.Values[Request.Column])">@CommonText.CopyValue</button>
    @if (_cell is { } cell)
    {
        <button class="menu-item" disabled="@(cell.Code is null)" title="@(cell.Problem ?? cell.Code)" @onclick="() => Export.CopyTextAsync(cell.Code!)">
            @GridText.GridMenu_CopyAsCSharpValue
        </button>
    }
    @if (OracleTypeMapper.IsLob(Column))
    {
        <button class="menu-item" title="@(CanEdit ? GridText.GridMenu_OpenLobTitleEdit : GridText.GridMenu_OpenLobTitle)" @onclick="OpenLobAsync">
            @GridText.Grid_OpenContent
        </button>
    }
    @if (!Details.PrimaryKey.Contains(Column.Name))
    {
        <button class="menu-item" @onclick="TogglePinAsync">@(Pinned ? GridText.Grid_UnpinColumn : GridText.Grid_PinColumnLeft)</button>
    }
    <FormMenuItems Count="Request.Selected.Count" Indexes="Request.SelectedIndexes" Close="CloseAsync" OnOpenForm="OnOpenForm" OnCompare="OnCompare" />

    @if (CanEdit && Tab.Changes is { } changes)
    {
        var selected = Request.Selected.Select(r => changes.Find(r.Key)).ToList();
        <div class="group-head-btn static">@TextFormat.Format(GridText.GridMenu_EditGroup, RowsText(Request.Selected.Count))</div>
        @if (selected.Any(c => c?.Deleted is null))
        {
            <button class="menu-item danger" title="@TextFormat.Format(GridText.GridMenu_DeleteRowTitle, Shortcuts.Hint(ShortcutAction.Flush))" @onclick="() => EditRowsAsync(OnDeleteRows)">@GridText.GridMenu_DeleteRow</button>
        }
        @if (selected.Any(c => c is { HasPending: true }))
        {
            <button class="menu-item" title="@GridText.GridMenu_DiscardPendingTitle" @onclick="() => EditRowsAsync(OnRevertRows)">
                @GridText.GridMenu_DiscardPending
            </button>
        }
        @if (Request.Marks is null && Request.Selected.Count > 1)
        {
            var reason = NotSettable(Request.Column);
            <button class="menu-item" disabled="@(reason is not null)" title="@(reason ?? GridText.GridMenu_SetValueRowsTitle)" @onclick="SetRowsValueAsync">
                @TextFormat.Format(GridText.GridMenu_SetValueInColumn, Column.Name)
            </button>
        }
    }

    @if (Request.Marks is { } marks)
    {
        <MarkedCellsMenuItems Menu="marks" OnClose="CloseAsync" />
        @if (CanEdit && Tab.Changes is not null)
        {
            var refused = MarksRefusal(marks.Marks, CellFill.Null);
            var down = MarksRefusal(marks.Marks, CellFill.Down);
            var editor = refused is null ? EditorColumn(marks.Marks) : null;
            <div class="group-head-btn static">@TextFormat.Format(GridText.GridMenu_EditGroup, marks.Marks.Text)</div>
            <button class="menu-item" disabled="@(editor is null)" title="@(refused ?? (editor is null ? GridText.GridMenu_SetValueNoColumn : GridText.GridMenu_SetValueTitle))"
                    @onclick="() => SetMarksValueAsync(marks.Marks, editor!.Value)">@GridText.GridMenu_SetValue</button>
            <button class="menu-item" disabled="@(refused is not null)" title="@(refused ?? GridText.GridMenu_SetNullTitle)" @onclick="() => FillAsync(CellFill.Null)">
                @GridText.GridMenu_SetNull
            </button>
            <button class="menu-item" disabled="@(down is not null)" title="@(down ?? GridText.GridMenu_FillDownTitle)" @onclick="() => FillAsync(CellFill.Down)">
                @GridText.GridMenu_FillDown
            </button>
        }
    }
    <ExportMenuItems Export="Export" Table="Details" Rows="Request.Selected" FileName="@Details.Table.DisplayName" XlsxColumns="_xlsxColumns" InsertTable="Details"
                     XlsxColumnsToSave="@(() => PresentedExport.Columns(_presentation, Names.Copy()))" AllRows="_allRows" Marked="@(Request.Marks is not null)"
                     Column="@PresentedExport.Column(_presentation, Request.Column, Column.Name, Request.Column)">
        <button class="menu-item" @onclick="SaveInsertAsync">@GridText.GridMenu_SaveInsert</button>
        @if (Active.Profile is { } linkProfile)
        {
            @* Links (WP-37): to the selected rows by their primary key, or to the view with its filters and sort order. *@
            var rowsLink = Core.Links.TableLink.ForRows(linkProfile, Details, Request.Selected);
            <button class="menu-item" disabled="@(rowsLink.Link is null)" title="@(rowsLink.Unavailable ?? GridText.GridMenu_CopyRowsLinkTitle)"
                    @onclick="() => CopyLinkAsync(linkProfile, rowsLink.Link!, rowsOnly: true)">@GridText.GridMenu_CopyRowsLink</button>
            <button class="menu-item" title="@GridText.GridMenu_CopyViewLinkTitle"
                    @onclick="() => CopyLinkAsync(linkProfile, Core.Links.TableLink.For(linkProfile, Details.Table.Ref, Tab.AppliedFilters, Tab.Sorts, Tab.Mode), rowsOnly: false)">@GridText.GridMenu_CopyViewLink</button>
        }
    </ExportMenuItems>

    @if (_presentation.Entity is not null)
    {
        var seed = CSharpRows.HasDataUnavailable(_presentation);
        <div class="group-head-btn static">C# · @_presentation.EntityName · @RowsText(Request.Selected.Count)</div>
        <button class="menu-item" title="@GridText.GridMenu_CopyObjectsTitle" @onclick="CopyObjectsAsync">@GridText.GridMenu_CopyObjects</button>
        <button class="menu-item" disabled="@(seed is not null)" title="@(seed ?? GridText.GridMenu_CopySeedTitle)" @onclick="CopySeedAsync">@GridText.GridMenu_CopySeed</button>
    }

    <FkJumpSection Outgoing="_jumps.Outgoing" Incoming="_jumps.Incoming" Related="InvolvesColumn" RowsText="@Request.JumpRowsText" MissingRows="Request.MissingRows"
                   WorkspaceId="Tab.WorkspaceId" ShowEmpty="true" OnJumped="CloseAsync" />
</PopoverMenu>

@code {
    [CascadingParameter]
    public ActiveConnection Active { get; set; } = null!;

    [CascadingParameter]
    public PresentationService Presentations { get; set; } = null!;

    [CascadingParameter]
    public WorkspaceManager Workspaces { get; set; } = null!;

    private const double MenuWidth = 400;
    private const double ItemHeight = 44;

    private FkJumpLists _jumps = FkJumpLists.None;
    private DomModule? _dom;
    private ExportActions? _export;

    /// <summary>dom.js for the clipboard, imported on first use (<see cref="DomModule"/>).</summary>
    private DomModule Dom => _dom ??= new(JS);

    private ExportActions Export => _export ??= new(Shell, Dom, Files, Request.MissingRows, CloseAsync, Logger, Active);
    private TablePresentation _presentation = null!;

    /// <summary>The columns of the Excel export as the grid presents them (WP-53).</summary>
    private IReadOnlyList<ExportColumn> _xlsxColumns = [];

    /// <summary>All rows of the tab's query (WP-54).</summary>
    private AllRowsExport? _allRows;

    /// <summary>The clicked cell as C# (WP-15); null if the table has no entity.</summary>
    private CSharpValue? _cell;

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [Parameter, EditorRequired]
    public GridContextMenuRequest Request { get; set; } = null!;

    [Parameter, EditorRequired]
    public TableTab Tab { get; set; } = null!;

    [Parameter, EditorRequired]
    public TableDetails Details { get; set; } = null!;

    /// <summary>The names the grid has looked up beside its foreign keys (WP-31): the Excel export writes them in a column of their own.</summary>
    [Parameter]
    public DisplayNames Names { get; set; } = DisplayNames.None;

    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>Whether the clicked column is currently pinned.</summary>
    [Parameter]
    public bool Pinned { get; set; }

    [Parameter]
    public EventCallback<int> OnTogglePin { get; set; }

    /// <summary>Grid row indexes of the selected rows to mark for deletion.</summary>
    [Parameter]
    public EventCallback<IReadOnlyList<int>> OnDeleteRows { get; set; }

    /// <summary>Grid row indexes of the selected rows whose pending changes to drop.</summary>
    [Parameter]
    public EventCallback<IReadOnlyList<int>> OnRevertRows { get; set; }

    /// <summary>The workspace may write and the table can be edited (rows can be deleted, changes reverted).</summary>
    [Parameter]
    public bool CanEdit { get; set; }

    [Parameter]
    public EventCallback OnOpenLob { get; set; }

    /// <summary>Shows the clicked row in the form beside the grid (WP-21).</summary>
    [Parameter]
    public EventCallback OnOpenForm { get; set; }

    /// <summary>Compares the selected rows (grid indexes) side by side (WP-21).</summary>
    [Parameter]
    public EventCallback<IReadOnlyList<int>> OnCompare { get; set; }

    /// <summary>NULL or the top row's values for the marked cells (WP-59).</summary>
    [Parameter]
    public EventCallback<CellFill> OnFillMarks { get; set; }

    /// <summary>Opens "Set value…" for the marked cells or a column of the selected rows (WP-59).</summary>
    [Parameter]
    public EventCallback<SetValueRequest> OnSetValue { get; set; }


    private async Task OpenLobAsync()
    {
        await CloseAsync();
        await OnOpenLob.InvokeAsync();
    }

    private async Task EditRowsAsync(EventCallback<IReadOnlyList<int>> action)
    {
        var rows = Request.SelectedIndexes ?? [];
        await CloseAsync();
        await action.InvokeAsync(rows);
    }

    private ColumnInfo Column => Details.Columns[Request.Column];

    /// <summary>Why a column cannot take a value from the cell menu (WP-59); null if it can.</summary>
    private string? NotSettable(int column)
    {
        var info = Details.Columns[column];
        return OracleTypeMapper.NotEditableReason(Details, info, newRow: false)
               ?? (OracleTypeMapper.IsLob(info) ? TextFormat.Format(DataText.EditInLobEditor, info.DisplayType) : null);
    }

    /// <summary>
    /// Why a command cannot run on the marked cells (WP-59): whole columns before all their rows are loaded, too many rows,
    /// a fill down of one row. Null if it can.
    /// </summary>
    private string? MarksRefusal(GridMarks marks, CellFill fill) =>
        marks.Whole && !Tab.AllRowsLoaded ? GridText.Fill_ColumnsNotLoaded
        : ChangeTracker.FillRefusal(marks.Whole ? Tab.RowsLoaded : marks.Rows, fill);

    /// <summary>The column whose editor "Set value…" shows: the clicked one if it can take a value, else the first marked one that can.</summary>
    private int? EditorColumn(GridMarks marks)
    {
        var columns = marks.ColumnIndexes;
        return columns.Contains(Request.Column) && NotSettable(Request.Column) is null ? Request.Column
            : columns.Where(c => NotSettable(c) is null).Cast<int?>().FirstOrDefault();
    }

    private async Task FillAsync(CellFill fill)
    {
        await CloseAsync();
        await OnFillMarks.InvokeAsync(fill);
    }

    private async Task SetMarksValueAsync(GridMarks marks, int column)
    {
        await CloseAsync();
        await OnSetValue.InvokeAsync(new SetValueRequest(Request.Row, column, marks, [], marks.Text));
    }

    private async Task SetRowsValueAsync()
    {
        var rows = Request.SelectedIndexes ?? [];
        await CloseAsync();
        await OnSetValue.InvokeAsync(new SetValueRequest(Request.Row, Request.Column, null, rows, $"{Column.Name} · {RowsText(rows.Count)}"));
    }

    /// <summary>For the first placement; dom.js keepInViewport corrects it once rendered.</summary>
    private double EstimatedHeight => 336 + ItemHeight * (_jumps.Count + Math.Max(0, _jumps.Headings - 2) + (ExportMenuItems.OffersRaw(_xlsxColumns) ? 2 : 1) + ExportMenuItems.ColumnEntries + ExportMenuItems.AllRowsEntries(_allRows, _xlsxColumns))
                                      + (_cell is null ? 0 : 128) + (Request.MissingRows > 0 ? 40 : 0)
                                      + (Request.Marks is null ? 0 : ItemHeight * (MarkedCellsMenuItems.Entries - 1 - ExportMenuItems.ColumnEntries))
                                      + (!CanEdit ? 0 : Request.Marks is not null ? ItemHeight * 4 : Request.Selected.Count > 1 ? ItemHeight : 0);

    protected override void OnInitialized()
    {
        _presentation = Presentations.For(Details);
        _xlsxColumns = PresentedExport.Columns(_presentation, Names);
        _allRows = AllRowsExports.ForTable(Tab, Details, _presentation, Names, Presentations.For, Workspaces.GetDataAsync);
        _cell = _presentation.Entity is null ? null : CSharpRows.Cell(_presentation, Request.Column, Request.Row.Values[Request.Column]);
        if (Active.Schema is not { } schema)
        {
            return;
        }

        var row = Details.Table.Ref;
        _jumps = FkJumpLists.Of(
            FkNavigation.JumpsFor(Details, Request.JumpRows, schema.OutgoingOf(row), schema.IncomingOf(row), schema.InheritedIncomingOf(row)), InvolvesColumn);
    }

    private bool InvolvesColumn(FkJump jump) => jump.RowColumns.Contains(Column.Name);

    private async Task TogglePinAsync()
    {
        await CloseAsync();
        await OnTogglePin.InvokeAsync(Request.Column);
    }

    private static string RowsText(long rows) => ExportActions.RowsText(rows);

    private Task CopyObjectsAsync() => Export.CopyAsync(CSharpRows.Initializers(_presentation, Request.Selected), ExportCopy.CSharpObjects);

    private Task CopySeedAsync() => Export.CopyAsync(CSharpRows.HasData(_presentation, Request.Selected), ExportCopy.HasData);

    private Task SaveInsertAsync() =>
        Export.SaveAsync(InsertExport.Build(Details, Request.Selected), Details.Table.DisplayName + ".sql", GridText.Export_SqlScriptFilter, utf8Bom: false);

    private async Task CopyLinkAsync(FerretSharp.Core.Connections.ConnectionProfile profile, Core.Links.TableLink link, bool rowsOnly)
    {
        await LinkCopy.CopyAsync(Shell, Dom, profile, link, rowsOnly);
        await CloseAsync();
    }

    private Task CloseAsync() => OnClose.InvokeAsync();

    public ValueTask DisposeAsync() => Dom.DisposeAsync();
}
