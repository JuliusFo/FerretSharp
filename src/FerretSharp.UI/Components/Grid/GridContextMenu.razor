@* Right-click menu of a grid cell, rebuilt in WP-61 (it had grown to some 40 lines): the cell as head, a quick bar of icons
   for the single actions – copy the value (also as C#), open a LOB, pin the column, the form or the comparison of the
   selected rows, the record diagram, the copy into another connection, links –, a filter field that narrows actions and
   foreign keys as you type, the lines for editing (delete or revert the selected rows, one value for a column of them,
   WP-59) and for marked cells or columns (WP-58: copy them, one value, NULL or the top row's values for them), the export
   as a matrix of format × copy / save selected / save all with the clicked column's values as chips (ExportMatrix, C#
   objects and seed data with an entity), and the jumps along foreign keys (outgoing and incoming with counts, one line
   each, NULL ones and long lists folded). Inside marked cells the row's entries take the clicked row. *@
@using FerretSharp.Core.ClrModel
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Data
@using FerretSharp.Core.Display
@using FerretSharp.Core.Forms
@using FerretSharp.Core.Oracle
@using FerretSharp.Core.Query
@using FerretSharp.Core.Schema
@inherits FerretComponent
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IFileSaveService Files
@inject ShortcutService Shortcuts
@inject ILogger<GridContextMenu> Logger

<PopoverMenu X="Request.X" Y="Request.Y" ViewportWidth="Request.ViewportWidth" ViewportHeight="Request.ViewportHeight"
             Width="MenuWidth" EstimatedHeight="EstimatedHeight" KeyNavigation="true" OnClose="CloseAsync">
    <CascadingValue Value="_filter">
        <div class="ctx-head">
            <span class="ctx-col">@Column.Name</span>
            <span class="ctx-value @(Request.CellText is null ? "fs-null" : "")">@(Request.CellText ?? "NULL")</span>
        </div>
        <QuickBar>
            <QuickAction Icon="Icons.Copy" Label="@CommonText.CopyValue" Unavailable="@(Request.CellText is null ? GridText.Quick_ValueIsNull : null)"
                         OnClick="() => Export.CopyValueAsync(Column, Request.Row.Values[Request.Column])" />
            @if (_cell is { } cell)
            {
                <QuickAction Icon="Icons.Braces" Label="@GridText.GridMenu_CopyAsCSharpValue" Title="@cell.Code" Unavailable="@cell.Problem"
                             OnClick="() => Export.CopyTextAsync(cell.Code!)" />
            }
            @if (OracleTypeMapper.IsLob(Column))
            {
                <QuickAction Icon="Icons.Document" Label="@GridText.Grid_OpenContent" Title="@(CanEdit ? GridText.GridMenu_OpenLobTitleEdit : GridText.GridMenu_OpenLobTitle)"
                             OnClick="OpenLobAsync" />
            }
            @{ var primary = Details.PrimaryKey.Contains(Column.Name); }
            <QuickAction Icon="Icons.Pin" Label="@(primary ? GridText.ColumnMenu_PkPinned : Pinned ? GridText.Grid_UnpinColumn : GridText.Grid_PinColumnLeft)" Active="@(Pinned || primary)"
                         Unavailable="@(primary ? GridText.ColumnMenu_PkPinnedTitle : null)" OnClick="TogglePinAsync" />
            <FormQuickAction Count="Request.Selected.Count" Indexes="Request.SelectedIndexes" Close="CloseAsync" OnOpenForm="OnOpenForm" OnCompare="OnCompare" />
            <QuickAction Icon="Icons.Records" Label="@($"{GridText.GridMenu_Records} · {RowsText(Request.JumpRows.Count)}")" Title="@GridText.GridMenu_RecordsTitle"
                         Unavailable="@RecordsUnavailable" OnClick="ShowRecordsAsync" />
            <QuickAction Icon="Icons.Transfer" Label="@($"{GridText.GridMenu_CopyToConnection} · {RowsText(Request.JumpRows.Count)}")" Title="@GridText.GridMenu_CopyToConnectionTitle"
                         Unavailable="@CopyUnavailable" OnClick="CopyToConnectionAsync" />
            @if (Active.Profile is { } linkProfile)
            {
                @* Links (WP-37): to the selected rows by their primary key, or to the view with its filters and sort order. *@
                var rowsLink = Core.Links.TableLink.ForRows(linkProfile, Details, Request.Selected);
                <QuickAction Icon="Icons.Link" Label="@GridText.GridMenu_CopyRowsLink" Title="@GridText.GridMenu_CopyRowsLinkTitle" Unavailable="@rowsLink.Unavailable"
                             OnClick="() => CopyLinkAsync(linkProfile, rowsLink.Link!, rowsOnly: true)" />
                <QuickAction Icon="Icons.LinkView" Label="@GridText.GridMenu_CopyViewLink" Title="@GridText.GridMenu_CopyViewLinkTitle"
                             OnClick="() => CopyLinkAsync(linkProfile, Core.Links.TableLink.For(linkProfile, Details.Table.Ref, Tab.AppliedFilters, Tab.Sorts, Tab.Mode), rowsOnly: false)" />
            }
        </QuickBar>
        <SearchBox Class="popover-search ctx-filter" Value="@_filter.Text" ValueChanged="text => _filter.Set(text)" Placeholder="@GridText.Menu_FilterPlaceholder" />

        <div class="ctx-body" data-empty="@GridText.Menu_NoMatch">
            @if (CanEdit && Tab.Changes is { } changes)
            {
                var selected = Request.Selected.Select(r => changes.Find(r.Key)).ToList();
                var group = TextFormat.Format(GridText.GridMenu_EditGroup, RowsText(Request.Selected.Count));
                var delete = selected.Any(c => c?.Deleted is null);
                var revert = selected.Any(c => c is { HasPending: true });
                var setValue = Request.Marks is null && Request.Selected.Count > 1;
                var setLabel = TextFormat.Format(GridText.GridMenu_SetValueInColumn, Column.Name);
                @if ((delete || revert || setValue) && Matches(group, delete ? GridText.GridMenu_DeleteRow : null, revert ? GridText.GridMenu_DiscardPending : null, setValue ? setLabel : null))
                {
                    <div class="group-head-btn static">@group</div>
                }
                @if (delete)
                {
                    <MenuEntry Label="@GridText.GridMenu_DeleteRow" Group="@group" Danger="true" Title="@TextFormat.Format(GridText.GridMenu_DeleteRowTitle, Shortcuts.Hint(ShortcutAction.Flush))"
                               OnClick="() => EditRowsAsync(OnDeleteRows)" />
                }
                @if (revert)
                {
                    <MenuEntry Label="@GridText.GridMenu_DiscardPending" Group="@group" Title="@GridText.GridMenu_DiscardPendingTitle" OnClick="() => EditRowsAsync(OnRevertRows)" />
                }
                @if (setValue)
                {
                    <MenuEntry Label="@setLabel" Group="@group" Unavailable="@NotSettable(Request.Column)" Title="@GridText.GridMenu_SetValueRowsTitle" OnClick="SetRowsValueAsync" />
                }
            }

            @if (Request.Marks is { } marks)
            {
                <MarkedCellsMenuItems Menu="marks" OnClose="CloseAsync" />
                @if (CanEdit && Tab.Changes is not null)
                {
                    var refused = MarksRefusal(marks.Marks, CellFill.Null);
                    var down = MarksRefusal(marks.Marks, CellFill.Down);
                    var editor = refused is null ? EditorColumn(marks.Marks) : null;
                    var group = TextFormat.Format(GridText.GridMenu_EditGroup, marks.Marks.Text);
                    @if (Matches(group, GridText.GridMenu_SetValue, GridText.GridMenu_SetNull, GridText.GridMenu_FillDown))
                    {
                        <div class="group-head-btn static">@group</div>
                    }
                    <MenuEntry Label="@GridText.GridMenu_SetValue" Group="@group" Unavailable="@(refused ?? (editor is null ? GridText.GridMenu_SetValueNoColumn : null))"
                               Title="@GridText.GridMenu_SetValueTitle" OnClick="() => SetMarksValueAsync(marks.Marks, editor!.Value)" />
                    <MenuEntry Label="@GridText.GridMenu_SetNull" Group="@group" Unavailable="@refused" Title="@GridText.GridMenu_SetNullTitle" OnClick="() => FillAsync(CellFill.Null)" />
                    <MenuEntry Label="@GridText.GridMenu_FillDown" Group="@group" Unavailable="@down" Title="@GridText.GridMenu_FillDownTitle" OnClick="() => FillAsync(CellFill.Down)" />
                }
            }

            <ExportMatrix Export="Export" Table="Details" Rows="Request.Selected" FileName="@Details.Table.DisplayName" XlsxColumns="_xlsxColumns" InsertTable="Details" InsertFile="true"
                          XlsxColumnsToSave="@(() => PresentedExport.Columns(_presentation, Names.Copy()))" AllRows="_allRows" Marked="@(Request.Marks is not null)" More="_csharp"
                          Column="@PresentedExport.Column(_presentation, Request.Column, Column.Name, Request.Column)" />

            <FkJumpSection Outgoing="_jumps.Outgoing" Incoming="_jumps.Incoming" Related="InvolvesColumn" RowsText="@Request.JumpRowsText" MissingRows="Request.MissingRows"
                           WorkspaceId="Tab.WorkspaceId" ShowEmpty="true" OnJumped="CloseAsync" />
        </div>
    </CascadingValue>
</PopoverMenu>

@code {
    [CascadingParameter]
    public ActiveConnection Active { get; set; } = null!;

    [CascadingParameter]
    public PresentationService Presentations { get; set; } = null!;

    [CascadingParameter]
    public WorkspaceManager Workspaces { get; set; } = null!;

    private const double MenuWidth = 400;
    private const double LineHeight = 32;

    private readonly MenuFilter _filter = new();
    private FkJumpLists _jumps = FkJumpLists.None;

    /// <summary>C# objects and seed data of the selected rows as rows of the export matrix; none without an entity.</summary>
    private IReadOnlyList<ExportMatrixRow> _csharp = [];
    private DomModule? _dom;
    private ExportActions? _export;

    /// <summary>dom.js for the clipboard, imported on first use (<see cref="DomModule"/>).</summary>
    private DomModule Dom => _dom ??= new(JS);

    private ExportActions Export => _export ??= new(Shell, Dom, Files, Request.MissingRows, CloseAsync, Logger, Active);
    private TablePresentation _presentation = null!;

    /// <summary>The columns of the Excel export as the grid presents them (WP-53).</summary>
    private IReadOnlyList<ExportColumn> _xlsxColumns = [];

    /// <summary>All rows of the tab's query (WP-54).</summary>
    private AllRowsExport? _allRows;

    /// <summary>The clicked cell as C# (WP-15); null if the table has no entity.</summary>
    private CSharpValue? _cell;

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [Parameter, EditorRequired]
    public GridContextMenuRequest Request { get; set; } = null!;

    [Parameter, EditorRequired]
    public TableTab Tab { get; set; } = null!;

    [Parameter, EditorRequired]
    public TableDetails Details { get; set; } = null!;

    /// <summary>The names the grid has looked up beside its foreign keys (WP-31): the Excel export writes them in a column of their own.</summary>
    [Parameter]
    public DisplayNames Names { get; set; } = DisplayNames.None;

    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>Whether the clicked column is currently pinned.</summary>
    [Parameter]
    public bool Pinned { get; set; }

    [Parameter]
    public EventCallback<int> OnTogglePin { get; set; }

    /// <summary>Grid row indexes of the selected rows to mark for deletion.</summary>
    [Parameter]
    public EventCallback<IReadOnlyList<int>> OnDeleteRows { get; set; }

    /// <summary>Grid row indexes of the selected rows whose pending changes to drop.</summary>
    [Parameter]
    public EventCallback<IReadOnlyList<int>> OnRevertRows { get; set; }

    /// <summary>The workspace may write and the table can be edited (rows can be deleted, changes reverted).</summary>
    [Parameter]
    public bool CanEdit { get; set; }

    [Parameter]
    public EventCallback OnOpenLob { get; set; }

    /// <summary>Shows the clicked row in the form beside the grid (WP-21).</summary>
    [Parameter]
    public EventCallback OnOpenForm { get; set; }

    /// <summary>Compares the selected rows (grid indexes) side by side (WP-21).</summary>
    [Parameter]
    public EventCallback<IReadOnlyList<int>> OnCompare { get; set; }

    /// <summary>NULL or the top row's values for the marked cells (WP-59).</summary>
    [Parameter]
    public EventCallback<CellFill> OnFillMarks { get; set; }

    /// <summary>Opens "Set value…" for the marked cells or a column of the selected rows (WP-59).</summary>
    [Parameter]
    public EventCallback<SetValueRequest> OnSetValue { get; set; }

    /// <summary>Why the rows cannot be copied to another connection (none open, a view); null if they can (WP-42).</summary>
    [Parameter]
    public string? CopyUnavailable { get; set; }

    /// <summary>Opens the copy of the selected rows (or the clicked one) into another connection (WP-42).</summary>
    [Parameter]
    public EventCallback OnCopyToConnection { get; set; }

    private async Task CopyToConnectionAsync()
    {
        await CloseAsync();
        await OnCopyToConnection.InvokeAsync();
    }

    /// <summary>Why the rows cannot start a record diagram (a view, keys without exact text); null if they can (WP-60).</summary>
    [Parameter]
    public string? RecordsUnavailable { get; set; }

    /// <summary>Opens a record diagram tab of the selected rows (or the clicked one), WP-60.</summary>
    [Parameter]
    public EventCallback OnShowRecords { get; set; }

    private async Task ShowRecordsAsync()
    {
        await CloseAsync();
        await OnShowRecords.InvokeAsync();
    }

    private async Task OpenLobAsync()
    {
        await CloseAsync();
        await OnOpenLob.InvokeAsync();
    }

    private async Task EditRowsAsync(EventCallback<IReadOnlyList<int>> action)
    {
        var rows = Request.SelectedIndexes ?? [];
        await CloseAsync();
        await action.InvokeAsync(rows);
    }

    private ColumnInfo Column => Details.Columns[Request.Column];

    /// <summary>Why a column cannot take a value from the cell menu (WP-59); null if it can.</summary>
    private string? NotSettable(int column) => ChangeTracker.FillUnavailable(Details, Details.Columns[column]);

    /// <summary>
    /// Why a command cannot run on the marked cells (WP-59): whole columns before all their rows are loaded, too many rows,
    /// a fill down of one row. Null if it can.
    /// </summary>
    private string? MarksRefusal(GridMarks marks, CellFill fill) =>
        marks.Whole && !Tab.AllRowsLoaded ? GridText.Fill_ColumnsNotLoaded
        : ChangeTracker.FillRefusal(marks.Whole ? Tab.RowsLoaded : marks.Rows, fill);

    /// <summary>The column whose editor "Set value…" shows: the clicked one if it can take a value, else the first marked one that can.</summary>
    private int? EditorColumn(GridMarks marks)
    {
        var columns = marks.ColumnIndexes;
        return columns.Contains(Request.Column) && NotSettable(Request.Column) is null ? Request.Column
            : columns.Where(c => NotSettable(c) is null).Cast<int?>().FirstOrDefault();
    }

    private async Task FillAsync(CellFill fill)
    {
        await CloseAsync();
        await OnFillMarks.InvokeAsync(fill);
    }

    private async Task SetMarksValueAsync(GridMarks marks, int column)
    {
        await CloseAsync();
        await OnSetValue.InvokeAsync(new SetValueRequest(Request.Row, column, marks, [], marks.Text));
    }

    private async Task SetRowsValueAsync()
    {
        var rows = Request.SelectedIndexes ?? [];
        await CloseAsync();
        await OnSetValue.InvokeAsync(new SetValueRequest(Request.Row, Request.Column, null, rows, $"{Column.Name} · {RowsText(rows.Count)}"));
    }

    /// <summary>For the first placement; dom.js menuKeys corrects it once rendered, and whenever the menu grows.</summary>
    private double EstimatedHeight => 170 + LineHeight * (ExportMatrix.Lines(_xlsxColumns, _csharp.Count) + JumpLines + (CanEdit ? 3 : 0))
                                      + (Request.Marks is null ? 0 : LineHeight * MarkedCellsMenuItems.Entries);

    /// <summary>Jumps shown before a folded line opens, with their headings.</summary>
    private int JumpLines =>
        _jumps.Headings + FkJumpLists.FoldNull(_jumps.Outgoing, InvolvesColumn).Shown.Count + 1 + Math.Min(_jumps.Incoming.Count, FkJumpLists.ShownIncoming + 1);

    protected override void OnInitialized()
    {
        _presentation = Presentations.For(Details);
        _xlsxColumns = PresentedExport.Columns(_presentation, Names);
        _allRows = AllRowsExports.ForTable(Tab, Details, _presentation, Names, Presentations.For, Workspaces.GetDataAsync);
        _cell = _presentation.Entity is null ? null : CSharpRows.Cell(_presentation, Request.Column, Request.Row.Values[Request.Column]);
        _csharp = _presentation.Entity is null ? [] :
        [
            new(GridText.Matrix_CSharpObjects, new(GridText.GridMenu_CopyObjects, $"{_presentation.EntityName}: {GridText.GridMenu_CopyObjectsTitle}", CopyObjectsAsync)),
            new("HasData", new(GridText.GridMenu_CopySeed, GridText.GridMenu_CopySeedTitle, CopySeedAsync, CSharpRows.HasDataUnavailable(_presentation))),
        ];
        if (Active.Schema is not { } schema)
        {
            return;
        }

        var row = Details.Table.Ref;
        _jumps = FkJumpLists.Of(
            FkNavigation.JumpsFor(Details, Request.JumpRows, schema.LinksOf(row), schema.IncomingOf(row), schema.InheritedIncomingOf(row)), InvolvesColumn);
    }

    private bool InvolvesColumn(FkJump jump) => jump.RowColumns.Contains(Column.Name);

    private async Task TogglePinAsync()
    {
        await CloseAsync();
        await OnTogglePin.InvokeAsync(Request.Column);
    }

    private static string RowsText(long rows) => ExportActions.RowsText(rows);

    /// <summary>A heading stays while the filter matches it or one of its lines (null: a line not offered).</summary>
    private bool Matches(string group, params string?[] lines) =>
        !_filter.Active || _filter.Matches(group) || lines.Any(line => line is not null && _filter.Matches(line));

    private Task CopyObjectsAsync() => Export.CopyAsync(CSharpRows.Initializers(_presentation, Request.Selected), ExportCopy.CSharpObjects);

    private Task CopySeedAsync() => Export.CopyAsync(CSharpRows.HasData(_presentation, Request.Selected), ExportCopy.HasData);

    private async Task CopyLinkAsync(FerretSharp.Core.Connections.ConnectionProfile profile, Core.Links.TableLink link, bool rowsOnly)
    {
        await LinkCopy.CopyAsync(Shell, Dom, profile, link, rowsOnly);
        await CloseAsync();
    }

    private Task CloseAsync() => OnClose.InvokeAsync();

    public ValueTask DisposeAsync() => Dom.DisposeAsync();
}
