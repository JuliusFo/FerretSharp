@* The chips of a column header menu that copy all values of the column (WP-57, as chips since WP-61) – of the table tab's
   filter or of the SQL editor's result, read again in the background: one value per line, as IN list, or each once. *@
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Data
@using FerretSharp.Core.Query
@using FerretSharp.Core.Schema
@inject IClipboardService Clipboard
@inject ILogger<AllValueChips> Logger

<ValueChips Heading="@All.Heading" Stacked="true" Title="@All.Tooltip" Unavailable="@(ColumnValues.CanCopy(Column) ? null : GridText.GridMenu_CopyColumnUnavailable)"
            OnCopy="CopyAsync" />

@code {
    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [CascadingParameter]
    public ActiveConnection Active { get; set; } = null!;

    /// <summary>The column with its database type: LOBs and the like cannot be copied.</summary>
    [Parameter, EditorRequired]
    public ColumnInfo Column { get; set; } = null!;

    /// <summary>The column as presented (enum members); the IN list takes the database values.</summary>
    [Parameter, EditorRequired]
    public ExportColumn Presented { get; set; } = null!;

    [Parameter, EditorRequired]
    public AllColumnValues All { get; set; } = null!;

    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>Rows with pending changes of the column: the read does not have them, the notice says so (WP-58).</summary>
    [Parameter]
    public int Pending { get; set; }

    /// <summary>Closes the menu first: the read goes on in the background, shown in the status bar.</summary>
    private async Task CopyAsync(ColumnValuesFormat format)
    {
        var (shell, active, column, presented, all, pending) = (Shell, Active, Column, Presented, All, Pending);
        await OnClose.InvokeAsync();
        await ColumnValueCopies.CopyAllAsync(shell, Clipboard, Logger, active, presented, column.Name, format, all, ColumnValueCopies.PendingLeftOut(pending));
    }
}
