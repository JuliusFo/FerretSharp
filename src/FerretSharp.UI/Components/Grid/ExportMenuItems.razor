@* The export group of a right-click menu (R6b, review 3.40.0, B5; WP-53 had to add Excel to two menus): copy the rows as
   table or INSERT, save them as CSV or Excel – and as Excel with database names and raw values when the columns are
   presented. Further entries of the group (a SQL script, links) as child content. Below, the same files from all rows of
   the grid's query (WP-54), read again block by block. Files are written after the dialog, in the background (A13). The
   values of the clicked column from the selected rows, one per line or as an IN list (WP-57). *@
@using FerretSharp.Core.Data
@using FerretSharp.Core.Query
@using FerretSharp.Core.Schema
@inject ShortcutService Shortcuts

<div class="group-head-btn static">@TextFormat.Format(GridText.GridMenu_ExportGroup, ExportActions.RowsText(Rows.Count))</div>
<button class="menu-item" title="@GridText.GridMenu_CopyTableTitle" @onclick="CopyTableAsync">@GridText.GridMenu_CopyTable</button>
@if (Column is { } column)
{
    var name = Table.Columns[column.Source].Name;
    var unavailable = ColumnValues.CanCopy(column.Column) ? null : GridText.GridMenu_CopyColumnUnavailable;
    <button class="menu-item" disabled="@(unavailable is not null)" title="@(unavailable ?? TextFormat.Format(GridText.GridMenu_CopyColumnTitle, Shortcuts.Hint(ShortcutAction.CopyColumnValues)))"
            @onclick="() => Export.CopyColumnAsync(column, name, ColumnValuesFormat.Lines, Rows)">@TextFormat.Format(GridText.GridMenu_CopyColumn, name)</button>
    <button class="menu-item" disabled="@(unavailable is not null)" title="@(unavailable ?? GridText.GridMenu_CopyColumnInListTitle)"
            @onclick="() => Export.CopyColumnAsync(column, name, ColumnValuesFormat.InList, Rows)">@TextFormat.Format(GridText.GridMenu_CopyColumnInList, name)</button>
}
<button class="menu-item" disabled="@(InsertTable is null)" title="@InsertTitle" @onclick="CopyInsertAsync">@GridText.GridMenu_CopyInsert</button>
<button class="menu-item" title="@GridText.GridMenu_SaveCsvTitle" @onclick="SaveCsvAsync">@GridText.GridMenu_SaveCsv</button>
<button class="menu-item" title="@GridText.GridMenu_SaveXlsxTitle" @onclick="() => SaveXlsxAsync(XlsxColumnsToSave?.Invoke() ?? XlsxColumns)">@GridText.GridMenu_SaveXlsx</button>
@if (OffersRaw(XlsxColumns))
{
    <button class="menu-item" title="@GridText.GridMenu_SaveXlsxRawTitle" @onclick="() => SaveXlsxAsync(ExportColumn.Raw(Table))">@GridText.GridMenu_SaveXlsxRaw</button>
}
@ChildContent

@if (AllRows is { } all)
{
    <div class="group-head-btn static">@all.Heading</div>
    <button class="menu-item" title="@AllRowsTitle(GridText.GridMenu_SaveCsvTitle)" @onclick="() => SaveAllCsvAsync(all)">@GridText.GridMenu_SaveCsv</button>
    <button class="menu-item" title="@AllRowsTitle(GridText.GridMenu_SaveXlsxTitle)" @onclick="() => SaveAllXlsxAsync(all, all.Excel())">@GridText.GridMenu_SaveXlsx</button>
    @if (OffersRaw(XlsxColumns))
    {
        <button class="menu-item" title="@AllRowsTitle(GridText.GridMenu_SaveXlsxRawTitle)" @onclick="() => SaveAllXlsxAsync(all, new AllRowsExcel(ExportColumn.Raw(Table), null))">@GridText.GridMenu_SaveXlsxRaw</button>
    }
}

@code {
    [Parameter, EditorRequired]
    public ExportActions Export { get; set; } = null!;

    /// <summary>The columns of the rows (database names): CSV, the table copy and the raw Excel variant.</summary>
    [Parameter, EditorRequired]
    public TableDetails Table { get; set; } = null!;

    /// <summary>The selected rows.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<RowData> Rows { get; set; } = [];

    /// <summary>
    /// The clicked column as presented (<see cref="ExportColumn.Source"/>: its index in <see cref="Table"/>): its values can be
    /// copied (WP-57). Null offers no such entries.
    /// </summary>
    [Parameter]
    public ExportColumn? Column { get; set; }

    /// <summary>Entries for the clicked column – for the menu's estimated height.</summary>
    public const int ColumnEntries = 2;

    /// <summary>File name (without extension) offered for CSV and Excel.</summary>
    [Parameter, EditorRequired]
    public string FileName { get; set; } = "";

    /// <summary>The columns of the Excel export as the grid presents them (WP-53).</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<ExportColumn> XlsxColumns { get; set; } = [];

    /// <summary>
    /// The columns the Excel export of the selected rows writes, taken when it is chosen – over a copy of the names the grid
    /// has looked up, because the file is written in the background while the grid goes on (A13). Null writes
    /// <see cref="XlsxColumns"/>.
    /// </summary>
    [Parameter]
    public Func<IReadOnlyList<ExportColumn>>? XlsxColumnsToSave { get; set; }

    /// <summary>The table the INSERT statements write into; null disables "Copy as INSERT" (<see cref="InsertTitle"/> says why).</summary>
    [Parameter]
    public TableDetails? InsertTable { get; set; }

    [Parameter]
    public string InsertTitle { get; set; } = GridText.GridMenu_CopyInsertTitle;

    /// <summary>All rows of the grid's query (WP-54); null offers no such entries (the LINQ console).</summary>
    [Parameter]
    public AllRowsExport? AllRows { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Whether the raw Excel variant is offered – one entry more for the menu's estimated height.</summary>
    public static bool OffersRaw(IReadOnlyList<ExportColumn> columns) => ExportColumn.DiffersFromRaw(columns);

    /// <summary>Entries of the group for all rows (with its heading) – for the menu's estimated height.</summary>
    public static int AllRowsEntries(AllRowsExport? all, IReadOnlyList<ExportColumn> xlsxColumns) => all is null ? 0 : OffersRaw(xlsxColumns) ? 4 : 3;

    private static string AllRowsTitle(string format) => format + Environment.NewLine + GridText.GridMenu_AllRowsTitle;

    private Task CopyTableAsync() =>
        Export.CopyAsync(DelimitedExport.Build(Table, Rows, DelimitedExport.ClipboardSeparator), ExportCopy.Table);

    private Task CopyInsertAsync() => InsertTable is { } target
        ? Export.CopyAsync(InsertExport.Build(target, Rows), ExportCopy.Insert)
        : Task.CompletedTask;

    private Task SaveCsvAsync()
    {
        var (table, rows) = (Table, Rows);
        return Export.SaveRowsAsync(FileName + ".csv", GridText.Export_CsvFilter, rows.Count, (stream, progress, ct) =>
            RowExport.WriteAsync(RowExport.FromRows(rows), DelimitedExport.CreateWriter(stream, table), null, progress, ct));
    }

    private Task SaveXlsxAsync(IReadOnlyList<ExportColumn> columns)
    {
        var (rows, name) = (Rows, FileName);
        return Export.SaveRowsAsync(name + ".xlsx", GridText.Export_XlsxFilter, rows.Count, async (stream, progress, ct) =>
            await RowExport.WriteAsync(RowExport.FromRows(rows), await XlsxExport.CreateWriterAsync(stream, columns, name, rows.Count, ct), null, progress, ct));
    }

    private Task SaveAllCsvAsync(AllRowsExport all)
    {
        var table = Table;
        return Export.SaveAllRowsAsync(FileName + ".csv", GridText.Export_CsvFilter, all.Total, (stream, progress, ct) =>
            RowExport.WriteAsync(all.Read, DelimitedExport.CreateWriter(stream, table), null, progress, ct));
    }

    /// <param name="excel">The columns and the names they write, looked up while reading.</param>
    private Task SaveAllXlsxAsync(AllRowsExport all, AllRowsExcel excel)
    {
        var name = FileName;
        return Export.SaveAllRowsAsync(name + ".xlsx", GridText.Export_XlsxFilter, all.Total, async (stream, progress, ct) =>
            await RowExport.WriteAsync(all.Read, await XlsxExport.CreateWriterAsync(stream, excel.Columns, name, null, ct), excel.Names, progress, ct));
    }
}
