@* The FK jumps of a context menu (the grid's cell menu, the menu of a query result – WP-48): "Points to" and "Referenced
   by" with the rows behind incoming jumps, counted at once or on hover (FkCountMode), then "Referenced via" for what
   references a base table of the row's table (BaseTables); a jump opens the target table filtered. Each on one line (WP-61):
   jumps without a target (NULL) folded into "7 more are NULL", a long list of incoming ones into "… 22 more" – not shortened
   otherwise, the user jumps often. Typing into the menu's filter shows every jump whose table it matches. *@
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Query
@inherits FerretComponent
@implements IDisposable
@inject ILogger<FkJumpSection> Logger
@inject AppSettingsService Settings

@{
    var outgoing = Outgoing.Where(Shown).ToList();
    var (outShown, outFolded) = Filtering ? (outgoing, []) : FkJumpLists.FoldNull(outgoing, Related);
}
@if (outgoing.Count > 0)
{
    <div class="group-head-btn static">@TextFormat.Format(GridText.GridMenu_PointsTo, RowsText)</div>
    @foreach (var jump in outShown)
    {
        <FkJumpItem Jump="jump" Related="Related(jump)" OneLine="true" OnJump="JumpAsync" />
    }
    @if (outFolded.Count > 0)
    {
        @if (_nullsOpen)
        {
            @foreach (var jump in outFolded)
            {
                <FkJumpItem Jump="jump" OneLine="true" OnJump="JumpAsync" />
            }
        }
        else
        {
            <button type="button" class="menu-item ctx-fold" title="@string.Join(Environment.NewLine, outFolded.Select(j => FkTargets.Label(Active, j.Table)))"
                    @onclick="() => _nullsOpen = true">
                <span class="ctx-arrow">○</span>
                <span class="ctx-fold-text">@TextFormat.Plural(outFolded.Count, GridText.FkJump_MoreNullOne, GridText.FkJump_MoreNullOther)</span>
            </button>
        }
    }
}

@foreach (var (via, all) in FkJumpLists.Groups(Incoming))
{
    var jumps = all.Where(Shown).ToList();
    if (jumps.Count == 0)
    {
        continue;
    }

    var (shown, folded) = Filtering || _open.Contains(via?.ToString() ?? "") ? (jumps, []) : FkJumpLists.FoldIncoming(jumps);
    <div class="group-head-btn static" title="@(via is null ? null : FkTargets.ViaTitle(Active, via, all))">
        @(via is null ? TextFormat.Format(GridText.GridMenu_ReferencedBy, RowsText) : TextFormat.Format(GridText.GridMenu_ReferencedVia, FkTargets.Label(Active, via), RowsText))
    </div>
    @foreach (var jump in shown)
    {
        <FkJumpItem Jump="jump" Count="_counts.Of(jump)" Related="Related(jump)" OneLine="true" OnJump="JumpAsync" OnEnter="Hover" OnLeave="_counts.Leave" />
    }
    @if (folded.Count > 0)
    {
        var key = via?.ToString() ?? "";
        <button type="button" class="menu-item ctx-fold" title="@string.Join(Environment.NewLine, folded.Select(j => FkTargets.Label(Active, j.Table)))"
                @onclick="() => _open.Add(key)">
            <span class="ctx-arrow">…</span>
            <span class="ctx-fold-text">@TextFormat.Format(GridText.FkJump_More, folded.Count)</span>
        </button>
    }
}

@if (Outgoing.Count == 0 && Incoming.Count == 0)
{
    @if (ShowEmpty && !Filtering)
    {
        <div class="ctx-empty">@GridText.GridMenu_NoForeignKeys</div>
    }
}
else if (MissingRows > 0 && !Filtering)
{
    <div class="ctx-note">@TextFormat.Format(GridText.GridMenu_MissingRows, ExportActions.RowsText(MissingRows))</div>
}

@code {
    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [CascadingParameter]
    public ActiveConnection Active { get; set; } = null!;

    [CascadingParameter]
    public WorkspaceManager Workspaces { get; set; } = null!;

    /// <summary>What is typed into the menu's filter field; none in menus without one.</summary>
    [CascadingParameter]
    public MenuFilter? Filter { get; set; }

    private readonly CancellationTokenSource _cts = new();
    private FkCounts _counts = null!;

    /// <summary>"7 more are NULL" was opened.</summary>
    private bool _nullsOpen;

    /// <summary>Groups of incoming jumps whose "… more" was opened, by base table (empty: the direct ones).</summary>
    private readonly HashSet<string> _open = [];

    /// <summary>Jumps to the rows the selected rows reference, those over the clicked column first.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<FkJump> Outgoing { get; set; } = [];

    /// <summary>
    /// Jumps to the rows referencing the selected rows, those through base tables last (<see cref="FkJumpLists.Of"/>);
    /// counted in the workspace's session.
    /// </summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<FkJump> Incoming { get; set; } = [];

    /// <summary>The jump goes over the clicked column: highlighted, never folded.</summary>
    [Parameter, EditorRequired]
    public Func<FkJump, bool> Related { get; set; } = _ => false;

    /// <summary>" · 3 rows" after the headings if several rows are selected; empty for one row.</summary>
    [Parameter]
    public string RowsText { get; set; } = "";

    /// <summary>Selected rows no longer loaded: left out of the jumps, mentioned below them.</summary>
    [Parameter]
    public int MissingRows { get; set; }

    /// <summary>The workspace the rows were read in: incoming jumps are counted there.</summary>
    [Parameter, EditorRequired]
    public Guid WorkspaceId { get; set; }

    /// <summary>Says so when there are no jumps (a table grid); a query result without traced columns shows nothing.</summary>
    [Parameter]
    public bool ShowEmpty { get; set; }

    /// <summary>After a jump opened its tab: the menu closes.</summary>
    [Parameter]
    public EventCallback OnJumped { get; set; }

    private bool Filtering => Filter?.Active == true;

    /// <summary>The filter matches the jump's table (as labeled, with the C# entity), its key's columns or its constraint.</summary>
    private bool Shown(FkJump jump) =>
        Filter?.Matches(FkTargets.Label(Active, jump.Table), jump.Table.Name, string.Join(" ", jump.RowColumns), jump.ForeignKey.Name) != false;

    protected override void OnInitialized()
    {
        _counts = FkCounts.For(Shell, Logger, Active, Workspaces, WorkspaceId, () => InvokeAsync(StateHasChanged));
        // One after the other: they share the workspace's session. Closing the menu cancels the rest.
        if (Settings.Current.FkCounts == FkCountMode.Immediately)
        {
            var token = _cts.Token;
            Fire(() => _counts.CountAllAsync(Incoming, token));
        }
    }

    /// <summary>Counts the entry the mouse rests on (<see cref="FkCountMode.OnHover"/>); a jump then waits for one count at most.</summary>
    private void Hover(FkJump jump)
    {
        if (Settings.Current.FkCounts == FkCountMode.OnHover && jump.Direction == JumpDirection.Incoming && !_cts.IsCancellationRequested)
        {
            var token = _cts.Token;
            Fire(() => _counts.HoverAsync(jump, token));
        }
    }

    private async Task JumpAsync(FkJump jump)
    {
        await _cts.CancelAsync();
        Shell.OpenFiltered(FkTargets.SummaryOf(Active, jump.Table), jump.Filters);
        await OnJumped.InvokeAsync();
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
