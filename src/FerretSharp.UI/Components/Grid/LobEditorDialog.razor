@* LOB editor (WP-10): the whole CLOB/NCLOB/BLOB value of one cell – read it, save it to a file, and on a writable
   workspace replace it (text, file, NULL). The new value becomes a pending change like a cell edit. Text shows in Monaco
   (word selection, find, wrapping, JSON/XML colouring, JSON indenting); the editor owns the text, the dialog takes it
   before every decision (Escape, Apply, Save). *@
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Data
@using FerretSharp.Core.Oracle
@using FerretSharp.Core.Schema
@inject IFileSaveService SaveFiles
@inject IFileOpenService OpenFiles
@inject ILogger<LobEditorDialog> Logger
@inject ShortcutService Shortcuts
@inject AppSettingsService Settings

<ModalFrame Label="@Column.Name" Class="lob-dialog" OnCancel="CancelAsync" FocusOnOpen="true">
    <header>
        <span>@Column.Name <span class="lob-type">@Column.DisplayType · @Details.Table.DisplayName</span></span>
        <button class="icon-btn ghost" title="@CommonText.Close" @onclick="OnClose">@Icons.Close</button>
    </header>
    <div class="dialog-body">
        @if (_loading)
        {
            <div class="structure-loading"><span class="spinner"></span> @GridText.Lob_Loading</div>
        }
        else if (_error is not null)
        {
            <div class="test-result error"><span>@_error</span></div>
        }
        else
        {
            <div class="lob-info">
                <span class="@(Current is null ? "fs-null" : "")">@(Current is string && _editedLength is { } length ? LobContent.CharacterCount(length) : LobContent.Describe(Current))</span>
                @if (Changed)
                {
                    <span class="lob-changed">@GridText.Lob_Changed</span>
                }
                @if (!CanEdit)
                {
                    <span class="lob-readonly" title="@ReadOnlyReason">@GridText.Lob_ReadOnly</span>
                }
                @if (_notice is not null)
                {
                    <span class="lob-notice">@_notice</span>
                }
                @if (ShowsEditor)
                {
                    <span class="spacer"></span>
                    <div class="segmented small" role="group" title="@GridText.Lob_FormatTitle">
                        @foreach (var (format, label) in Formats)
                        {
                            <button class="seg @(_format == format ? "active" : "")" aria-pressed="@(_format == format ? "true" : "false")"
                                    @onclick="() => SetFormatAsync(format)">@label</button>
                        }
                    </div>
                    @if (_format == LobTextFormat.Json)
                    {
                        <button class="btn ghost small" title="@(CanEdit ? GridText.Lob_IndentTitle : GridText.Lob_IndentViewTitle)"
                                disabled="@_indenting" @onclick="IndentAsync">@GridText.Lob_Indent</button>
                    }
                    <button class="btn ghost small @(_wrap ? "active" : "")" aria-pressed="@(_wrap ? "true" : "false")"
                            title="@GridText.Lob_WordWrapTitle" @onclick="ToggleWrapAsync">@GridText.Lob_WordWrap</button>
                }
            </div>

            @if (IsBlob)
            {
                @if (_bytes is { } bytes)
                {
                    var kind = LobContent.Detect(bytes);
                    @if (kind.ImageMime is { } mime && bytes.Length <= MaxImagePreview)
                    {
                        <div class="lob-image"><img src="data:@mime;base64,@Convert.ToBase64String(bytes)" alt="@GridText.Lob_Preview" /></div>
                    }
                    <pre class="lob-hex">@LobContent.HexDump(bytes, HexBytes)@(bytes.Length > HexBytes ? "\n…" : "")</pre>
                }
            }
            else if (_isNull)
            {
                <div class="lob-null">NULL @if (CanEdit) { <button class="link-btn" @onclick="StartText">@GridText.Lob_EnterText</button> }</div>
            }
            else if (_tooLarge)
            {
                <div class="lob-null">@TextFormat.Format(GridText.Lob_TooLargeToEdit, LobContent.Size(LobLimits.MaxEditLength))</div>
            }
            else
            {
                @* A new editor for new content (file, indented view); typing stays in the same one. Escape that Monaco does
                   not need itself (no selection, no find box) reaches the dialog. *@
                <MonacoEditor @ref="_editor" @key="_editorVersion" Class="lob-text" Text="@_editorText" Language="@LanguageOf(_format)"
                              ReadOnly="@(!CanEdit)" ReadOnlyMessage="@(ReadOnlyReason ?? GridText.Lob_ReadOnly)" WordWrap="_wrap" LineFeed="true"
                              OnEdit="OnEdited" />
            }
        }
    </div>
    <footer>
        @if (!_loading && _error is null)
        {
            <button class="btn" disabled="@(Current is null)" @onclick="SaveToFileAsync">@GridText.Lob_SaveToFile</button>
            @if (CanEdit)
            {
                <button class="btn" @onclick="LoadFromFileAsync">@GridText.Lob_LoadFromFile</button>
                <button class="btn" disabled="@(Current is null)" @onclick="SetNull">@GridText.Lob_SetNull</button>
            }
        }
        <span class="spacer"></span>
        @if (CanEdit && !_loading && _error is null)
        {
            <button class="btn ghost" @onclick="OnClose">@CommonText.Cancel</button>
            <button class="btn primary" title="@TextFormat.Format(GridText.Lob_ApplyTitle, Shortcuts.Hint(ShortcutAction.Flush))" @onclick="ApplyAsync">@CommonText.Apply</button>
        }
        else
        {
            <button class="btn" @onclick="OnClose">@CommonText.Close</button>
        }
    </footer>
</ModalFrame>

@code {
    [CascadingParameter]
    public WorkspaceManager Workspaces { get; set; } = null!;

    [CascadingParameter]
    public ActiveConnection Active { get; set; } = null!;

    private const int HexBytes = 1024;
    private const int MaxImagePreview = 5 * 1024 * 1024;

    private bool _loading = true;
    private string? _error;
    private string? _notice;
    private object? _loaded; // as in the database (the workspace's transaction): reference for the concurrency check
    private string? _text; // the value as the dialog knows it: the editor's text once edited, taken before each decision
    private byte[]? _bytes;
    private bool _isNull;

    /// <summary>Changed other than by typing: NULL, a file, text for a NULL value.</summary>
    private bool _replaced;

    private MonacoEditor? _editor;
    private int _editorVersion;
    private string _editorText = ""; // what the current editor started with: the value while it is not edited

    /// <summary>
    /// Edited in the editor since it was created (undo back to the start is not) – as the editor reports it, and taken
    /// before each decision. Not a comparison of texts: Monaco rewrites line ends and drops a BOM when it takes the text.
    /// </summary>
    private bool _edited;

    private int? _editedLength; // the editor's length after an edit, for the character count
    private bool _indenting;
    private LobTextFormat _format;
    private bool _wrap;

    /// <summary>The text has no line break: it starts wrapped whatever the switch says (decision of the user).</summary>
    private bool _oneLine;

    /// <summary>
    /// Too large for the editor – decided when the value is shown, so that an edit (Indent, pasting) that grows past the
    /// limit does not take the editor away under the cursor.
    /// </summary>
    private bool _tooLarge;

    private static readonly (LobTextFormat Format, string Label)[] FormatLabels =
        [(LobTextFormat.Text, ""), (LobTextFormat.Json, "JSON"), (LobTextFormat.Xml, "XML")];

    private static IEnumerable<(LobTextFormat Format, string Label)> Formats =>
        FormatLabels.Select(f => f.Format == LobTextFormat.Text ? (f.Format, GridText.Lob_FormatText) : f);

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [Parameter, EditorRequired]
    public FerretGrid.LobRequest Request { get; set; } = null!;

    [Parameter, EditorRequired]
    public TableDetails Details { get; set; } = null!;

    [Parameter, EditorRequired]
    public TableTab Tab { get; set; } = null!;

    /// <summary>The workspace may write and the cell can be edited.</summary>
    [Parameter]
    public bool CanEdit { get; set; }

    [Parameter]
    public string? ReadOnlyReason { get; set; }

    /// <summary>Takes the new value (loaded, value); returns a message if it was refused.</summary>
    [Parameter]
    public Func<object?, object?, Task<string?>> OnApply { get; set; } = (_, _) => Task.FromResult<string?>(null);

    [Parameter]
    public EventCallback OnClose { get; set; }

    private bool Changed => _replaced || (!_isNull && CanEdit && _edited);

    private bool ShowsEditor => !_loading && _error is null && !IsBlob && !_isNull && _text is not null && !_tooLarge;

    /// <summary>Escape: with changes, closing goes through "Cancel" only – Escape in the text box must not drop a long edit.</summary>
    private async Task CancelAsync()
    {
        await TakeTextAsync();
        if (Changed)
        {
            _notice = TextFormat.Format(GridText.Lob_EscapeKeepsChanges, CommonText.Cancel, CommonText.Apply);
            return;
        }

        await OnClose.InvokeAsync();
    }

    /// <summary>
    /// The text as the editor has it: it reports typing only after a short pause, and Escape, Apply or Save may come
    /// sooner. Not edited (or undone back to the start): the text the editor started with, exactly – not Monaco's copy.
    /// A read-only editor may show the indented view – the value stays the loaded one.
    /// </summary>
    private async Task TakeTextAsync()
    {
        if (CanEdit && ShowsEditor && _editor is not null)
        {
            var edited = await _editor.GetEditedTextAsync();
            _edited = edited is not null;
            _text = edited ?? _editorText;
        }
    }

    private static string LanguageOf(LobTextFormat format) => format switch
    {
        LobTextFormat.Json => "fs-json",
        LobTextFormat.Xml => "xml",
        _ => "plaintext",
    };

    private ColumnInfo Column => Details.Columns[Request.Column];

    private bool IsBlob => ColumnCategories.Of(Column) == ColumnCategory.Blob;

    private object? Current => _isNull ? null : IsBlob ? _bytes : _text;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (Request.NewRow is { } added)
            {
                Show(added.ValueOf(Request.Column));
                return;
            }

            var row = Request.Row!;
            if (row.Values[Request.Column] is LobValue { Length: > LobLimits.MaxLoadLength } large)
            {
                _error = TextFormat.Format(GridText.Lob_TooLargeToLoad, LobContent.Size(large.Length), LobContent.Size(LobLimits.MaxLoadLength));
                return;
            }

            var result = await Shell.RunDbAsync(Logger, Active, async () =>
            {
                var data = await Workspaces.GetDataAsync(Tab.WorkspaceId, CancellationToken.None);
                return await data.ReadLobAsync(Details, row.Key, Request.Column, CancellationToken.None);
            });
            if (result.Value is not { } read)
            {
                _error = result.Error?.Display;
                return;
            }

            if (!read.Found)
            {
                _error = TextFormat.Format(GridText.Grid_RowGone, Shortcuts.Hint(ShortcutAction.Refresh));
                return;
            }

            _loaded = read.Value;
            // A pending value of this cell is what the user sees; the database value stays the reference.
            var change = Tab.Changes?.Find(row.Key);
            Show(change?.StageOf(Request.Column) == ChangeStage.Pending ? change.ValueOf(Request.Column) : _loaded);
        }
        finally
        {
            _loading = false;
        }
    }

    private void Show(object? value)
    {
        _isNull = value is null;
        _text = value as string ?? (IsBlob ? null : "");
        _bytes = value as byte[];
        _tooLarge = _text is not null && _text.Length > LobLimits.MaxEditLength;
        NewEditor(_text ?? "");
        _format = LobContent.DetectFormat(_editorText);
        _oneLine = _editorText.AsSpan().IndexOfAny('\r', '\n') < 0;
        _wrap = _oneLine || Settings.Current.LobWordWrap;
    }

    private void NewEditor(string text)
    {
        _editorText = text;
        _editorVersion++;
        _edited = false;
        _editedLength = null;
    }

    private void OnEdited(MonacoEditor.EditState state)
    {
        _edited = state.Edited;
        _editedLength = state.Edited ? state.Length : null; // undone: the value's own count, not Monaco's copy
    }

    private void StartText()
    {
        _isNull = false;
        Show("");
        _replaced = true;
    }

    private void SetNull()
    {
        _isNull = true;
        _text = IsBlob ? null : "";
        _bytes = null;
        _replaced = true;
        _notice = null;
    }

    private async Task SetFormatAsync(LobTextFormat format)
    {
        _format = format;
        if (_editor is not null)
        {
            await _editor.SetLanguageAsync(LanguageOf(format));
        }
    }

    /// <summary>
    /// JSON one member per line. Editable: an edit in the editor (undo takes it back), so the value changes only with
    /// Apply. Read-only: a view – a new editor with the indented text, the value stays the loaded one. Runs off the UI
    /// thread (megabytes take a second) and stops at the edit limit.
    /// </summary>
    private async Task IndentAsync()
    {
        if (_indenting)
        {
            return;
        }

        _indenting = true;
        try
        {
            await IndentShownAsync();
        }
        finally
        {
            _indenting = false;
        }
    }

    private async Task IndentShownAsync()
    {
        string shown;
        if (CanEdit)
        {
            await TakeTextAsync();
            shown = _text ?? "";
        }
        else
        {
            shown = _editorText;
        }

        var result = await Task.Run(() => LobContent.IndentJson(shown));
        if (result.TooLarge)
        {
            _notice = TextFormat.Format(GridText.Lob_TooLargeToIndent, LobContent.Size(LobLimits.MaxEditLength));
            return;
        }

        if (result.Text is not { } indented)
        {
            _notice = TextFormat.Format(GridText.Lob_InvalidJson, result.Line, result.Column);
            return;
        }

        _notice = null;
        if (indented == shown)
        {
            return;
        }

        if (CanEdit && _editor is not null)
        {
            // Monaco keeps a BOM apart from the text and adds it back in GetEditedTextAsync: not a second one.
            await _editor.SetTextAsync(indented.StartsWith('﻿') ? indented[1..] : indented);
            _text = indented;
            _edited = true;
            _editedLength = indented.Length;
        }
        else
        {
            NewEditor(indented);
        }
    }

    /// <summary>
    /// For text with line breaks the switch holds for the next dialog and after a restart. Text without starts wrapped
    /// anyway, so switching there is kept only for this dialog.
    /// </summary>
    private async Task ToggleWrapAsync()
    {
        _wrap = !_wrap;
        if (_editor is not null)
        {
            await _editor.SetWordWrapAsync(_wrap);
        }

        if (!_oneLine)
        {
            var wrap = _wrap;
            await Shell.TrySaveSettingsAsync(() => Settings.UpdateAsync(s => s with { LobWordWrap = wrap }, CancellationToken.None));
        }
    }

    private async Task SaveToFileAsync()
    {
        var name = $"{Details.Table.Name}_{Column.Name}";
        await TakeTextAsync();
        try
        {
            string? path = Current switch
            {
                string text => await SaveFiles.SaveTextAsync(name + ".txt", GridText.Lob_TextFileFilter, text, utf8Bom: false),
                byte[] bytes => await SaveFiles.SaveBytesAsync($"{name}.{LobContent.Detect(bytes).Extension}", GridText.Lob_FileFilter, bytes),
                _ => null,
            };
            if (path is not null)
            {
                Shell.Notify(TextFormat.Format(GridText.Lob_Saved, path));
            }
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            // A file open in another program, no permission: the dialog stays, the value is not lost.
            _notice = TextFormat.Format(CommonText.SaveFailed, ex.Message);
        }
    }

    private async Task LoadFromFileAsync()
    {
        OpenedFile? file;
        try
        {
            file = IsBlob
                ? await OpenFiles.OpenAsync(CommonText.AllFiles, [], LobLimits.MaxLoadLength)
                : await OpenFiles.OpenAsync(GridText.Lob_TextFilesFilter, ["txt", "xml", "json", "csv", "sql", "html"], LobLimits.MaxLoadLength);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _notice = TextFormat.Format(GridText.Lob_LoadFailed, ex.Message);
            return;
        }

        if (file is null)
        {
            return;
        }

        if (file.Content is not { } content)
        {
            _notice = TextFormat.Format(GridText.Lob_FileTooLarge, file.Name, LobContent.Size(file.Length), LobContent.Size(LobLimits.MaxLoadLength));
            return;
        }

        if (IsBlob)
        {
            Show(content);
            _notice = TextFormat.Format(GridText.Lob_FromFile, file.Name);
        }
        else
        {
            Show(LobContent.DecodeText(content, out var utf8));
            _notice = TextFormat.Format(utf8 ? GridText.Lob_FromFile : GridText.Lob_FromFileNotUtf8, file.Name);
        }

        _replaced = true;
    }

    private async Task ApplyAsync()
    {
        await TakeTextAsync();
        if (!Changed)
        {
            await OnClose.InvokeAsync();
            return;
        }

        if (await OnApply(_loaded, Current) is { } refused)
        {
            _notice = refused;
            return;
        }

        await OnClose.InvokeAsync();
    }
}
