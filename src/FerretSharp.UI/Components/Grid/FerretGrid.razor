@using System.Diagnostics
@using FerretSharp.Core.ClrModel
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Data
@using FerretSharp.Core.Display
@using FerretSharp.Core.Forms
@using FerretSharp.Core.Oracle
@using FerretSharp.Core.Query
@using FerretSharp.Core.Schema
@inherits FerretComponent
@implements IAsyncDisposable
@implements IFormGrid
@implements IDisplayNamesGrid
@implements IEditableGrid
@implements ISelectionGrid
@inject IJSRuntime JS
@inject ILogger<FerretGrid> Logger
@inject ShortcutService Shortcuts
@inject DisplayColumnSource DisplayColumns

<div id="@Tab.Id" class="ag-host"></div>

@code {
    [CascadingParameter]
    public ActiveConnection Active { get; set; } = null!;

    [CascadingParameter]
    public WorkspaceManager Workspaces { get; set; } = null!;

    [CascadingParameter]
    public PresentationService Presentations { get; set; } = null!;

    private readonly RowBlocks _blocks = new();

    /// <summary>grid.js; does nothing once disposed, so queued change handlers cannot touch the released module.</summary>
    private GridBridge _grid = null!;
    private bool _editable;
    private TablePresentation? _presentation;
    private PresentationWatch _presentationWatch = null!;

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [CascadingParameter]
    public WorkspaceLifecycle Lifecycle { get; set; } = null!;

    [Parameter, EditorRequired]
    public TableTab Tab { get; set; } = null!;

    [Parameter, EditorRequired]
    public TableDetails Details { get; set; } = null!;

    /// <summary>Raised after every page (or failure), so the tab footer can update.</summary>
    [Parameter]
    public EventCallback OnPageLoaded { get; set; }

    [Parameter]
    public EventCallback<GridContextMenuRequest> OnContextMenu { get; set; }

    [Parameter]
    public EventCallback<ColumnMenuRequest> OnColumnMenu { get; set; }

    /// <summary>Double click (or Enter) on a LOB cell: open the LOB editor.</summary>
    [Parameter]
    public EventCallback<LobRequest> OnLobOpen { get; set; }

    /// <summary>Writing became possible or impossible (workspace unlocked or locked again).</summary>
    [Parameter]
    public EventCallback OnEditableChanged { get; set; }

    /// <summary>Alt+Enter in the grid: the form of the focused row, or the comparison of the selected rows (WP-21).</summary>
    [Parameter]
    public EventCallback<FormRequest> OnFormRequested { get; set; }

    /// <summary>Alt+Enter: where the focus was and which rows were selected (grid indexes, in grid order).</summary>
    public sealed record FormRequest(GridCell? Focused, IReadOnlyList<int> Selected);

    /// <summary>The cell with the focus (click, arrow keys, the form's ▲ ▼); null before any.</summary>
    public GridCell? Focused { get; private set; }

    /// <summary>The focused cell moved: the form follows its row (WP-21).</summary>
    public event Action? FocusChanged;

    /// <summary>Rows were loaded, redrawn or changed: what the form shows may have changed.</summary>
    public event Action? RowsChanged;

    private static string ColumnId(int index) => GridColumn.IdOf(index);

    private static int ColumnIndex(string colId) => GridColumn.IndexOf(colId);

    protected override void OnInitialized() => _grid = new GridBridge(JS, Tab.Id, DotNetObjectReference.Create(this));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        Tab.PinnedColumns = ColumnPinning.Normalize(Details, Tab.PinnedColumns); // columns may have been dropped since
        _editable = CanEdit;
        if (_editable)
        {
            Tab.Changes ??= new ChangeTracker(Details);
        }

        Workspaces.Changed += OnWorkspacesChanged;
        Shell.Changed += OnShellChanged; // a write starts or ends (A3), the schema was reloaded (A15)
        _schemaLoadedAt = Active.Schema?.LoadedAt;
        Presentations.Changed += OnPresentationChanged;
        DisplayColumns.Changed += OnDisplayColumnsChanged;
        _displayVersion = DisplayColumns.Version;
        _presentationWatch = new PresentationWatch(Presentations);
        _presentation = Presentations.For(Details);
        _shownColumns = ShownColumns(Enumerable.Range(0, Details.Columns.Count).Select(ColumnMeta).ToList());
        var columns = ColumnPinning.DisplayOrder(Details, Tab.PinnedColumns).Select(ColumnMeta).ToList();
        var sorts = GridSorts(Tab.Sorts);

        // Closed while grid.js loaded or the grid was created (closing the tab, switching connections): nothing to show.
        await _grid.CreateAsync(columns, new GridOptions(sorts, Tab.FirstVisibleRow ?? 0, _editable, HeaderHeight, Table: true));
        if (Tab.Changes?.NewRows.Count > 0)
        {
            await SetNewRowsAsync(); // the tab was mounted again (workspace switch) with new rows still unsaved
        }

        // An unlock or a C# model that came while the grid was created: the handlers skipped it (R4a). Both check for
        // themselves whether anything changed.
        OnWorkspacesChanged();
        OnPresentationChanged();
        await DisplayNamesOf.PlanAsync();
    }

    /// <summary>How columns and values are shown: plain, or with the C# model (WP-12).</summary>
    public TablePresentation Presentation => _presentation ??= Presentations.For(Details);

    private int? HeaderHeight => Presentation.ShowsClrNames ? GridOptions.ClrHeaderHeight : null;

    /// <summary>What grid.js needs to know about a column (header, editing, member list).</summary>
    private GridColumn ColumnMeta(int i)
    {
        var c = Details.Columns[i];
        var category = ColumnCategories.Of(c);
        var label = Presentation.LabelOf(i);
        var values = Presentation.ValuesOf(i);
        var (fk, fkModel) = ForeignKeyBadges.Of(Active.Schema?.OutgoingOf(Details.Table.Ref) ?? [], c.Name);
        var lob = OracleTypeMapper.IsLob(c);
        var named = Names.Shows(i);
        return new GridColumn(ColumnId(i), c.Name, label.Name, c.DisplayType, category.ToString(), c.Nullable)
        {
            Alternate = label.AlternateName,
            ClrType = label.ClrType,
            ClrLine = Presentation.ShowsClrNames,
            Pk = Details.PrimaryKey.Contains(c.Name),
            Fk = fk,
            FkModel = fkModel,
            DisplayColumn = Details.Table.Kind != TableKind.View && DisplayColumns.Current().Columns.IndexIn(Details) == i,
            Numeric = category == ColumnCategory.Number && values is null && !named,
            Named = named,
            Sortable = ColumnCategories.IsSortable(category),
            Pinned = ColumnPinning.IsPinned(Details, Tab.PinnedColumns, c.Name),
            Comment = c.Comment,
            // LOBs are not edited in the cell: they open the LOB editor (also to read them whole on a locked workspace).
            Editable = !lob && OracleTypeMapper.NotEditableReason(Details, c, newRow: false) is null,
            EditableNew = !lob && OracleTypeMapper.NotEditableReason(Details, c, newRow: true) is null,
            Lob = lob,
            Multiline = category == ColumnCategory.Text && (c.Length ?? 0) > 200,
            Options = values?.Options,
            Flags = values?.Flags is not null,
            UnknownText = values?.UnknownText,
        };
    }

    /// <summary>
    /// The C# model was loaded (or unlinked) or the name setting changed: relabel the columns in place and redraw the
    /// rows, whose values may now read differently. Model relationships may add FK badges too.
    /// </summary>
    private void OnPresentationChanged() => Fire(async () =>
    {
        if (!_grid.IsCreated || _presentationWatch.Unchanged)
        {
            return;
        }

        var touched = _presentationWatch.Touches(Details.Table.Ref);
        // A display column of a target may read differently now (enum members): its names are looked up again.
        var targets = Names.Links.Any(l => _presentationWatch.Touches(l.Target.Table.Ref));
        _presentationWatch.Seen();
        _presentation = Presentations.For(Details); // the same reading, but no longer holding the previous model
        if (touched || targets)
        {
            await DisplayNamesOf.PlanAsync(force: targets); // relationships of the model may come or go
        }

        if (touched)
        {
            await UpdateColumnsAsync();
        }
    });

    /// <summary>
    /// Relabels the columns in place (C# names, badges) and fetches the rows again – only if the grid would show anything
    /// different.
    /// </summary>
    private async Task UpdateColumnsAsync()
    {
        var columns = Enumerable.Range(0, Details.Columns.Count).Select(ColumnMeta).ToList();
        // A new build reloads the whole model; most tables read exactly as before – their rows are not fetched again.
        var shown = ShownColumns(columns);
        if (shown == _shownColumns)
        {
            return;
        }

        _shownColumns = shown;
        if (await _grid.CallAsync("updateColumns", columns, HeaderHeight))
        {
            await ReloadAsync();
        }
    }

    // ---------- names beside foreign key values (WP-31) ----------

    private int _displayVersion;
    private GridDisplayNames? _displayNames;

    /// <summary>The names of the grid (the form shows them too); none before the grid planned them.</summary>
    public DisplayNames Names => _displayNames?.Names ?? DisplayNames.None;

    /// <summary>Plans, looks up and shows the names (<see cref="GridDisplayNames"/>, R5b).</summary>
    private GridDisplayNames DisplayNamesOf => _displayNames ??= new GridDisplayNames(this, PlanLinksAsync,
        (lookup, token) => Shell.RunDbAsync(Logger, Active, async () =>
        {
            var data = await Workspaces.GetDataAsync(Tab.WorkspaceId, token);
            return await DisplayNames.LookupAsync(data, lookup, DisplayNames.LookupTimeout, token);
        }, token),
        NameFormatter, i => Details.Columns[i].Name);

    /// <summary>The display columns file or the setting changed: header badges, and which columns get names.</summary>
    private void OnDisplayColumnsChanged() => Fire(async () =>
    {
        if (!_grid.IsCreated || DisplayColumns.Version == _displayVersion)
        {
            return;
        }

        _displayVersion = DisplayColumns.Version;
        await DisplayNamesOf.PlanAsync();
        await UpdateColumnsAsync();
    });

    /// <summary>The foreign key columns whose target has a display column; none if the setting is off or planning failed.</summary>
    private async Task<IReadOnlyList<DisplayLink>> PlanLinksAsync()
    {
        var shown = DisplayColumns.Shown;
        if (shown.Count == 0 || Active.Schema is not { } schema)
        {
            return [];
        }

        var details = Details;
        var planned = await Shell.RunDbAsync(Logger, Active, () => DisplayLinks.PlanAsync(details, schema, shown, CancellationToken.None));
        return planned.Value ?? [];
    }

    /// <summary>
    /// The display value of a target as text, with the targets' presentation as it is when a name is formatted (a model may
    /// load meanwhile), reused per version.
    /// </summary>
    private Func<DisplayLink, object?, string?> NameFormatter()
    {
        var presentations = new Dictionary<TableRef, TablePresentation>();
        var version = Presentations.Version;
        return (link, value) =>
        {
            if (Presentations.Version != version)
            {
                version = Presentations.Version;
                presentations.Clear();
            }

            if (!presentations.TryGetValue(link.Target.Table.Ref, out var target))
            {
                presentations[link.Target.Table.Ref] = target = Presentations.For(link.Target);
            }

            return target.Present(link.DisplayColumn, value).Text;
        };
    }

    bool IDisplayNamesGrid.IsAlive => _grid.IsCreated;

    IEnumerable<IReadOnlyList<object?>> IDisplayNamesGrid.HeldRows() => _blocks.All().Select(r => ValuesOf(r.Row)).Concat(NewRowValues());

    void IDisplayNamesGrid.Fire(Func<Task> work) => Fire(work);

    void IDisplayNamesGrid.Notify(string text) => Shell.Notify(text);

    /// <summary>
    /// New column metadata (badges, alignment of columns with names) without fetching the rows again: they are redrawn
    /// from the held values. An open cell editor stays open – this comes at any moment (a lookup's answer, a file change).
    /// </summary>
    public async Task RelabelAsync()
    {
        var columns = Enumerable.Range(0, Details.Columns.Count).Select(ColumnMeta).ToList();
        var shown = ShownColumns(columns);
        if (shown != _shownColumns && _grid.IsCreated)
        {
            _shownColumns = shown;
            await _grid.CallAsync("updateColumns", columns, HeaderHeight, true);
        }
    }

    /// <summary>A row's values as the grid shows them: pending and flushed edits over the loaded ones.</summary>
    private IReadOnlyList<object?> ValuesOf(RowData row) =>
        Tab.Changes?.Find(row.Key) is { } change ? ValuesOf(change) : row.Values;

    private IReadOnlyList<object?> ValuesOf(RowChange change) => Enumerable.Range(0, Details.Columns.Count).Select(change.ValueOf).ToList();

    /// <summary>
    /// A row with the values the grid shows – what copying, the context menu and its exports take (decision of the user,
    /// review 3.31.0 A21: they took the loaded values while the grid and the form showed the pending ones).
    /// </summary>
    private RowData Shown(RowData row) => Tab.Changes?.Find(row.Key) is null ? row : row with { Values = ValuesOf(row) };

    private IEnumerable<IReadOnlyList<object?>> NewRowValues() => (Tab.Changes?.NewRows ?? []).Select(ValuesOf);

    /// <summary>Redraws the held rows (and new rows) whose values <paramref name="touches"/> selects (names arrived for them).</summary>
    public async Task RedrawAsync(Func<IReadOnlyList<object?>, bool> touches)
    {
        var updates = _blocks.All()
            .Where(r => touches(ValuesOf(r.Row)))
            .Select(r => new GridRowUpdate(r.Index, GridRow(r.Row)))
            .ToList();
        if (updates.Count > 0)
        {
            await _grid.CallAsync("updateRows", updates);
        }

        if (NewRowValues().Any(touches))
        {
            await UpdateNewRowsAsync();
        }

        if (updates.Count > 0)
        {
            RowsChanged?.Invoke();
        }
    }

    /// <summary>Rows sent to grid.js per call when every held row is redrawn (up to 40 blocks).</summary>
    private const int RedrawBatch = 1000;

    /// <summary>Redraws every held row (the links changed: names come or go).</summary>
    public async Task RedrawAllAsync()
    {
        if (!_grid.IsCreated)
        {
            return;
        }

        foreach (var batch in _blocks.All().Chunk(RedrawBatch))
        {
            await _grid.CallAsync("updateRows", batch.Select(r => new GridRowUpdate(r.Index, GridRow(r.Row))).ToList());
        }

        await UpdateNewRowsAsync();
        RowsChanged?.Invoke();
    }

    /// <summary>
    /// Redraws the new rows in place: unlike <see cref="SetNewRowsAsync"/>, grid.js keeps their nodes, so a cell being
    /// edited in one of them stays open (names arrive at any moment).
    /// </summary>
    private Task UpdateNewRowsAsync() =>
        Tab.Changes?.NewRows is { Count: > 0 } rows
            ? _grid.CallAsync("updateNewRows", rows.Select(r => GridRow(r, null)).ToList())
            : Task.CompletedTask;

    /// <summary>The column metadata the grid shows, in schema order (to skip presentation changes that change nothing).</summary>
    private string? _shownColumns;

    private string ShownColumns(IReadOnlyList<GridColumn> columns) => System.Text.Json.JsonSerializer.Serialize(new { columns, HeaderHeight });

    /// <summary>Fetches the loaded rows again where they are (after writing, commit, rollback) and redraws the new rows.</summary>
    public async Task ReloadAsync()
    {
        // Names may read differently after writing, commit or rollback – also when the first block is no longer held and
        // GetRows never starts at row 0.
        DisplayNamesOf.Clear();
        if (await _grid.CallAsync("reload"))
        {
            await SetNewRowsAsync();
        }
    }

    /// <summary>Reloads from the first row, e.g. after filters changed.</summary>
    public async Task RefreshAsync()
    {
        Tab.TotalCount = null;
        await _grid.CallAsync("refresh");
    }

    /// <summary>
    /// Reloads from the first row sorted by <paramref name="sorts"/> (a filter preset, WP-37): the grid takes the new
    /// order and asks for the first rows itself – one query, not a refresh and then a sort.
    /// </summary>
    public async Task RefreshAsync(IReadOnlyList<SortSpec> sorts)
    {
        Tab.TotalCount = null;
        await _grid.CallAsync("setSorts", GridSorts(sorts));
    }

    private List<GridSort> GridSorts(IReadOnlyList<SortSpec> sorts) => sorts
        .Where(s => IndexOf(s.Column) >= 0)
        .Select(s => new GridSort(ColumnId(IndexOf(s.Column)), s.Descending ? "desc" : "asc"))
        .ToList();

    public Task SetRowCountAsync(long count) => _grid.CallAsync("setRowCount", (int)Math.Min(count, int.MaxValue));

    /// <summary>
    /// Editing is possible in workspaces that may write – connections without the read-only lock, or a workspace the
    /// user unlocked (WP-10) – for tables with a row key (v2, WP-09), and not while the workspace writes or commits.
    /// </summary>
    public bool CanEdit => Workspaces.IsWritable(Tab.WorkspaceId)
                           && Details.Table.Kind == TableKind.Table
                           && QueryBuilder.RowKeyOf(Details) != RowKeyKind.None
                           && !WriteRunning;

    /// <summary>
    /// The workspace writes or commits: an edit now could be marked written without being sent, or be cleared by the
    /// commit (review 3.31.0, A3). The grid stops editing meanwhile; edits that still arrive are refused.
    /// </summary>
    private bool WriteRunning => Lifecycle.Editing.IsBusy(Tab.WorkspaceId);

    /// <summary>Typed values, Del, delete and revert, new rows, LOB contents (R6b, review 3.40.0, B10).</summary>
    private GridEditing Editing => new(this, Details);

    ChangeTracker? IEditableGrid.Changes => Tab.Changes;

    bool IEditableGrid.WriteRunning => WriteRunning;

    RowData? IEditableGrid.RowAt(int rowIndex) => _blocks.At(rowIndex);

    Dictionary<string, object?> IEditableGrid.Draw(RowChange? change, IReadOnlyList<object?>? values) => GridRow(change, values);

    async Task IEditableGrid.UpdateRowsAsync(List<GridRowUpdate> updates) => await _grid.CallAsync("updateRows", updates);

    Task IEditableGrid.SetNewRowsAsync() => SetNewRowsAsync();

    void IEditableGrid.QueueDisplayNames(IReadOnlyList<object?> values) => DisplayNamesOf.Queue([values]);

    void IEditableGrid.ChangesMade() => ChangesMade();

    void IEditableGrid.Notify(string text) => Shell.Notify(text);

    string IEditableGrid.RowNotLoaded => RowNotLoaded;

    /// <summary>When the connection's schema was loaded last (<see cref="OnShellChanged"/>).</summary>
    private DateTimeOffset? _schemaLoadedAt;

    /// <summary>
    /// A write started or ended (editing on or off), or the schema was reloaded (review 3.31.0, A15): a tab whose own
    /// structure stayed is not rebuilt, but its foreign keys or their targets may have changed – a renamed display column
    /// failed with ORA-00904, a new foreign key showed neither badge nor names. The links are planned again.
    /// </summary>
    private void OnShellChanged()
    {
        OnWorkspacesChanged();
        if (_grid.IsCreated && Active.Schema?.LoadedAt is { } loaded && loaded != _schemaLoadedAt)
        {
            _schemaLoadedAt = loaded;
            Fire(async () =>
            {
                await DisplayNamesOf.PlanAsync(force: true);
                await UpdateColumnsAsync();
            });
        }
    }

    /// <summary>Unlocking or locking the workspace switches editing in the grid on or off without reloading it.</summary>
    private void OnWorkspacesChanged() => Fire(async () =>
    {
        if (!_grid.IsCreated || CanEdit == _editable)
        {
            return;
        }

        _editable = CanEdit;
        if (_editable)
        {
            Tab.Changes ??= new ChangeTracker(Details);
        }
        else if (Tab.Changes is { HasChanges: false })
        {
            Tab.Changes = null; // locked again (after commit or rollback): nothing to keep
        }

        if (await _grid.CallAsync("setEditable", _editable))
        {
            await OnEditableChanged.InvokeAsync();
        }
    });

    /// <summary>A LOB cell to open in the LOB editor: a loaded row (with its grid index) or a new row.</summary>
    public sealed record LobRequest(int RowIndex, RowData? Row, RowChange? NewRow, int Column);

    /// <summary>Double click or Enter on a LOB cell (grid.js).</summary>
    [JSInvokable]
    public Task OnLobCell(int rowIndex, string? newId, string colId) => GuardAsync(() => OnLobCellCoreAsync(rowIndex, newId, colId));

    private async Task OnLobCellCoreAsync(int rowIndex, string? newId, string colId)
    {
        var column = ColumnIndex(colId);
        if (NewRow(newId) is { } added)
        {
            await OnLobOpen.InvokeAsync(new LobRequest(-1, null, added, column));
        }
        else if (_blocks.At(rowIndex) is { } row)
        {
            await OnLobOpen.InvokeAsync(new LobRequest(rowIndex, row, null, column));
        }
    }

    /// <summary>Opens the LOB editor for a cell of a loaded row (context menu).</summary>
    public Task OpenLobAsync(int rowIndex, int column) =>
        _blocks.At(rowIndex) is { } row ? OnLobOpen.InvokeAsync(new LobRequest(rowIndex, row, null, column)) : Task.CompletedTask;

    /// <summary>The LOB editor's result: the whole new value; <paramref name="loaded"/> is what it read from the database.</summary>
    public Task<string?> SetLobAsync(LobRequest request, object? loaded, object? value) =>
        Editing.SetContentAsync(request.NewRow is null ? (request.RowIndex, request.Row!) : null, request.NewRow, request.Column, loaded, value);

    /// <summary>
    /// A grid row: display texts by column id, with pending/flushed values of the tab's changes laid over the loaded
    /// ones. Extra fields for grid.js: <c>__s</c> stage per column ("p" pending, "f" flushed), <c>__d</c> deleted
    /// ("p"/"f"), <c>__ro</c> columns whose value cannot be edited, <c>__u</c> columns whose value is no member of
    /// their enum (WP-12), <c>__t</c> extra tooltip per column (the C# member behind a display text), <c>__new</c> id
    /// of a new row.
    /// </summary>
    private Dictionary<string, object?> GridRow(RowData row) => GridRow(Tab.Changes?.Find(row.Key), row.Values);

    private Dictionary<string, object?> GridRow(RowChange? change, IReadOnlyList<object?>? values) => GridRows.Build(Presentation, change, values, Names);

    private RowChange? NewRow(string? newId) => GridRows.NewRow(Tab.Changes, newId);

    /// <summary>Full value of a cell for the editor (pending value if any); null if it cannot be edited.</summary>
    [JSInvokable]
    public string? GetEditText(int rowIndex, string? newId, string colId) => Guard(() => EditTextOf(rowIndex, newId, colId), null);

    private string? EditTextOf(int rowIndex, string? newId, string colId)
    {
        var column = ColumnIndex(colId);
        if (NewRow(newId) is { } added)
        {
            return EditText(column, added.ValueOf(column));
        }

        return _blocks.At(rowIndex) is { } row
            ? EditText(column, Tab.Changes?.Find(row.Key)?.ValueOf(column) ?? row.Values[column])
            : null;
    }

    /// <summary>
    /// The flags editor of a cell (flags enum stored as its number): which boxes there are and which are ticked comes from
    /// .NET, grid.js only shows them and adds up the ticked values. Null if the cell cannot be edited.
    /// </summary>
    [JSInvokable]
    public FlagsEdit? GetFlagsEdit(int rowIndex, string? newId, string colId) => Guard(() =>
    {
        var column = ColumnIndex(colId);
        return EditTextOf(rowIndex, newId, colId) is { } text
            ? Presentation.ValuesOf(column)?.FlagsEditOf(text, nullAllowed: Details.Columns[column].Nullable || newId is not null)
            : null;
    }, null);

    /// <summary>The edit text; for enum and bool columns the member's database value as the member list has it.</summary>
    private string EditText(int column, object? value) =>
        Presentation.ValuesOf(column)?.OptionOf(value) is { } option
            ? option.Value
            : OracleTypeMapper.EditText(Details.Columns[column], value);

    /// <summary>Enter in the editor: the message if the text cannot be taken; the editor then stays open.</summary>
    [JSInvokable]
    public string? ValidateEdit(int rowIndex, string? newId, string colId, string text) => Guard(() =>
    {
        var column = Details.Columns[ColumnIndex(colId)];
        if (NewRow(newId) is not null)
        {
            // Empty stays allowed while filling a new row (see ChangeTracker.SetValue).
            return string.IsNullOrEmpty(text) ? null : OracleTypeMapper.Parse(column, text).Error;
        }

        return _blocks.At(rowIndex) is null
            ? RowNotLoaded
            : OracleTypeMapper.Parse(column, text).Error;
    }, CommonText.UnexpectedError);

    /// <summary>The user finished editing a cell: check the text in .NET and keep it as a pending change.</summary>
    [JSInvokable]
    public GridEdit OnCellEdit(int rowIndex, string? newId, string colId, string text) =>
        Guard(() => Edit(rowIndex, newId, ColumnIndex(colId), text), new GridEdit(null, CommonText.UnexpectedError));

    /// <summary>
    /// A value typed in the form (WP-21): checked and kept like a cell edit, the grid redraws the row. Returns the
    /// message if the text cannot be taken. Synchronous, so the form can hand over typed values right before writing.
    /// </summary>
    public string? EditFromForm(GridCell cell, int column, string text)
    {
        var edit = Edit(cell.RowIndex, cell.NewId, column, text);
        if (edit.Row is { } row)
        {
            // A list, not an array: an array would become the params array of CallAsync itself (one object per row for grid.js).
            Fire(() => cell.IsNew ? SetNewRowsAsync() : _grid.CallAsync("updateRows", new List<GridRowUpdate> { new(cell.RowIndex, row) }));
        }

        return edit.Error;
    }

    private string RowNotLoaded => TextFormat.Format(GridText.Grid_RowNotLoaded, Shortcuts.Hint(ShortcutAction.Refresh));

    private GridEdit Edit(int rowIndex, string? newId, int column, string text) => Editing.Edit(rowIndex, newId, column, text);

    /// <summary>The focused cell moved (grid.js reports the last position after a short pause).</summary>
    [JSInvokable]
    public void OnFocused(int rowIndex, string? newId, string? colId) => Guard(() =>
    {
        Focused = new GridCell(rowIndex, newId, colId is not null && colId.StartsWith('c') ? ColumnIndex(colId) : null);
        FocusChanged?.Invoke();
    });

    public GridSelection Selection { get; private set; } = GridSelection.None;

    public event Action? SelectionChanged;

    /// <summary>The selection changed (grid.js reports the last state after a short pause); the footer shows it.</summary>
    [JSInvokable]
    public void OnSelectionChanged(int count, bool toEnd) => Guard(() =>
    {
        Selection = new GridSelection(count, toEnd);
        SelectionChanged?.Invoke();
    });

    /// <summary>Alt+Enter in the grid (WP-21).</summary>
    [JSInvokable]
    public Task OnFormKey(int rowIndex, string? newId, int[] selectedRows)
    {
        var focused = rowIndex < 0 && newId is null ? null : new GridCell(rowIndex, newId, Focused?.Column);
        return GuardAsync(() => OnFormRequested.InvokeAsync(new FormRequest(focused, selectedRows.Order().ToList())));
    }

    /// <summary>The row at a grid position with the tab's changes; null if its block is not (or no longer) loaded.</summary>
    public FormRow? RowOf(GridCell cell) =>
        cell.IsNew
            ? NewRow(cell.NewId) is { } added ? new FormRow(null, added) : null
            : RowAt(cell.RowIndex);

    /// <summary>A loaded row with the tab's changes; null if its block is not (or no longer) loaded.</summary>
    public FormRow? RowAt(int rowIndex) => _blocks.At(rowIndex) is { } row ? new FormRow(row, Tab.Changes?.Find(row.Key)) : null;

    /// <summary>Grid index of a loaded row by its key (the form finds its row again after writing or reloading).</summary>
    public int? IndexOf(RowKey key) => _blocks.IndexOf(key);

    /// <summary>The grid position of a new row that is not inserted yet; null if it is gone (inserted or removed).</summary>
    public GridCell? CellOf(RowChange newRow, int? column) =>
        Tab.Changes?.NewRows.Contains(newRow) == true ? new GridCell(-1, GridRows.NewRowId(newRow), column) : null;

    /// <summary>
    /// Moves the grid's focus to a row (the form's ▲ ▼); a block not loaded yet is fetched. <paramref name="keepFocus"/>:
    /// the keyboard stays in the form. <paramref name="select"/>: the row becomes the selection, as with the arrow keys
    /// (opening or closing the form keeps the selection).
    /// </summary>
    public Task FocusRowAsync(GridCell cell, bool keepFocus, bool select = false)
    {
        var pinned = cell.IsNew;
        var index = pinned ? GridRows.NewRowIndex(Tab.Changes, cell.NewId) : cell.RowIndex;
        if (index < 0)
        {
            return Task.CompletedTask;
        }

        Focused = cell with { RowIndex = pinned ? -1 : index };
        return _grid.CallAsync("focusRow", index, cell.Column is { } column ? ColumnId(column) : null, pinned, keepFocus, select);
    }

    /// <summary>
    /// Focuses and selects the row of a change (change overview, WP-30): a new row at the top, a loaded row where it is. False if the
    /// row is not among the loaded rows (or the grid not created yet).
    /// </summary>
    public async Task<bool> FocusChangeAsync(RowChange change)
    {
        if (!_grid.IsCreated)
        {
            return false;
        }

        if (change is { IsNew: true, IsInserted: false })
        {
            if (CellOf(change, null) is not { } cell)
            {
                return false;
            }

            await FocusRowAsync(cell, keepFocus: false, select: true);
            return true;
        }

        if (IndexOf(change.Key) is not { } index)
        {
            return false;
        }

        await FocusRowAsync(new GridCell(index, null, null), keepFocus: false, select: true);
        return true;
    }

    /// <summary>
    /// Ctrl+Z / Ctrl+Y in the grid (WP-30, changeable): takes back or applies again the last pending edit of this tab –
    /// written changes are taken back with ↶. The rows it touched are redrawn.
    /// </summary>
    [JSInvokable]
    public Task OnEditHistoryKey(bool undo) => GuardAsync(async () =>
    {
        if (Tab.Changes is not { } changes || Editing.StoppedByWrite())
        {
            return;
        }

        var touched = undo ? changes.UndoEdit() : changes.RedoEdit();
        if (touched.Count == 0)
        {
            Shell.Notify(undo ? GridText.Grid_NothingToUndoEdit : GridText.Grid_NothingToRedoEdit);
            return;
        }

        await RedrawAsync(touched);
        ChangesMade();
    });

    /// <summary>Redraws the rows of changes made outside the grid's own edits (edit history, change overview).</summary>
    public async Task RedrawAsync(IReadOnlyList<RowChange> changes)
    {
        var updates = changes
            .Where(c => c is not { IsNew: true, IsInserted: false })
            .Select(c => IndexOf(c.Key))
            .OfType<int>()
            .Distinct()
            .Select(i => (Index: i, Row: _blocks.At(i)))
            .Where(r => r.Row is not null)
            .Select(r => new GridRowUpdate(r.Index, GridRow(r.Row!)))
            .ToList();
        if (updates.Count > 0)
        {
            await _grid.CallAsync("updateRows", updates);
        }

        // New rows may have come back, gone or changed: they are few, all of them are set again.
        await SetNewRowsAsync();
    }

    /// <summary>Opens the LOB editor for a cell of the form's row (loaded or new).</summary>
    public Task OpenLobAsync(GridCell cell, int column) =>
        cell.IsNew
            ? NewRow(cell.NewId) is { } added ? OnLobOpen.InvokeAsync(new LobRequest(-1, null, added, column)) : Task.CompletedTask
            : OpenLobAsync(cell.RowIndex, column);

    /// <summary>Copies the full value of a cell, like Ctrl+C (the form's "Copy value").</summary>
    public async Task CopyValueAsync(ColumnInfo column, object? value)
    {
        var cell = DelimitedExport.CellText(column, value);
        if (await CopyTextAsync(cell.Text))
        {
            Shell.Notify(cell.Warnings.Count > 0 ? GridText.Grid_ValueNotCopied : TextFormat.Format(GridText.Grid_ColumnCopied, column.Name), cell.Warnings);
        }
    }

    /// <summary>Del in the grid: the focused new row disappears, otherwise the selected loaded rows are marked for deletion.</summary>
    [JSInvokable]
    public Task<GridRowUpdate[]> OnDeleteKey(int[] rowIndexes, string? focusedNewId) =>
        GuardAsync(() => OnDeleteKeyCoreAsync(rowIndexes, focusedNewId), []);

    private Task<GridRowUpdate[]> OnDeleteKeyCoreAsync(int[] rowIndexes, string? focusedNewId) => Editing.DeleteKeyAsync(rowIndexes, focusedNewId);

    /// <summary>Deletes or reverts rows from the context menu; redraws them.</summary>
    public Task ChangeRowsAsync(IReadOnlyList<int> rowIndexes, bool delete) => Editing.ChangeRowsAsync(rowIndexes, delete);

    /// <summary>
    /// Adds an empty new row at the top and starts editing its first editable cell – or, with
    /// <paramref name="inGrid"/> false (the form is open, WP-21), only focuses the row: it is filled in the form.
    /// </summary>
    public async Task AddRowAsync(bool inGrid = true)
    {
        if (!_grid.IsCreated || await Editing.AddRowAsync(ColumnPinning.DisplayOrder(Details, Tab.PinnedColumns)) is not { } added)
        {
            return;
        }

        var first = added.Column is { } column ? ColumnId(column) : null;
        if (!inGrid)
        {
            Focused = new GridCell(-1, GridRows.NewRowId(added.Row), added.Column);
            FocusChanged?.Invoke();
            await _grid.CallAsync("focusRow", added.PinnedIndex, first, true, true);
        }
        else if (first is not null)
        {
            await _grid.CallAsync("startEditing", added.PinnedIndex, first, true);
        }
    }

    /// <summary>The new (not yet inserted) rows, pinned at the top of the grid.</summary>
    public async Task SetNewRowsAsync()
    {
        await _grid.CallAsync("setNewRows", (Tab.Changes?.NewRows ?? []).Select(r => GridRow(r, null)).ToList());
        RowsChanged?.Invoke();
    }

    /// <summary>The changes of the tab changed: the status bar and the tab header show counts, the form its values.</summary>
    private void ChangesMade()
    {
        Shell.NotifyChanged();
        RowsChanged?.Invoke();
    }

    /// <summary>Scrolls the column into view, highlights it briefly and focuses its cell in the first visible row.</summary>
    public Task JumpToColumnAsync(int column) => _grid.CallAsync("jumpToColumn", ColumnId(column));

    public bool IsPinned(int column) => ColumnPinning.IsPinned(Details, Tab.PinnedColumns, Details.Columns[column].Name);

    /// <summary>Pins or releases a column (from the column or cell menu); the primary key stays pinned.</summary>
    public async Task TogglePinAsync(int column)
    {
        Tab.PinnedColumns = ColumnPinning.Toggle(Details, Tab.PinnedColumns, Details.Columns[column].Name);
        Shell.MarkDirty();
        var pinned = ColumnPinning.DisplayOrder(Details, Tab.PinnedColumns)
            .Where(i => IsPinned(i))
            .Select(ColumnId)
            .ToList();
        await _grid.CallAsync("setPinned", pinned);
    }

    /// <summary>The user pinned, released or reordered pinned columns by dragging; <paramref name="colIds"/> in display order.</summary>
    [JSInvokable]
    public void OnPinnedChanged(string[] colIds) => Guard(() =>
    {
        Tab.PinnedColumns = ColumnPinning.Normalize(Details, colIds.Select(id => Details.Columns[ColumnIndex(id)].Name));
        Shell.MarkDirty();
    });

    [JSInvokable]
    public Task OnHeaderContextMenu(string colId, double x, double y, double viewportWidth, double viewportHeight) =>
        GuardAsync(() => OnColumnMenu.InvokeAsync(new ColumnMenuRequest(ColumnIndex(colId), x, y, viewportWidth, viewportHeight)));

    [JSInvokable]
    public Task<GridPage> GetRows(int startRow, int endRow, GridSort[] sortModel) =>
        GuardAsync(() => GetRowsCoreAsync(startRow, endRow, sortModel), GridPage.Failure);

    private async Task<GridPage> GetRowsCoreAsync(int startRow, int endRow, GridSort[] sortModel)
    {
        Tab.Sorts = sortModel
            .Select(s => new SortSpec(Details.Columns[ColumnIndex(s.ColId)].Name, s.Sort == "desc"))
            .ToList();
        if (startRow == 0)
        {
            Tab.RowsLoaded = 0;
            Tab.AllRowsLoaded = false;
            _blocks.Clear(); // new query: blocks from an older filter or sort order are stale
            DisplayNamesOf.Clear(); // names too: after writing, commit, rollback or F5 they may read differently
            Shell.MarkDirty(); // sort order may have changed
        }

        var details = Details;
        var filters = Tab.AppliedFilters;
        var sorts = Tab.Sorts;
        var started = Stopwatch.GetTimestamp();
        var result = await Shell.RunDbAsync(Logger, Active, async () =>
        {
            var data = await Workspaces.GetDataAsync(Tab.WorkspaceId, CancellationToken.None);
            return await data.ReadPageAsync(details, filters, sorts, new PageSpec(startRow, endRow - startRow), CancellationToken.None);
        });
        // With opening the session and waiting for it (a running FK count): the footer's time is the query's alone.
        Logger.LogDebug("Rows {Start}+ of {Table} ({Filters} filters): {Elapsed} ms, query {Query} ms",
            startRow, details.Table.Ref, filters.Count, (long)Stopwatch.GetElapsedTime(started).TotalMilliseconds,
            (long?)result.Value?.Elapsed.TotalMilliseconds);
        if (result.Value is not { } page)
        {
            // The footer shows why ("Details" only for a statement that ran); grid.js fails the block.
            Tab.Error = result.Error?.Display;
            Tab.Failure = result.IsRefusal ? null : result.Error;
            await OnPageLoaded.InvokeAsync();
            return GridPage.Failure;
        }

        var rows = page.Rows.Select(GridRow).ToList();
        _blocks.Keep(startRow, page.Rows);
        Tab.RowsLoaded = Math.Max(Tab.RowsLoaded, startRow + page.Rows.Count);
        Tab.AllRowsLoaded |= page.IsLastPage;
        Tab.LastQueryTime = page.Elapsed;
        (Tab.DataAsOf, Tab.SnapshotMoved) = Snapshots.Next(startRow, Tab.DataAsOf, Tab.SnapshotMoved, page.DataAsOf);
        Tab.Error = null;
        Tab.Failure = null;
        await OnPageLoaded.InvokeAsync();
        RowsChanged?.Invoke();
        DisplayNamesOf.Queue(page.Rows.Select(ValuesOf)); // names come after the block, the rows are redrawn then

        return new GridPage(rows, page.IsLastPage ? startRow + page.Rows.Count : -1);
    }

    /// <summary>
    /// Right-click on a cell; the menu needs the raw row values, not the display text. <paramref name="selectedRows"/>
    /// are the selected row indexes (the clicked row is always among them); rows no longer cached are counted as missing.
    /// </summary>
    [JSInvokable]
    public Task OnCellContextMenu(
        int rowIndex, string colId, int[] selectedRows, double x, double y, double viewportWidth, double viewportHeight) =>
        GuardAsync(() => OnCellContextMenuCoreAsync(rowIndex, colId, selectedRows, x, y, viewportWidth, viewportHeight));

    private async Task OnCellContextMenuCoreAsync(
        int rowIndex, string colId, int[] selectedRows, double x, double y, double viewportWidth, double viewportHeight)
    {
        if (_blocks.At(rowIndex) is not { } row || !colId.StartsWith('c'))
        {
            return;
        }

        var selected = selectedRows.Order().Select(_blocks.At).Select(r => r is null ? null : Shown(r)).ToList();
        var column = ColumnIndex(colId);
        row = Shown(row);
        await OnContextMenu.InvokeAsync(new GridContextMenuRequest(
            row, column, Presentation.Present(column, row.Values[column]).Text,
            selected.OfType<RowData>().ToList(), selected.Count(r => r is null), x, y, viewportWidth, viewportHeight, selectedRows.Order().ToList(), rowIndex));
    }

    /// <summary>
    /// Ctrl+C in the grid: several selected rows are copied as a table (like "Copy as table"), otherwise the
    /// focused cell – always from the raw values, not the display text.
    /// </summary>
    [JSInvokable]
    public Task OnCopy(int rowIndex, string colId, int[] selectedRows) => GuardAsync(() => OnCopyCoreAsync(rowIndex, colId, selectedRows));

    private async Task OnCopyCoreAsync(int rowIndex, string colId, int[] selectedRows)
    {
        // The pending values, as shown (A21).
        if (selectedRows.Length > 1)
        {
            await ExportActions.CopyRowsAsync(Shell, _grid, Details, selectedRows.Order().Select(i => _blocks.At(i) is { } r ? Shown(r) : null).ToList());
        }
        else if (_blocks.At(rowIndex) is { } row && colId.StartsWith('c'))
        {
            var index = ColumnIndex(colId);
            await ExportActions.CopyCellAsync(Shell, _grid, Details.Columns[index], Shown(row).Values[index]);
        }
    }

    private Task<bool> CopyTextAsync(string text) => _grid.CopyTextAsync(Shell, text);

    /// <summary>Remembers the first visible row (rough scroll position), but only rows that were actually loaded.</summary>
    [JSInvokable]
    public void OnScrolled(int firstVisibleRow) => Guard(() => // like the other synchronous calls from grid.js (A48)
    {
        if (firstVisibleRow < Tab.RowsLoaded)
        {
            Tab.FirstVisibleRow = firstVisibleRow > 0 ? firstVisibleRow : null;
            Shell.MarkDirty();
        }
    });

    private int IndexOf(string column)
    {
        for (var i = 0; i < Details.Columns.Count; i++)
        {
            if (Details.Columns[i].Name == column)
            {
                return i;
            }
        }

        return -1;
    }

    public async ValueTask DisposeAsync()
    {
        Workspaces.Changed -= OnWorkspacesChanged;
        Shell.Changed -= OnShellChanged;
        Presentations.Changed -= OnPresentationChanged;
        DisplayColumns.Changed -= OnDisplayColumnsChanged;
        if (_displayNames is not null)
        {
            await _displayNames.DisposeAsync(); // a running lookup stops; queued ones are not run
        }

        await _grid.DisposeAsync();
    }
}
