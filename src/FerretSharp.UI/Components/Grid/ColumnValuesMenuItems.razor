@* The group of a column header menu that copies all values of the column (WP-57) – of the table tab's filter or of the SQL
   editor's result, read again in the background: one value per line, or an IN list. *@
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Data
@using FerretSharp.Core.Query
@using FerretSharp.Core.Schema
@inject IClipboardService Clipboard
@inject ILogger<ColumnValuesMenuItems> Logger

<div class="menu-sep"></div>
<div class="group-head-btn static">@All.Heading</div>
<button class="menu-item" disabled="@(!CanCopy)" title="@Title(GridText.ColumnMenu_CopyValuesTitle)" @onclick="() => CopyAsync(ColumnValuesFormat.Lines)">
    @GridText.ColumnMenu_CopyValues
</button>
<button class="menu-item" disabled="@(!CanCopy)" title="@Title(GridText.GridMenu_CopyColumnInListTitle)" @onclick="() => CopyAsync(ColumnValuesFormat.InList)">
    @GridText.ColumnMenu_CopyInList
</button>

@code {
    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [CascadingParameter]
    public ActiveConnection Active { get; set; } = null!;

    /// <summary>The column with its database type: LOBs and the like cannot be copied.</summary>
    [Parameter, EditorRequired]
    public ColumnInfo Column { get; set; } = null!;

    /// <summary>The column as presented (enum members); the IN list takes the database values.</summary>
    [Parameter, EditorRequired]
    public ExportColumn Presented { get; set; } = null!;

    [Parameter, EditorRequired]
    public AllColumnValues All { get; set; } = null!;

    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>Rows of the group – separator, heading and two entries – for the menu's estimated height.</summary>
    public const int Entries = 4;

    private bool CanCopy => ColumnValues.CanCopy(Column);

    private string Title(string first) => CanCopy ? first + Environment.NewLine + All.Tooltip : GridText.GridMenu_CopyColumnUnavailable;

    /// <summary>Closes the menu first: the read goes on in the background, shown in the status bar.</summary>
    private async Task CopyAsync(ColumnValuesFormat format)
    {
        var (shell, active, column, presented, all) = (Shell, Active, Column, Presented, All);
        await OnClose.InvokeAsync();
        await ColumnValueCopies.CopyAllAsync(shell, Clipboard, Logger, active, presented, column.Name, format, all);
    }
}
