@* The frame of a form beside a grid (review 3.44.0, B1: shared by the table's form, WP-21, and the result's form, WP-56):
   width handle, ▲ ▼ with the position, search and "hide empty", the field count, the fields as the caller renders them
   and the rows referencing the shown one. What differs – editing, the key, notes, more switches – the caller passes in. *@
@using FerretSharp.Core.ClrModel
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Forms
@using FerretSharp.Core.Query
@inherits FerretComponent
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ShortcutService Shortcuts

@* tabindex: a click on a label keeps the focus in the form, so Ctrl+F opens its search, not the grid's column jump. *@
<aside class="form-panel" style="@WidthStyle" tabindex="-1" @ref="_panel" @onkeydown="OnKeyDownAsync">
    <div class="form-resize" @ref="_handle" title="@GridText.Form_ResizeWidth" @onpointerdown="StartResizeAsync"></div>
    <header class="form-head">
        <button class="icon-btn ghost" title="@TextFormat.Format(GridText.Form_PreviousRow, Shortcuts.Hint(ShortcutAction.FormPrevious))" disabled="@(!CanPrevious)" @onclick="() => OnMove.InvokeAsync(-1)">@Icons.ChevronUp</button>
        <button class="icon-btn ghost" title="@TextFormat.Format(GridText.Form_NextRow, Shortcuts.Hint(ShortcutAction.FormNext))" disabled="@(!CanNext)" @onclick="() => OnMove.InvokeAsync(1)">@Icons.ChevronDown</button>
        <span class="form-pos">
            @if (Position is not null)
            {
                <strong>@Position</strong>
                @HeaderExtra
            }
            else
            {
                <span class="muted">@GridText.Form_Title</span>
            }
        </span>
        <span class="spacer"></span>
        <button class="icon-btn ghost" title="@TextFormat.Format(GridText.Form_Close, Shortcuts.Hint(ShortcutAction.ToggleForm))" @onclick="OnClose">@Icons.Close</button>
    </header>

    <div class="form-tools">
        <SearchBox @ref="_search" Class="structure-filter" Placeholder="@TextFormat.Format(GridText.Form_SearchFields, Shortcuts.Hint(ShortcutAction.FindColumn))" @bind-Value="_query" />
        <div class="form-switches">
            <label class="check" title="@HideEmptyTitle">
                <input type="checkbox" checked="@Tab.FormHideEmpty" @onchange="e => SetHideEmpty(e.Value is true)" /> @GridText.Grid_HideEmpty
            </label>
            @Switches
        </div>
    </div>

    @{
        var view = RowForm.Visible(Fields, Presentation, new FormFilter(_query, Tab.FormHideEmpty, OnlyChanged));
    }

    @if (RowLoaded)
    {
        <div class="form-count">
            @if (view.Fields.Count == view.Total)
            {
                <span>@TextFormat.Plural(view.Total, GridText.Form_FieldsOne, GridText.Form_FieldsOther)</span>
            }
            else
            {
                <span>@TextFormat.Format(GridText.Form_FieldsShown, view.Fields.Count, view.Total)</span>
                @if (view.EmptyHidden > 0)
                {
                    <span> · @TextFormat.Format(GridText.Form_EmptyHidden, view.EmptyHidden)</span>
                }
            }
        </div>
        @Notes
    }

    <div class="form-fields" @ref="_fields">
        @if (Position is null)
        {
            <div class="form-empty">@(Lost ?? GridText.Form_ChooseRow)</div>
        }
        else if (!RowLoaded)
        {
            <div class="form-empty"><span class="spinner small"></span> @GridText.Form_LoadingRow</div>
        }
        else if (view.Fields.Count == 0)
        {
            <div class="form-empty">@(string.IsNullOrWhiteSpace(_query) ? GridText.Form_NoFieldMatches : TextFormat.Format(GridText.Form_NoFieldMatchesQuery, _query))</div>
        }
        else
        {
            @foreach (var field in view.Fields)
            {
                @Field(new FieldSlot(field, FieldId(field.Column)))
            }
        }

        @if (RowLoaded && Incoming.Jumps.Count > 0)
        {
            <div class="form-incoming">
                @foreach (var (via, jumps) in FkJumpLists.Groups(Incoming.Jumps))
                {
                    <div class="form-section" title="@(via is null ? null : FkTargets.ViaTitle(Active, via, jumps))">
                        @(via is null ? GridText.Form_ReferencedBy : TextFormat.Format(GridText.Form_ReferencedVia, FkTargets.Label(Active, via)))
                    </div>
                    @foreach (var jump in jumps)
                    {
                        <FkJumpItem Jump="jump" Count="Incoming.Counts.Of(jump)" OnJump="OnJump" OnEnter="j => Fire(() => Incoming.HoverAsync(j))" OnLeave="Incoming.Counts.Leave" />
                    }
                }
            </div>
        }
    </div>
</aside>

@code {
    [CascadingParameter]
    public ActiveConnection Active { get; set; } = null!;

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    /// <summary>Default width; the user drags the left edge (saved per tab).</summary>
    public const int DefaultWidth = 440;

    private const int MinWidth = 300;
    private const double MaxFraction = 0.75;

    private readonly string _idPrefix = "ff-" + Guid.NewGuid().ToString("N")[..8] + "-";
    private ElementReference _panel;
    private ElementReference _handle;
    private ElementReference _fields;
    private SearchBox? _search;
    private DomModule? _dom;
    private string _query = "";
    private int? _reveal;
    private bool _focusSearch;
    private bool _focusFirstInput;
    private bool _disposed;

    /// <summary>dom.js, imported on first use; does nothing once disposed (<see cref="DomModule"/>).</summary>
    private DomModule Dom => _dom ??= new(JS);

    [Parameter, EditorRequired]
    public IFormTab Tab { get; set; } = null!;

    /// <summary>"Row 3 of 120" (or "new row"); null if no row is shown.</summary>
    [Parameter]
    public string? Position { get; set; }

    /// <summary>Beside the position (the table's key).</summary>
    [Parameter]
    public RenderFragment? HeaderExtra { get; set; }

    /// <summary>Why no row is shown any more (<see cref="FormCursor.Lost"/>).</summary>
    [Parameter]
    public string? Lost { get; set; }

    /// <summary>The shown row is loaded: its fields are in <see cref="Fields"/>.</summary>
    [Parameter]
    public bool RowLoaded { get; set; }

    [Parameter]
    public bool CanPrevious { get; set; }

    [Parameter]
    public bool CanNext { get; set; }

    /// <summary>▲ (-1) or ▼ (+1), by button or key.</summary>
    [Parameter]
    public EventCallback<int> OnMove { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter, EditorRequired]
    public string HideEmptyTitle { get; set; } = "";

    /// <summary>More switches beside "hide empty".</summary>
    [Parameter]
    public RenderFragment? Switches { get; set; }

    /// <summary>"Only changed" (a table's form).</summary>
    [Parameter]
    public bool OnlyChanged { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<FormField> Fields { get; set; } = [];

    [Parameter, EditorRequired]
    public IColumnPresentation Presentation { get; set; } = null!;

    /// <summary>Below the field count (deleted, new, read-only).</summary>
    [Parameter]
    public RenderFragment? Notes { get; set; }

    /// <summary>A shown field with its element id (the frame scrolls to it).</summary>
    public sealed record FieldSlot(FormField Field, string Id);

    /// <summary>One shown field.</summary>
    [Parameter, EditorRequired]
    public RenderFragment<FieldSlot> Field { get; set; } = null!;

    [Parameter, EditorRequired]
    public IncomingCounts Incoming { get; set; } = null!;

    [Parameter]
    public EventCallback<FkJump> OnJump { get; set; }

    private string WidthStyle => FormattableString.Invariant($"width: {Tab.FormWidth ?? DefaultWidth}px;");

    private string FieldId(int column) => _idPrefix + column.ToString(CultureInfo.InvariantCulture);

    /// <summary>Scrolls a field into view after the next render (the grid's focus or column jump chose it).</summary>
    public void Reveal(int column) => _reveal = column;

    /// <summary>Ctrl+F while the focus is in the form: its search instead of the grid's column jump or the editor's search.</summary>
    public async Task<bool> ContainsFocusAsync() => !_disposed && await Dom.InvokeAsync<bool>("containsFocus", _panel);

    public void FocusSearch()
    {
        _focusSearch = true;
        StateHasChanged();
    }

    /// <summary>Focuses the first input after the next render ("+ Row" with the form open).</summary>
    public void FocusFirstInput() => _focusFirstInput = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
        {
            return;
        }

        if (firstRender)
        {
            // Enum fields: typing picks by value, then by label, like the grid's cell editor.
            await Dom.InvokeVoidAsync("typeInLists", _panel);
            if (_disposed)
            {
                return;
            }
        }

        if (_reveal is { } column)
        {
            _reveal = null;
            await Dom.InvokeVoidAsync("scrollIntoViewById", FieldId(column), "nearest");
        }

        if (_focusFirstInput && RowLoaded)
        {
            _focusFirstInput = false;
            await Dom.InvokeVoidAsync("focusFirstInput", _fields);
        }

        if (_focusSearch && _search is not null)
        {
            _focusSearch = false;
            await Dom.InvokeVoidAsync("focusAndSelect", _search.Input);
        }
    }

    /// <summary>The form's own keys (Alt+↑/↓/Enter by default, changeable since WP-25) – not global, Monaco keeps them.</summary>
    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (Shortcuts.Is(ShortcutAction.FormPrevious, e))
        {
            await OnMove.InvokeAsync(-1);
        }
        else if (Shortcuts.Is(ShortcutAction.FormNext, e))
        {
            await OnMove.InvokeAsync(1);
        }
        else if (Shortcuts.Is(ShortcutAction.ToggleForm, e))
        {
            await OnClose.InvokeAsync();
        }
    }

    private void SetHideEmpty(bool hide)
    {
        Tab.FormHideEmpty = hide;
        Shell.MarkDirty();
    }

    private async Task StartResizeAsync(PointerEventArgs e)
    {
        if (e.Button != 0)
        {
            return;
        }

        var width = await Dom.InvokeAsync<int>("dragWidth", _handle, _panel, e.PointerId, e.ClientX, MinWidth, MaxFraction);
        if (!_disposed && width > 0)
        {
            Tab.FormWidth = width;
            Shell.MarkDirty();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await Dom.DisposeAsync();
    }
}
