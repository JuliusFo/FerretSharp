@* The export of a right-click menu (R6b, review 3.40.0, B5; WP-53, WP-54) as a matrix (WP-61; a list of 14 lines before):
   the formats as rows – table, CSV, Excel, Excel with database names and raw values when the columns are presented, INSERT
   and further rows of the menu (C# objects, seed data) –, the targets as columns: copy, save the selected rows, save all rows
   of the grid's query, read again block by block (WP-54). A dash where there is no such combination. Files are written after
   the dialog, in the background (A13). Below, the values of the clicked column from the selected rows as chips (WP-57) – not
   inside marked cells, which have their own group (WP-58). Rows the menu's filter does not match are left out. *@
@using FerretSharp.Core.Data
@using FerretSharp.Core.Query
@using FerretSharp.Core.Schema
@inject ShortcutService Shortcuts

@{
    var rows = MatrixRows();
    var shown = Filter is null ? rows : rows.Where(r => r.Matches(Filter)).ToList();
}
@if (shown.Count > 0)
{
    <div class="ctx-section export-matrix">
        <span class="matrix-head format">@GridText.Matrix_Export</span>
        <span class="matrix-head">@GridText.Matrix_Copy</span>
        <span class="matrix-head" title="@GridText.Matrix_SelectionTitle">@ExportActions.RowsText(Rows.Count)</span>
        <span class="matrix-head" title="@AllRows?.Heading">@GridText.Matrix_All</span>
        @foreach (var row in shown)
        {
            <span class="matrix-format">@row.Format</span>
            @Cell(row.Copy, Icons.Copy)
            @Cell(row.Selection, Icons.Download)
            @Cell(row.All, Icons.Download)
        }
    </div>
}
@if (Column is { } column && !Marked)
{
    var name = Table.Columns[column.Source].Name;
    <ValueChips Heading="@TextFormat.Format(GridText.Matrix_Column, name)" LinesTitle="@TextFormat.Format(GridText.GridMenu_CopyColumnTitle, Shortcuts.Hint(ShortcutAction.CopyColumnValues))"
                Unavailable="@(ColumnValues.CanCopy(column.Column) ? null : GridText.GridMenu_CopyColumnUnavailable)"
                OnCopy="format => Export.CopyColumnAsync(column, name, format, Rows)" />
}

@code {
    [CascadingParameter]
    public MenuFilter? Filter { get; set; }

    [Parameter, EditorRequired]
    public ExportActions Export { get; set; } = null!;

    /// <summary>The columns of the rows (database names): CSV, the table copy and the raw Excel variant.</summary>
    [Parameter, EditorRequired]
    public TableDetails Table { get; set; } = null!;

    /// <summary>The selected rows.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<RowData> Rows { get; set; } = [];

    /// <summary>
    /// The clicked column as presented (<see cref="ExportColumn.Source"/>: its index in <see cref="Table"/>): its values can be
    /// copied (WP-57). Null offers no such chips.
    /// </summary>
    [Parameter]
    public ExportColumn? Column { get; set; }

    /// <summary>
    /// The right-click landed in marked cells (WP-58): their group copies them (<see cref="MarkedCellsMenuItems"/>), so the
    /// table copy and the column's values are left out here; the other fields take the clicked row.
    /// </summary>
    [Parameter]
    public bool Marked { get; set; }

    /// <summary>File name (without extension) offered for CSV, Excel and the INSERT script.</summary>
    [Parameter, EditorRequired]
    public string FileName { get; set; } = "";

    /// <summary>The columns of the Excel export as the grid presents them (WP-53).</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<ExportColumn> XlsxColumns { get; set; } = [];

    /// <summary>
    /// The columns the Excel export of the selected rows writes, taken when it is chosen – over a copy of the names the grid
    /// has looked up, because the file is written in the background while the grid goes on (A13). Null writes
    /// <see cref="XlsxColumns"/>.
    /// </summary>
    [Parameter]
    public Func<IReadOnlyList<ExportColumn>>? XlsxColumnsToSave { get; set; }

    /// <summary>The table the INSERT statements write into; null disables "Copy as INSERT" (<see cref="InsertTitle"/> says why).</summary>
    [Parameter]
    public TableDetails? InsertTable { get; set; }

    [Parameter]
    public string InsertTitle { get; set; } = GridText.GridMenu_CopyInsertTitle;

    /// <summary>The INSERT statements of the selected rows can be saved as a script too (a table grid).</summary>
    [Parameter]
    public bool InsertFile { get; set; }

    /// <summary>All rows of the grid's query (WP-54); null offers no such fields (the LINQ console).</summary>
    [Parameter]
    public AllRowsExport? AllRows { get; set; }

    /// <summary>Further formats below INSERT (C# objects and seed data of a table with an entity).</summary>
    [Parameter]
    public IReadOnlyList<ExportMatrixRow> More { get; set; } = [];

    /// <summary>Whether the raw Excel variant is offered.</summary>
    public static bool OffersRaw(IReadOnlyList<ExportColumn> columns) => ExportColumn.DiffersFromRaw(columns);

    /// <summary>Lines of the matrix (with its head and the chips of the column) – for the menu's estimated height.</summary>
    public static int Lines(IReadOnlyList<ExportColumn> xlsxColumns, int more) => (OffersRaw(xlsxColumns) ? 7 : 6) + more;

    private IReadOnlyList<ExportMatrixRow> MatrixRows()
    {
        var raw = OffersRaw(XlsxColumns);
        var all = AllRows;
        List<ExportMatrixRow> rows =
        [
            new(GridText.Matrix_Table, Marked ? null : new(GridText.GridMenu_CopyTable, GridText.GridMenu_CopyTableTitle, CopyTableAsync)),
            new("CSV", null,
                new(GridText.GridMenu_SaveCsv, GridText.GridMenu_SaveCsvTitle, SaveCsvAsync),
                all is null ? null : new(GridText.GridMenu_SaveCsv, AllRowsTitle(all, GridText.GridMenu_SaveCsvTitle), () => SaveAllCsvAsync(all))),
            new("Excel", null,
                new(GridText.GridMenu_SaveXlsx, GridText.GridMenu_SaveXlsxTitle, () => SaveXlsxAsync(XlsxColumnsToSave?.Invoke() ?? XlsxColumns)),
                all is null ? null : new(GridText.GridMenu_SaveXlsx, AllRowsTitle(all, GridText.GridMenu_SaveXlsxTitle), () => SaveAllXlsxAsync(all, all.Excel()))),
        ];
        if (raw)
        {
            rows.Add(new(GridText.Matrix_ExcelRaw, null,
                new(GridText.GridMenu_SaveXlsxRaw, GridText.GridMenu_SaveXlsxRawTitle, () => SaveXlsxAsync(ExportColumn.Raw(Table))),
                all is null ? null : new(GridText.GridMenu_SaveXlsxRaw, AllRowsTitle(all, GridText.GridMenu_SaveXlsxRawTitle),
                    () => SaveAllXlsxAsync(all, new AllRowsExcel(ExportColumn.Raw(Table), null)))));
        }

        rows.Add(new("INSERT",
            new(GridText.GridMenu_CopyInsert, InsertTitle, CopyInsertAsync, InsertTable is null ? InsertTitle : null),
            InsertFile && InsertTable is not null ? new(GridText.GridMenu_SaveInsert, GridText.GridMenu_CopyInsertTitle, SaveInsertAsync) : null));
        rows.AddRange(More);
        return rows;
    }

    private RenderFragment Cell(ExportMatrixCell? cell, MarkupString icon) => cell is null
        ? @<span class="matrix-none">–</span>
        : @<button type="button" class="matrix-cell" disabled="@(cell.Unavailable is not null)" title="@cell.Tooltip" aria-label="@cell.Label" @onclick="cell.Run">@icon</button>;

    private static string AllRowsTitle(AllRowsExport all, string format) =>
        all.Heading + Environment.NewLine + format + Environment.NewLine + GridText.GridMenu_AllRowsTitle;

    private Task CopyTableAsync() =>
        Export.CopyAsync(DelimitedExport.Build(Table, Rows, DelimitedExport.ClipboardSeparator), ExportCopy.Table);

    private Task CopyInsertAsync() => InsertTable is { } target
        ? Export.CopyAsync(InsertExport.Build(target, Rows), ExportCopy.Insert)
        : Task.CompletedTask;

    private Task SaveInsertAsync() => InsertTable is { } target
        ? Export.SaveAsync(InsertExport.Build(target, Rows), FileName + ".sql", GridText.Export_SqlScriptFilter, utf8Bom: false)
        : Task.CompletedTask;

    private Task SaveCsvAsync()
    {
        var (table, rows) = (Table, Rows);
        return Export.SaveRowsAsync(FileName + ".csv", GridText.Export_CsvFilter, rows.Count, (stream, progress, ct) =>
            RowExport.WriteAsync(RowExport.FromRows(rows), DelimitedExport.CreateWriter(stream, table), null, progress, ct));
    }

    private Task SaveXlsxAsync(IReadOnlyList<ExportColumn> columns)
    {
        var (rows, name) = (Rows, FileName);
        return Export.SaveRowsAsync(name + ".xlsx", GridText.Export_XlsxFilter, rows.Count, async (stream, progress, ct) =>
            await RowExport.WriteAsync(RowExport.FromRows(rows), await XlsxExport.CreateWriterAsync(stream, columns, name, rows.Count, ct), null, progress, ct));
    }

    private Task SaveAllCsvAsync(AllRowsExport all)
    {
        var table = Table;
        return Export.SaveAllRowsAsync(FileName + ".csv", GridText.Export_CsvFilter, all.Total, all.WorkspaceId, (stream, progress, ct) =>
            RowExport.WriteAsync(all.Read, DelimitedExport.CreateWriter(stream, table), null, progress, ct));
    }

    /// <param name="excel">The columns and the names they write, looked up while reading.</param>
    private Task SaveAllXlsxAsync(AllRowsExport all, AllRowsExcel excel)
    {
        var name = FileName;
        return Export.SaveAllRowsAsync(name + ".xlsx", GridText.Export_XlsxFilter, all.Total, all.WorkspaceId, async (stream, progress, ct) =>
            await RowExport.WriteAsync(all.Read, await XlsxExport.CreateWriterAsync(stream, excel.Columns, name, null, ct), excel.Names, progress, ct));
    }
}
