@* Selected rows side by side (WP-21; of a query result since WP-56): one column per row, one line per column, deviating
   values marked. Read-only – values as the grid shows them, including pending changes. A row's heading leads back to the
   grid and opens that row in the form. *@
@using FerretSharp.Core.ClrModel
@using FerretSharp.Core.Data
@using FerretSharp.Core.Forms
@using FerretSharp.Core.Schema

<ModalFrame Label="@TextFormat.Format(GridText.Compare_Label, Title)" Class="compare-rows-dialog" OnCancel="OnClose" CloseOnBackdrop="true" FocusOnOpen="true">
    @{
        var fields = RowComparison.Compare(Presentation, Rows.Select(r => r.Row).ToList(), Order);
        var view = RowComparison.Visible(fields, Presentation, new CompareFilter(_query, _hideEmpty, _onlyDifferences));
        var differing = fields.Count(f => f.Differs);
    }
    <header>
        <span>@TextFormat.Format(GridText.Compare_Header, RowsText(Rows.Count), Title)</span>
        <SearchBox Class="structure-filter" Placeholder="@GridText.Compare_SearchColumns" @bind-Value="_query" />
        <label class="check"><input type="checkbox" checked="@_onlyDifferences" @onchange="e => _onlyDifferences = e.Value is true" /> @CommonText.OnlyDifferences</label>
        <label class="check" title="@GridText.Compare_HideEmptyTitle"><input type="checkbox" checked="@_hideEmpty" @onchange="e => _hideEmpty = e.Value is true" /> @GridText.Grid_HideEmpty</label>
        <span class="muted">
            @TextFormat.Plural(differing, GridText.Compare_ColumnsDifferOne, GridText.Compare_ColumnsDifferOther)@(view.Fields.Count < view.Total ? " · " + TextFormat.Format(GridText.Compare_Shown, view.Fields.Count, view.Total) : "")
        </span>
        <span class="spacer"></span>
        <button class="icon-btn ghost" title="@CommonText.Close" @onclick="OnClose">@Icons.Close</button>
    </header>
    <div class="dialog-body compare-rows-body">
        <table class="compare-rows">
            <thead>
                <tr>
                    <th class="cr-col">@GridText.Grid_Column</th>
                    @foreach (var (index, row) in Rows)
                    {
                        <th>
                            <button class="link-btn cr-row" title="@GridText.Compare_ShowRowTitle" @onclick="() => OnShow.InvokeAsync(index)">@TextFormat.Format(GridText.Compare_Row, index + 1)</button>
                            @if (KeyText?.Invoke(row) is { } key)
                            {
                                <span class="cr-key" title="@KeyTitle">@key</span>
                            }
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (view.Fields.Count == 0)
                {
                    <tr><td class="muted" colspan="@(Rows.Count + 1)">@(_onlyDifferences && differing == 0 ? GridText.Compare_RowsEqual : GridText.Compare_NoColumnMatches)</td></tr>
                }
                @foreach (var field in view.Fields)
                {
                    <tr class="@(field.Differs ? "differs" : "")">
                        <th class="cr-col" title="@ColumnTitle(field)">
                            <span class="cr-name">@field.Label.Name</span>
                            @if (field.Label.AlternateName is { } alternate)
                            {
                                <span class="cr-alt">@alternate</span>
                            }
                            <span class="cr-type">@field.Info.DisplayType</span>
                        </th>
                        @foreach (var cell in field.Cells)
                        {
                            <td class="@(cell.Deviates ? "deviates" : "") @StageClass(cell.Stage) @(cell.IsNull ? "fs-null" : "")" title="@cell.Value.Tooltip">@(cell.Value.Text ?? "NULL")</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <footer>
        <span class="muted">
            @(Note ?? GridText.Compare_FooterNote)@(Missing > 0 ? " · " + TextFormat.Format(GridText.Compare_MissingRows, RowsText(Missing)) : "")
        </span>
        <span class="spacer"></span>
        <button class="btn" @onclick="OnClose">@CommonText.Close</button>
    </footer>
</ModalFrame>

@code {
    private string _query = "";
    private bool _onlyDifferences;
    private bool _hideEmpty;

    /// <summary>What is compared: the table's name, or the name of a query result.</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter, EditorRequired]
    public IColumnPresentation Presentation { get; set; } = null!;

    /// <summary>The columns in display order (a table: key and pinned ones first; a result: its own order).</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<int> Order { get; set; } = [];

    /// <summary>The primary key values of a row beside its heading; null without a key.</summary>
    [Parameter]
    public Func<FormRow, string?>? KeyText { get; set; }

    /// <summary>Tooltip of the key values: the key's columns.</summary>
    [Parameter]
    public string? KeyTitle { get; set; }

    /// <summary>The note in the footer; null for the one of a table (with pending changes).</summary>
    [Parameter]
    public string? Note { get; set; }

    /// <summary>The compared rows with their grid index, in grid order.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<(int Index, FormRow Row)> Rows { get; set; } = [];

    /// <summary>Selected rows whose block is no longer loaded: not compared.</summary>
    [Parameter]
    public int Missing { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>A row's heading: back to the grid, that row in the form.</summary>
    [Parameter]
    public EventCallback<int> OnShow { get; set; }

    private static string RowsText(int rows) => ExportActions.RowsText(rows);

    private static string StageClass(ChangeStage? stage) => stage switch
    {
        ChangeStage.Pending => "ff-pending",
        ChangeStage.Flushed => "ff-flushed",
        _ => "",
    };

    private static string ColumnTitle(CompareField field) => string.Join("\n", new[]
    {
        field.Info.Name + (field.Label.ClrType is { } type ? $" · {field.Label.AlternateName ?? field.Label.Name} · {type}" : ""),
        field.Info.Comment,
    }.OfType<string>());
}
