@using FerretSharp.Core.Connections
@using FerretSharp.Core.Data
@using FerretSharp.Core.Oracle
@using FerretSharp.Core.Query
@using FerretSharp.Core.Schema
@using FerretSharp.UI.State
@implements IDisposable
@inject ActiveConnection Active
@inject WorkspaceManager Workspaces
@inject PresentationService Presentations
@inject ILogger<TabView> Logger

<div class="tabview">
    <div class="tab-toolbar">
        @if (Tab.BackTarget(Shell.Tabs) is { } back)
        {
            <button class="btn ghost nav-btn" title="@($"Zurück zu {NavLabel(back)} (Alt+←)")" @onclick="Shell.GoBack">← @back.Table.DisplayName</button>
        }
        @if (Tab.ForwardTarget(Shell.Tabs) is { } forward)
        {
            <button class="btn ghost nav-btn" title="@($"Vor zu {NavLabel(forward)} (Alt+→)")" @onclick="Shell.GoForward">@forward.Table.DisplayName →</button>
        }
        <div class="segmented small" role="tablist">
            @foreach (var (mode, label) in Modes)
            {
                var m = mode;
                <button class="seg @(Tab.Mode == m ? "active" : "")" role="tab" aria-selected="@(Tab.Mode == m ? "true" : "false")"
                        @onclick="() => SetMode(m)">@label</button>
            }
        </div>
        <span class="toolbar-title">
            @if (Tab.Table.Synonym is { } synonym)
            {
                @($"{(synonym.IsPublic ? "öffentliches Synonym" : "Synonym")} {synonym.Name} → ")
            }
            @Tab.Table.Owner.@Tab.Table.Name
        </span>
        <span class="spacer"></span>
        @if (Tab.Mode == TabMode.Data && _details is not null)
        {
            @if (Tab.Changes is not null && _grid?.CanEdit == true)
            {
                <button class="btn ghost" title="Neue Zeile oben im Grid anlegen – wird mit „Schreiben“ (Ctrl+S) eingefügt" @onclick="() => _grid?.AddRowAsync() ?? Task.CompletedTask">+ Zeile</button>
            }
            <ColumnJump @ref="_jump" Details="_details" OnJump="c => _pendingJump = c" />
        }
        @if (_details is not null && Tab.Mode != TabMode.Structure)
        {
            <button class="icon-btn ghost" title="Neu laden (F5)" @onclick="RefreshViewAsync">@Icons.Refresh</button>
        }
    </div>

    @if (_loadError is not null)
    {
        <div class="tab-error">
            <span>@_loadError.Display</span>
            <button class="link-btn" @onclick="() => Shell.ShowError(_loadError)">Details</button>
        </div>
    }
    else if (_details is null)
    {
        <div class="structure-loading padded"><span class="spinner"></span> Lade Struktur …</div>
    }
    else
    {
        <div class="tab-data @(Tab.Mode == TabMode.Data ? "" : "hidden")">
            <FilterBar Tab="Tab" Details="_details" OnApply="ApplyFiltersAsync" OnShowSql="ShowSql" OnShowPlan="ShowPlan" />
            @if (Tab.Error is not null)
            {
                <div class="tab-error">
                    <span>@Tab.Error</span>
                    @if (Tab.Failure is { } failure)
                    {
                        <button class="link-btn" @onclick="() => Shell.ShowError(failure)">Details</button>
                    }
                </div>
            }
            <div class="grid-host">
                <FerretGrid @ref="_grid" Tab="Tab" Details="_details" OnPageLoaded="StateHasChanged"
                            OnContextMenu="r => _menu = r" OnColumnMenu="r => _columnMenu = r"
                            OnLobOpen="r => _lob = r" OnEditableChanged="StateHasChanged" />
            </div>
            <footer class="tab-footer">
                @* RowsLoaded is the highest loaded position (blocks load where the user scrolls), so it is a lower bound. *@
                @if (Tab.AllRowsLoaded)
                {
                    <span><strong>@Tab.RowsLoaded.ToString("N0", CultureInfo.CurrentCulture)</strong> Zeilen</span>
                }
                else if (Tab.TotalCount is null)
                {
                    <span>≥ <strong>@Tab.RowsLoaded.ToString("N0", CultureInfo.CurrentCulture)</strong> Zeilen</span>
                }
                @if (Tab.TotalCount is { } total && !Tab.AllRowsLoaded)
                {
                    <span>Gesamt <strong>@total.ToString("N0", CultureInfo.CurrentCulture)</strong></span>
                }
                else if (_countCts is not null)
                {
                    <span><span class="spinner small"></span> Zähle … <button class="status-btn" @onclick="CancelCount">Abbrechen</button></span>
                }
                else if (!Tab.AllRowsLoaded)
                {
                    <button class="status-btn" @onclick="CountAsync">Zeilen zählen</button>
                }
                @if (Tab.LastQueryTime is { } time)
                {
                    <span>@time.TotalMilliseconds.ToString("N0", CultureInfo.CurrentCulture) ms</span>
                }
                @if (Tab.DataAsOf is { } asOf)
                {
                    <span title="Schreibgeschützte Verbindung: Oracle liefert die Daten aus einer READ ONLY-Transaktion mit dem Stand dieses Zeitpunkts. Jede neue Abfrage (Filter, Sortierung, F5) holt einen neuen Stand; weitere Seiten bleiben im selben Stand.">
                        Stand @asOf.ToString("T", CultureInfo.CurrentCulture)
                    </span>
                }
                <span>@SortText</span>
                @if (_countError is not null)
                {
                    <span class="error">@_countError.Display <button class="link-btn" @onclick="() => Shell.ShowError(_countError)">Details</button></span>
                }
                <span class="spacer"></span>
                <span>Row-Key: @RowKeyText</span>
            </footer>
        </div>

        @* Detail views mount when first shown and then stay (like the grid), so switching back costs no query. *@
        @if (_visited.Any(m => m != TabMode.Data))
        {
            <div class="tab-details @(Tab.Mode == TabMode.Data ? "hidden" : "")">
                <ObjectHeader Details="_details" Version="_version" />
                <div class="details-body">
                    @foreach (var (mode, _) in Modes.Where(m => m.Mode != TabMode.Data && _visited.Contains(m.Mode)))
                    {
                        <div class="structure @(Tab.Mode == mode ? "" : "hidden")" @key="mode">
                            @switch (mode)
                            {
                                case TabMode.Structure:
                                    <ColumnsView @ref="_columns" Details="_details" />
                                    break;
                                case TabMode.Constraints:
                                    <ConstraintsView Details="_details" Version="_version" />
                                    break;
                                case TabMode.Indexes:
                                    <IndexesView Details="_details" Version="_version" />
                                    break;
                                case TabMode.Dependencies:
                                    <DependenciesView Details="_details" Version="_version" />
                                    break;
                                case TabMode.Ddl:
                                    <DdlView Details="_details" Version="_version" />
                                    break;
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@if (_menu is { } menu && _details is not null)
{
    <GridContextMenu @key="menu" Request="menu" Tab="Tab" Details="_details" OnClose="() => _menu = null"
                     CanEdit="@(_grid?.CanEdit == true && Tab.Changes is not null)"
                     Pinned="@(_grid?.IsPinned(menu.Column) == true)" OnTogglePin="TogglePinAsync"
                     OnDeleteRows="rows => _grid?.ChangeRowsAsync(rows, delete: true) ?? Task.CompletedTask"
                     OnRevertRows="rows => _grid?.ChangeRowsAsync(rows, delete: false) ?? Task.CompletedTask"
                     OnOpenLob="() => _grid?.OpenLobAsync(menu.RowIndex, menu.Column) ?? Task.CompletedTask" />
}

@if (_lob is { } lob && _details is not null)
{
    <LobEditorDialog @key="lob" Request="lob" Details="_details" Tab="Tab"
                     CanEdit="@LobEditable(lob)" ReadOnlyReason="@LobReadOnlyReason(lob)"
                     OnApply="(loaded, value) => _grid?.SetLobAsync(lob, loaded, value) ?? Task.FromResult<string?>(null)"
                     OnClose="() => _lob = null" />
}

@if (_columnMenu is { } columnMenu && _details is not null)
{
    <ColumnMenu @key="columnMenu" Request="columnMenu" Details="_details" OnClose="() => _columnMenu = null"
                Pinned="@(_grid?.IsPinned(columnMenu.Column) == true)" OnTogglePin="TogglePinAsync" />
}

@if (_sql is { } sql)
{
    <SqlPreview Sql="@sql.Sql" Parameters="sql.Parameters" Error="@sql.Error" OnClose="() => _sql = null"
                OnOpenInEditor="() => OpenInSqlEditor(sql.Sql, sql.Parameters)" />
}

@if (_plan is { } planQuery)
{
    <PlanDialog Query="planQuery.FirstPage" WholeQuery="planQuery.Whole" WorkspaceId="Tab.WorkspaceId" Title="@Tab.Table.DisplayName" OnClose="() => _plan = null" />
}

@code {
    private TableDetails? _details;
    private (QuerySpec FirstPage, QuerySpec Whole)? _plan;
    private DatabaseException? _loadError;
    private FerretGrid? _grid;
    private CancellationTokenSource? _countCts;
    private DatabaseException? _countError;
    private (string Sql, IReadOnlyList<QueryParameter> Parameters, string? Error)? _sql;
    private GridContextMenuRequest? _menu;
    private FerretGrid.LobRequest? _lob;

    /// <summary>The LOB editor may change the value: writable workspace, editable column, row not marked for deletion.</summary>
    private bool LobEditable(FerretGrid.LobRequest lob) => LobReadOnlyReason(lob) is null;

    private string? LobReadOnlyReason(FerretGrid.LobRequest lob)
    {
        if (_grid?.CanEdit != true || Tab.Changes is not { } changes)
        {
            return Workspaces.IsWritable(Tab.WorkspaceId)
                ? "Diese Tabelle lässt sich nicht bearbeiten."
                : "Der Workspace ist schreibgeschützt – zum Ändern freischalten.";
        }

        if (OracleTypeMapper.NotEditableReason(_details!, _details!.Columns[lob.Column], newRow: lob.NewRow is not null) is { } reason)
        {
            return reason;
        }

        return lob.Row is { } row && changes.Find(row.Key)?.Deleted is not null ? "Die Zeile ist zum Löschen markiert." : null;
    }
    private ColumnMenuRequest? _columnMenu;
    private ColumnJump? _jump;
    private ColumnsView? _columns;
    private int? _pendingJump; // scrolled to after the search list has closed, so the grid cell keeps the focus
    private readonly HashSet<TabMode> _visited = [];
    private int _version; // F5 in a detail view: incremented, the detail views reload

    private static readonly (TabMode Mode, string Label)[] Modes =
    [
        (TabMode.Data, "Daten"),
        (TabMode.Structure, "Spalten"),
        (TabMode.Constraints, "Constraints"),
        (TabMode.Indexes, "Indizes"),
        (TabMode.Dependencies, "Abhängigkeiten"),
        (TabMode.Ddl, "DDL"),
    ];

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [Parameter, EditorRequired]
    public TableTab Tab { get; set; } = null!;

    private string SortText => Tab.Sorts.Count > 0
        ? "Sortierung: " + string.Join(", ", Tab.Sorts.Select(s => s.Column + (s.Descending ? " ↓" : " ↑")))
        : _details is not null && QueryBuilder.RowKeyOf(_details) == RowKeyKind.None
            ? "Sortierung: alle Spalten"
            : "Sortierung: Row-Key";

    private string NavLabel(TableTab tab) =>
        tab.FilterSummary(maxLength: 80, tab.Details is { } details ? Presentations.For(details) : null) is { } filters
            ? $"{tab.Table.DisplayName} ({filters})"
            : tab.Table.DisplayName;

    /// <summary>The C# model or the name setting changed: filter bar (member lists) and labels follow.</summary>
    private void OnPresentationChanged() => InvokeAsync(StateHasChanged);

    private string RowKeyText =>_details is null ? "" : QueryBuilder.RowKeyOf(_details) switch
    {
        RowKeyKind.PrimaryKey => "PK " + string.Join(", ", _details.PrimaryKey),
        RowKeyKind.RowId => _details.IsIndexOrganized ? "UROWID" : "ROWID",
        _ => "keiner (View ohne Schlüssel)",
    };

    protected override async Task OnInitializedAsync()
    {
        Shell.TabCommandRequested += OnTabCommand;
        Presentations.Changed += OnPresentationChanged;
        if (Active.Schema is not { } schema)
        {
            return;
        }

        try
        {
            var table = Tab.Table;
            _details = await Task.Run(() => schema.GetDetailsAsync(table, CancellationToken.None));
            Tab.Details = _details;
        }
        catch (DatabaseException ex)
        {
            QueryErrorLog.Log(Logger, ex, Active.Profile);
            _loadError = ex;
            Shell.ReportFailure(ex);
        }
    }

    /// <summary>The mode may also change from outside (a table link opens the structure of an open tab).</summary>
    protected override void OnParametersSet() => _visited.Add(Tab.Mode);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingJump is { } column && _grid is not null)
        {
            _pendingJump = null;
            await _grid.JumpToColumnAsync(column);
        }
    }

    private void SetMode(TabMode mode)
    {
        Tab.Mode = mode;
        _visited.Add(mode);
        Shell.NotifyChanged();
    }

    private async Task ApplyFiltersAsync()
    {
        if (_details is null)
        {
            return;
        }

        var conditions = Tab.FilterRows.Select(r => r.ToCondition()).ToList();
        var errors = QueryBuilder.Validate(_details, conditions);
        for (var i = 0; i < Tab.FilterRows.Count; i++)
        {
            Tab.FilterRows[i].Error = errors.GetValueOrDefault(i);
        }

        if (errors.Count > 0)
        {
            return;
        }

        Tab.AppliedFilters = conditions;
        Shell.NotifyChanged(); // filter count in the tab header
        await RefreshAsync();
    }

    /// <summary>F5 / reload button: the grid in the data view, the detail views otherwise (columns come with the schema).</summary>
    private Task RefreshViewAsync()
    {
        if (Tab.Mode == TabMode.Data)
        {
            return RefreshAsync();
        }

        _version++;
        return Task.CompletedTask;
    }

    private async Task RefreshAsync()
    {
        CancelCount();
        _countError = null;
        Tab.Error = null;
        Tab.Failure = null;
        Tab.FirstVisibleRow = null;
        Shell.MarkDirty();
        if (_grid is not null)
        {
            await _grid.RefreshAsync();
        }
    }

    private async Task TogglePinAsync(int column)
    {
        if (_grid is not null)
        {
            await _grid.TogglePinAsync(column);
        }
    }

    private async Task CountAsync()
    {
        if (_details is null)
        {
            return;
        }

        var cts = _countCts = new CancellationTokenSource();
        _countError = null;
        var details = _details;
        var filters = Tab.AppliedFilters;
        try
        {
            var data = await Workspaces.GetDataAsync(Tab.WorkspaceId, cts.Token);
            var count = await Task.Run(() => data.CountAsync(details, filters, cts.Token), cts.Token);
            Tab.TotalCount = count;
            if (_grid is not null)
            {
                await _grid.SetRowCountAsync(count);
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (DatabaseException ex)
        {
            QueryErrorLog.Log(Logger, ex, Active.Profile);
            _countError = ex;
            Shell.ReportFailure(ex);
        }
        finally
        {
            if (ReferenceEquals(_countCts, cts))
            {
                _countCts = null;
            }

            cts.Dispose();
        }
    }

    private void CancelCount() => _countCts?.Cancel();

    /// <summary>"In SQL-Editor öffnen": the statement in a new SQL tab, its bind values as variables (WP-17).</summary>
    private void OpenInSqlEditor(string sql, IReadOnlyList<QueryParameter> parameters)
    {
        _sql = null;
        Shell.OpenSql(sql + ";\n", parameters.Select(SqlBinds.FromParameter).ToList());
    }

    /// <summary>Shows the statement for the filters as currently edited (or the applied ones if the edit is invalid).</summary>
    private void ShowSql()
    {
        if (_details is null)
        {
            return;
        }

        var edited = Tab.FilterRows.Select(r => r.ToCondition()).ToList();
        var filters = QueryBuilder.Validate(_details, edited).Count == 0 ? edited : Tab.AppliedFilters;
        try
        {
            var query = QueryBuilder.BuildSelect(_details, filters, Tab.Sorts, new PageSpec(0, 500));
            _sql = (query.Sql, query.Parameters, null);
        }
        catch (QueryValidationException ex)
        {
            _sql = ("", [], ex.Message);
        }
    }

    /// <summary>The plan of the grid's query: the applied filters and sorting, first page (WP-14).</summary>
    private void ShowPlan()
    {
        if (_details is null)
        {
            return;
        }

        try
        {
            var query = QueryBuilder.BuildSelect(_details, Tab.AppliedFilters, Tab.Sorts, new PageSpec(0, IDataAccess.ActualPlanPageSize));
            // "Ganzes Ergebnis" means all rows of the filter, not the grid's first page: the same query without the limit.
            var whole = QueryBuilder.BuildSelect(_details, Tab.AppliedFilters, Tab.Sorts, new PageSpec(0, int.MaxValue));
            _plan = (new QuerySpec(query.Sql, query.Parameters), new QuerySpec(whole.Sql, whole.Parameters));
        }
        catch (QueryValidationException ex)
        {
            _sql = ("", [], ex.Message);
        }
    }

    private void OnTabCommand(WorkspaceTab tab, TabCommand command)
    {
        if (tab != Tab)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            switch (command)
            {
                case TabCommand.ApplyFilters:
                    await ApplyFiltersAsync();
                    break;
                case TabCommand.Refresh:
                    await RefreshViewAsync();
                    break;
                case TabCommand.Reload when _grid is not null:
                    await _grid.ReloadAsync();
                    break;
                case TabCommand.FindColumn when Tab.Mode == TabMode.Data:
                    _jump?.Open();
                    break;
                case TabCommand.FindColumn when Tab.Mode == TabMode.Structure && _columns is not null:
                    await _columns.FocusFilterAsync();
                    break;
            }

            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Shell.TabCommandRequested -= OnTabCommand;
        Presentations.Changed -= OnPresentationChanged;
        _countCts?.Cancel();
    }
}
