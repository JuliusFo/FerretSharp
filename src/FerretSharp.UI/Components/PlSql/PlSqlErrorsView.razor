@* "Errors" of a PL/SQL unit (WP-28): compile errors and warnings from ALL_ERRORS; a click shows the place in the source. *@
@using FerretSharp.Core.Schema

@if (Errors is { } errors)
{
    <section>
        <h2>@SchemaViewText.PlSql_ViewErrors <span class="count">@errors.Count</span></h2>
        @if (errors.Count == 0)
        {
            <p class="muted">@(Unit.IsInvalid
                ? SchemaViewText.PlSql_NoErrorsButInvalid
                : SchemaViewText.PlSql_NoCompileErrors)</p>
        }
        @foreach (var e in errors)
        {
            <button class="relation plsql-error @(e.IsWarning ? "warning" : "")" title="@SchemaViewText.PlSql_ShowInSource" @onclick="() => OnShow.InvokeAsync(e)">
                <span class="chip @(e.IsWarning ? "" : "invalid")">@(e.IsWarning ? SchemaViewText.PlSql_WarningChip : SchemaViewText.PlSql_ErrorChip)</span>
                @if (Unit.Kind == PlSqlKind.Package)
                {
                    <span class="muted">@(e.Part == PlSqlPart.Body ? SchemaViewText.PlSql_ViewBody : SchemaViewText.PlSql_ViewSpecification)</span>
                }
                <span class="mono position">@TextFormat.Format(SchemaViewText.PlSql_ErrorPosition, e.Line, e.Column)</span>
                <span class="message">@e.Text</span>
            </button>
        }
    </section>
}

@code {
    [Parameter, EditorRequired]
    public PlSqlObjectSummary Unit { get; set; } = null!;

    /// <summary>Null while loading.</summary>
    [Parameter]
    public IReadOnlyList<PlSqlError>? Errors { get; set; }

    [Parameter]
    public EventCallback<PlSqlError> OnShow { get; set; }
}
