<ModalFrame Label="@Title" Class="confirm" Alert="true" OnCancel="OnCancel">
    <header><span>@Title</span></header>
    <div class="dialog-body">@ChildContent</div>
    <footer>
        <span class="spacer"></span>
        <button class="btn ghost" @ref="_cancelButton" @onclick="OnCancel">@(CancelLabel ?? CommonText.Cancel)</button>
        @if (SecondaryLabel is not null)
        {
            <button class="btn" @onclick="OnSecondary">@SecondaryLabel</button>
        }
        <button class="btn @(Danger ? "danger-solid" : "primary")" @onclick="OnConfirm">@ConfirmLabel</button>
    </footer>
</ModalFrame>

@code {
    private ElementReference _cancelButton;

    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string ConfirmLabel { get; set; } = CommonText.Ok;

    /// <summary>The safe option (focused, also Esc); "Cancel" unless the question needs another word.</summary>
    [Parameter]
    public string? CancelLabel { get; set; }

    /// <summary>A third answer between cancel and confirm (e.g. close only the tabs that lose nothing); none if null.</summary>
    [Parameter]
    public string? SecondaryLabel { get; set; }

    [Parameter]
    public EventCallback OnSecondary { get; set; }

    [Parameter]
    public bool Danger { get; set; }

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    // Focus the safe option, so Enter does not delete by accident.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _cancelButton.FocusAsync();
        }
    }
}
