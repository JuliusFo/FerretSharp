@using FerretSharp.Core.Query

<ModalFrame Label="@SqlEditorText.SqlPreview_Title" Class="sql-dialog" OnCancel="OnClose" CloseOnBackdrop="true" FocusOnOpen="true">
    <header>
        <span>@Title</span>
        <span class="spacer"></span>
        @if (OnOpenInEditor.HasDelegate && Error is null)
        {
            <button class="btn" title="@SqlEditorText.SqlPreview_OpenInEditorTitle" @onclick="OnOpenInEditor">@SqlEditorText.SqlPreview_OpenInEditor</button>
        }
        <button class="icon-btn ghost" title="@CommonText.Close" @onclick="OnClose">✕</button>
    </header>
    @if (Error is not null)
    {
        <div class="test-result error"><span>@Error</span></div>
    }
    else
    {
        <SqlCode Sql="@Sql" />
        @if (Parameters.Count > 0)
        {
            <table class="binds">
                <thead><tr><th>@SqlEditorText.SqlPreview_BindVariable</th><th>@SqlEditorText.SqlPreview_Value</th><th>@SqlEditorText.SqlPreview_Type</th></tr></thead>
                <tbody>
                    @foreach (var p in Parameters)
                    {
                        <tr><td>:@p.Name</td><td>@BindValues.Format(p, mask: false)</td><td>@p.Type</td></tr>
                    }
                </tbody>
            </table>
        }
    }
</ModalFrame>

@code {
    [Parameter]
    public string Title { get; set; } = SqlEditorText.SqlPreview_Title;

    [Parameter]
    public string Sql { get; set; } = "";

    [Parameter]
    public IReadOnlyList<QueryParameter> Parameters { get; set; } = [];

    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>"Open in SQL editor" (WP-17); without a handler the button is not shown.</summary>
    [Parameter]
    public EventCallback OnOpenInEditor { get; set; }
}
