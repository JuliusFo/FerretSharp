@using FerretSharp.Core.Query

<div class="modal-backdrop" @onclick="OnClose" @onkeydown="OnKeyDown">
    <div class="modal dialog sql-dialog" @onclick:stopPropagation="true" role="dialog" aria-label="Generiertes SQL" tabindex="-1" @ref="_dialog">
        <header>
            <span>@Title</span>
            <span class="spacer"></span>
            <button class="btn" @onclick="CopyAsync">@(_copied ? "Kopiert ✓" : "Kopieren")</button>
            <button class="icon-btn ghost" title="Schließen" @onclick="OnClose">✕</button>
        </header>
        @if (Error is not null)
        {
            <div class="test-result error"><span>@Error</span></div>
        }
        else
        {
            <SqlCode Sql="@Sql" />
            @if (Parameters.Count > 0)
            {
                <table class="binds">
                    <thead><tr><th>Bind-Variable</th><th>Wert</th><th>Typ</th></tr></thead>
                    <tbody>
                        @foreach (var p in Parameters)
                        {
                            <tr><td>:@p.Name</td><td>@BindValues.Format(p, mask: false)</td><td>@p.Type</td></tr>
                        }
                    </tbody>
                </table>
            }
        }
    </div>
</div>

@code {
    private bool _copied;
    private ElementReference _dialog;

    [Inject]
    private IJSRuntime JS { get; set; } = null!;

    [Parameter]
    public string Title { get; set; } = "Generiertes SQL";

    [Parameter]
    public string Sql { get; set; } = "";

    [Parameter]
    public IReadOnlyList<QueryParameter> Parameters { get; set; } = [];

    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _dialog.FocusAsync(); // Escape closes
        }
    }

    private async Task CopyAsync()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", Sql);
        _copied = true;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await OnClose.InvokeAsync();
        }
    }
}
