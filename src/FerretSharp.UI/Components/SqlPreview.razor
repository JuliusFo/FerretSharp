@using FerretSharp.Core.Query

<ModalFrame Label="Generiertes SQL" Class="sql-dialog" OnCancel="OnClose" CloseOnBackdrop="true" FocusOnOpen="true">
    <header>
        <span>@Title</span>
        <span class="spacer"></span>
        @if (OnOpenInEditor.HasDelegate && Error is null)
        {
            <button class="btn" title="Neuer SQL-Editor mit diesem Statement; die Bind-Werte werden zu Variablen" @onclick="OnOpenInEditor">In SQL-Editor öffnen</button>
        }
        <button class="icon-btn ghost" title="Schließen" @onclick="OnClose">✕</button>
    </header>
    @if (Error is not null)
    {
        <div class="test-result error"><span>@Error</span></div>
    }
    else
    {
        <SqlCode Sql="@Sql" />
        @if (Parameters.Count > 0)
        {
            <table class="binds">
                <thead><tr><th>Bind-Variable</th><th>Wert</th><th>Typ</th></tr></thead>
                <tbody>
                    @foreach (var p in Parameters)
                    {
                        <tr><td>:@p.Name</td><td>@BindValues.Format(p, mask: false)</td><td>@p.Type</td></tr>
                    }
                </tbody>
            </table>
        }
    }
</ModalFrame>

@code {
    [Parameter]
    public string Title { get; set; } = "Generiertes SQL";

    [Parameter]
    public string Sql { get; set; } = "";

    [Parameter]
    public IReadOnlyList<QueryParameter> Parameters { get; set; } = [];

    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>"In SQL-Editor öffnen" (WP-17); without a handler the button is not shown.</summary>
    [Parameter]
    public EventCallback OnOpenInEditor { get; set; }
}
