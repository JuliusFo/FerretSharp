@* "Relations" view (WP-46, ADR 0033): the tables this one references to the left, those that reference it to the right,
   as a diagram. Edges are coloured by the kind of relationship, a dot marks the referencing end. "+n" on a node shows
   its hidden neighbours on that side, a click on the name opens the table; many neighbours at once become one node until
   shown. Nothing is read from the database: the schema holds every relationship. Laid out by DiagramLayout (Core),
   drawn here – nodes as HTML over an SVG of the edges, no JS but scrolling and the clipboard. "Path to …" (WP-74) shows
   every way to another table instead: the list beside a diagram of all of them, searched in blocks in the background. *@
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Relations
@using FerretSharp.Core.Schema
@inherits FerretComponent
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<RelationsView> Logger
@inject AppSettingsService Settings

@if (_state.Diagram is { } diagram && _state.Placement is { } placement)
{
    var lit = Neighbours(diagram);
    var inQuery = _query.Tables;
    var pathMode = PathMode;
    <div class="relations-view">
        <div class="relations-head">
            @if (!_query.Active)
            {
                <PathTargetPicker Start="_paths.Start" Target="_paths.Target" Tables="@(Active.Schema?.Tables ?? [])" Label="Label"
                                  EntityOf="Presentations.ShownEntityNameOf" OnPick="PickTargetAsync" />
            }
            @if (!pathMode)
            {
                <span class="muted" title="@SchemaViewText.Relations_LevelsTitle">@SchemaViewText.Relations_Levels</span>
                <div class="segmented small" role="group" title="@SchemaViewText.Relations_LevelsTitle">
                    @for (var depth = 1; depth <= RelationDiagram.MaxDepth; depth++)
                    {
                        var d = depth;
                        <button class="seg @(_state.Depth == d ? "active" : "")" aria-pressed="@(_state.Depth == d ? "true" : "false")"
                                @onclick="() => Change(() => _state.SetDepth(d))">@d</button>
                    }
                </div>
            }
            @foreach (var source in _state.Sources)
            {
                var s = source;
                <label class="relations-source" title="@SchemaViewText.Relations_SourceTitle">
                    @if (_state.Sources.Count > 1)
                    {
                        <input type="checkbox" checked="@_state.Shows(s)" @onchange="() => ToggleSourceAsync(s)" />
                    }
                    <span class="relations-swatch @DiagramStyle.KindClass(s)"></span>
                    @DiagramStyle.SourceLabel(s)
                </label>
            }
            <span class="spacer"></span>
            <button class="btn @(_query.Active ? "primary" : "ghost")" aria-pressed="@(_query.Active ? "true" : "false")" title="@SchemaViewText.Query_BuildTitle"
                    @onclick="ToggleQueryAsync">@SchemaViewText.Query_Build</button>
            <DiagramZoomBar Zoom="_state.Zoom" OnChange="() => { }" />
            @if (!pathMode)
            {
                <button class="btn ghost" title="@TextFormat.Format(SchemaViewText.Relations_ResetTitle, Label(_state.Home))" disabled="@(!_state.Changed)"
                        @onclick="() => Change(_state.Reset, scroll: true)">@CommonText.Reset</button>
            }
            <button class="btn ghost" title="@(pathMode ? SchemaViewText.Paths_CopyMermaidTitle : SchemaViewText.Relations_CopyMermaidTitle)" disabled="@(pathMode && _paths.Paths.Count == 0)"
                    @onclick="CopyMermaidAsync">@SchemaViewText.Relations_CopyMermaid</button>
        </div>

        <div class="relations-body @(_query.Active ? "with-query" : pathMode ? "with-paths" : "")">
        @if (pathMode)
        {
            <RelationPathsPanel State="_paths" Width="Settings.Current.PathsPanelWidth" OnWidthChanged="SavePathsWidthAsync" Label="Label" LabelKey="@Active.Schema?.Tables" OnHover="p => _hoverPath = p" OnSelect="p => _paths.Select(p)"
                                OnMore="RunPathsAsync" OnCancel="_paths.Cancel" OnAllow="t => SetAvoidedAsync(t, avoid: false)"
                                OnBuildQuery="BuildQueryAsync" OnCopyText="CopyPathTextAsync" OnCopyMermaid="CopyPathMermaidAsync" />
            @if (_paths.Placement is { } paths && _paths.Diagram is { } pathDiagram)
            {
                @if (_paths.Paths.Count == 0 && _paths.Done)
                {
                    <div class="relations-empty">
                        <EmptyState Title="@SchemaViewText.Paths_NoneTitle"
                                    Text="@TextFormat.Format(_state.Sources.All(_state.Shows) && _paths.Avoided.Count == 0 ? SchemaViewText.Paths_NoneText : SchemaViewText.Paths_NoneFilteredText, Label(_paths.Start), Label(_paths.Target!))" />
                    </div>
                }
                else
                {
                    var onPath = ActivePath is { } active ? active.Tables.ToHashSet() : null;
                    <DiagramCanvas Id="@CanvasId" Placement="paths" Zoom="_state.Zoom.Value" OnMouseLeave="() => _hover = null"
                                   EdgeClass="edge => PathEdgeClass(pathDiagram, edge)" EdgeTitle="edge => pathDiagram.RelationOf(edge.Id) is { } r ? DiagramStyle.EdgeTitle(r, Label) : null">
                        @foreach (var table in pathDiagram.Tables)
                        {
                            var t = table.Table;
                            var box = paths.Nodes[RelationDiagram.IdOf(t)];
                            var summary = Active.Schema?.Find(t);
                            var state = onPath is not null ? (onPath.Contains(t) ? "lit" : "faded") : DiagramStyle.NodeState(t, _hover, PathNeighbours(pathDiagram));
                            <div id="@(t == _paths.Start ? FocusId : null)" class="relations-node @(t == _paths.Start || t == _paths.Target ? "focus" : "") @state" style="@DiagramStyle.Box(box)"
                                 @onmouseenter="() => _hover = t" @onmouseleave="() => Leave(t)" @oncontextmenu="e => _menu!.OpenAsync(e, t)" @oncontextmenu:preventDefault="true">
                                @if (summary is not null)
                                {
                                    <button class="relations-name" title="@TextFormat.Format(SchemaViewText.Relations_OpenTitle, $"{t.Owner}.{t.Name}")"
                                            @onclick="() => Shell.OpenTable(summary)">@Label(t)</button>
                                }
                                else
                                {
                                    <span class="relations-name" title="@SchemaViewText.TableLink_OtherSchema">@Label(t)</span>
                                }
                                @if (SubLabel(t) is { } sub)
                                {
                                    <span class="relations-sub">@sub</span>
                                }
                            </div>
                        }
                    </DiagramCanvas>
                }
            }
        }
        else if (diagram.Tables.Count == 1 && diagram.Groups.Count == 0)
        {
            <div class="relations-empty">
                <EmptyState Title="@SchemaViewText.Relations_NoneTitle"
                            Text="@TextFormat.Format(_state.Sources.All(_state.Shows) ? SchemaViewText.Relations_NoneText : SchemaViewText.Relations_NoneHiddenText, Label(_state.Focus))" />
            </div>
        }
        else
        {
            <DiagramCanvas Id="@CanvasId" Placement="placement" Zoom="_state.Zoom.Value" OnMouseLeave="() => _hover = null"
                           EdgeClass="edge => EdgeClass(diagram, edge)" EdgeTitle="edge => EdgeTitle(diagram, edge)"
                           OnEdgeClick="@(_query.Active ? EventCallback.Factory.Create<EdgePath>(this, e => ToggleEdgeAsync(diagram, e)) : default)">
                @foreach (var table in diagram.Tables)
                {
                    var t = table.Table;
                    var box = placement.Nodes[RelationDiagram.IdOf(t)];
                    var summary = Active.Schema?.Find(t);
                    var parents = diagram.HiddenCount(t, DiagramSide.Parents);
                    var children = diagram.HiddenCount(t, DiagramSide.Children);
                    var toParents = parents > 0 ? diagram.HiddenRelations(t, DiagramSide.Parents) : [];
                    var toChildren = children > 0 ? diagram.HiddenRelations(t, DiagramSide.Children) : [];
                    <div id="@(t == _state.Focus ? FocusId : null)" class="relations-node @(t == _state.Focus ? "focus" : "") @(_query.Active && inQuery.Contains(t) ? "in-query" : "") @DiagramStyle.NodeState(t, _hover, lit)" style="@DiagramStyle.Box(box)"
                         @onmouseenter="() => _hover = t" @onmouseleave="() => Leave(t)" @oncontextmenu="e => _menu!.OpenAsync(e, t)" @oncontextmenu:preventDefault="true">
                        @if (parents > 0)
                        {
                            <button class="relations-handle left @DiagramStyle.HandleClass(toParents)" title="@DiagramStyle.HandleTitle(TextFormat.Plural(parents, SchemaViewText.Relations_ShowParentsOne, SchemaViewText.Relations_ShowParentsOther), toParents)"
                                    @onclick="() => Change(() => _state.Expand(t, DiagramSide.Parents), anchor: t)">@Icons.ChevronsLeft+@parents</button>
                        }
                        @if (summary is not null)
                        {
                            <button class="relations-name" title="@TextFormat.Format(SchemaViewText.Relations_OpenTitle, $"{t.Owner}.{t.Name}")"
                                    @onclick="() => Shell.OpenTable(summary)">@Label(t)</button>
                        }
                        else
                        {
                            <span class="relations-name" title="@SchemaViewText.TableLink_OtherSchema">@Label(t)</span>
                        }
                        @if (SubLabel(t) is { } sub)
                        {
                            <span class="relations-sub">@sub</span>
                        }
                        @if (children > 0)
                        {
                            <button class="relations-handle right @DiagramStyle.HandleClass(toChildren)" title="@DiagramStyle.HandleTitle(TextFormat.Plural(children, SchemaViewText.Relations_ShowChildrenOne, SchemaViewText.Relations_ShowChildrenOther), toChildren)"
                                    @onclick="() => Change(() => _state.Expand(t, DiagramSide.Children), anchor: t)">+@children@Icons.ChevronsRight</button>
                        }
                    </div>
                }
                @foreach (var group in diagram.Groups)
                {
                    var g = group;
                    var members = diagram.Members(g);
                    if (members.Count > 0 && placement.Nodes.TryGetValue(g.Id, out var box))
                    {
                        <div class="relations-node group" style="@DiagramStyle.Box(box)">
                            <span class="relations-name">@TextFormat.Plural(members.Count, SchemaViewText.Relations_GroupOne, SchemaViewText.Relations_GroupOther)</span>
                            <button class="btn small" title="@TextFormat.Format(SchemaViewText.Relations_GroupTitle, string.Join(", ", members.Select(Label)))"
                                    @onclick="() => Change(() => _state.Open(g), anchor: g.Table)">@SchemaViewText.Relations_GroupShow</button>
                        </div>
                    }
                }
            </DiagramCanvas>
        }
        @if (_query.Active)
        {
            <QueryDesignPanel Editor="_query" Tab="Tab" OnChanged="OnQueryChangedAsync" />
        }
        </div>
    </div>
}

@* A node's right-click menu (review 3.54.0, B2: built by hand before, without ↑ ↓). *@
<ContextMenuHost @ref="_menu" TItem="TableRef" Width="260" EstimatedHeight="150" Context="table">
    @{
        var summary = Active.Schema?.Find(table);
        var diagram = _state.Diagram;
    }
    <button class="menu-item" disabled="@(summary is null)" @onclick="() => FromMenu(() => Shell.OpenTable(summary!))">@TextFormat.Format(SchemaViewText.Relations_OpenTitle, Label(table))</button>
    @if (PathMode)
    {
        <button class="menu-item" disabled="@(table == _paths.Start || table == _paths.Target)" title="@TextFormat.Format(SchemaViewText.Paths_AvoidTitle, Label(table))"
                @onclick="() => AvoidFromMenuAsync(table)">@SchemaViewText.Paths_Avoid</button>
    }
    else
    {
        <button class="menu-item" disabled="@(table == _state.Focus)" @onclick="() => FromMenu(() => _state.Recenter(table), scroll: true)">@SchemaViewText.Relations_MenuCenter</button>
        <div class="menu-sep"></div>
        <button class="menu-item" disabled="@(diagram?.HiddenCount(table, DiagramSide.Parents) is not > 0)"
                @onclick="() => FromMenu(() => _state.Expand(table, DiagramSide.Parents), anchor: table)">@SchemaViewText.Relations_MenuShowParents</button>
        <button class="menu-item" disabled="@(diagram?.HiddenCount(table, DiagramSide.Children) is not > 0)"
                @onclick="() => FromMenu(() => _state.Expand(table, DiagramSide.Children), anchor: table)">@SchemaViewText.Relations_MenuShowChildren</button>
    }
</ContextMenuHost>

@if (_replace is { } replace)
{
    <ConfirmDialog Title="@SchemaViewText.Paths_ReplaceTitle" ConfirmLabel="@SchemaViewText.Paths_Replace" SecondaryLabel="@SchemaViewText.Paths_Append"
                   OnConfirm="() => TakePathAsync(replace, replace: true)" OnSecondary="() => TakePathAsync(replace, replace: false)" OnCancel="() => _replace = null">
        <p>@SchemaViewText.Paths_ReplaceText</p>
    </ConfirmDialog>
}

@code {
    private readonly string _id = "rel-" + Guid.NewGuid().ToString("N");
    private RelationsDiagramState _state = null!;
    private RelationPathsState _paths = null!;
    private RelationGraph? _graph;
    private RelationPath? _hoverPath;
    private RelationPath? _replace;
    private bool _disposed;
    private IReadOnlyList<ForeignKeyInfo>? _loadedRelations;
    private int? _loadedVersion;
    private TableRef? _hover;
    private ContextMenuHost<TableRef>? _menu;
    private bool _scroll = true;
    private (double X, double Y)? _scrollBy;
    private DomModule? _dom;

    [CascadingParameter]
    public ActiveConnection Active { get; set; } = null!;

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [CascadingParameter]
    public PresentationService Presentations { get; set; } = null!;

    [Parameter, EditorRequired]
    public TableDetails Details { get; set; } = null!;

    /// <summary>The tab: it keeps the query built here (WP-69).</summary>
    [Parameter, EditorRequired]
    public TableTab Tab { get; set; } = null!;

    private QueryDesignEditor _query = null!;

    private bool _loadingColumns;

    /// <summary>Incremented by the tab (F5): the diagram is built again from the schema, with what was expanded.</summary>
    [Parameter]
    public int Version { get; set; }

    /// <summary>
    /// The view is what the user sees now (<c>TabView.IsShown</c>). A restored tab mounts its view hidden: scrolling to the
    /// middle then does nothing, so it waits until the view is shown (review).
    /// </summary>
    [Parameter]
    public bool Shown { get; set; }

    /// <summary>
    /// Mounted once opened, it rendered its whole SVG on every change of the shell – each typed cell in another tab – also
    /// hidden (review 3.54.0, A24; as <c>UsageView</c>, review 3.44.0, A35). Shown again, its parameters render it.
    /// </summary>
    protected override bool ShouldRender() => Shown;

    private DomModule Dom => _dom ??= new(JS);

    private string FocusId => _id + "-focus";

    private string CanvasId => _id + "-canvas";

    protected override void OnInitialized()
    {
        _state = new RelationsDiagramState(Details.Table.Ref);
        _paths = new RelationPathsState(Details.Table.Ref);
        _paths.SetTarget(Tab.PathTarget);
        _paths.SetAvoided(AvoidedNow);
        _query = new QueryDesignEditor(Tab);
        Presentations.Changed += OnPresentationChanged;
        Settings.Changed += OnSettingsChanged;
    }

    /// <summary>
    /// F5, or the schema's relationships changed since: "Reload schema", or DDL in another tab, replaces them without an
    /// event this view hears (review); the tab renders again when it is shown.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (_loadedVersion != Version || !ReferenceEquals(Active.Schema?.ForeignKeys, _loadedRelations))
        {
            _loadedVersion = Version;
            Load();
        }
        else if (_query.Active && _query.Missing.Count > 0)
        {
            // Switched on from the object menu (WP-69) while the view was mounted.
            Fire(LoadColumnsAsync);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scroll && Shown && _state.Placement is not null)
        {
            _scroll = false;
            _scrollBy = null;
            await Dom.InvokeVoidAsync("scrollIntoViewById", FocusId, "center");
        }
        else if (_scrollBy is { } by)
        {
            _scrollBy = null;
            await Dom.InvokeVoidAsync("scrollByPx", CanvasId, by.X, by.Y);
        }
    }

    /// <summary>The schema's relationships as they are now; the C# model brings its own later (or a new build changes them).</summary>
    private void Load()
    {
        if (Active.Schema is not { } schema)
        {
            return;
        }

        _loadedRelations = schema.ForeignKeys;
        var graph = _graph = RelationGraph.Of(schema);
        _state.Load(graph);
        _query.Load(graph);
        LoadPaths();
        if (_query.Active)
        {
            Fire(LoadColumnsAsync);
        }
    }

    /// <summary>The ways follow the kinds of relationship the diagram shows; a new search runs its first block.</summary>
    private void LoadPaths()
    {
        if (_graph is null)
        {
            return;
        }

        _paths.Load(new RelationGraph(_graph.Relations.Where(r => _state.Shows(r.Source))));
        if (_hoverPath is { } hover && !_paths.Paths.Any(p => p.Key == hover.Key))
        {
            _hoverPath = null; // a new search: the way under the mouse is gone (review)
        }

        StartPaths();
    }

    /// <summary>The first block of a search that has none yet – for the path mode only, a hidden mode searches nothing.</summary>
    private void StartPaths()
    {
        if (PathMode && _paths.Paths.Count == 0 && !_paths.Running && !_paths.Done && !_paths.Cancelled)
        {
            Fire(RunPathsAsync);
        }
    }

    /// <summary>The diagram shows the ways to a target (WP-74); "Abfrage bauen" shows the neighbours with the query.</summary>
    private bool PathMode => _paths.Target is not null && !_query.Active;

    /// <summary>The way under the mouse in the list, else the one chosen.</summary>
    private RelationPath? ActivePath => _hoverPath ?? _paths.Selected;

    /// <summary>Searches one block; the list fills while it runs.</summary>
    private async Task RunPathsAsync()
    {
        if (_paths.Running)
        {
            return;
        }

        var run = _paths.MoreAsync();
        var length = _paths.Length;
        while (!run.IsCompleted)
        {
            await Task.WhenAny(run, Task.Delay(200));
            if (_disposed)
            {
                return;
            }

            // Only what changed: new ways or a longer length (review: the whole view rendered five times a second).
            if (_paths.Collect() | _paths.Length != length)
            {
                length = _paths.Length;
                StateHasChanged();
            }
        }

        await run;
        _paths.Collect();
        StateHasChanged();
    }

    private Task PickTargetAsync(TableRef? target)
    {
        _hoverPath = null;
        _hover = null;
        _paths.SetTarget(target);
        Tab.PathTarget = _paths.Target;
        Shell.MarkDirty();
        _scroll = true;
        StartPaths();
        return Task.CompletedTask;
    }

    private Task ToggleSourceAsync(FkSource source)
    {
        Change(() => _state.ToggleSource(source));
        LoadPaths();
        return Task.CompletedTask;
    }

    /// <summary>The connection's tables no way goes through, from the settings.</summary>
    private IReadOnlySet<TableRef> AvoidedNow =>
        Active.Profile?.Id is { } id ? Settings.Current.PathAvoidedTables.Of(id.ToString()) : new HashSet<TableRef>();

    private void OnSettingsChanged() => Fire(() =>
    {
        if (_disposed || AvoidedNow.SetEquals(_paths.Avoided))
        {
            return;
        }

        _hoverPath = null;
        _paths.SetAvoided(AvoidedNow);
        StartPaths();
        StateHasChanged();
    });

    private async Task SetAvoidedAsync(TableRef table, bool avoid)
    {
        if (Active.Profile?.Id.ToString() is not { } key)
        {
            return;
        }

        var tables = AvoidedNow.ToHashSet();
        if (!(avoid ? tables.Add(table) : tables.Remove(table)))
        {
            return;
        }

        // In effect at once (Changed starts the new search); only writing the file may fail.
        await Shell.TrySaveSettingsAsync(
            () => Settings.UpdateAsync(s => s with { PathAvoidedTables = s.PathAvoidedTables.With(key, tables) }, CancellationToken.None), Logger);
    }

    /// <summary>The dragged width of the list of ways – one for the whole app, kept in the settings; null for the default.</summary>
    private async Task SavePathsWidthAsync(int? width)
    {
        if (width == Settings.Current.PathsPanelWidth)
        {
            return;
        }

        await Shell.TrySaveSettingsAsync(() => Settings.UpdateAsync(s => s with { PathsPanelWidth = width }, CancellationToken.None), Logger);
    }

    private Task AvoidFromMenuAsync(TableRef table)
    {
        _menu?.Close();
        _hover = null;
        return SetAvoidedAsync(table, avoid: true);
    }

    /// <summary>"Abfrage bauen" for a way: asks first if the tab has a query already.</summary>
    private Task BuildQueryAsync(RelationPath path)
    {
        if (_query.HasSteps)
        {
            _replace = path;
            return Task.CompletedTask;
        }

        return TakePathAsync(path, replace: true);
    }

    /// <summary>The way into the query; the neighbours diagram opens along it and shows the query.</summary>
    private Task TakePathAsync(RelationPath path, bool replace)
    {
        _replace = null;
        _hoverPath = null;
        _hover = null;
        _query.TakePath(path, replace);
        Change(() => _state.ShowPath(path.Steps), scroll: true);
        Shell.MarkDirty();
        return LoadColumnsAsync();
    }

    private async Task CopyPathTextAsync(RelationPath path)
    {
        if (await Dom.CopyTextAsync(Shell, path.Text(Label)))
        {
            Shell.Notify(SchemaViewText.Paths_TextCopied);
        }
    }

    private async Task CopyPathMermaidAsync(RelationPath path)
    {
        if (await Dom.CopyTextAsync(Shell, RelationMermaid.Write([path], Label)))
        {
            Shell.Notify(SchemaViewText.Relations_MermaidCopied);
        }
    }

    /// <summary>An edge of the ways: its kind, lit on the way under the mouse or chosen, else by the table under the mouse.</summary>
    private string PathEdgeClass(PathDiagram diagram, EdgePath edge)
    {
        var kind = diagram.RelationOf(edge.Id) is { } relation ? DiagramStyle.KindClass(relation.Source) : "group";
        return ActivePath is { } path
            ? $"{kind} {(EdgesOf(path).Contains(edge.Id) ? "lit" : "faded")}"
            : $"{kind} {DiagramStyle.EdgeState(edge, HoverId)}";
    }

    private RelationPath? _edgesFor;
    private HashSet<string> _edges = [];

    /// <summary>The edge ids of a way, kept for the way last asked: every edge asks on every render (review).</summary>
    private HashSet<string> EdgesOf(RelationPath path)
    {
        if (!ReferenceEquals(path, _edgesFor))
        {
            (_edgesFor, _edges) = (path, path.Steps.Select(s => RelationGraph.KeyOf(s.Relation)).ToHashSet(StringComparer.Ordinal));
        }

        return _edges;
    }

    /// <summary>The tables related to the one under the mouse in the diagram of the ways.</summary>
    private IReadOnlySet<TableRef> PathNeighbours(PathDiagram diagram) =>
        _hover is not { } hover ? new HashSet<TableRef>()
        : diagram.Relations.Where(r => r.From == hover || r.To == hover).SelectMany(r => new[] { r.From, r.To }).ToHashSet();

    private Task ToggleQueryAsync()
    {
        _query.SetActive(!_query.Active);
        Shell.MarkDirty();
        _scroll = true;
        StartPaths(); // back to the ways, if there is a target
        return _query.Active ? LoadColumnsAsync() : Task.CompletedTask;
    }

    /// <summary>A click on an edge in the mode "Abfrage bauen": the relationship goes into the query or out of it.</summary>
    private Task ToggleEdgeAsync(RelationDiagram diagram, EdgePath edge)
    {
        if (diagram.RelationOf(edge.Id) is not { } relation || !_query.ToggleEdge(relation))
        {
            return Task.CompletedTask;
        }

        Shell.MarkDirty();
        return LoadColumnsAsync();
    }

    private Task OnQueryChangedAsync() => LoadColumnsAsync();

    /// <summary>The columns of the query's tables the panel and the SQL need, one table after the other.</summary>
    private async Task LoadColumnsAsync()
    {
        if (_loadingColumns || Active.Schema is not { } schema)
        {
            return;
        }

        _loadingColumns = true;
        _query.ColumnsFailed = false;
        try
        {
            while (_query.Missing is [var table, ..])
            {
                var summary = schema.Find(table) ?? new TableSummary(table.Owner, table.Name, TableKind.Table);
                var read = await Shell.RunDbAsync(Logger, Active, () => schema.GetDetailsAsync(summary, CancellationToken.None), CancellationToken.None);
                if (read.Value is not { } details)
                {
                    _query.ColumnsFailed = true;
                    StateHasChanged();
                    return;
                }

                _query.Loaded(details);
                StateHasChanged();
            }
        }
        finally
        {
            _loadingColumns = false;
        }
    }

    private string? EdgeTitle(RelationDiagram diagram, EdgePath edge) =>
        diagram.RelationOf(edge.Id) is not { } relation ? null
        : _query.Active ? TextFormat.Format(SchemaViewText.Query_EdgeTitle, DiagramStyle.EdgeTitle(relation, Label))
        : DiagramStyle.EdgeTitle(relation, Label);

    /// <summary>A loaded or changed C# model: entity names change, and with its navigations the relationships may too.</summary>
    private void OnPresentationChanged() => Fire(() =>
    {
        if (!ReferenceEquals(Active.Schema?.ForeignKeys, _loadedRelations))
        {
            Load();
        }

        StateHasChanged();
    });

    /// <param name="anchor">
    /// The table clicked: it stays where it is on the screen – a new column to the left, a taller column above it, would
    /// move it away from under the mouse.
    /// </param>
    private void Change(Action change, bool scroll = false, TableRef? anchor = null)
    {
        _hover = null;
        var before = anchor is null ? null : _state.Placement?.Nodes.GetValueOrDefault(RelationDiagram.IdOf(anchor));
        change();
        _scroll |= scroll;
        if (before is not null && _state.Placement?.Nodes.GetValueOrDefault(RelationDiagram.IdOf(anchor!)) is { } after)
        {
            _scrollBy = ((after.X - before.X) * _state.Zoom.Value, (after.Y - before.Y) * _state.Zoom.Value);
        }
    }

    private void Leave(TableRef table)
    {
        if (_hover == table)
        {
            _hover = null;
        }
    }

    private void FromMenu(Action action, bool scroll = false, TableRef? anchor = null)
    {
        _menu?.Close();
        Change(action, scroll, anchor);
    }

    private async Task CopyMermaidAsync()
    {
        if (_state.Diagram is not { } diagram || Active.Schema is not { } schema)
        {
            return;
        }

        var text = PathMode ? RelationMermaid.Write(_paths.Paths, schema.LabelOf) : RelationMermaid.Write(diagram, schema.LabelOf);
        if (await Dom.CopyTextAsync(Shell, text))
        {
            Shell.Notify(SchemaViewText.Relations_MermaidCopied);
        }
    }

    private string Label(TableRef table) => Active.Schema?.LabelOf(table) ?? table.ToString();

    /// <summary>The entity's name, if C# names are shown; otherwise the owner of a table reached through a synonym.</summary>
    private string? SubLabel(TableRef table) =>
        Presentations.ShownEntityNameOf(table)
        ?? (Active.Schema?.Find(table)?.Synonym is not null ? table.Owner : null);

    /// <summary>An edge's kind of relationship (<c>group</c> for one to a group) and its state under the mouse.</summary>
    private string EdgeClass(RelationDiagram diagram, EdgePath edge) =>
        $"{(diagram.RelationOf(edge.Id) is { } relation ? DiagramStyle.KindClass(relation.Source) : "group")} {DiagramStyle.EdgeState(edge, HoverId)}"
        + (_query.Active && _query.Edges.Contains(edge.Id) ? " in-query" : "");

    private string? HoverId => _hover is { } hover ? RelationDiagram.IdOf(hover) : null;

    /// <summary>The tables related to the one under the mouse.</summary>
    private IReadOnlySet<TableRef> Neighbours(RelationDiagram diagram) =>
        _hover is not { } hover ? new HashSet<TableRef>()
        : diagram.Relations.Where(r => r.From == hover || r.To == hover).SelectMany(r => new[] { r.From, r.To }).ToHashSet();

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _paths.Cancel();
        Presentations.Changed -= OnPresentationChanged;
        Settings.Changed -= OnSettingsChanged;
        await Dom.DisposeAsync();
    }
}
