@using FerretSharp.Core.Connections
@using FerretSharp.Core.Schema

@if (Active.Schema?.Find(Target) is { } table)
{
    <button class="link" title="@(table.Synonym is null ? SchemaViewText.TableLink_ShowStructure : TextFormat.Format(SchemaViewText.TableLink_ShowStructureViaSynonym, Target))"
            @onclick="() => Shell.OpenTable(table, TabMode.Structure)">@Active.Schema.LabelOf(Target)</button>
}
else
{
    <span class="mono" title="@SchemaViewText.TableLink_OtherSchema">@Target</span>
}

@code {
    [CascadingParameter]
    public ActiveConnection Active { get; set; } = null!;

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [Parameter, EditorRequired]
    public TableRef Target { get; set; } = null!;
}
