@* Header above the detail views: name, kind, synonym, status, comment, dates and statistics of the object. *@
@using FerretSharp.Core.Schema
@inherits DetailViewBase<ObjectInfo>

<div class="object-header">
    <div class="structure-head">
        <span class="structure-icon">@Icons.For(Table.Kind)</span>
        <h1>@Table.DisplayName</h1>
        <span class="chip">@KindLabel</span>
        @if (Table.Synonym is { } synonym)
        {
            <span class="chip syn">@(synonym.IsPublic ? SchemaViewText.PublicSynonymChip : "SYNONYM")</span>
            <span class="muted">→ @Table.Owner.@Table.Name</span>
        }
        @if (Details.IsIndexOrganized)
        {
            <span class="chip">INDEX-ORGANIZED</span>
        }
        @if (Data is { } flags)
        {
            @if (flags.IsInvalid)
            {
                <span class="chip invalid" title="@InvalidStatusText.For(Table.Kind == TableKind.MaterializedView ? "MATERIALIZED VIEW" : "VIEW")">@SchemaViewText.InvalidChip</span>
            }
            @if (flags.Partitioned)
            {
                <span class="chip">@SchemaViewText.Object_PartitionedChip</span>
            }
            @if (flags.Temporary)
            {
                <span class="chip">@SchemaViewText.Object_TemporaryChip</span>
            }
        }
        @if (Table.Synonym is null)
        {
            <span class="muted">@Table.Owner</span>
        }
    </div>

    @if (Data is { } info)
    {
        @if (info.Comment is { } comment)
        {
            <p class="object-comment">@comment</p>
        }
        <div class="object-meta">
            @if (info.Created is { } created)
            {
                <span>@TextFormat.Format(SchemaViewText.Object_Created, Format(created))</span>
            }
            @if (info.LastDdl is { } ddl)
            {
                <span>@TextFormat.Format(SchemaViewText.Object_LastDdl, Format(ddl))</span>
            }
            @if (info.NumRows is { } rows)
            {
                <span title="@SchemaViewText.Object_RowsEstimateTitle">@RowsText(rows, info.LastAnalyzed)</span>
            }
            else if (Table.Kind != TableKind.View)
            {
                <span title="@SchemaViewText.Object_NoStatisticsTitle">@SchemaViewText.Object_NoStatistics</span>
            }
            @if (info.Tablespace is { } tablespace)
            {
                <span>Tablespace @tablespace</span>
            }
        </div>
    }
    <DetailStatus Loading="Loading && Data is null" Error="Error" Text="@SchemaViewText.Object_Loading" />
</div>

@code {
    private string KindLabel => Table.Kind switch
    {
        TableKind.View => "VIEW",
        TableKind.MaterializedView => "MATERIALIZED VIEW",
        _ => SchemaViewText.Object_TableChip,
    };

    private static string Format(DateTime value) => value.ToString("g", CultureInfo.CurrentCulture);

    private static string RowsText(long rows, DateTime? analyzed) => analyzed is { } date
        ? TextFormat.Format(SchemaViewText.Object_RowsEstimateAnalyzed, rows.ToString("N0", CultureInfo.CurrentCulture), date.ToString("d", CultureInfo.CurrentCulture))
        : TextFormat.Format(SchemaViewText.Object_RowsEstimate, rows.ToString("N0", CultureInfo.CurrentCulture));

    protected override Task<ObjectInfo> LoadAsync(SchemaCache schema, CancellationToken cancellationToken) =>
        schema.GetObjectInfoAsync(Table, cancellationToken);
}
