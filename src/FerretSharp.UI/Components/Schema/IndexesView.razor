@* "Indexes" view: indexes of the table with columns/expressions and state, plus foreign keys without a supporting index.
   WP-23: "Create index" (columns in order, optionally UNIQUE) and "Create index for it" on an unindexed foreign key open a
   draft above the list; its DDL is run, opened in the SQL editor or saved through DdlDraftPanel. *@
@using FerretSharp.Core.Design
@using FerretSharp.Core.Schema
@inherits DetailViewBase<IReadOnlyList<IndexInfo>>
@inject ILogger<IndexesView> Logger

@if (Table.Kind == TableKind.View)
{
    <p class="muted">@SchemaViewText.Indexes_ViewHasNone</p>
}
else
{
    <DetailStatus Loading="Loading && Data is null" Error="Error" Text="@SchemaViewText.Indexes_Loading" />
    @if (Data is { } indexes)
    {
        // Declared foreign keys only; relationships of the C# model have no constraint to speak of.
        var unindexed = IndexAdvice.UnindexedForeignKeys(Active.Schema?.OutgoingOf(Table.Ref).Where(f => f.Source == FkSource.Declared) ?? [], indexes);
        @if (unindexed.Count > 0)
        {
            <div class="advice" role="note">
                <strong>@TextFormat.Plural(unindexed.Count, SchemaViewText.Indexes_UnindexedFkOne, SchemaViewText.Indexes_UnindexedFkOther)</strong>
                @foreach (var fk in unindexed)
                {
                    <span class="mono">
                        @fk.Name (@string.Join(", ", fk.FromColumns))
                        <button class="link-btn" title="@TextFormat.Format(SchemaViewText.Indexes_CreateForFkTitle, fk.Name)"
                                @onclick="() => StartDraftAsync(IndexDesign.ForForeignKey(fk, indexes))">@SchemaViewText.Indexes_CreateForFk</button>
                    </span>
                }
                <span class="muted">@SchemaViewText.Indexes_UnindexedFkHint</span>
            </div>
        }
        @if (_draft is { } editor)
        {
            var draft = editor.Draft;
            var check = IndexDesign.Check(draft, Details, indexes, _elsewhere, _tablespaces);
            <section class="index-draft">
                <h2>@SchemaViewText.Indexes_NewHeading</h2>
                <div class="index-draft-form">
                    <label for="@_nameId">@SchemaViewText.Head_Name</label>
                    <input id="@_nameId" class="field mono" spellcheck="false" value="@editor.Name" @oninput="e => editor.TypeName((string?)e.Value)" @onchange="editor.SuggestName" />

                    <span class="label">@SchemaViewText.Head_Columns</span>
                    <div class="index-draft-columns">
                        @for (var i = 0; i < editor.Columns.Count; i++)
                        {
                            var at = i;
                            var descending = editor.Descending.Contains(editor.Columns[at]);
                            <span class="index-draft-column">
                                <span class="mono">@editor.Columns[at]</span>
                                <button class="sort-toggle mono @(descending ? "desc" : "")" aria-pressed="@(descending ? "true" : "false")"
                                        title="@(descending ? SchemaViewText.Indexes_DescendingTitle : SchemaViewText.Indexes_AscendingTitle)"
                                        @onclick="() => editor.ToggleDescending(editor.Columns[at])">@(descending ? "DESC" : "ASC")</button>
                                <button class="icon-btn" disabled="@(at == 0)" title="@SchemaViewText.Indexes_ColumnEarlier" @onclick="() => editor.Move(at, -1)">@Icons.ArrowUp</button>
                                <button class="icon-btn" disabled="@(at == editor.Columns.Count - 1)" title="@SchemaViewText.Indexes_ColumnLater" @onclick="() => editor.Move(at, 1)">@Icons.ArrowDown</button>
                                <button class="icon-btn" title="@SchemaViewText.Indexes_ColumnRemove" @onclick="() => editor.Remove(at)">@Icons.Close</button>
                            </span>
                        }
                        @{ var free = Details.Columns.Where(c => !editor.Columns.Contains(c.Name) && !OracleTypes.IsLobOrLong(c.DataType)).ToList(); /* LOBs cannot be indexed */ }
                        @if (free.Count > 0)
                        {
                            @* Keyed on the choice: after adding, the select shows its placeholder again. *@
                            <select class="field" @key="editor.Columns.Count" @onchange="e => editor.Add((string?)e.Value)" aria-label="@SchemaViewText.Indexes_ColumnAdd">
                                <option value="" selected>@SchemaViewText.Indexes_ColumnAdd</option>
                                @foreach (var column in free)
                                {
                                    <option value="@column.Name">@column.Name · @column.DisplayType</option>
                                }
                            </select>
                        }
                    </div>

                    <span></span>
                    <label class="check">
                        <input type="checkbox" checked="@editor.Unique" @onchange="e => editor.Unique = e.Value is true" />
                        @SchemaViewText.Indexes_UniqueOption
                    </label>

                    <label for="@_tablespaceId">@SchemaViewText.Tablespace_Label</label>
                    <TablespacePicker Id="@_tablespaceId" Value="@editor.Tablespace" ValueChanged="value => editor.Tablespace = value"
                                      Tablespaces="_tablespaces" Suggestion="_tablespaces.ForIndexes()" Label="@SchemaViewText.Tablespace_Label" />
                </div>
                <DdlDraftPanel WorkspaceId="WorkspaceId" Steps="editor.Steps()" Problems="check.Problems" Warnings="check.Warnings"
                               FileName="@($"{DateTime.Now:yyyy-MM-dd}_{draft.Name}.sql")" OnRan="OnRanAsync" OnClose="() => _draft = null" />
            </section>
        }
        <section>
            <div class="structure-columns-head">
                <h2>@SchemaViewText.Indexes_Heading <span class="count">@indexes.Count</span></h2>
                @if (_draft is null)
                {
                    <button class="btn" @onclick="() => StartDraftAsync(null)"><span class="plus">+</span> @SchemaViewText.Indexes_Create</button>
                }
            </div>
            @if (indexes.Count == 0)
            {
                <p class="muted">@SchemaViewText.Indexes_None</p>
            }
            else
            {
                <table class="columns">
                    <thead>
                        <tr><th>@SchemaViewText.Head_Name</th><th>@SchemaViewText.Head_Columns</th><th>@SchemaViewText.Head_Type</th><th>@SchemaViewText.Head_Status</th><th>Tablespace</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var index in indexes)
                        {
                            <tr>
                                <td class="mono">
                                    @(index.Owner == Table.Owner ? index.Name : $"{index.Owner}.{index.Name}")
                                    @if (index.Unique)
                                    {
                                        <span class="fs-badge uk" title="@SchemaViewText.Indexes_Unique">UNIQUE</span>
                                    }
                                </td>
                                <td class="mono">
                                    @for (var i = 0; i < index.Columns.Count; i++)
                                    {
                                        var column = index.Columns[i];
                                        @(i > 0 ? ", " : "")
                                        <span class="@(column.IsExpression ? "expression" : "")">@column.Name</span>
                                        @if (column.Descending)
                                        {
                                            <span class="muted"> DESC</span>
                                        }
                                    }
                                </td>
                                <td>@index.IndexType</td>
                                <td class="state @(index.IsUnusable ? "bad" : "")">@State(index)</td>
                                <td class="mono">@index.Tablespace</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    }
}

@code {
    private readonly string _nameId = $"index-name-{Guid.NewGuid():N}";
    private readonly string _tablespaceId = $"index-tablespace-{Guid.NewGuid():N}";

    /// <summary>The open draft of a new index (WP-23); null while none is open.</summary>
    private IndexDraftEditor? _draft;

    /// <summary>The tab's workspace: DDL runs in its session.</summary>
    [Parameter, EditorRequired]
    public Guid WorkspaceId { get; set; }

    /// <summary>DDL ran: the tab reloads its detail views (indexes, constraints, DDL).</summary>
    [Parameter]
    public EventCallback OnSchemaChanged { get; set; }

    private static string State(IndexInfo index) => string.Join(" · ", new[]
    {
        index.Status switch { "VALID" => SchemaViewText.Indexes_Valid, "UNUSABLE" => "UNUSABLE", "N/A" => null, var s => s },
        index.Partitioned ? SchemaViewText.Indexes_Partitioned : null,
        index.Visible ? null : SchemaViewText.Indexes_Invisible,
    }.OfType<string>());

    protected override Task<IReadOnlyList<IndexInfo>> LoadAsync(SchemaCache schema, CancellationToken cancellationToken) =>
        Table.Kind == TableKind.View ? Task.FromResult<IReadOnlyList<IndexInfo>>([]) : schema.GetIndexesAsync(Table.Ref, cancellationToken);

    /// <summary>
    /// Index names of the owner's other tables, read when the first draft opens (one round trip, not on every visit of the
    /// view); null until then or if the read failed – the check knows the table's own then, Oracle refuses the rest cleanly.
    /// </summary>
    private IReadOnlySet<string>? _elsewhere;

    /// <summary>The tablespaces to choose from, the owner's quotas and where the indexes lie (WP-67); read with the names.</summary>
    private Tablespaces _tablespaces = Tablespaces.None;

    /// <summary>Opens a draft at once – empty, or one prepared for a foreign key – and reads the names it must avoid and the tablespaces.</summary>
    private async Task StartDraftAsync(IndexDraft? prepared)
    {
        _draft = Data is { } indexes ? IndexDraftEditor.Start(Table.Ref, indexes, prepared) : null;
        if (_draft is not null && _elsewhere is null && Active.Schema is { } schema)
        {
            var table = Table.Ref;
            var read = await Shell.RunDbAsync(Logger, Active, async () =>
                (await schema.GetNamesElsewhereAsync(table, CancellationToken.None), await schema.GetTablespacesAsync(table, CancellationToken.None)));
            (_elsewhere, _tablespaces) = (read.Value.Item1?.Indexes, read.Value.Item2 ?? Tablespaces.None);
        }
    }

    private async Task OnRanAsync()
    {
        _draft = null;
        await OnSchemaChanged.InvokeAsync();
    }
}
