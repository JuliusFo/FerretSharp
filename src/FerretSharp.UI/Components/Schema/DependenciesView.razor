@* "Dependencies" view: what the object uses and what uses it (views, packages, triggers, synonyms …). *@
@using FerretSharp.Core.Schema
@inherits DetailViewBase<ObjectDependencies>

<DetailStatus Loading="Loading && Data is null" Error="Error" Text="@SchemaViewText.Dependencies_Loading" />

@if (Data is { } dependencies)
{
    <DependencyList Dependencies="dependencies" Owner="@Table.Owner" Subject="@Table.DisplayName"
                    NoUses="@(Table.Kind == TableKind.Table ? SchemaViewText.Dependencies_TableUsesNothing : SchemaViewText.Dependencies_NoneFound)" />
}

@code {
    protected override Task<ObjectDependencies> LoadAsync(SchemaCache schema, CancellationToken cancellationToken) =>
        schema.GetDependenciesAsync(Table, cancellationToken);
}
