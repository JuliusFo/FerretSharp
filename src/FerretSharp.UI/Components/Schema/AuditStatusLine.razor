@* The table's audit objects in one line above its columns (WP-26), graded so that a table without audit table – the normal
   case – does not look like a fault: none → a grey "Create audit…"; up to date → the names, neutral; outdated → a warning
   with the reasons and "Bring up to date". Hidden for an audit table itself and while the template cannot be used. *@
@using FerretSharp.Core.Audit
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Schema
@inherits FerretComponent
@implements IDisposable
@inject AuditTemplateSource AuditTemplates
@inject ILogger<AuditStatusLine> Logger

@switch (_status)
{
    case { Health: AuditHealth.None }:
        <div class="audit-status">
            <button class="link-btn muted" title="@($"{SchemaViewText.Audit_CreateTitle}\n{_templateLabel}")" @onclick="() => OnOpen.InvokeAsync()">@SchemaViewText.Audit_Create</button>
        </div>
        break;
    case { Health: AuditHealth.UpToDate } status:
        <div class="audit-status muted" title="@_templateLabel">
            @SchemaViewText.Audit_Label @AuditTable(status.Names) · <span class="mono">@status.Names.Trigger</span>
        </div>
        break;
    case { Health: AuditHealth.Outdated } status:
        <div class="audit-status warn" title="@($"{SchemaViewText.Audit_OutdatedTitle}\n{_templateLabel}")">
            ⚠ @SchemaViewText.Audit_Label @AuditTable(status.Names)
            <span>@TextFormat.Format(SchemaViewText.Audit_Outdated, string.Join("; ", status.Reasons))</span>
            · <button class="link-btn" @onclick="() => OnOpen.InvokeAsync()">@SchemaViewText.Audit_Sync</button>
        </div>
        break;
}

@code {
    /// <summary>The audit table's name (WP-26): a link that opens it (R6b: was a component of its own).</summary>
    private RenderFragment AuditTable(FerretSharp.Core.Audit.AuditNames names) =>
        @<button class="link-btn mono" title="@SchemaViewText.Audit_OpenTable" @onclick="() => OpenAuditTable(names)">@names.AuditTable.Name</button>;

    private AuditStatus? _status;
    private string? _templateLabel; // which template applies and where it is set (WP-51)
    private TableDetails? _loadedFor;
    private readonly CancellationTokenSource _cts = new();

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [CascadingParameter]
    public ActiveConnection Active { get; set; } = null!;

    [Parameter, EditorRequired]
    public TableDetails Details { get; set; } = null!;

    /// <summary>Opens the designer with the audit box on.</summary>
    [Parameter]
    public EventCallback OnOpen { get; set; }

    /// <summary>
    /// Loads again for other details (the tab reloaded after DDL). Without an audit table or trigger of the template's
    /// names in the schema list this asks the database nothing.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (ReferenceEquals(_loadedFor, Details))
        {
            return;
        }

        _loadedFor = Details;
        _status = null;
        var load = AuditTemplates.For(Active.Profile);
        _templateLabel = AuditTemplateLabel.Of(load);
        if (load.Template is not { } template || Active.Schema is not { } schema
            || AuditStatus.IsAuditTable(template, Details.Table.Ref, schema.Tables.Where(t => t.Kind == TableKind.Table && t.Synonym is null).Select(t => t.Ref)))
        {
            return;
        }

        var names = template.NamesFor(Details.Table.Ref);
        if (schema.Find(names.AuditTable) is null && schema.FindPlSql(new PlSqlRef(names.AuditTable.Owner, names.Trigger, PlSqlKind.Trigger)) is null)
        {
            _status = new AuditStatus(AuditHealth.None, names, []);
            return;
        }

        var details = Details;
        var token = _cts.Token;
        var loaded = await Shell.RunDbAsync(Logger, Active, () => AuditLoader.LoadAsync(schema, names, token), token);
        if (loaded.Value is { } state && ReferenceEquals(details, Details))
        {
            _status = AuditStatus.Of(template, details.Table.Ref, details.Columns, state);
        }
    }

    private void OpenAuditTable(AuditNames names)
    {
        if (Active.Schema?.Find(names.AuditTable) is { } summary)
        {
            Shell.OpenTable(summary);
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
