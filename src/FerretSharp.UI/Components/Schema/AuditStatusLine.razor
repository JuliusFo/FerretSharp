@* The table's audit objects in one line above its columns (WP-26), graded so that a table without audit table – the normal
   case – does not look like a fault: none → a grey "Create audit…" (nothing when audit tables may not be created); up to date → the names, neutral; outdated → a warning
   with the reasons and "Bring up to date" (not for a missing audit table that may not be created). Hidden for an audit table itself and while the template cannot be used. Many
   missing columns and audit columns that cannot take every value are counted in the line and listed under "Details",
   with the advice once (an audit table not kept up for long filled half the view with one sentence per column), and so
   are the changes "Bring up to date" makes without touching values (types, NOT NULL, comments). *@
@using FerretSharp.Core.Audit
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Schema
@inherits FerretComponent
@implements IDisposable
@inject AuditTemplateSource AuditTemplates
@inject AppSettingsService Settings
@inject ILogger<AuditStatusLine> Logger

@switch (_status)
{
    case { Health: AuditHealth.None } when Settings.Current.CreateAuditTables:
        <div class="audit-status">
            <button class="link-btn muted" title="@($"{SchemaViewText.Audit_CreateTitle}\n{_templateLabel}")" @onclick="() => OnOpen.InvokeAsync()">@SchemaViewText.Audit_Create</button>
        </div>
        break;
    case { Health: AuditHealth.UpToDate } status:
        <div class="audit-status muted" title="@_templateLabel">
            @SchemaViewText.Audit_Label @AuditTable(status.Names) · <span class="mono">@status.Names.Trigger</span>
        </div>
        break;
    case { Health: AuditHealth.Outdated } status:
        var title = $"{SchemaViewText.Audit_OutdatedTitle}\n{_templateLabel}"; // not on the details: they have their own text
        <div class="audit-status warn">
            <span class="audit-head" title="@title">@Icons.Warning @SchemaViewText.Audit_Label</span> @AuditTable(status.Names)
            <span title="@title">@SchemaViewText.Audit_Outdated @string.Join(" · ", AuditStatusSummary.Parts(status))</span>
            @if (AuditStatusSummary.HasDetails(status))
            {
                <span>·</span>
                <button type="button" class="link-btn" aria-expanded="@(_details ? "true" : "false")" @onclick="() => _details = !_details">
                    @CommonText.Details<span class="chev @(_details ? "" : "closed")">@Icons.ChevronDown</span>
                </button>
            }
            @if (AuditStatusSummary.CanSync(status, Settings.Current.CreateAuditTables))
            {
                <span>·</span> <button class="link-btn" @onclick="() => OnOpen.InvokeAsync()">@SchemaViewText.Audit_Sync</button>
            }
            else
            {
                <span>·</span> <span class="muted" title="@AuditStatusSummary.CreateOffHint">@SchemaViewText.Audit_SyncCreateOff</span>
            }
            @if (_details)
            {
                <div class="audit-details">
                    @if (status.ColumnIssues.Count > 0)
                    {
                        <table>
                            <thead>
                                <tr>
                                    <th>@SchemaViewText.Head_Name</th>
                                    <th>@TextFormat.Format(SchemaViewText.Audit_IssueAuditType, status.Names.AuditTable.Name)</th>
                                    <th>@SchemaViewText.Audit_IssueValueType</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var issue in status.ColumnIssues)
                                {
                                    <tr>
                                        <td class="mono">@issue.Column</td>
                                        <td class="mono">@issue.AuditType</td>
                                        <td><span class="mono">@issue.ValueType</span>@if (issue.OfTemplate) { <span class="muted"> @SchemaViewText.Audit_IssueFromTemplate</span> }</td>
                                        <td>@AuditStatusSummary.Consequence(issue)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <p>@SchemaViewText.Audit_IssuesAdvice</p>
                    }
                    @if (status.MissingColumns.Count > AuditStatusSummary.NamedMissing)
                    {
                        <p>@TextFormat.Format(SchemaViewText.Audit_MissingList, string.Join(", ", status.MissingColumns))</p>
                    }
                    @if (status.Changes.Count > 0)
                    {
                        <p>@TextFormat.Format(SchemaViewText.Audit_ChangesHead, SchemaViewText.Audit_Sync)</p>
                        <table>
                            <thead>
                                <tr>
                                    <th>@SchemaViewText.Head_Name</th>
                                    <th>@SchemaViewText.Audit_ChangeHeadKind</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var change in status.Changes)
                                {
                                    <tr>
                                        <td class="mono">@change.Column</td>
                                        <td>@AuditStatusSummary.Label(change)</td>
                                        <td class="audit-change">
                                            @switch (change.Kind)
                                            {
                                                case AuditChangeKind.TypeGrows:
                                                    <span class="mono">@change.Before → @change.After</span>
                                                    break;
                                                case AuditChangeKind.Comment or AuditChangeKind.TableComment:
                                                    <span class="@(change.After is null ? "muted" : "")" title="@change.Before">@(change.After ?? SchemaViewText.Audit_ChangeNoComment)</span>
                                                    break;
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            }
        </div>
        break;
}

@code {
    /// <summary>The audit table's name (WP-26): a link that opens it (R6b: was a component of its own).</summary>
    private RenderFragment AuditTable(FerretSharp.Core.Audit.AuditNames names) =>
        @<button class="link-btn mono" title="@SchemaViewText.Audit_OpenTable" @onclick="() => OpenAuditTable(names)">@names.AuditTable.Name</button>;

    private AuditStatus? _status;
    private bool _details; // the details of an outdated audit unfolded
    private string? _templateLabel; // which template applies and where it is set (WP-51)
    private TableDetails? _loadedFor;
    private readonly CancellationTokenSource _cts = new();

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [CascadingParameter]
    public ActiveConnection Active { get; set; } = null!;

    [Parameter, EditorRequired]
    public TableDetails Details { get; set; } = null!;

    /// <summary>Opens the designer with the audit box on.</summary>
    [Parameter]
    public EventCallback OnOpen { get; set; }

    /// <summary>
    /// Loads again for other details (the tab reloaded after DDL). Without an audit table or trigger of the template's
    /// names in the schema list this asks the database nothing.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (ReferenceEquals(_loadedFor, Details))
        {
            return;
        }

        _loadedFor = Details;
        _status = null;
        var load = AuditTemplates.For(Active.Profile);
        _templateLabel = AuditTemplateLabel.Of(load);
        if (load.Template is not { } template || Active.Schema is not { } schema
            || AuditStatus.IsAuditTable(template, Details.Table.Ref, schema.Tables.Where(t => t.Kind == TableKind.Table && t.Synonym is null).Select(t => t.Ref)))
        {
            return;
        }

        var names = template.NamesFor(Details.Table.Ref);
        if (schema.Find(names.AuditTable) is null && schema.FindPlSql(new PlSqlRef(names.AuditTable.Owner, names.Trigger, PlSqlKind.Trigger)) is null)
        {
            _status = new AuditStatus(AuditHealth.None, names, []);
            return;
        }

        var details = Details;
        var token = _cts.Token;
        var loaded = await Shell.RunDbAsync(Logger, Active, () => AuditLoader.LoadAsync(schema, names, token), token);
        if (loaded.Value is { } state && ReferenceEquals(details, Details))
        {
            _status = AuditStatus.Of(template, details.Table.Ref, details.Columns, state);
        }
    }

    private void OpenAuditTable(AuditNames names)
    {
        if (Active.Schema?.Find(names.AuditTable) is { } summary)
        {
            Shell.OpenTable(summary);
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
