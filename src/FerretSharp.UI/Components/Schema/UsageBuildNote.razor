@* Projects that could use the model are not built (WP-40 addendum): "unused" may be wrong, so the views showing it say
   so, with a build of the whole solution right there (decision of the user, 2026-10-23); also a failed build's output.
   While the build runs, how many of the solution's projects are built and which came last. It follows both services itself,
   while its view is shown. *@
@using System.Globalization
@using FerretSharp.Core.ClrModel
@inherits FerretComponent
@implements IDisposable

@if (Usage.State.Result is { } result)
{
    var missing = result.Missing;
    @if (missing.Count > 0 || Usage.IsBuildingSolution)
    {
        <div class="settings-note warn usage-build-note">
            @if (missing.Count > 0)
            {
                <span title="@string.Join("\n", missing.Select(p => p.Name))">@TextFormat.Format(MissingNote ?? ModelViewText.Usage_MissingNote, missing.Count)</span>
            }
            @if (Usage.IsBuildingSolution)
            {
                @* Its own row under the sentence: beside it, Cancel broke onto a line of its own (review of the PR). *@
                <div class="usage-build-run">
                    <span class="muted"><span class="spinner small"></span> @ModelViewText.Usage_BuildingSolution</span>
                    @if (Usage.BuildProgress is { Fraction: { } fraction } progress)
                    {
                        var done = TextFormat.Format(ModelViewText.Usage_BuildProgress, progress.Done, progress.Total);
                        <span class="build-progress" role="progressbar" aria-label="@done" aria-valuemin="0" aria-valuemax="@progress.Total" aria-valuenow="@progress.Done">
                            <span style="width: @((fraction * 100).ToString("0.#", CultureInfo.InvariantCulture))%"></span>
                        </span>
                        <span class="muted">@done</span>
                        @if (progress.Last is { } last)
                        {
                            <span class="muted ellipsis build-progress-last" title="@last">@TextFormat.Format(ModelViewText.Usage_BuildLast, last)</span>
                        }
                    }
                    @if (Usage.IsCancellingSolutionBuild)
                    {
                        <span class="muted">@ModelViewText.Usage_BuildSolutionCancelling</span>
                    }
                    else
                    {
                        <button class="link-btn" title="@ModelViewText.Usage_BuildSolutionCancelTitle" @onclick="Usage.CancelSolutionBuild">@CommonText.Cancel</button>
                    }
                </div>
            }
            else if (Usage.Solution is { } solution && Models.State.Link is { } link)
            {
                @if (Usage.SolutionBuildCancelled)
                {
                    <span class="muted">@ModelViewText.Usage_BuildSolutionCancelled</span>
                }
                <button class="btn" disabled="@(Models.IsBuilding || Usage.State.Phase == CodeUsagePhase.Building)"
                        title="@TextFormat.Format(ModelViewText.Usage_BuildSolutionTitle, System.IO.Path.GetFileName(solution), link.Configuration)"
                        @onclick="BuildAsync">@ModelViewText.Usage_BuildSolution</button>
            }
        </div>
    }
    @if (Usage.LastSolutionBuild is { Succeeded: false } build && !Usage.IsBuildingSolution)
    {
        <div class="tab-error">
            <span>@(build.Error ?? TextFormat.Format(ModelViewText.Usage_BuildSolutionFailed, build.ExitCode))</span>
            <button class="link-btn" @onclick="() => _showOutput = !_showOutput">@(_showOutput ? ModelViewText.Model_HideDetails : CommonText.Details)</button>
        </div>
        @if (_showOutput)
        {
            <pre class="model-log">@build.Output</pre>
        }
    }
}

@code {
    [CascadingParameter]
    public ClrModelManager Models { get; set; } = null!;

    [CascadingParameter]
    public CodeUsageService Usage { get; set; } = null!;

    /// <summary>
    /// False while the view around it is hidden: it then does not render on every step of the model (review 3.44.0, A35 for
    /// the view itself; the note follows the services on its own). Shown again, the parameter renders it.
    /// </summary>
    [Parameter]
    public bool Shown { get; set; } = true;

    /// <summary>What the missing projects mean for the view around it ({0} = their number); "unused may be wrong" by default.</summary>
    [Parameter]
    public string? MissingNote { get; set; }

    private readonly CancellationTokenSource _lifetime = new();

    private bool _showOutput;

    protected override void OnInitialized()
    {
        Usage.Changed += OnChanged;
        Models.Changed += OnChanged;
    }

    protected override bool ShouldRender() => Shown;

    private void OnChanged() => Fire(StateHasChanged);

    private Task BuildAsync() => GuardAsync(async () =>
    {
        _showOutput = false;
        await Usage.BuildSolutionAsync(_lifetime.Token);
    });

    public void Dispose()
    {
        Usage.Changed -= OnChanged;
        Models.Changed -= OnChanged;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
