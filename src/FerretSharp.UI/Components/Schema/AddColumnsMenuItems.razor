@* Columns of a table added to the same table elsewhere (small-column-add-ddl, chips since WP-61): copy the ALTER TABLE … ADD
   of the columns with the foreign keys made only of them, or open it in a SQL tab of another connection, connecting if need
   be (AddColumnsScript). The menu of the "Columns" view and the column header menu of a table grid (the column, or all
   marked columns with it). Connections the menu's filter does not match are left out. *@
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Ddl
@using FerretSharp.Core.Schema
@inject ConnectionManager Connections
@inject ConnectionHub Hub
@inject AppSettingsService Settings
@inject ILogger<AddColumnsMenuItems> Logger
@inject IClipboardService Clipboard
@implements IAsyncDisposable

@{
    var targets = AddColumnsTargets.Of(Connections.Profiles, Active.Profile?.Id ?? Guid.Empty)
        .Where(t => Filter?.Matches(ConnectionLabel.Of(t, Settings.Current), ConnectionKindInfo.Short(t.Kind)) != false).ToList();
}
<div class="ctx-section">
    <div class="group-head-btn static" title="@SchemaViewText.Columns_CopyAddScriptTitle">
        @TextFormat.Format(SchemaViewText.Columns_AddScriptGroup, TextFormat.Plural(Columns.Count, SchemaViewText.Columns_PickedOne, SchemaViewText.Columns_PickedOther))
    </div>
    <div class="chips menu-chips">
        <button type="button" class="menu-chip" title="@SchemaViewText.Columns_CopyAddScriptTitle" disabled="@_reading" @onclick="CopyAsync">@Icons.Copy @SchemaViewText.Columns_CopyAddScriptChip</button>
    </div>
    @if (_reading)
    {
        <div class="ctx-note">@SchemaViewText.Columns_ReadingForeignKeys</div>
    }
    <div class="group-head-btn static">@SchemaViewText.Columns_OpenAddScriptIn</div>
    <div class="chips menu-chips">
        @foreach (var target in targets)
        {
            var table = TargetTable(target);
            <button type="button" class="menu-chip conn kind-@target.Kind.ToString().ToLowerInvariant()" disabled="@_reading" @onclick="() => OpenInAsync(target)"
                    title="@TextFormat.Format(SchemaViewText.Columns_OpenAddScriptTitle, ConnectionLabel.Of(target, Settings.Current), $"{table.Owner}.{table.Name}")">
                <span class="kind-badge">@ConnectionKindInfo.Short(target.Kind)</span> @ConnectionLabel.Of(target, Settings.Current)
            </button>
        }
        @if (targets.Count == 0)
        {
            <span class="ctx-empty">@(Filter?.Active == true ? GridText.Menu_NoMatch : SchemaViewText.Columns_NoOtherConnection)</span>
        }
    </div>
</div>

@code {
    [CascadingParameter]
    public ActiveConnection Active { get; set; } = null!;

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [CascadingParameter]
    public WorkspaceLifecycle Lifecycle { get; set; } = null!;

    [CascadingParameter]
    public MenuFilter? Filter { get; set; }

    [Parameter, EditorRequired]
    public TableDetails Details { get; set; } = null!;

    /// <summary>The columns to add, by name, in the order the script adds them.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<string> Columns { get; set; } = [];

    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>Connections shown before the menu offers a filter field (the "Columns" view).</summary>
    public const int ShownWithoutFilter = 8;

    /// <summary>The table the script changes on <paramref name="target"/>: the matching one if its schema is loaded, else by name in its schema.</summary>
    private TableRef TargetTable(ConnectionProfile target) => AddColumnsTargets.Table(target, Hub.Find(target.Id)?.Active.Schema, Details.Table.Ref);

    /// <summary>Ends the constraint read when the menu closes.</summary>
    private readonly CancellationTokenSource _lifetime = new();

    /// <summary>
    /// The constraints are being read: the chips wait, and the menu says so – the read goes through the connection's
    /// explorer session and may wait behind another call on it (review, finding 2).
    /// </summary>
    private bool _reading;

    /// <summary>
    /// The script for <paramref name="target"/>; null if the menu closed during the read. Table and columns are taken before
    /// the read: new details of the parent meanwhile must not mix with them (review, finding 5).
    /// </summary>
    private async Task<string?> ScriptAsync(TableRef target)
    {
        var source = Details.Table.Ref;
        var columns = Columns.Select(name => Details.Columns[Details.IndexOf(name)]).ToList();
        _reading = true;
        try
        {
            var constraints = await ConstraintsAsync(source);
            return _lifetime.IsCancellationRequested ? null : AddColumnsScript.Write(source, target, columns, constraints);
        }
        finally
        {
            _reading = false;
        }
    }

    /// <summary>
    /// The table's constraints for its foreign keys, read on the click: the column header menu of every grid shows these
    /// items, opening it must not cost a query. Null if they could not be read (the error is logged, the script says so).
    /// </summary>
    private async Task<IReadOnlyList<ConstraintInfo>?> ConstraintsAsync(TableRef table)
    {
        if (Active.Schema is not { } schema)
        {
            return null;
        }

        var token = _lifetime.Token;
        var read = await Shell.RunDbAsync(Logger, Active, () => schema.GetConstraintsAsync(table, token), token);
        return read.Succeeded ? read.Value : null;
    }

    /// <summary>
    /// Through the host's clipboard: the text exists only after a read, and the browser's clipboard refuses once the window
    /// is no longer in front (ui.md; review, finding 1).
    /// </summary>
    private async Task CopyAsync()
    {
        if (await ScriptAsync(Details.Table.Ref) is not { } script)
        {
            return;
        }

        var count = Columns.Count;
        await OnClose.InvokeAsync();
        Shell.Notify(await Clipboard.SetTextAsync(script)
            ? TextFormat.Format(SchemaViewText.Columns_AddScriptCopied, TextFormat.Plural(count, SchemaViewText.Columns_PickedOne, SchemaViewText.Columns_PickedOther))
            : CommonText.ClipboardUnavailable);
    }

    /// <summary>
    /// The script in a SQL tab of <paramref name="target"/>, shown and connected if need be – as the schema comparison's
    /// proposal (WP-22): it runs there like any script, with the confirmation of the schema path.
    /// </summary>
    private async Task OpenInAsync(ConnectionProfile target)
    {
        if (await ScriptAsync(TargetTable(target)) is not { } script)
        {
            return;
        }

        await OnClose.InvokeAsync();
        Shell.OpenSqlIn(target.Id, script);
        await Lifecycle.ConnectAsync(target);
    }

    public async ValueTask DisposeAsync()
    {
        await _lifetime.CancelAsync();
        _lifetime.Dispose();
    }
}
