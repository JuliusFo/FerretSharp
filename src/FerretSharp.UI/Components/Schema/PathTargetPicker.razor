@* "Path to …" in the head of the relationship view (WP-74): the table picker over the schema's tables without the start – by
   name, synonym and entity name like the quick open (code review of the foreign key target picker: one picker for both) –
   and an ✕ back to the neighbours. *@
@using FerretSharp.Core.Schema

<span class="path-target">
    <TablePicker Tables="Choices" Value="Target" ValueChanged="OnPick" Class="@(Target is null ? "btn ghost" : "btn primary")"
                 Title="@SchemaViewText.Paths_ToTitle" SearchPlaceholder="@SchemaViewText.Paths_FindTable" EntityName="EntityOf" ShowKeys="false">
        <ButtonContent>@(Target is { } target ? TextFormat.Format(SchemaViewText.Paths_ToTable, Label(target)) : SchemaViewText.Paths_To)</ButtonContent>
    </TablePicker>
    @if (Target is not null)
    {
        <button class="icon-btn ghost" title="@TextFormat.Format(SchemaViewText.Paths_ClearTitle, Label(Start))" @onclick="() => OnPick.InvokeAsync(null)">@Icons.Close</button>
    }
</span>

@code {
    private (IReadOnlyList<TableSummary> Tables, TableRef Start)? _choicesFor;
    private IReadOnlyList<TableSummary> _choices = [];

    [Parameter, EditorRequired]
    public TableRef Start { get; set; } = null!;

    [Parameter]
    public TableRef? Target { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<TableSummary> Tables { get; set; } = [];

    [Parameter, EditorRequired]
    public Func<TableRef, string> Label { get; set; } = null!;

    /// <summary>The entity's name if C# names are shown; null otherwise.</summary>
    [Parameter, EditorRequired]
    public Func<TableRef, string?> EntityOf { get; set; } = null!;

    /// <summary>A table chosen; null for back to the neighbours.</summary>
    [Parameter]
    public EventCallback<TableRef?> OnPick { get; set; }

    /// <summary>The tables to choose from; built again when the schema's list or the start changes.</summary>
    private IReadOnlyList<TableSummary> Choices
    {
        get
        {
            if (_choicesFor is not { } built || !ReferenceEquals(built.Tables, Tables) || built.Start != Start)
            {
                (_choicesFor, _choices) = ((Tables, Start), RelationPathsState.TargetChoices(Tables, Start));
            }

            return _choices;
        }
    }
}
