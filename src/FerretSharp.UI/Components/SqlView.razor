@* SQL editor tab (WP-17, ADR 0014): a script; Ctrl+Enter runs the statement at the cursor (or the selection) in the
   workspace's session. Queries go through the read path into a result grid, INSERT/UPDATE/DELETE/MERGE through the write
   path into the workspace's transaction (only on writable workspaces, confirmed on Prod and without WHERE); everything else
   is refused with a reason. *@
@using System.Text.RegularExpressions
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Query
@using FerretSharp.Core.Schema
@using FerretSharp.Core.Workspaces
@using FerretSharp.UI.State
@implements IDisposable
@inject WorkspaceManager Workspaces
@inject ActiveConnection Active
@inject PresentationService Presentations
@inject SqlHistoryStore History
@inject ILogger<SqlView> Logger

<div class="sqlview">
    <div class="tab-toolbar">
        @Icons.Database
        <TabTitle Tab="Tab" />
        <span class="muted">@(Workspaces.IsWritable(Tab.WorkspaceId) ? "lesen und schreiben" : "nur lesen – Workspace schreibgeschützt")</span>
        <span class="spacer"></span>
        <button class="btn ghost @(_historyOpen ? "active" : "")" title="Zuletzt ausgeführte Statements dieser Verbindung" @onclick="ToggleHistoryAsync">Verlauf</button>
        @if (Tab.ShownRun is { Info.IsQuery: true, Error: null } && _error is null)
        {
            <button class="btn ghost" title="Ausführungsplan des angezeigten Statements – geschätzt oder tatsächlich" @onclick="() => _planOpen = true">Plan</button>
        }
        @if (_running)
        {
            <span class="spinner small"></span>
            <button class="btn ghost" @onclick="Cancel">Abbrechen</button>
        }
        <button class="btn" disabled="@_running" @onclick="RunScriptAsync"
                title="Alle Statements nacheinander ausführen (oder die markierten); beim ersten Fehler hält das Skript an">
            ▶▶ Skript <kbd>Alt X</kbd>
        </button>
        <button class="btn primary" disabled="@_running" @onclick="RunAsync"
                title="Das Statement am Cursor ausführen (oder die Markierung); Statements trennt ; oder eine Leerzeile">
            ▶ Ausführen <kbd>Ctrl ↵</kbd>
        </button>
    </div>

    <div class="sql-main">
        <div class="sql-editors">
            <MonacoEditor @ref="_editor" Language="sql" Class="sql-code" Text="@Tab.Text" OnChange="OnTextChanged" Completion="CompleteAsync"
                          Placeholder="SELECT * FROM kunden WHERE kunde_id = :id;" />
            @if (Tab.Variables.Count > 0)
            {
                <div class="linq-label">
                    Variablen
                    <span class="hint">Werte wie im Filter (1.234,5 · 05.10.2026 14:00 · ISO); gebunden, nie in das SQL eingesetzt.</span>
                </div>
                <div class="sql-variables">
                    @foreach (var variable in Tab.Variables)
                    {
                        var v = variable;
                        var used = _binds.Contains(v.Name, StringComparer.OrdinalIgnoreCase);
                        <div class="sql-variable @(used ? "" : "unused")" title="@(used ? null : "Im Skript nicht mehr verwendet")">
                            <code>:@v.Name</code>
                            <select class="field" value="@v.Type" @onchange="e => SetVariable(v, Enum.Parse<SqlVariableType>((string)e.Value!), v.Value)">
                                @foreach (var type in Enum.GetValues<SqlVariableType>())
                                {
                                    <option value="@type">@TypeText(type)</option>
                                }
                            </select>
                            @if (v.Type != SqlVariableType.Null)
                            {
                                <input class="field" value="@v.Value" placeholder="@Placeholder(v.Type)" spellcheck="false"
                                       @onchange="e => SetVariable(v, v.Type, Text(e))" />
                            }
                            @if (!used)
                            {
                                <button class="icon-btn ghost" title="Variable entfernen" @onclick="() => RemoveVariable(v)">✕</button>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @if (_historyOpen)
        {
            <aside class="sql-history">
                <input class="field" placeholder="Verlauf durchsuchen …" value="@_historySearch" @oninput="SetSearch" />
                <div class="sql-history-list">
                    @foreach (var entry in FilteredHistory)
                    {
                        var e = entry;
                        <button class="sql-history-item @(e.Error is null ? "" : "failed")" title="@e.Sql" @onclick="() => AdoptAsync(e)">
                            <span class="sql-history-sql">@OneLine(e.Sql)</span>
                            <span class="sql-history-meta">@e.ExecutedAt.ToLocalTime().ToString("dd.MM. HH:mm", CultureInfo.CurrentCulture) · @Outcome(e)</span>
                        </button>
                    }
                    @if (!FilteredHistory.Any())
                    {
                        <div class="ctx-empty">@(_history.Count == 0 ? "Noch nichts ausgeführt." : "Kein Treffer.")</div>
                    }
                </div>
            </aside>
        }
    </div>

    <div class="linq-output">
        @if (_notice is not null)
        {
            <div class="linq-notice muted">@_notice</div>
        }

        @if (_error is not null)
        {
            <div class="tab-error">
                <span>@_error</span>
                @if (_needsUnlock)
                {
                    <button class="link-btn" @onclick="() => Shell.RequestUnlock(Tab.WorkspaceId)">Workspace freischalten …</button>
                }
            </div>
        }

        @if (Tab.Runs.Count > 1 && _error is null)
        {
            <div class="linq-commands sql-runs">
                @for (var i = 0; i < Tab.Runs.Count; i++)
                {
                    var index = i;
                    var item = Tab.Runs[i];
                    <button class="chip-btn @(index == Tab.SelectedRun ? "active" : "") @(item.Error is null ? "" : "failed")"
                            title="@item.Statement.Text" @onclick="() => SelectRun(index)">
                        @item.Number · @item.Info.FirstWord · @RunOutcome(item)
                    </button>
                }
            </div>
        }

        @if (Tab.ShownRun is { } run && _error is null)
        {
            @if (run.Error is { } failure)
            {
                <div class="tab-error">
                    <span>@(run.Number > 0 ? $"Statement {run.Number}: " : "")@failure.Display</span>
                    @if (failure.ErrorCode is not null)
                    {
                        <button class="link-btn" @onclick="() => Shell.ShowError(failure)">Details</button>
                    }
                </div>
            }
            else if (run.Info.IsQuery)
            {
                <div class="grid-host">
                    <SqlResultGrid @key="@($"{_runKey}-{Tab.SelectedRun}")" WorkspaceId="Tab.WorkspaceId" Query="run.Query" FirstPage="run.FirstPage"
                                   OnStatus="OnGridStatus" InsertTarget="InsertTarget(run.Info)" ExportName="@ExportName(run.Info)" />
                </div>
                <ResultFooter Status="_grid" />
            }
            else if (run.Changed is { } changed)
            {
                <div class="linq-write">
                    @switch (FateOf(run))
                    {
                        case WriteFate.Open:
                            <p><strong>@(changed == 1 ? "1 Zeile" : $"{changed:N0} Zeilen") geändert</strong> (@run.Info.FirstWord) – in der Transaktion des Workspaces.
                                Für andere unsichtbar bis zum Commit; committen, verwerfen oder zurücknehmen (↶) über die Statusleiste.</p>
                            break;
                        case WriteFate.Undone:
                            <p class="muted">@(changed == 1 ? "1 Zeile" : $"{changed:N0} Zeilen") geändert (@run.Info.FirstWord) – inzwischen zurückgenommen (↶).</p>
                            break;
                        default:
                            <p class="muted">@(changed == 1 ? "1 Zeile" : $"{changed:N0} Zeilen") geändert (@run.Info.FirstWord) – die Transaktion ist inzwischen beendet (Commit oder Rollback).</p>
                            break;
                    }
                </div>
            }
        }
        else if (_error is null && _notice is null && Tab.Runs.Count == 0)
        {
            <EmptyState Title="SQL im Workspace"
                        Text="Statements schreiben, mit ; oder einer Leerzeile trennen und mit Ctrl+Enter das Statement am Cursor ausführen – Alt+X führt das ganze Skript aus. SELECT läuft immer, INSERT, UPDATE, DELETE und MERGE nur auf schreibbaren Workspaces in deren Transaktion. Ctrl+Leertaste schlägt Tabellen und Spalten vor." />
        }
    </div>
</div>

@if (_confirm is { } pending)
{
    var allRows = pending.Where(r => r.Info.AffectsAllRows).ToList();
    var writes = pending.Where(r => r.Info.IsDml).ToList();
    <ConfirmDialog Title="@(allRows.Count > 0 ? "Alle Zeilen ändern?" : "Auf Prod schreiben?")" ConfirmLabel="Ausführen" Danger="true"
                   OnConfirm="() => ConfirmAsync(pending)" OnCancel="() => _confirm = null">
        @foreach (var r in allRows)
        {
            <p>@StatementLabel(r)@r.Info.FirstWord ohne WHERE betrifft <strong>alle Zeilen</strong> der Tabelle.</p>
        }
        @if (IsProd)
        {
            <p>Die Verbindung <strong>@Active.Profile?.Name</strong> ist eine Produktionsdatenbank@(pending.Count > 1 ? $" – das Skript ändert Daten in {(writes.Count == 1 ? "einem Statement" : $"{writes.Count} Statements")}" : "").</p>
        }
        <p>@(pending.Count > 1 ? "Das Skript läuft" : "Das Statement läuft") in der Transaktion des Workspaces und bleibt bis zum Commit für andere unsichtbar.</p>
        @foreach (var r in (allRows.Count > 0 ? allRows : writes).Take(3))
        {
            <SqlCode Sql="@r.Statement.Text" />
        }
    </ConfirmDialog>
}

@if (_planOpen && Tab.ShownRun is { Info.IsQuery: true } planned)
{
    <PlanDialog Query="planned.Query" WorkspaceId="Tab.WorkspaceId" Title="@Tab.Title" OnClose="() => _planOpen = false" />
}

@code {
    private MonacoEditor? _editor;
    private CancellationTokenSource? _cts;
    private bool _running;
    private bool _planOpen;
    private string? _error;
    private bool _needsUnlock;
    private string? _notice;
    private int _runKey;
    private SqlGridStatus? _grid;

    private IReadOnlyList<SqlRun>? _confirm;
    private bool _historyOpen;
    private string _historySearch = "";
    private IReadOnlyList<SqlHistoryEntry> _history = [];

    /// <summary>The binds of the whole script, in order (unused variables are shown dimmed).</summary>
    private IReadOnlyList<string> _binds = [];

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [Parameter, EditorRequired]
    public SqlTab Tab { get; set; } = null!;

    private bool IsProd => Active.Profile?.Kind == ConnectionKind.Prod;

    protected override async Task OnInitializedAsync()
    {
        Shell.TabCommandRequested += OnTabCommand;
        Workspaces.Changed += OnWorkspacesChanged;
        await UpdateVariablesAsync(Tab.Text);
    }

    private void OnTabCommand(WorkspaceTab tab, TabCommand command)
    {
        if (tab != Tab)
        {
            return;
        }

        switch (command)
        {
            case TabCommand.RunScript:
                _ = InvokeAsync(RunScriptAsync);
                break;
            case TabCommand.ApplyFilters or TabCommand.Refresh:
                _ = InvokeAsync(RunAsync);
                break;
            case TabCommand.FindColumn when _editor is not null:
                _ = InvokeAsync(_editor.FindAsync);
                break;
        }
    }

    private void OnWorkspacesChanged() => InvokeAsync(StateHasChanged); // writable or locked: toolbar text, unlock hint

    private async Task OnTextChanged(string text)
    {
        Tab.Text = text;
        Shell.MarkDirty();
        await UpdateVariablesAsync(text);
    }

    /// <summary>Variables follow the binds of the script; new ones get the type of the column they are compared with.</summary>
    private async Task UpdateVariablesAsync(string text)
    {
        var statements = SqlScript.Split(text).Select(s => SqlScript.Analyze(s.Text)).ToList();
        _binds = statements.SelectMany(s => s.Binds).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        var known = Tab.Variables.Select(v => v.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var suggestions = new Dictionary<string, SqlVariableType>(StringComparer.OrdinalIgnoreCase);
        foreach (var bind in _binds.Where(b => !known.Contains(b)))
        {
            if (statements.FirstOrDefault(s => s.BindUses.Any(u => string.Equals(u.Bind, bind, StringComparison.OrdinalIgnoreCase))) is { } info
                && Active.Schema is { } schema && await SqlBinds.SuggestTypeAsync(info, bind, schema, CancellationToken.None) is { } type)
            {
                suggestions[bind] = type;
            }
        }

        var variables = SqlBinds.Reconcile(_binds, Tab.Variables, b => suggestions.TryGetValue(b, out var t) ? t : null);
        if (!variables.SequenceEqual(Tab.Variables))
        {
            Tab.Variables = variables;
            Shell.MarkDirty();
        }
    }

    private void SetVariable(SqlVariable variable, SqlVariableType type, string value)
    {
        Tab.Variables = Tab.Variables.Select(v => ReferenceEquals(v, variable) ? v with { Type = type, Value = value } : v).ToList();
        Shell.MarkDirty();
    }

    private void RemoveVariable(SqlVariable variable)
    {
        Tab.Variables = Tab.Variables.Where(v => !ReferenceEquals(v, variable)).ToList();
        Shell.MarkDirty();
    }

    /// <summary>Ctrl+Enter: the statement at the cursor, or the first one of the selection.</summary>
    private async Task RunAsync()
    {
        if (await PrepareAsync() is not { } context)
        {
            return;
        }

        var statement = SqlScript.StatementAt(context.Text, context.Start, context.End);
        if (statement is null)
        {
            _error = "Kein Statement am Cursor – Statements trennt ; oder eine Leerzeile.";
            StateHasChanged();
            return;
        }

        if (context.End > context.Start && SqlScript.CountStatements(context.Text[context.Start..context.End]) is var count and > 1)
        {
            _notice = $"Die Markierung enthält {count} Statements – ausgeführt wird das erste (Alt+X führt alle aus).";
        }

        await StartAsync([statement], single: true);
    }

    /// <summary>Alt+X: all statements (of the selection, if there is one), one after the other.</summary>
    private async Task RunScriptAsync()
    {
        if (await PrepareAsync() is not { } context)
        {
            return;
        }

        var statements = SqlScript.StatementsIn(context.Text, context.Start, context.End);
        if (statements.Count == 0)
        {
            _error = "Keine Statements im Skript.";
            StateHasChanged();
            return;
        }

        await StartAsync(statements, single: false);
    }

    /// <summary>Takes the editor's text and variables as they are right now and clears the last problems.</summary>
    private async Task<MonacoEditor.EditorRunContext?> PrepareAsync()
    {
        if (_running || _editor is null || await _editor.GetRunContextAsync() is not { } context)
        {
            return null;
        }

        Tab.Text = context.Text;
        Shell.MarkDirty();
        await UpdateVariablesAsync(context.Text);
        _error = null;
        _needsUnlock = false;
        _notice = null;
        await _editor.SetOffsetMarkersAsync([]);
        return context;
    }

    /// <summary>
    /// Checks every statement before anything runs – allowed, writable workspace for DML, values for all binds – so a script
    /// never stops halfway over something that was clear beforehand. Then asks if needed (Prod, UPDATE/DELETE without WHERE).
    /// </summary>
    private async Task StartAsync(IReadOnlyList<SqlStatement> statements, bool single)
    {
        var plan = SqlScriptPlan.Prepare(statements, Tab.Variables, Workspaces.IsWritable(Tab.WorkspaceId), single);
        if (plan.Problem is { } problem)
        {
            (_error, _needsUnlock) = (problem.Message, problem.NeedsUnlock);
            await _editor!.SetOffsetMarkersAsync([new MonacoEditor.EditorMarker(problem.Statement.Start, problem.Statement.Length, "warning", problem.Message)]);
            StateHasChanged();
            return;
        }

        var runs = plan.Statements.Select(s => new SqlRun(s.Number, s.Statement, s.Info, s.Query, DateTimeOffset.Now)).ToList();
        if (plan.NeedsConfirmation(IsProd))
        {
            _confirm = runs;
            StateHasChanged(); // started from a shortcut, not a UI event
            return;
        }

        await ExecuteAsync(runs);
    }

    private async Task ConfirmAsync(IReadOnlyList<SqlRun> runs)
    {
        _confirm = null;
        await ExecuteAsync(runs);
    }

    /// <summary>Runs the statements one after the other in the workspace's session; the first failure stops the rest.</summary>
    private async Task ExecuteAsync(IReadOnlyList<SqlRun> runs)
    {
        _running = true;
        _cts = new CancellationTokenSource();
        var token = _cts.Token;
        Tab.Runs = [];
        Tab.SelectedRun = 0;
        _grid = null;
        _runKey++;
        var (first, last) = (runs[0].Statement, runs[^1].Statement);
        await _editor!.FlashAsync(first.Start, last.End - first.Start);
        StateHasChanged();

        var results = new List<SqlRun>();
        try
        {
            foreach (var run in runs)
            {
                var result = await RunOneAsync(run, token);
                results.Add(result);
                Tab.Runs = results.ToList();
                Tab.SelectedRun = results.Count - 1;
                _grid = null;
                StateHasChanged();
                if (result.Error is not null)
                {
                    break;
                }
            }
        }
        finally
        {
            _running = false;
            _cts.Dispose();
            _cts = null;
        }

        var wrote = results.Any(r => r.Changed is not null);
        if (results.Count < runs.Count)
        {
            var rest = runs.Count - results.Count;
            _notice = $"Das Skript hat bei Statement {results[^1].Number} angehalten – {(rest == 1 ? "ein weiteres Statement" : $"{rest} weitere Statements")} nicht ausgeführt."
                      + (wrote ? " Was schon geschrieben ist, bleibt in der Transaktion (Rollback über die Statusleiste)." : "");
        }

        if (wrote)
        {
            // Table tabs of the workspace may show the changed rows: they fetch them again from the transaction.
            foreach (var tab in Shell.Workspaces.FirstOrDefault(w => w.WorkspaceId == Tab.WorkspaceId)?.TableTabs ?? [])
            {
                Shell.RequestTabCommand(tab, TabCommand.Reload);
            }

            Shell.NotifyChanged(); // status bar: open transaction, commit/rollback
        }

        StateHasChanged();
    }

    /// <summary>
    /// One statement: a query reads its first page right away (a later statement of the script must not change what it
    /// shows), DML runs in the workspace's transaction. Failures come back in <see cref="SqlRun.Error"/>.
    /// </summary>
    private async Task<SqlRun> RunOneAsync(SqlRun run, CancellationToken token)
    {
        run = run with { At = DateTimeOffset.Now };
        var query = run.Query;
        if (run.Info.IsQuery)
        {
            var read = await Shell.RunDbAsync(Logger, Active.Profile, async () =>
                await (await Workspaces.GetDataAsync(Tab.WorkspaceId, token)).ReadSqlAsync(query, 0, SqlResultGrid.PageSize, token), token);
            if (read.Value is not { } page)
            {
                return await FailedAsync(run, read);
            }

            await LogAsync(run, page.Rows.Count, !page.IsLastPage, false, null, page.Elapsed);
            return run with { FirstPage = page };
        }

        var written = await Shell.RunDbAsync(Logger, Active.Profile, async () =>
            await (await Workspaces.GetEditorAsync(Tab.WorkspaceId, token)).ExecuteAsync(query, token), token);
        if (written.Value is not { } action)
        {
            return await FailedAsync(run, written);
        }

        await LogAsync(run, action.Rows, false, true, null);
        return run with { Changed = action.Rows, Transaction = Workspaces.TransactionOf(Tab.WorkspaceId)?.StartedAt, Action = action.Id };
    }

    /// <summary>A failed or cancelled statement: an error Oracle reported is marked in the editor and goes into the history.</summary>
    private async Task<SqlRun> FailedAsync<T>(SqlRun run, DbResult<T> result)
    {
        if (result.Error is not { } error)
        {
            return run with { Error = new DatabaseException(run.Info.IsQuery ? "Abgebrochen." : "Abgebrochen – das Statement wurde zurückgenommen.") };
        }

        if (!result.IsRefusal)
        {
            await MarkAsync(run, error);
            await LogAsync(run, null, false, false, error.Display);
        }

        return run with { Error = error };
    }

    private void SelectRun(int index)
    {
        Tab.SelectedRun = index;
        _grid = null;
    }

    /// <summary>Later pages of a result are read by the grid; it reports them (and their failures) here.</summary>
    private void OnGridStatus(SqlGridStatus status) => _grid = status;

    /// <summary>Marks the name an ORA-00904/00942 complains about, if it is in the statement.</summary>
    private async Task MarkAsync(SqlRun run, DatabaseException ex)
    {
        if (_editor is not null && SqlScriptPlan.LocateError(run.Statement.Text, ex.ErrorCode, ex.Message) is var (start, length))
        {
            await _editor.SetOffsetMarkersAsync([new MonacoEditor.EditorMarker(run.Statement.Start + start, length, "error", ex.Display)]);
        }
    }

    private static string StatementLabel(SqlRun run) => run.Number > 0 ? $"Statement {run.Number}: " : "";

    private static string RunOutcome(SqlRun run) => run switch
    {
        { Error: not null } => "Fehler",
        { Changed: { } changed } => $"{changed:N0} geändert",
        { FirstPage: { IsLastPage: true, Rows.Count: 1 } } => "1 Zeile",
        { FirstPage: { } page } => $"{(page.IsLastPage ? "" : "≥ ")}{page.Rows.Count:N0} Zeilen",
        _ => "",
    };

    private async Task LogAsync(SqlRun run, int? rows, bool moreRows, bool changed, string? error, TimeSpan? elapsed = null)
    {
        if (Active.Profile is not { } profile)
        {
            return;
        }

        var variables = Tab.Variables.Where(v => run.Info.Binds.Contains(v.Name, StringComparer.OrdinalIgnoreCase)).ToList();
        var entry = new SqlHistoryEntry(run.Statement.Text, run.At, elapsed ?? DateTimeOffset.Now - run.At, rows, moreRows, changed, error, variables);
        try
        {
            _history = await History.AddAsync(profile.Id, IsProd ? entry.WithoutValues() : entry, CancellationToken.None);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            Logger.LogWarning(ex, "SQL history could not be written");
        }
    }

    private async Task ToggleHistoryAsync()
    {
        _historyOpen = !_historyOpen;
        if (_historyOpen && Active.Profile is { } profile)
        {
            _history = await History.LoadAsync(profile.Id, CancellationToken.None);
        }
    }

    private void SetSearch(ChangeEventArgs e) => _historySearch = Text(e);

    private static string Text(ChangeEventArgs e) => (string?)e.Value ?? string.Empty;

    private IEnumerable<SqlHistoryEntry> FilteredHistory => _history.Where(e =>
        _historySearch.Split(' ', StringSplitOptions.RemoveEmptyEntries).All(w => e.Sql.Contains(w, StringComparison.OrdinalIgnoreCase)));

    /// <summary>Appends the statement after a blank line, adopts its variables and puts the cursor there.</summary>
    private async Task AdoptAsync(SqlHistoryEntry entry)
    {
        if (_editor is null)
        {
            return;
        }

        var current = (await _editor.GetRunContextAsync())?.Text ?? Tab.Text;
        var trimmed = current.TrimEnd();
        var prefix = trimmed.Length == 0 ? "" : trimmed + "\n\n"; // the blank line separates; the script stays as written
        Tab.Text = prefix + entry.Sql + ";\n";
        Tab.Variables = [.. Tab.Variables.Where(v => !entry.Variables.Any(e => string.Equals(e.Name, v.Name, StringComparison.OrdinalIgnoreCase))),
            .. entry.Variables.Where(v => v.Value.Length > 0 || !Tab.Variables.Any(t => string.Equals(t.Name, v.Name, StringComparison.OrdinalIgnoreCase)))];
        await _editor.SetTextAsync(Tab.Text);
        await UpdateVariablesAsync(Tab.Text);
        Shell.MarkDirty();
        await _editor.RevealOffsetAsync(prefix.Length);
    }

    /// <summary>Completion for the statement around the cursor (also one still being written).</summary>
    private async Task<IReadOnlyList<MonacoEditor.CompletionItem>> CompleteAsync(string text, int cursor)
    {
        if (Active.Schema is not { } schema)
        {
            return [];
        }

        var statement = SqlScript.StatementAt(text, cursor, cursor);
        var (slice, offset) = statement is not null && statement.Start <= cursor
            ? (text[statement.Start..Math.Max(statement.End, cursor)], cursor - statement.Start)
            : ("", 0);
        try
        {
            var items = await SqlCompletion.ItemsAsync(slice, offset, SqlCompletion.AtLineEnd(text, cursor), schema, Presentations.For,
                Presentations.EntityNameOf, CancellationToken.None);
            return items.Select(i => new MonacoEditor.CompletionItem(i.Label, i.InsertText, i.Kind.ToString(), i.Detail, i.Rank)).ToList();
        }
        catch (DatabaseException)
        {
            return [];
        }
    }

    /// <summary>The table a query reads if it reads exactly one: target of "Als INSERT kopieren".</summary>
    private TableSummary? InsertTarget(SqlStatementInfo info) =>
        info.Tables is [{ Depth: 0 } only] && Active.Schema is { } schema ? SqlCompletion.Resolve(schema, only) : null;

    private string ExportName(SqlStatementInfo info) => InsertTarget(info)?.DisplayName ?? Tab.Title;

    /// <summary>Whether the statement's write is still uncommitted, was taken back (↶) or ended with commit or rollback.</summary>
    private WriteFate FateOf(SqlRun run) =>
        run.Action is { } action ? WorkspaceEditing.FateOf(Workspaces, Tab.WorkspaceId, action, run.Transaction) : WriteFate.Ended;

    private void Cancel() => _cts?.Cancel();

    private static string TypeText(SqlVariableType type) => type switch
    {
        SqlVariableType.Text => "Text",
        SqlVariableType.Char => "Text (CHAR)",
        SqlVariableType.Number => "Zahl",
        SqlVariableType.Date => "Datum",
        SqlVariableType.Raw => "Hex (RAW)",
        _ => "NULL",
    };

    private static string Placeholder(SqlVariableType type) => type switch
    {
        SqlVariableType.Number => "4711",
        SqlVariableType.Date => "05.10.2026 14:00",
        SqlVariableType.Raw => "CAFE01",
        _ => "",
    };

    private static string OneLine(string sql) => Regex.Replace(sql, @"\s+", " ").Trim();

    private static string Outcome(SqlHistoryEntry entry) => entry switch
    {
        { Error: { } error } => error.Split(':')[0],
        { Changed: true, Rows: { } rows } => $"{rows:N0} geändert",
        { Rows: { } rows } => $"{(entry.MoreRows ? "≥ " : "")}{rows:N0} Zeilen",
        _ => "",
    };

    public void Dispose()
    {
        Shell.TabCommandRequested -= OnTabCommand;
        Workspaces.Changed -= OnWorkspacesChanged;
        _cts?.Cancel();
    }
}
