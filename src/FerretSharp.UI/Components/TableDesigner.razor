@* Edit mode of the "Columns" view (WP-23, stage 2): the columns and constraints of an existing table as editable rows. The
   DDL below follows every change (TableDesign); what needs a look at the data – NULLs before NOT NULL, values before a
   type change, rows before a mandatory new column – is counted in the tab's workspace. Run, open in the SQL editor or save
   it through DdlDraftPanel; new columns of a table the C# model maps get their property line to copy. *@
@using FerretSharp.Core.ClrModel
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Design
@using FerretSharp.Core.Schema
@using FerretSharp.Core.Workspaces
@inherits FerretComponent
@implements IDisposable
@inject ILogger<TableDesigner> Logger

@if (_designer is not { } designer)
{
    <DetailStatus Loading="_loadError is null" Error="_loadError" Text="@SchemaViewText.Designer_Loading" />
}
else
{
    var (draft, inputProblems) = designer.ToDraft();
    var context = new DesignContext(designer.Table, _constraints, _indexes, _incoming) { Referenced = _referenced };
    var plan = TableDesign.Plan(context, draft, new DataFacts(_facts));
    var counting = _counting.Count > 0;
    <section class="designer">
        @if (Tab?.Changes is { PendingCount: > 0 } or { FlushedCount: > 0 })
        {
            <p class="hint small">⚠ @SchemaViewText.Designer_TabHasChanges</p>
        }
        <table class="columns designer-columns">
            <thead>
                <tr>
                    <th class="num">#</th><th>@SchemaViewText.Head_Name</th><th>@SchemaViewText.Head_Type</th><th>@SchemaViewText.Designer_Size</th>
                    <th>@SchemaViewText.Designer_Scale</th><th>CHAR</th><th>NOT NULL</th><th>@SchemaViewText.Head_Default</th><th>ON NULL</th>
                    <th>@SchemaViewText.Columns_Comment</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var column in designer.Columns)
                {
                    var c = column;
                    var locked = c.Dropped || c.OnlyNameAndComment;
                    <tr class="@(c.Dropped ? "dropped" : c.IsNew ? "new" : c.IsChanged ? "changed" : "")" @key="c">
                        <td class="num">@(c.Before?.Position.ToString(CultureInfo.CurrentCulture) ?? "+")</td>
                        <td><input class="field mono" spellcheck="false" disabled="@c.Dropped" @bind="c.Name" @bind:event="oninput" aria-label="@SchemaViewText.Head_Name" /></td>
                        <td>
                            <select class="field" disabled="@locked" @bind="c.Type" aria-label="@SchemaViewText.Head_Type">
                                @foreach (var type in TypesFor(c))
                                {
                                    <option value="@type">@type</option>
                                }
                            </select>
                        </td>
                        <td><input class="field mono narrow" disabled="@(locked || !c.HasSize)" @bind="c.Size" @bind:event="oninput" aria-label="@SchemaViewText.Designer_Size" /></td>
                        <td><input class="field mono narrow" disabled="@(locked || !c.HasScale)" @bind="c.Scale" @bind:event="oninput" aria-label="@SchemaViewText.Designer_Scale" /></td>
                        <td class="check-cell"><input type="checkbox" disabled="@(locked || !c.HasSemantics)" @bind="c.CharSemantics" title="@SchemaViewText.Designer_CharSemantics" /></td>
                        <td class="check-cell"><input type="checkbox" disabled="@(locked || c.Identity)" @bind="c.NotNull" title="NOT NULL" /></td>
                        <td><input class="field mono" spellcheck="false" disabled="@(locked || c.Identity)" @bind="c.Default" @bind:event="oninput" aria-label="@SchemaViewText.Head_Default" /></td>
                        <td class="check-cell"><input type="checkbox" disabled="@(locked || c.Identity)" @bind="c.DefaultOnNull" title="@SchemaViewText.Designer_DefaultOnNull" /></td>
                        <td><input class="field" disabled="@c.Dropped" @bind="c.Comment" @bind:event="oninput" aria-label="@SchemaViewText.Columns_Comment" /></td>
                        <td class="row-actions"><span>
                            @if (c.IsNew)
                            {
                                <label class="check" title="GENERATED BY DEFAULT AS IDENTITY"><input type="checkbox" @bind="c.Identity" /> ID</label>
                            }
                            <button class="icon-btn" title="@(c.Dropped ? SchemaViewText.Designer_Restore : SchemaViewText.Designer_Drop)" @onclick="() => designer.ToggleDrop(c)">@(c.Dropped ? "↺" : "✕")</button>
                        </span></td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="designer-add">
            <button class="btn" @onclick="() => designer.AddColumn()"><span class="plus">+</span> @SchemaViewText.Designer_AddColumn</button>
        </div>

        <h2>@SchemaViewText.Designer_Constraints</h2>
        @if (designer.Existing.Count > 0)
        {
            <ul class="designer-constraints">
                @foreach (var constraint in designer.Existing)
                {
                    var name = constraint.Name;
                    var dropped = designer.DroppedConstraints.Contains(name);
                    <li class="@(dropped ? "dropped" : "")">
                        <span class="fs-badge @BadgeCss(constraint.Type)">@Kind(constraint.Type)</span>
                        <span class="mono">@name</span>
                        <span class="muted mono">@Describe(constraint)</span>
                        <button class="icon-btn" title="@(dropped ? SchemaViewText.Designer_Restore : SchemaViewText.Designer_Drop)"
                                @onclick="() => { if (!designer.DroppedConstraints.Remove(name)) designer.DroppedConstraints.Add(name); }">@(dropped ? "↺" : "✕")</button>
                    </li>
                }
            </ul>
        }
        @foreach (var added in designer.AddedConstraints)
        {
            var a = added;
            <div class="designer-constraint" @key="a">
                <select class="field" value="@a.Type" @onchange="e => SetType(designer, a, e.Value)" aria-label="@SchemaViewText.Head_Type">
                    <option value="@ConstraintType.PrimaryKey">PRIMARY KEY</option>
                    <option value="@ConstraintType.Unique">UNIQUE</option>
                    <option value="@ConstraintType.ForeignKey">FOREIGN KEY</option>
                    <option value="@ConstraintType.Check">CHECK</option>
                </select>
                <input class="field mono" spellcheck="false" value="@a.Name" @oninput="e => SetName(a, e.Value)"
                       @onchange="() => designer.SuggestName(a)" aria-label="@SchemaViewText.Head_Name" />
                <span class="index-draft-columns">
                    @for (var i = 0; i < a.Columns.Count; i++)
                    {
                        var at = i;
                        <span class="index-draft-column">
                            <span class="mono">@a.Columns[at]</span>
                            <button class="icon-btn" title="@SchemaViewText.Indexes_ColumnRemove" @onclick="() => RemoveColumn(designer, a, at)">✕</button>
                        </span>
                    }
                    @{ var free = designer.ColumnNames.Where(n => !a.Columns.Contains(n)).ToList(); }
                    @if (free.Count > 0)
                    {
                        <select class="field" @key="@($"{a.Columns.Count}-{free.Count}")" @onchange="e => AddColumn(designer, a, (string?)e.Value)" aria-label="@SchemaViewText.Indexes_ColumnAdd">
                            <option value="" selected>@SchemaViewText.Indexes_ColumnAdd</option>
                            @foreach (var name in free)
                            {
                                <option value="@name">@name</option>
                            }
                        </select>
                    }
                </span>
                @if (a.Type == ConstraintType.Check)
                {
                    <input class="field mono grow" spellcheck="false" placeholder="@SchemaViewText.Designer_CheckPlaceholder" @bind="a.Condition" @bind:event="oninput" aria-label="CHECK" />
                }
                else if (a.Type == ConstraintType.ForeignKey)
                {
                    <span class="designer-fk">
                        → <select class="field" value="@(a.References is { } r ? $"{r.Owner}.{r.Name}" : "")" @onchange="e => ReferenceAsync(designer, a, (string?)e.Value)" aria-label="@SchemaViewText.Designer_References">
                            <option value="">@SchemaViewText.Designer_ChooseTable</option>
                            @foreach (var table in Tables)
                            {
                                <option value="@($"{table.Owner}.{table.Name}")">@table.DisplayName</option>
                            }
                        </select>
                        @if (a.References is { } references && ColumnsOf(references) is { } targetColumns)
                        {
                            @for (var i = 0; i < a.Columns.Count; i++)
                            {
                                var at = i;
                                <select class="field" @key="@($"{references}-{at}-{a.ReferencedColumns.ElementAtOrDefault(at)}")" value="@a.ReferencedColumns.ElementAtOrDefault(at)"
                                        @onchange="e => SetReferenced(a, at, (string?)e.Value)" aria-label="@SchemaViewText.Designer_References">
                                    @foreach (var target in targetColumns)
                                    {
                                        <option value="@target">@target</option>
                                    }
                                </select>
                            }
                        }
                        <select class="field" @bind="a.DeleteRule" aria-label="ON DELETE">
                            <option value="">ON DELETE –</option>
                            <option value="CASCADE">ON DELETE CASCADE</option>
                            <option value="SET NULL">ON DELETE SET NULL</option>
                        </select>
                        <label class="check"><input type="checkbox" @bind="a.WithIndex" /> @SchemaViewText.Designer_WithIndex</label>
                    </span>
                }
                <button class="icon-btn" title="@SchemaViewText.Designer_Drop" @onclick="() => designer.AddedConstraints.Remove(a)">✕</button>
            </div>
        }
        <div class="designer-add">
            <button class="btn" @onclick="() => designer.AddConstraint(ConstraintType.Unique)"><span class="plus">+</span> @SchemaViewText.Designer_AddConstraint</button>
        </div>

        @if (counting)
        {
            <p class="hint small"><span class="spinner"></span> @SchemaViewText.Designer_Counting</p>
        }
        <DdlDraftPanel WorkspaceId="WorkspaceId" Statements="@(counting ? Array.Empty<string>() : plan.Statements)" Problems="@(inputProblems.Concat(plan.Problems).ToList())" Warnings="plan.Warnings"
                       FileName="@($"{DateTime.Now:yyyy-MM-dd}_{Details.Table.Name}.sql")" OnRan="OnRanAsync" OnFailed="OnFailedAsync" Stopped="OnStopped" Earlier="_failure" OnClose="CloseAsync" />

        @if (PropertyLines(designer) is { Count: > 0 } suggestions)
        {
            <h2>@TextFormat.Format(SchemaViewText.Designer_CSharpHeading, ClrModelMapping.ShortName(Models.Mapping!.EntityOf(Details.Table.Ref)!.Entity.ClrType))</h2>
            <PropertySuggestions Suggestions="suggestions" />
        }
    </section>
}

@code {
    private ColumnDesigner? _designer;

    /// <summary>How the last run failed: shown in the panel until it runs again.</summary>
    private DdlRunResult? _failure;
    private DatabaseException? _loadError;
    private IReadOnlyList<ConstraintInfo> _constraints = [];
    private IReadOnlyList<IndexInfo> _indexes = [];
    private IReadOnlyList<ForeignKeyInfo> _incoming = [];
    private readonly Dictionary<TableRef, TableDetails> _referenced = [];
    private readonly Dictionary<DataQuestion, long> _facts = [];
    private readonly HashSet<DataQuestion> _counting = [];
    private readonly HashSet<DataQuestion> _failed = [];
    private readonly CancellationTokenSource _cts = new();
    private bool _disposed;

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [CascadingParameter]
    public ActiveConnection Active { get; set; } = null!;

    [CascadingParameter]
    public WorkspaceManager Workspaces { get; set; } = null!;

    [CascadingParameter]
    public ClrModelManager Models { get; set; } = null!;

    [Parameter, EditorRequired]
    public TableDetails Details { get; set; } = null!;

    [Parameter, EditorRequired]
    public Guid WorkspaceId { get; set; }

    /// <summary>The tab: uncommitted changes in it keep its old structure after DDL (WP-22).</summary>
    [Parameter]
    public TableTab? Tab { get; set; }

    /// <summary>The DDL ran: the edit mode ends, the tab's views reload.</summary>
    [Parameter]
    public EventCallback OnRan { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private IEnumerable<TableSummary> Tables => (Active.Schema?.Tables ?? []).Where(t => t.Kind == TableKind.Table && t.Synonym is null);

    protected override async Task OnInitializedAsync()
    {
        _failure = Tab?.Designer?.Failure;
        await LoadAsync(Tab?.Designer?.Draft);
    }

    /// <summary>
    /// The table as the database has it now – not the tab's structure, which a tab with uncommitted changes keeps after
    /// DDL – with its constraints and indexes; a draft from before (a run that stopped halfway) is laid over it.
    /// </summary>
    private async Task LoadAsync(ColumnDesigner? previous)
    {
        if (_disposed || Active.Schema is not { } schema)
        {
            return;
        }

        var token = _cts.Token;
        var loaded = await Shell.RunDbAsync(Logger, Active, async () =>
            (await schema.GetDetailsAsync(Details.Table, token), await schema.GetConstraintsAsync(Details.Table.Ref, token),
             await schema.GetIndexesAsync(Details.Table.Ref, token)), token);
        if (!loaded.Succeeded)
        {
            _loadError = loaded.Error ?? new DatabaseException(SqlEditorText.Run_Canceled);
            return;
        }

        var (table, constraints, indexes) = loaded.Value;
        (_constraints, _indexes) = (constraints, indexes);
        _incoming = schema.IncomingOf(Details.Table.Ref).Where(f => f.Source == FkSource.Declared).ToList();
        _designer = previous?.Rebase(table, constraints) ?? new ColumnDesigner(table, constraints);
        _facts.Clear(); // the data may have changed with the DDL
        _failed.Clear();
        if (Tab is not null)
        {
            Tab.Designer = new DesignerSession(_designer, _failure);
        }
    }

    /// <summary>
    /// A statement failed: what ran before it stays. The draft is laid over the table as it is now, so it holds only what
    /// is still to do – here, and after the tab rebuilt its views (the session stays in the tab with the failure).
    /// </summary>
    private async Task OnFailedAsync(DdlRunResult result)
    {
        // Rebuilt meanwhile (the DDL changed the structure): the new view took the draft and the failure from the tab.
        if (_disposed)
        {
            return;
        }

        _failure = result;
        if (result.Ran.Count > 0 && _designer is { } designer)
        {
            await LoadAsync(designer);
        }
    }

    /// <summary>Before the schema is reloaded: the draft and the failure go into the tab, for a rebuilt view to reopen with.</summary>
    private void OnStopped(DdlRunResult result)
    {
        if (Tab is not null && _designer is not null)
        {
            Tab.Designer = new DesignerSession(_designer, result);
        }
    }

    private async Task CloseAsync()
    {
        if (Tab is not null)
        {
            Tab.Designer = null;
        }

        await OnClose.InvokeAsync();
    }

    /// <summary>What the plan needs to know about the data and nobody counted yet: counted in the tab's workspace.</summary>
    protected override void OnAfterRender(bool firstRender)
    {
        if (_designer is null)
        {
            return;
        }

        var missing = TableDesign.Questions(_designer.Table, _designer.ToDraft().Draft)
            .Where(q => !_facts.ContainsKey(q) && !_counting.Contains(q) && !_failed.Contains(q)).ToList();
        if (missing.Count > 0)
        {
            _counting.UnionWith(missing);
            Fire(() => CountAsync(missing));
        }
    }

    private async Task CountAsync(IReadOnlyList<DataQuestion> questions)
    {
        if (_disposed)
        {
            return;
        }

        var token = _cts.Token;
        var table = _designer!.Table;
        var counted = await Shell.RunDbAsync(Logger, Active, async () =>
        {
            var data = await Workspaces.GetDataAsync(WorkspaceId, token);
            return await TableDesign.CountAsync(data, table, questions, token);
        }, token);
        if (token.IsCancellationRequested)
        {
            return;
        }

        foreach (var question in questions)
        {
            _counting.Remove(question);
            if (counted.Value?.Of(question) is { } count)
            {
                _facts[question] = count;
            }
            else
            {
                _failed.Add(question); // unknown: the plan warns instead of deciding
            }
        }

        StateHasChanged();
    }

    /// <summary>The offered types, and a column's own type if it is none of them (INTERVAL, XMLTYPE …).</summary>
    private static IEnumerable<string> TypesFor(DesignColumn column) =>
        DesignColumn.Types.Contains(column.Type) ? DesignColumn.Types : [column.Type, .. DesignColumn.Types];

    private static void SetName(DesignConstraint constraint, object? value)
    {
        constraint.Name = value as string ?? "";
        constraint.NameTyped = constraint.Name.Length > 0; // cleared: follows type and columns again when the field is left
    }

    private static void SetType(ColumnDesigner designer, DesignConstraint constraint, object? value)
    {
        if (Enum.TryParse<ConstraintType>(value as string, out var type))
        {
            constraint.Type = type;
            designer.SuggestName(constraint);
        }
    }

    private void AddColumn(ColumnDesigner designer, DesignConstraint constraint, string? column)
    {
        if (string.IsNullOrEmpty(column) || constraint.Columns.Contains(column))
        {
            return;
        }

        constraint.Columns.Add(column);
        // A foreign key's referenced column follows the key of the referenced table, position by position.
        if (constraint.References is { } references && _referenced.TryGetValue(references, out var target))
        {
            constraint.ReferencedColumns.Add(target.PrimaryKey.ElementAtOrDefault(constraint.Columns.Count - 1) ?? target.Columns[0].Name);
        }

        designer.SuggestName(constraint);
    }

    private static void RemoveColumn(ColumnDesigner designer, DesignConstraint constraint, int at)
    {
        constraint.Columns.RemoveAt(at);
        if (at < constraint.ReferencedColumns.Count)
        {
            constraint.ReferencedColumns.RemoveAt(at);
        }

        designer.SuggestName(constraint);
    }

    private async Task ReferenceAsync(ColumnDesigner designer, DesignConstraint constraint, string? value)
    {
        constraint.ReferencedColumns.Clear();
        constraint.References = Tables.FirstOrDefault(t => $"{t.Owner}.{t.Name}" == value)?.Ref;
        designer.SuggestName(constraint);
        if (constraint.References is not { } references || Active.Schema is not { } schema || Active.Schema.Find(references) is not { } summary)
        {
            return;
        }

        if (!_referenced.ContainsKey(references))
        {
            var loaded = await Shell.RunDbAsync(Logger, Active, () => schema.GetDetailsAsync(summary, _cts.Token), _cts.Token);
            if (loaded.Value is not { } details)
            {
                return;
            }

            _referenced[references] = details;
        }

        // Its primary key, position by position; the user may pick another column.
        var key = _referenced[references].PrimaryKey;
        constraint.ReferencedColumns.AddRange(constraint.Columns.Select((_, i) => key.ElementAtOrDefault(i) ?? _referenced[references].Columns[0].Name));
    }

    private IReadOnlyList<string>? ColumnsOf(TableRef table) =>
        table == Details.Table.Ref ? _designer?.ColumnNames : _referenced.TryGetValue(table, out var details) ? details.Columns.Select(c => c.Name).ToList() : null;

    private static void SetReferenced(DesignConstraint constraint, int at, string? column)
    {
        while (constraint.ReferencedColumns.Count <= at)
        {
            constraint.ReferencedColumns.Add("");
        }

        constraint.ReferencedColumns[at] = column ?? "";
    }

    /// <summary>Property lines for the new columns, if the C# model maps this table.</summary>
    private IReadOnlyList<PropertySuggestion> PropertyLines(ColumnDesigner designer)
    {
        if (Models.Mapping is not { } mapping || mapping.EntityOf(Details.Table.Ref) is null)
        {
            return [];
        }

        return designer.Columns.Where(c => c.IsNew && !c.Dropped && c.Name.Trim().Length > 0)
            .Select(c => c.ToColumn().Column).OfType<ColumnInfo>()
            .Select(c => PropertyCode.Suggest(mapping.Model, c))
            .ToList();
    }

    private async Task OnRanAsync()
    {
        if (Tab is not null)
        {
            Tab.Designer = null;
        }

        await OnRan.InvokeAsync();
    }

    private static string Kind(ConstraintType type) => type switch
    {
        ConstraintType.PrimaryKey => "PK",
        ConstraintType.Unique => "UK",
        ConstraintType.ForeignKey => "FK",
        _ => "CHECK",
    };

    private static string BadgeCss(ConstraintType type) => type switch
    {
        ConstraintType.PrimaryKey => "pk",
        ConstraintType.Unique => "uk",
        ConstraintType.ForeignKey => "fk",
        _ => "",
    };

    private static string Describe(ConstraintInfo constraint) => constraint.Type switch
    {
        ConstraintType.Check => constraint.Condition ?? "",
        ConstraintType.ForeignKey => $"({string.Join(", ", constraint.Columns)}) → {constraint.References?.Name} ({string.Join(", ", constraint.ReferencedColumns)})",
        _ => $"({string.Join(", ", constraint.Columns)})",
    };

    public void Dispose()
    {
        _disposed = true;
        _cts.Cancel();
        _cts.Dispose();
    }
}
