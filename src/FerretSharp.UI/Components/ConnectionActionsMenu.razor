@using FerretSharp.Core.Connections

<button class="icon-btn ghost more" title="@ShellText.Actions" @onclick="Open" @onclick:stopPropagation="true" @ondblclick:stopPropagation="true">⋯</button>

@if (_open)
{
    <div class="overlay" @onclick="Close" @onclick:stopPropagation="true" @oncontextmenu="Close" @oncontextmenu:preventDefault="true"></div>
    <div class="menu" style="left:@Px(_x);top:@Px(_y)" @onclick:stopPropagation="true" @ondblclick:stopPropagation="true">
        <button class="menu-item strong" @onclick="() => RunAsync(Shell.Connect)">@ShellText.ConnectionMenu_Connect</button>
        <div class="menu-sep"></div>
        <button class="menu-item" @onclick="() => RunAsync(Shell.EditConnection)">@ShellText.Connection_Edit</button>
        <button class="menu-item" @onclick="() => RunAsync(Shell.DuplicateConnection)">@ShellText.ConnectionMenu_Duplicate</button>
        <div class="menu-sep"></div>
        <button class="menu-item danger" @onclick="() => RunAsync(Shell.RequestDelete)">@ShellText.Connection_DeleteEllipsis</button>
    </div>
}

@code {
    private const double MenuWidth = 200;

    private bool _open;
    private double _x;
    private double _y;

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [Parameter, EditorRequired]
    public ConnectionProfile Profile { get; set; } = null!;

    /// <summary>Raised before an action runs, e.g. to close the surrounding popover.</summary>
    [Parameter]
    public EventCallback OnAction { get; set; }

    private void Open(MouseEventArgs e)
    {
        _x = Math.Max(8, e.ClientX - MenuWidth);
        _y = e.ClientY + 10;
        _open = true;
    }

    private void Close() => _open = false;

    private async Task RunAsync(Action<ConnectionProfile> action)
    {
        _open = false;
        await OnAction.InvokeAsync();
        action(Profile);
    }

    private static string Px(double value) => value.ToString("0", CultureInfo.InvariantCulture) + "px";
}
