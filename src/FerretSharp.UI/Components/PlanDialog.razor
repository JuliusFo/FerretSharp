@* Execution plan of a query (WP-14, ADR 0012): estimated (EXPLAIN PLAN on the explorer session, without bind values)
   or actual (the query run again in the workspace's session with GATHER_PLAN_STATISTICS – first page or the whole
   result). Marks wrong estimates and full table scans; copies as DBMS_XPLAN-like text. *@
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Data
@using FerretSharp.Core.Query
@using FerretSharp.UI.State
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<PlanDialog> Logger

<ModalFrame Label="Ausführungsplan" Class="plan-dialog" OnCancel="CloseAsync" CloseOnBackdrop="true" FocusOnOpen="true">
    <header>
        <span>Ausführungsplan · @Title</span>
        <div class="segmented" role="radiogroup" aria-label="Planquelle">
            <button class="seg @(_source == PlanSource.Estimated ? "active" : "")" disabled="@_loading" @onclick="() => ShowAsync(PlanSource.Estimated)"
                    title="EXPLAIN PLAN: der Plan des Optimizers, ohne Ausführung und ohne Bind-Werte">Geschätzt</button>
            <button class="seg @(_source == PlanSource.Actual ? "active" : "")" disabled="@_loading" @onclick="() => ShowAsync(PlanSource.Actual)"
                    title="Führt die Abfrage im Workspace erneut aus und zeigt den verwendeten Plan mit echten Zahlen">Tatsächlich</button>
        </div>
        @if (_source == PlanSource.Actual)
        {
            <label class="plan-whole" title="Holt das ganze Ergebnis (wird verworfen), damit die Zahlen den vollständigen Lauf zeigen – kann dauern">
                <input type="checkbox" checked="@_wholeResult" disabled="@_loading" @onchange="ToggleWholeAsync" /> ganzes Ergebnis
            </label>
        }
        <span class="spacer"></span>
        @if (_loading)
        {
            <span class="spinner small"></span>
            <button class="btn ghost" @onclick="Cancel">Abbrechen</button>
        }
        <button class="btn" disabled="@(_plan is null)" @onclick="CopyAsync">@(_copied ? "Kopiert ✓" : "Als Text kopieren")</button>
        <button class="icon-btn ghost" title="Schließen" @onclick="CloseAsync">✕</button>
    </header>

    <div class="plan-body">
        @if (_error is not null)
        {
            <div class="test-result error"><span>@_error</span></div>
        }
        else if (_plan is { } plan)
        {
            <div class="plan-note">
                @if (plan.Source == PlanSource.Estimated)
                {
                    <span>Ohne Bind-Werte geplant – Oracle kennt die Werte nicht und kann tatsächlich einen anderen Plan wählen.</span>
                }
                else
                {
                    <span>
                        @(plan.WholeResult ? "Ganzes Ergebnis" : $"Erste {IDataAccess.ActualPlanPageSize:N0} Zeilen") gemessen
                        (@((plan.RowsFetched ?? 0).ToString("N0", CultureInfo.CurrentCulture)) geholt) · SQL_ID <code>@plan.SqlId</code>, Child @plan.ChildNumber
                    </span>
                    @if (plan.Steps.All(s => s.ActualRows is null))
                    {
                        <span class="warn">Keine Laufzeitstatistik im Cursor – der Hint wurde nicht angewendet.</span>
                    }
                }
                @if (plan.Steps.Any(plan.IsMisestimate))
                {
                    <span class="warn">⚠ Die Schätzung liegt bei markierten Schritten um Faktor @ExecutionPlan.MisestimateFactor oder mehr daneben.</span>
                }
            </div>
            <table class="plan">
                <thead>
                    <tr>
                        <th class="num">Id</th>
                        <th>Operation</th>
                        <th>Objekt</th>
                        <th class="num">Kosten</th>
                        <th class="num" title="Geschätzte Zeilen je Start">Zeilen gesch.</th>
                        @if (plan.Source == PlanSource.Actual)
                        {
                            <th class="num">Starts</th>
                            <th class="num" title="Tatsächliche Zeilen, alle Starts zusammen">Zeilen tats.</th>
                            <th class="num" title="Zeit in diesem Schritt samt allem darunter">Zeit</th>
                            <th class="num" title="Logische Lesevorgänge (Consistent Gets)">Buffers</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var step in plan.Steps)
                    {
                        var misestimate = plan.IsMisestimate(step);
                        // Adaptive plans keep the branches not taken in the cursor: they never started.
                        var inactive = plan.Source == PlanSource.Actual && step.Starts == 0;
                        <tr class="@(misestimate ? "misestimate" : "") @(inactive ? "inactive" : "")"
                            title="@(misestimate ? $"Geschätzt {step.EstimatedTotal:N0}, tatsächlich {step.ActualRows:N0}" : inactive ? "Nicht ausgeführt – bei adaptiven Plänen der Zweig, den Oracle zur Laufzeit verworfen hat" : null)">
                            <td class="num muted">@step.Id</td>
                            <td class="op" style="padding-left: @(8 + step.Depth * 16)px">
                                @step.Name
                                @if (step.IsFullTableScan)
                                {
                                    <span class="plan-badge" title="Liest die ganze Tabelle – bei großen Tabellen oft ein fehlender oder nicht nutzbarer Index">FULL</span>
                                }
                                @if (step.AccessPredicates is { } access)
                                {
                                    <div class="predicate"><span>access</span> @access</div>
                                }
                                @if (step.FilterPredicates is { } filter)
                                {
                                    <div class="predicate"><span>filter</span> @filter</div>
                                }
                            </td>
                            <td class="mono">@ObjectText(step)</td>
                            <td class="num">@Count(step.Cost)</td>
                            <td class="num">@Count(step.Rows)</td>
                            @if (plan.Source == PlanSource.Actual)
                            {
                                <td class="num">@Count(step.Starts)</td>
                                <td class="num @(misestimate ? "warn" : "")">@Count(step.ActualRows)</td>
                                <td class="num">@Time(step.ActualTime)</td>
                                <td class="num">@Count(step.BufferGets)</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
        else if (_loading)
        {
            <div class="plan-note">@(_source == PlanSource.Estimated ? "Plane …" : "Führe die Abfrage aus und lese den Cursor …")</div>
        }
    </div>
</ModalFrame>

@code {
    [CascadingParameter]
    public ActiveConnection Active { get; set; } = null!;

    [CascadingParameter]
    public WorkspaceManager Workspaces { get; set; } = null!;

    private CancellationTokenSource? _cts;
    private PlanSource _source = PlanSource.Estimated;
    private bool _wholeResult;
    private bool _loading;
    private bool _copied;
    private ExecutionPlan? _plan;
    private string? _error;
    private int _version;
    private IJSObjectReference? _dom;

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [Parameter, EditorRequired]
    public QuerySpec Query { get; set; } = null!;

    /// <summary>
    /// The statement for "ganzes Ergebnis" if it differs: the grid's query is paged, so its whole result is the query without
    /// the page limit. Defaults to <see cref="Query"/>.
    /// </summary>
    [Parameter]
    public QuerySpec? WholeQuery { get; set; }

    /// <summary>The workspace whose session runs the actual plan.</summary>
    [Parameter, EditorRequired]
    public Guid WorkspaceId { get; set; }

    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public EventCallback OnClose { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ShowAsync(PlanSource.Estimated);
        }
    }

    private async Task ShowAsync(PlanSource source)
    {
        _cts?.Cancel();
        var cts = _cts = new CancellationTokenSource();
        var version = ++_version;
        _source = source;
        _loading = true;
        _error = null;
        _plan = null;
        _copied = false;
        StateHasChanged();
        var whole = _wholeResult;
        var query = whole && source == PlanSource.Actual ? WholeQuery ?? Query : Query;
        var token = cts.Token;
        var result = await Shell.RunDbAsync(Logger, Active.Profile, async () => source == PlanSource.Estimated
            ? await (Active.Schema ?? throw new PlanUnavailableException("Nicht verbunden.")).ExplainAsync(query, token)
            : await (await Workspaces.GetDataAsync(WorkspaceId, token)).ExplainActualAsync(query, whole, token), token);
        var plan = result.Value;
        // A missing grant names the user to grant it to (PlanUnavailableException).
        var error = result.Cancelled && cts.IsCancellationRequested
            ? "Abgebrochen."
            : result.Error?.Display.Replace("<user>", Active.Profile?.User.ToUpperInvariant() ?? "<user>", StringComparison.Ordinal);

        // A newer request (other source, whole result) took over: its result counts, not this one.
        if (version == _version)
        {
            (_plan, _error, _loading) = (plan, error, false);
            StateHasChanged();
        }
    }

    private Task ToggleWholeAsync(ChangeEventArgs e)
    {
        _wholeResult = e.Value is true;
        return ShowAsync(PlanSource.Actual);
    }

    private void Cancel() => _cts?.Cancel();

    private async Task CopyAsync()
    {
        if (_plan is not null)
        {
            _dom ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/FerretSharp.UI/js/dom.js");
            _copied = await _dom.InvokeAsync<bool>("copyText", Plans.Format(_plan));
            if (!_copied)
            {
                Shell.Notify("Die Zwischenablage ist nicht verfügbar.");
            }
        }
    }

    /// <summary>The object, with its owner only if it is not the browsed schema.</summary>
    private string ObjectText(PlanStep step) =>
        step.ObjectName is null ? ""
        : step.ObjectOwner is { } owner && owner != Active.Schema?.Owner ? $"{owner}.{step.ObjectName}"
        : step.ObjectName;

    private static string Count(long? value) => value?.ToString("N0", CultureInfo.CurrentCulture) ?? "";

    private static string Time(TimeSpan? time) => time switch
    {
        null => "",
        { TotalMilliseconds: < 1 } t => $"{t.TotalMilliseconds.ToString("0.00", CultureInfo.CurrentCulture)} ms",
        { TotalSeconds: < 1 } t => $"{t.TotalMilliseconds.ToString("0", CultureInfo.CurrentCulture)} ms",
        { } t => $"{t.TotalSeconds.ToString("0.00", CultureInfo.CurrentCulture)} s",
    };

    private async Task CloseAsync()
    {
        _cts?.Cancel();
        await OnClose.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        if (_dom is not null)
        {
            try
            {
                await _dom.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
