@* Execution plan of a query (WP-14, ADR 0012): estimated (EXPLAIN PLAN on the explorer session, without bind values)
   or actual (the query run again in the workspace's session with GATHER_PLAN_STATISTICS – first page or the whole
   result). Marks wrong estimates and full table scans; copies as DBMS_XPLAN-like text. *@
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Data
@using FerretSharp.Core.Query
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<PlanDialog> Logger

<ModalFrame Label="@SqlEditorText.Plan_Label" Class="plan-dialog" OnCancel="CloseAsync" CloseOnBackdrop="true" FocusOnOpen="true">
    <header>
        <span>@TextFormat.Format(SqlEditorText.Plan_Header, Title)</span>
        <div class="segmented" role="radiogroup" aria-label="@SqlEditorText.Plan_Source">
            <button class="seg @(_source == PlanSource.Estimated ? "active" : "")" disabled="@_loading" @onclick="() => ShowAsync(PlanSource.Estimated)"
                    title="@SqlEditorText.Plan_EstimatedTitle">@SqlEditorText.Plan_Estimated</button>
            <button class="seg @(_source == PlanSource.Actual ? "active" : "")" disabled="@_loading" @onclick="() => ShowAsync(PlanSource.Actual)"
                    title="@SqlEditorText.Plan_ActualTitle">@SqlEditorText.Plan_Actual</button>
        </div>
        @if (_source == PlanSource.Actual)
        {
            <label class="plan-whole" title="@SqlEditorText.Plan_WholeResultTitle">
                <input type="checkbox" checked="@_wholeResult" disabled="@_loading" @onchange="ToggleWholeAsync" /> @SqlEditorText.Plan_WholeResult
            </label>
        }
        <span class="spacer"></span>
        @if (_loading)
        {
            <span class="spinner small"></span>
            <button class="btn ghost" @onclick="Cancel">@CommonText.Cancel</button>
        }
        <button class="btn" disabled="@(_plan is null)" @onclick="CopyAsync">@(_copied ? SqlEditorText.Plan_CopiedCheck : SqlEditorText.Plan_CopyAsText)</button>
        <button class="icon-btn ghost" title="@CommonText.Close" @onclick="CloseAsync">✕</button>
    </header>

    <div class="plan-body">
        @if (_error is not null)
        {
            <div class="test-result error"><span>@_error</span></div>
        }
        else if (_plan is { } plan)
        {
            <div class="plan-note">
                @if (plan.Source == PlanSource.Estimated)
                {
                    <span>@SqlEditorText.Plan_EstimatedNote</span>
                }
                else
                {
                    <span>
                        <Fmt Text="@(plan.WholeResult ? SqlEditorText.Plan_MeasuredWhole : SqlEditorText.Plan_MeasuredFirst)">
                            <Arg0>@((plan.RowsFetched ?? 0).ToString("N0", CultureInfo.CurrentCulture))</Arg0>
                            <Arg1><code>@plan.SqlId</code></Arg1>
                            <Arg2>@plan.ChildNumber</Arg2>
                            <Arg3>@IDataAccess.ActualPlanPageSize.ToString("N0", CultureInfo.CurrentCulture)</Arg3>
                        </Fmt>
                    </span>
                    @if (plan.Steps.All(s => s.ActualRows is null))
                    {
                        <span class="warn">@SqlEditorText.Plan_NoRuntimeStatistics</span>
                    }
                }
                @if (plan.Steps.Any(plan.IsMisestimate))
                {
                    <span class="warn">@TextFormat.Format(SqlEditorText.Plan_MisestimateNote, ExecutionPlan.MisestimateFactor)</span>
                }
            </div>
            <table class="plan">
                <thead>
                    <tr>
                        <th class="num">Id</th>
                        <th>@SqlEditorText.Plan_ColumnOperation</th>
                        <th>@SqlEditorText.Plan_ColumnObject</th>
                        <th class="num">@SqlEditorText.Plan_ColumnCost</th>
                        <th class="num" title="@SqlEditorText.Plan_ColumnEstimatedRowsTitle">@SqlEditorText.Plan_ColumnEstimatedRows</th>
                        @if (plan.Source == PlanSource.Actual)
                        {
                            <th class="num">@SqlEditorText.Plan_ColumnStarts</th>
                            <th class="num" title="@SqlEditorText.Plan_ColumnActualRowsTitle">@SqlEditorText.Plan_ColumnActualRows</th>
                            <th class="num" title="@SqlEditorText.Plan_ColumnTimeTitle">@SqlEditorText.Plan_ColumnTime</th>
                            <th class="num" title="@SqlEditorText.Plan_ColumnBuffersTitle">@SqlEditorText.Plan_ColumnBuffers</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var step in plan.Steps)
                    {
                        var misestimate = plan.IsMisestimate(step);
                        // Adaptive plans keep the branches not taken in the cursor: they never started.
                        var inactive = plan.Source == PlanSource.Actual && step.Starts == 0;
                        <tr class="@(misestimate ? "misestimate" : "") @(inactive ? "inactive" : "")"
                            title="@(misestimate ? TextFormat.Format(SqlEditorText.Plan_MisestimateTitle, step.EstimatedTotal, step.ActualRows) : inactive ? SqlEditorText.Plan_InactiveTitle : null)">
                            <td class="num muted">@step.Id</td>
                            <td class="op" style="padding-left: @(8 + step.Depth * 16)px">
                                @step.Name
                                @if (step.IsFullTableScan)
                                {
                                    <span class="plan-badge" title="@SqlEditorText.Plan_FullScanTitle">FULL</span>
                                }
                                @if (step.AccessPredicates is { } access)
                                {
                                    <div class="predicate"><span>access</span> @access</div>
                                }
                                @if (step.FilterPredicates is { } filter)
                                {
                                    <div class="predicate"><span>filter</span> @filter</div>
                                }
                            </td>
                            <td class="mono">@ObjectText(step)</td>
                            <td class="num">@Count(step.Cost)</td>
                            <td class="num">@Count(step.Rows)</td>
                            @if (plan.Source == PlanSource.Actual)
                            {
                                <td class="num">@Count(step.Starts)</td>
                                <td class="num @(misestimate ? "warn" : "")">@Count(step.ActualRows)</td>
                                <td class="num">@Time(step.ActualTime)</td>
                                <td class="num">@Count(step.BufferGets)</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
        else if (_loading)
        {
            <div class="plan-note">@(_source == PlanSource.Estimated ? SqlEditorText.Plan_Planning : SqlEditorText.Plan_Running)</div>
        }
    </div>
</ModalFrame>

@code {
    [CascadingParameter]
    public ActiveConnection Active { get; set; } = null!;

    [CascadingParameter]
    public WorkspaceManager Workspaces { get; set; } = null!;

    private CancellationTokenSource? _cts;
    private PlanSource _source = PlanSource.Estimated;
    private bool _wholeResult;
    private bool _loading;
    private bool _copied;
    private ExecutionPlan? _plan;
    private string? _error;
    private int _version;
    private DomModule? _dom;

    /// <summary>dom.js, imported on first use; does nothing once disposed (<see cref="DomModule"/>).</summary>
    private DomModule Dom => _dom ??= new(JS);

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [Parameter, EditorRequired]
    public QuerySpec Query { get; set; } = null!;

    /// <summary>
    /// The statement for "whole result" if it differs: the grid's query is paged, so its whole result is the query without
    /// the page limit. Defaults to <see cref="Query"/>.
    /// </summary>
    [Parameter]
    public QuerySpec? WholeQuery { get; set; }

    /// <summary>The workspace whose session runs the actual plan.</summary>
    [Parameter, EditorRequired]
    public Guid WorkspaceId { get; set; }

    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public EventCallback OnClose { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ShowAsync(PlanSource.Estimated);
        }
    }

    private async Task ShowAsync(PlanSource source)
    {
        _cts?.Cancel();
        var cts = _cts = new CancellationTokenSource();
        var version = ++_version;
        _source = source;
        _loading = true;
        _error = null;
        _plan = null;
        _copied = false;
        StateHasChanged();
        var whole = _wholeResult;
        var query = whole && source == PlanSource.Actual ? WholeQuery ?? Query : Query;
        var token = cts.Token;
        var result = await Shell.RunDbAsync(Logger, Active, async () => source == PlanSource.Estimated
            ? await (Active.Schema ?? throw new PlanUnavailableException(SqlEditorText.Plan_NotConnected)).ExplainAsync(query, token)
            : await (await Workspaces.GetDataAsync(WorkspaceId, token)).ExplainActualAsync(query, whole, token), token);
        var plan = result.Value;
        // A missing grant names the user to grant it to (PlanUnavailableException).
        var error = result.Cancelled && cts.IsCancellationRequested
            ? SqlEditorText.Run_Canceled
            : result.Error?.Display.Replace("<user>", Active.Profile?.User.ToUpperInvariant() ?? "<user>", StringComparison.Ordinal);

        // A newer request (other source, whole result) took over: its result counts, not this one.
        if (version == _version)
        {
            (_plan, _error, _loading) = (plan, error, false);
            StateHasChanged();
        }
    }

    private Task ToggleWholeAsync(ChangeEventArgs e)
    {
        _wholeResult = e.Value is true;
        return ShowAsync(PlanSource.Actual);
    }

    private void Cancel() => _cts?.Cancel();

    private async Task CopyAsync()
    {
        if (_plan is not null)
        {
            _copied = await Dom.CopyTextAsync(Plans.Format(_plan));
            if (!_copied)
            {
                Shell.Notify(SqlEditorText.Editor_ClipboardUnavailable);
            }
        }
    }

    /// <summary>The object, with its owner only if it is not the browsed schema.</summary>
    private string ObjectText(PlanStep step) =>
        step.ObjectName is null ? ""
        : step.ObjectOwner is { } owner && owner != Active.Schema?.Owner ? $"{owner}.{step.ObjectName}"
        : step.ObjectName;

    private static string Count(long? value) => value?.ToString("N0", CultureInfo.CurrentCulture) ?? "";

    private static string Time(TimeSpan? time) => time switch
    {
        null => "",
        { TotalMilliseconds: < 1 } t => $"{t.TotalMilliseconds.ToString("0.00", CultureInfo.CurrentCulture)} ms",
        { TotalSeconds: < 1 } t => $"{t.TotalMilliseconds.ToString("0", CultureInfo.CurrentCulture)} ms",
        { } t => $"{t.TotalSeconds.ToString("0.00", CultureInfo.CurrentCulture)} s",
    };

    private async Task CloseAsync()
    {
        _cts?.Cancel();
        await OnClose.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        await Dom.DisposeAsync();
    }
}
