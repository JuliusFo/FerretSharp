@* "Parameters" of a PL/SQL unit (WP-28): per procedure/function (overloads separately) name, direction, type and whether
   it has a default – from ALL_PROCEDURES/ALL_ARGUMENTS, so only what the specification declares. *@
@using FerretSharp.Core.Schema
@inherits PlSqlViewBase<IReadOnlyList<PlSqlSubprogram>>

<DetailStatus Loading="Loading && Data is null" Error="Error" Text="@SchemaViewText.PlSql_LoadingParameters" />

@if (Data is { } subprograms)
{
    @if (subprograms.Count == 0)
    {
        <p class="muted">@(Unit.Kind == PlSqlKind.Package ? SchemaViewText.PlSql_SpecDeclaresNothing : SchemaViewText.PlSql_NoParameterInfo)</p>
    }
    @foreach (var s in subprograms)
    {
        <section class="subprogram">
            <h2>
                <span class="chip">@(s.IsFunction ? "FUNCTION" : "PROCEDURE")</span>
                <span class="mono">@s.Name</span>
                @if (s.Overload is { } overload)
                {
                    <span class="muted" title="@SchemaViewText.PlSql_OverloadTitle">@TextFormat.Format(SchemaViewText.PlSql_Overload, overload)</span>
                }
                @if (s.ReturnType is { } returns)
                {
                    <span class="muted">RETURN <span class="mono">@returns</span></span>
                }
            </h2>
            @if (s.Parameters.Count == 0)
            {
                <p class="muted">@SchemaViewText.PlSql_NoParameters</p>
            }
            else
            {
                <table class="columns parameters">
                    <thead>
                        <tr><th>#</th><th>@SchemaViewText.Head_Name</th><th>@SchemaViewText.PlSql_Direction</th><th>@SchemaViewText.Head_Type</th><th>@SchemaViewText.Head_Default</th></tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < s.Parameters.Count; i++)
                        {
                            var p = s.Parameters[i];
                            <tr>
                                <td class="num">@(i + 1)</td>
                                <td class="name">@p.Name</td>
                                <td><span class="chip direction">@Direction(p.Direction)</span></td>
                                <td class="mono">@p.Type</td>
                                <td>
                                    @if (p.HasDefault)
                                    {
                                        <span title="@SchemaViewText.PlSql_HasDefaultTitle">@SchemaViewText.PlSql_Yes</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    }
    @if (Unit.Kind == PlSqlKind.Package)
    {
        <p class="muted"><Fmt Text="@SchemaViewText.PlSql_ParametersNote"><Arg0><code>%TYPE</code></Arg0></Fmt></p>
    }
}

@code {
    private static string Direction(PlSqlDirection direction) => direction switch
    {
        PlSqlDirection.Out => "OUT",
        PlSqlDirection.InOut => "IN OUT",
        _ => "IN",
    };

    protected override Task<IReadOnlyList<PlSqlSubprogram>> LoadAsync(SchemaCache schema, CancellationToken cancellationToken) =>
        schema.GetSubprogramsAsync(Unit, cancellationToken);
}
