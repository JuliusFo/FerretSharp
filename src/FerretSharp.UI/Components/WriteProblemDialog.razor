@* A write stopped (v2): lock conflict, concurrent change, deleted row or Oracle refusal – the user decides how to go on. *@
@using FerretSharp.Core.Data

<ModalFrame Label="@Title" Class="write-problem" Alert="true">
    <header><span>@Title</span></header>
    <div class="dialog-body">
        <p class="problem-row">
            <span class="mono">@Problem.Tab.Table.DisplayName</span> · @RowText
        </p>
        @switch (Problem.Error)
        {
            case LockConflictException:
                <p>@TextFormat.Plural(Wait, GridText.Problem_LockConflictOne, GridText.Problem_LockConflictOther)</p>
                <LockHolderList Holders="Problem.Holders" Note="@GridText.Problem_LockHoldersNote" />
                break;
            case ConcurrencyConflictException conflict:
                <p>@GridText.Problem_ChangedMeanwhileText</p>
                <table class="columns">
                    <thead><tr><th>@GridText.Grid_Column</th><th>@GridText.Problem_WhenLoaded</th><th>@GridText.Problem_NowInDatabase</th><th>@GridText.Problem_YourChange</th></tr></thead>
                    <tbody>
                        @foreach (var difference in conflict.Differences)
                        {
                            var column = Problem.Tab.Changes!.Table.Columns[difference.Column];
                            <tr>
                                <td class="mono">@column.Name</td>
                                <td>@Show(column, difference.Expected)</td>
                                <td><strong>@Show(column, difference.Actual)</strong></td>
                                <td>@Show(column, Problem.Error.Operation.Values.GetValueOrDefault(difference.Column))</td>
                            </tr>
                        }
                    </tbody>
                </table>
                break;
            case RowGoneException:
                <p>@GridText.Problem_RowGoneText</p>
                break;
            default:
                <p>@Problem.Error.Message</p>
                break;
        }
        @if (Problem.DuringCommit)
        {
            <p class="muted">@GridText.Problem_DuringCommit</p>
        }
    </div>
    <footer>
        <span class="spacer"></span>
        <button class="btn ghost" @ref="_cancel" @onclick="() => OnChoice.InvokeAsync(ProblemChoice.Cancel)">
            @(Problem.Error is WriteFailedException ? CommonText.Ok : CommonText.Cancel)
        </button>
        @switch (Problem.Error)
        {
            case LockConflictException:
                <button class="btn primary" @onclick="() => OnChoice.InvokeAsync(ProblemChoice.Retry)">@GridText.Problem_Retry</button>
                break;
            case ConcurrencyConflictException:
                <button class="btn" @onclick="() => OnChoice.InvokeAsync(ProblemChoice.Discard)">@GridText.Problem_DiscardMine</button>
                <button class="btn danger-solid" @onclick="() => OnChoice.InvokeAsync(ProblemChoice.Overwrite)">@GridText.Problem_Overwrite</button>
                break;
            case RowGoneException:
                <button class="btn primary" @onclick="() => OnChoice.InvokeAsync(ProblemChoice.Discard)">@GridText.Problem_DiscardChange</button>
                break;
        }
    </footer>
</ModalFrame>

@code {
    private ElementReference _cancel;

    [Parameter, EditorRequired]
    public FlushProblem Problem { get; set; } = null!;

    [Parameter]
    public int Wait { get; set; }

    [Parameter]
    public EventCallback<ProblemChoice> OnChoice { get; set; }

    private string Title => Problem.Error switch
    {
        LockConflictException => GridText.Problem_LockedTitle,
        ConcurrencyConflictException => GridText.Problem_ChangedMeanwhile,
        RowGoneException => GridText.Problem_RowDeleted,
        _ => GridText.Problem_WriteRefused,
    };

    private string RowText => Problem.Error.Operation switch
    {
        { Kind: OperationKind.Insert } => GridText.Problem_NewRow,
        { Key: RowKey.PrimaryKey pk } => TextFormat.Format(GridText.Problem_RowKey, string.Join(", ", pk.Values.Select(v => Show(null, v)))),
        { Kind: OperationKind.Delete } => GridText.Problem_RowToDelete,
        _ => GridText.Problem_ChangedRow,
    };

    private static string Show(Core.Schema.ColumnInfo? column, object? value) =>
        value is null ? "NULL" : column is null ? Convert.ToString(value, CultureInfo.CurrentCulture) ?? "" : CellFormatter.Format(column, value) ?? "NULL";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _cancel.FocusAsync();
        }
    }
}
