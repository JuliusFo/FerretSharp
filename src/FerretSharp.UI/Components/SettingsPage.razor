@* App settings: appearance (language, light/dark), C# names of a linked project, the connection behaviour, audit template and display columns; the shortcuts
   as a section of their own (WP-25). *@
@using FerretSharp.Core.Settings
@inject IThemeService Theme
@inject AppSettingsService Settings
@inject FerretSharp.Core.Audit.AuditTemplateSource AuditTemplates
@inject FerretSharp.Core.Display.DisplayColumnSource DisplaySource
@inject IFileOpenService Files
@inject IJSRuntime JS
@inject UpdateState Updates
@inject ShortcutService Shortcuts
@inject IProtocolRegistration Protocol
@implements IAsyncDisposable

<div class="settings-page">
    <div class="page-head">
        <h1>@ShellText.Settings_Title</h1>
        <span class="grow"></span>
        <button class="btn ghost" @onclick="Back">@CommonText.Back</button>
    </div>

    <div class="settings-layout">
    @* WP-34: the sections as a list to jump to, and a search over every setting and shortcut. *@
    <nav class="settings-nav" aria-label="@ShellText.Settings_Sections">
        <SearchBox @bind-Value="Query" Class="search settings-search" Placeholder="@ShellText.Settings_Search" />
        @foreach (var (part, label) in SettingsCatalog.Parts)
        {
            var value = part;
            var current = !Filter.IsActive && _part == value;
            <button class="settings-nav-item @(current ? "active" : "") @(Filter.IsActive && !ShowSection(value) ? "dim" : "")"
                    aria-current="@(current ? "page" : null)" @onclick="() => Select(value)">@label</button>
        }
    </nav>

    <div class="settings-content">
        @if (Filter.IsEmpty)
        {
            <div class="settings-note settings-no-match">@TextFormat.Format(ShellText.Settings_NoMatch, Filter.Search.Query)</div>
        }
        @if (ShowSection(SettingsPart.Appearance))
        {
        <section class="settings-section">
            <h2>@ShellText.Settings_Appearance</h2>
            <div class="settings-row @Hide(SettingKey.Language)">
                <div class="settings-label">
                    <span>@ShellText.Settings_Language</span>
                    <span class="hint">@ShellText.Settings_LanguageHint</span>
                </div>
                <div class="segmented" role="radiogroup" aria-label="@ShellText.Settings_Language">
                    @foreach (var (language, label) in Languages)
                    {
                        var value = language;
                        <button class="seg @(Settings.Current.Language == value ? "active" : "")" role="radio" lang="@UiLanguages.Culture(value).Name"
                                aria-checked="@(Settings.Current.Language == value ? "true" : "false")"
                                @onclick="() => SetLanguageAsync(value)">@label</button>
                    }
                </div>
            </div>
            @if (Settings.Current.Language != UiLanguages.Of(CultureInfo.CurrentUICulture))
            {
                <div class="settings-note @Hide(SettingKey.Language)">@ShellText.Settings_LanguageAfterRestart</div>
            }
            <div class="settings-row @Hide(SettingKey.ColorScheme)">
                <div class="settings-label">
                    <span>@ShellText.Settings_ColorScheme</span>
                    <span class="hint">@ShellText.Settings_ColorSchemeHint</span>
                </div>
                <div class="segmented" role="radiogroup" aria-label="@ShellText.Settings_ColorScheme">
                    @foreach (var (mode, label) in Modes)
                    {
                        var m = mode;
                        <button class="seg @(Theme.Mode == m ? "active" : "")" role="radio" aria-checked="@(Theme.Mode == m ? "true" : "false")"
                                @onclick="() => SetAsync(m)">@label</button>
                    }
                </div>
            </div>
            @if (Theme.SessionOverride is { } forced)
            {
                <div class="settings-note @Hide(SettingKey.ColorScheme)">
                    <Fmt Text="@ShellText.Settings_ThemeForced">
                        <Arg0><code>--theme=@forced</code></Arg0>
                        <Arg1>@(forced == "dark" ? ShellText.Settings_ThemeForcedDark : ShellText.Settings_ThemeForcedLight)</Arg1>
                    </Fmt>
                </div>
            }
            <div class="settings-row @Hide(SettingKey.ConnectionGroup)">
                <div class="settings-label">
                    <span>@ShellText.Settings_ConnectionGroup</span>
                    <span class="hint">
                        <Fmt Text="@ShellText.Settings_ConnectionGroupHint"><Arg0><code>@SettingsCatalog.ConnectionGroupExample</code></Arg0></Fmt>
                    </span>
                </div>
                <div class="segmented" role="radiogroup" aria-label="@ShellText.Settings_ConnectionGroup">
                    @foreach (var (on, label) in OnOff)
                    {
                        var value = on;
                        <button class="seg @(Settings.Current.ShowConnectionGroup == value ? "active" : "")" role="radio"
                                aria-checked="@(Settings.Current.ShowConnectionGroup == value ? "true" : "false")"
                                @onclick="() => SetShowConnectionGroupAsync(value)">@label</button>
                    }
                </div>
            </div>
        </section>
        }

        @if (ShowSection(SettingsPart.ClrModel))
        {
        <section class="settings-section">
            <h2>@ShellText.Settings_ClrModel</h2>
            <div class="settings-row @Hide(SettingKey.ClrNames)">
                <div class="settings-label">
                    <span>@ShellText.Settings_ClrNames</span>
                    <span class="hint">@ShellText.Settings_ClrNamesHint</span>
                </div>
                <div class="segmented" role="radiogroup" aria-label="@ShellText.Settings_ClrNames">
                    @foreach (var (mode, label) in NameModes)
                    {
                        var value = mode;
                        <button class="seg @(Settings.Current.ClrNames == value ? "active" : "")" role="radio"
                                aria-checked="@(Settings.Current.ClrNames == value ? "true" : "false")"
                                @onclick="() => SetClrNamesAsync(value)">@label</button>
                    }
                </div>
            </div>
        </section>
        }

        @if (ShowSection(SettingsPart.Connection))
        {
        <section class="settings-section">
            <h2>@ShellText.Settings_Connection</h2>
            <div class="settings-row @Hide(SettingKey.KeepAlive)">
                <div class="settings-label">
                    <span>@ShellText.Settings_KeepAlive</span>
                    <span class="hint">
                        <Fmt Text="@ShellText.Settings_KeepAliveHint">
                            <Arg0><code>@SettingsCatalog.KeepAliveQuery</code></Arg0>
                            <Arg1><code>@SettingsCatalog.KeepAliveProfileLimit</code></Arg1>
                        </Fmt>
                    </span>
                </div>
                <div class="segmented" role="radiogroup" aria-label="@ShellText.Settings_KeepAlive">
                    @foreach (var (on, label) in OnOff)
                    {
                        var value = on;
                        <button class="seg @(Settings.Current.KeepAlive == value ? "active" : "")" role="radio"
                                aria-checked="@(Settings.Current.KeepAlive == value ? "true" : "false")"
                                @onclick="() => SetKeepAliveAsync(value)">@label</button>
                    }
                </div>
            </div>
            <div class="settings-row @Hide(SettingKey.LockWait)">
                <div class="settings-label">
                    <span>@ShellText.Settings_LockWait</span>
                    <span class="hint">
                        <Fmt Text="@ShellText.Settings_LockWaitHint"><Arg0><code>@SettingsCatalog.LockWaitClause</code></Arg0></Fmt>
                    </span>
                </div>
                <div class="segmented" role="radiogroup" aria-label="@ShellText.Settings_LockWait">
                    @foreach (var seconds in WaitOptions)
                    {
                        var value = seconds;
                        <button class="seg @(Settings.Current.LockWaitSeconds == value ? "active" : "")" role="radio"
                                aria-checked="@(Settings.Current.LockWaitSeconds == value ? "true" : "false")"
                                @onclick="() => SetLockWaitAsync(value)">@value s</button>
                    }
                </div>
            </div>
            <div class="settings-row @Hide(SettingKey.FkCounts)">
                <div class="settings-label">
                    <span>@ShellText.Settings_FkCounts</span>
                    <span class="hint">@ShellText.Settings_FkCountsHint</span>
                </div>
                <div class="segmented" role="radiogroup" aria-label="@ShellText.Settings_FkCounts">
                    @foreach (var (mode, label) in FkCountModes)
                    {
                        var value = mode;
                        <button class="seg @(Settings.Current.FkCounts == value ? "active" : "")" role="radio"
                                aria-checked="@(Settings.Current.FkCounts == value ? "true" : "false")"
                                @onclick="() => SetFkCountsAsync(value)">@label</button>
                    }
                </div>
            </div>
            @* WP-37: which FerretSharp opens ferretsharp:// links – the installer registers itself; a portable copy or a build here. *@
            @{ var registered = Protocol.RegisteredProgram; var mine = IsOwnProgram(registered); }
            <div class="settings-row @Hide(SettingKey.LinkProtocol)">
                <div class="settings-label">
                    <span>@ShellText.Settings_LinkProtocol</span>
                    <span class="hint">@ShellText.Settings_LinkProtocolHint</span>
                </div>
                <div class="settings-path">
                    @if (mine)
                    {
                        <button class="btn ghost" @onclick="UnregisterLinksAsync">@ShellText.Settings_LinkProtocolRemove</button>
                    }
                    else
                    {
                        <button class="btn" @onclick="RegisterLinksAsync">@(registered is null ? ShellText.Settings_LinkProtocolRegister : ShellText.Settings_LinkProtocolTakeOver)</button>
                    }
                </div>
            </div>
            <div class="settings-note @(_protocolError is null ? "" : "error") @Hide(SettingKey.LinkProtocol)">
                @(_protocolError ?? (mine ? ShellText.Settings_LinkProtocolMine
                    : registered is null ? ShellText.Settings_LinkProtocolNone
                    : TextFormat.Format(ShellText.Settings_LinkProtocolOther, registered)))
            </div>
        </section>
        }

        @if (ShowSection(SettingsPart.Audit))
        {
        <section class="settings-section">
            <h2>@ShellText.Settings_Audit</h2>
            <div class="settings-row @Hide(SettingKey.AuditTemplate)">
                <div class="settings-label">
                    <span>@ShellText.Settings_AuditTemplate</span>
                    <span class="hint">@ShellText.Settings_AuditTemplateHint</span>
                </div>
                <div class="settings-path">
                    <input class="field mono" spellcheck="false" placeholder="@ShellText.Settings_AuditTemplateBuiltIn" value="@_auditPath"
                           @onchange="e => SetAuditTemplateAsync((string?)e.Value)" aria-label="@ShellText.Settings_AuditTemplate" />
                    <button class="btn" @onclick="PickAuditTemplateAsync">@ShellText.Settings_AuditTemplatePick</button>
                    @if (!string.IsNullOrWhiteSpace(_auditPath))
                    {
                        <button class="btn ghost" title="@ShellText.Settings_AuditTemplateResetTitle" @onclick="() => SetAuditTemplateAsync(null)">@ShellText.Settings_AuditTemplateReset</button>
                    }
                </div>
            </div>
            @{ var audit = AuditTemplates.Load(_auditPath); }
            @if (audit.Errors.Count > 0)
            {
                <div class="settings-note error @Hide(SettingKey.AuditTemplate)">
                    <ul class="settings-problems">
                        @foreach (var error in audit.Errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }
            else
            {
                <div class="settings-note @Hide(SettingKey.AuditTemplate)">
                    @(audit.IsDefault ? ShellText.Settings_AuditTemplateUsingBuiltIn : ShellText.Settings_AuditTemplateValid)
                </div>
            }
            @if (audit.IsDefault)
            {
                <div class="settings-note @Hide(SettingKey.AuditTemplate)">
                    <button class="link-btn" title="@ShellText.Settings_AuditTemplateCopyTitle" @onclick="CopyDefaultTemplateAsync">@ShellText.Settings_AuditTemplateCopy</button>
                </div>
            }
        </section>
        }

        @if (ShowSection(SettingsPart.DisplayColumns))
        {
        <section class="settings-section">
            <h2>@ShellText.Settings_DisplayColumns</h2>
            <div class="settings-row @Hide(SettingKey.ShowDisplayNames)">
                <div class="settings-label">
                    <span>@ShellText.Settings_ShowDisplayNames</span>
                    <span class="hint">
                        <Fmt Text="@ShellText.Settings_ShowDisplayNamesHint"><Arg0><code>@SettingsCatalog.DisplayNameExample</code></Arg0></Fmt>
                    </span>
                </div>
                <div class="segmented" role="radiogroup" aria-label="@ShellText.Settings_ShowDisplayNames">
                    @foreach (var (on, label) in OnOff)
                    {
                        var value = on;
                        <button class="seg @(Settings.Current.ShowDisplayNames == value ? "active" : "")" role="radio"
                                aria-checked="@(Settings.Current.ShowDisplayNames == value ? "true" : "false")"
                                @onclick="() => SetShowDisplayNamesAsync(value)">@label</button>
                    }
                </div>
            </div>
            <div class="settings-row @Hide(SettingKey.DisplayColumnsFile)">
                <div class="settings-label">
                    <span>@ShellText.Settings_DisplayColumnsFile</span>
                    <span class="hint">@ShellText.Settings_DisplayColumnsFileHint</span>
                </div>
                <div class="settings-path">
                    <input class="field mono" spellcheck="false" placeholder="@ShellText.Settings_DisplayColumnsDefault" value="@_displayPath"
                           @onchange="e => SetDisplayColumnsPathAsync((string?)e.Value)" aria-label="@ShellText.Settings_DisplayColumnsFile" />
                    <button class="btn" @onclick="PickDisplayColumnsAsync">@ShellText.Settings_DisplayColumnsPick</button>
                    @if (!string.IsNullOrWhiteSpace(_displayPath))
                    {
                        <button class="btn ghost" title="@ShellText.Settings_DisplayColumnsResetTitle" @onclick="() => SetDisplayColumnsPathAsync(null)">@ShellText.Settings_DisplayColumnsReset</button>
                    }
                </div>
            </div>
            @{ var display = DisplaySource.Load(_displayPath); }
            @if ((display.Error ?? display.ReadOnly) is { } problem)
            {
                <div class="settings-note error @Hide(SettingKey.DisplayColumnsFile)">@problem</div>
            }
            else
            {
                <div class="settings-note @Hide(SettingKey.DisplayColumnsFile)">
                    @(display.Exists
                        ? TextFormat.Plural(display.Columns.Count, ShellText.Settings_DisplayColumnsCountOne, ShellText.Settings_DisplayColumnsCountOther, display.Path)
                        : TextFormat.Format(ShellText.Settings_DisplayColumnsNoFile, display.Path))
                </div>
            }
        </section>
        }

        @if (ShowSection(SettingsPart.Updates))
        {
        <section class="settings-section">
            <h2>@ShellText.Settings_Updates</h2>
            <div class="settings-row @Hide(SettingKey.Version)">
                <div class="settings-label">
                    <span>@ShellText.Settings_Version</span>
                    <span class="hint">
                        @(Updates.Phase == UpdatePhase.NotInstalled ? ShellText.Settings_VersionNotInstalled : ShellText.Settings_VersionInstalled)
                    </span>
                </div>
                <span class="settings-value">@CurrentVersion</span>
            </div>
            @if (Updates.Phase != UpdatePhase.NotInstalled)
            {
                <div class="settings-row @Hide(SettingKey.CheckForUpdates)">
                    <div class="settings-label">
                        <span>@ShellText.Settings_CheckForUpdates</span>
                        <span class="hint">@ShellText.Settings_CheckForUpdatesHint</span>
                    </div>
                    <div class="segmented" role="radiogroup" aria-label="@ShellText.Settings_CheckForUpdates">
                        @foreach (var (on, label) in OnOff)
                        {
                            var value = on;
                            <button class="seg @(Settings.Current.CheckForUpdates == value ? "active" : "")" role="radio"
                                    aria-checked="@(Settings.Current.CheckForUpdates == value ? "true" : "false")"
                                    @onclick="() => SetCheckForUpdatesAsync(value)">@label</button>
                        }
                    </div>
                </div>
                <div class="settings-row @Hide(SettingKey.UpdateCheckInterval)">
                    <div class="settings-label">
                        <span>@ShellText.Settings_UpdateCheckInterval</span>
                        <span class="hint">@ShellText.Settings_UpdateCheckIntervalHint</span>
                    </div>
                    <div class="segmented" role="radiogroup" aria-label="@ShellText.Settings_UpdateCheckInterval">
                        @foreach (var (hours, label) in UpdateIntervals)
                        {
                            var value = hours;
                            var active = Math.Max(Settings.Current.UpdateCheckHours, 0) == value;
                            <button class="seg @(active ? "active" : "")" role="radio" aria-checked="@(active ? "true" : "false")"
                                    disabled="@(!Settings.Current.CheckForUpdates)" @onclick="() => SetUpdateCheckHoursAsync(value)">@label</button>
                        }
                    </div>
                </div>
                <div class="settings-note update-status @(Updates.Phase is UpdatePhase.DownloadFailed ? "error" : "") @Hide(SettingKey.CheckForUpdates)">
                    @UpdateStatus()
                </div>
            }
        </section>
        }

        @if (ShowSection(SettingsPart.Diagnostics))
        {
        <section class="settings-section">
            <h2>@ShellText.Settings_Diagnostics</h2>
            <div class="settings-row @Hide(SettingKey.DiagnoseUiStalls)">
                <div class="settings-label">
                    <span>@ShellText.Settings_DiagnoseUiStalls</span>
                    <span class="hint">
                        <Fmt Text="@ShellText.Settings_DiagnoseUiStallsHint">
                            <Arg0><code>@SettingsCatalog.StallTool</code></Arg0>
                            <Arg1><code>@SettingsCatalog.StallFiles</code></Arg1>
                        </Fmt>
                    </span>
                </div>
                <div class="segmented" role="radiogroup" aria-label="@ShellText.Settings_DiagnoseUiStalls">
                    @foreach (var (on, label) in OnOff)
                    {
                        var value = on;
                        <button class="seg @(Settings.Current.DiagnoseUiStalls == value ? "active" : "")" role="radio"
                                aria-checked="@(Settings.Current.DiagnoseUiStalls == value ? "true" : "false")"
                                @onclick="() => SetDiagnoseUiStallsAsync(value)">@label</button>
                    }
                </div>
            </div>
        </section>
        }
        @if (ShowSection(SettingsPart.Shortcuts))
        {
            <ShortcutSettings Filter="Filter" />
        }
    </div>
    </div>
</div>

@code {
    /// <summary>The section shown without a search; kept while the app runs, so the page opens where it was left (WP-34).</summary>
    private static SettingsPart s_part = SettingsPart.Appearance;

    private SettingsPart _part = s_part;

    private string _query = "";

    /// <summary>The search text; a new one works the filter out again.</summary>
    private string Query
    {
        get => _query;
        set
        {
            _query = value;
            _filter = null;
        }
    }

    private SettingsFilter? _filter;

    /// <summary>Whether <see cref="_filter"/> was built with the update settings.</summary>
    private bool _filterWithUpdates;

    /// <summary>
    /// What shows for the query, worked out once per query (and again when the shortcuts or the installation state change,
    /// both are part of what the page shows).
    /// </summary>
    private SettingsFilter Filter
    {
        get
        {
            if (_filter is null)
            {
                _filterWithUpdates = Updates.Phase != UpdatePhase.NotInstalled;
                _filter = new(new SettingsSearch(_query), SettingsCatalog.Entries(Shortcuts.Map, _filterWithUpdates));
            }

            return _filter;
        }
    }

    /// <summary>A click in the list shows that section and ends a search.</summary>
    private void Select(SettingsPart part)
    {
        _part = s_part = part;
        Query = "";
    }

    private bool ShowSection(SettingsPart part) => Filter.ShowsSection(part, _part);

    /// <summary>The class that hides a row (and its notes) that does not match the search.</summary>
    private string Hide(SettingKey key) => Filter.Shows(key) ? "" : "no-match";


    // Each language under its own name, in every UI language.
    private static readonly (UiLanguage Language, string Label)[] Languages = [(UiLanguage.English, "English"), (UiLanguage.German, "Deutsch")];

    private static (ThemeMode Mode, string Label)[] Modes =>
        [(ThemeMode.System, ShellText.Settings_ThemeSystem), (ThemeMode.Light, ShellText.Settings_ThemeLight), (ThemeMode.Dark, ShellText.Settings_ThemeDark)];

    private static (bool On, string Label)[] OnOff => [(true, CommonText.On), (false, CommonText.Off)];

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [Parameter]
    public EventCallback OnBack { get; set; }

    private Task Back() => OnBack.InvokeAsync();

    private Task SetAsync(ThemeMode mode) => Shell.TrySaveSettingsAsync(() => Theme.SetModeAsync(mode));

    private static readonly int[] WaitOptions = [1, 3, 5, 10, 30];

    private static (ClrNameDisplay Mode, string Label)[] NameModes =>
        [(ClrNameDisplay.Off, CommonText.Off), (ClrNameDisplay.Beside, ShellText.Settings_ClrNamesBeside), (ClrNameDisplay.Front, ShellText.Settings_ClrNamesFront)];

    /// <summary>Why registering or removing the link protocol failed (WP-37); null if it did not.</summary>
    private string? _protocolError;

    private bool IsOwnProgram(string? program) =>
        program is not null && string.Equals(Path.GetFullPath(program), Path.GetFullPath(Protocol.OwnProgram), StringComparison.OrdinalIgnoreCase);

    private Task RegisterLinksAsync() => ChangeLinksAsync(Protocol.Register);

    private Task UnregisterLinksAsync() => ChangeLinksAsync(Protocol.Unregister);

    private Task ChangeLinksAsync(Action change)
    {
        try
        {
            change();
            _protocolError = null;
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or IOException or System.Security.SecurityException)
        {
            _protocolError = TextFormat.Format(ShellText.Settings_LinkProtocolFailed, ex.Message);
        }

        return Task.CompletedTask;
    }

    private Task SetLanguageAsync(UiLanguage language) => UpdateAsync(s => s with { Language = language });

    private Task SetClrNamesAsync(ClrNameDisplay mode) => UpdateAsync(s => s with { ClrNames = mode });

    private Task SetLockWaitAsync(int seconds) => UpdateAsync(s => s with { LockWaitSeconds = seconds });

    private static (FkCountMode Mode, string Label)[] FkCountModes =>
        [(FkCountMode.Immediately, ShellText.Settings_FkCountsImmediately), (FkCountMode.OnHover, ShellText.Settings_FkCountsOnHover)];

    private Task SetFkCountsAsync(FkCountMode mode) => UpdateAsync(s => s with { FkCounts = mode });

    private Task SetKeepAliveAsync(bool on) => UpdateAsync(s => s with { KeepAlive = on });

    private Task SetDiagnoseUiStallsAsync(bool on) => UpdateAsync(s => s with { DiagnoseUiStalls = on });

    private Task SetCheckForUpdatesAsync(bool on) => UpdateAsync(s => s with { CheckForUpdates = on });

    private static (int Hours, string Label)[] UpdateIntervals =>
    [
        (0, ShellText.Settings_UpdateCheckNever), (1, ShellText.Settings_UpdateCheckHourly),
        (4, ShellText.Settings_UpdateCheckEvery4Hours), (24, ShellText.Settings_UpdateCheckDaily),
    ];

    private Task SetUpdateCheckHoursAsync(int hours) => UpdateAsync(s => s with { UpdateCheckHours = hours });

    private static readonly string CurrentVersion = AppVersion.Current;

    /// <summary>Settings › Updates: what the last check found, and the button that fits (WP-32).</summary>
    private RenderFragment UpdateStatus() => @<text>
        @switch (Updates.Phase)
        {
            case UpdatePhase.Checking:
                <span class="spinner small"></span> @ShellText.Update_Checking
                break;
            case UpdatePhase.UpToDate when Updates.LastChecked is { } at:
                @TextFormat.Format(ShellText.Update_UpToDate, at.ToString("t", CultureInfo.CurrentCulture))
                break;
            case UpdatePhase.CheckFailed:
                @TextFormat.Format(ShellText.Update_CheckFailed, Updates.Error)
                break;
            case UpdatePhase.Available when Updates.Update is { } update:
                @TextFormat.Format(ShellText.Update_Available, update.Version)
                <button class="link-btn" @onclick="Updates.ShowDetails">@ShellText.Update_ShowChanges</button>
                break;
            case UpdatePhase.Downloading when Updates.Update is { } update:
                <span class="spinner small"></span> @TextFormat.Format(ShellText.Update_Downloading, update.Version, Updates.Progress)
                break;
            case UpdatePhase.Ready when Updates.Update is { } update:
                @TextFormat.Format(ShellText.Update_Ready, update.Version)
                <button class="link-btn" @onclick="Updates.Restart">@ShellText.Update_RestartNow</button>
                break;
            case UpdatePhase.DownloadFailed when Updates.Update is { } update:
                @TextFormat.Format(ShellText.Update_DownloadFailed, update.Version, Updates.Error)
                <button class="link-btn" @onclick="Updates.ShowDetails">@CommonText.TryAgain</button>
                break;
        }
        @if (Updates.CanCheck)
        {
            <button class="btn small update-check" @onclick="Updates.CheckAsync">@ShellText.Update_CheckNow</button>
        }
    </text>;

    /// <summary>A shortcut changed: part of what the search finds.</summary>
    private void OnCatalogChanged() => InvokeAsync(() =>
    {
        _filter = null;
        StateHasChanged();
    });

    /// <summary>The update state changed (every percent of a download): the search only depends on "installed" (A49).</summary>
    private void OnUpdatesChanged() => InvokeAsync(() =>
    {
        if (_filter is not null && (Updates.Phase != UpdatePhase.NotInstalled) != _filterWithUpdates)
        {
            _filter = null;
        }

        StateHasChanged();
    });

    private Task UpdateAsync(Func<AppSettings, AppSettings> change) => Shell.TrySaveSettingsAsync(() => Settings.UpdateAsync(change, CancellationToken.None));

    /// <summary>The template file as the field shows it: saved as typed (also when it has errors, which show below).</summary>
    private string? _auditPath;

    /// <summary>The display columns file as the field shows it (WP-31); null = the data folder.</summary>
    private string? _displayPath;

    protected override void OnInitialized()
    {
        (_auditPath, _displayPath) = (Settings.Current.AuditTemplatePath, Settings.Current.DisplayColumnsPath);
        Updates.Changed += OnUpdatesChanged;
        Shortcuts.Changed += OnCatalogChanged;
    }

    private Task SetShowDisplayNamesAsync(bool on) => UpdateAsync(s => s with { ShowDisplayNames = on });

    private Task SetShowConnectionGroupAsync(bool on) => UpdateAsync(s => s with { ShowConnectionGroup = on });

    private Task SetDisplayColumnsPathAsync(string? path)
    {
        _displayPath = string.IsNullOrWhiteSpace(path) ? null : path.Trim();
        return UpdateAsync(s => s with { DisplayColumnsPath = _displayPath });
    }

    private async Task PickDisplayColumnsAsync()
    {
        if (await Files.PickAsync(ShellText.Settings_DisplayColumnsFilter, ["json"], _displayPath) is { } path)
        {
            await SetDisplayColumnsPathAsync(path);
        }
    }

    private Task SetAuditTemplateAsync(string? path)
    {
        _auditPath = string.IsNullOrWhiteSpace(path) ? null : path.Trim();
        return UpdateAsync(s => s with { AuditTemplatePath = _auditPath });
    }

    private DomModule? _dom;

    /// <summary>The built-in template as the start of an own one (its syntax is documented in it and in docs/audit-templates.md).</summary>
    private async Task CopyDefaultTemplateAsync()
    {
        if (await (_dom ??= new(JS)).CopyTextAsync(Shell, FerretSharp.Core.Audit.AuditTemplates.DefaultText))
        {
            Shell.Notify(ShellText.Settings_AuditTemplateCopied);
        }
    }

    public async ValueTask DisposeAsync()
    {
        Updates.Changed -= OnUpdatesChanged;
        Shortcuts.Changed -= OnCatalogChanged;
        if (_dom is not null)
        {
            await _dom.DisposeAsync();
        }
    }

    private async Task PickAuditTemplateAsync()
    {
        if (await Files.PickAsync(ShellText.Settings_AuditTemplateFilter, ["sql", "txt"], _auditPath) is { } path)
        {
            await SetAuditTemplateAsync(path);
        }
    }
}
