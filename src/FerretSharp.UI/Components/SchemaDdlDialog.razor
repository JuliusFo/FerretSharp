@* DDL proposal of the schema comparison (WP-20): which side to align to which, the script to copy – or to open in a SQL
   tab of the target connection and run there (WP-22). *@
@using FerretSharp.Core.Compare

<ModalFrame Label="@CompareViewText.CompareDdl_Title" Class="sql-dialog compare-ddl-dialog" OnCancel="OnClose" CloseOnBackdrop="true" FocusOnOpen="true">
    <header>
        <span>@CompareViewText.CompareDdl_Title</span>
        <Fmt Text="@CompareViewText.CompareDdl_AlignTo">
            <Arg0>
                <select title="@CompareViewText.CompareDdl_TargetTitle" @bind="_target" @bind:after="Build">
                    @for (var i = 0; i < Labels.Count; i++)
                    {
                        <option value="@i" disabled="@(i == _reference)">@Labels[i]</option>
                    }
                </select>
            </Arg0>
            <Arg1>
                <select title="@CompareViewText.CompareDdl_ReferenceTitle" @bind="_reference" @bind:after="Build">
                    @for (var i = 0; i < Labels.Count; i++)
                    {
                        <option value="@i" disabled="@(i == _target)">@Labels[i]</option>
                    }
                </select>
            </Arg1>
        </Fmt>
        <span class="spacer"></span>
        @if (_proposal is { Steps.Count: > 0 } runnable)
        {
            <button class="btn" title="@TextFormat.Format(CompareViewText.CompareDdl_OpenInEditorTitle, Labels[_target])"
                    @onclick="() => OnOpenInEditor.InvokeAsync(runnable)">@CompareViewText.CompareDdl_OpenInEditor</button>
        }
        <button class="icon-btn ghost" title="@CommonText.Close" @onclick="OnClose">✕</button>
    </header>
    <div class="settings-note compare-ddl-note">
        @CompareViewText.CompareDdl_Note
    </div>
    @if (_error is { } error)
    {
        <div class="test-result error"><span>@error</span></div>
    }
    else if (_proposal is { } proposal)
    {
        @if (proposal.Steps.Count == 0)
        {
            <div class="compare-none">@CompareViewText.CompareDdl_NoDifferences</div>
        }
        else
        {
            <SqlCode Sql="@proposal.Script" />
        }
    }
</ModalFrame>

@code {
    private int _reference;
    private int _target = 1;
    private DdlProposal? _proposal;
    private string? _error;

    [Parameter, EditorRequired]
    public SchemaComparison Comparison { get; set; } = null!;

    [Parameter, EditorRequired]
    public IReadOnlyList<string> Labels { get; set; } = [];

    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>"Open in SQL editor": the proposal to run on its target side (WP-22).</summary>
    [Parameter]
    public EventCallback<DdlProposal> OnOpenInEditor { get; set; }

    protected override void OnInitialized()
    {
        // The reference of the comparison, aligning the first other side to it.
        _reference = Comparison.Options.Reference ?? 0;
        _target = _reference == 0 ? 1 : 0;
        Build();
    }

    private void Build()
    {
        try
        {
            _proposal = SchemaDdl.Align(Comparison, _reference, _target);
            _error = null;
        }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            // A bug in the proposal must not take the page down; the comparison itself stays usable.
            (_proposal, _error) = (null, TextFormat.Format(CompareViewText.CompareDdl_Failed, ex.Message));
        }
    }
}
