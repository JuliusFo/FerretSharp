@* The footer of a table tab (R3b, out of TabView): rows loaded, total count (counted on request, cancellable), query time,
   snapshot time of a locked workspace, sort order and the row key. *@
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Query
@using FerretSharp.Core.Schema
@implements IDisposable
@inject ILogger<TabFooter> Logger
@inject ShortcutService Shortcuts

<footer class="tab-footer">
    @* RowsLoaded is the highest loaded position (blocks load where the user scrolls), so it is a lower bound. *@
    @if (Tab.AllRowsLoaded)
    {
        <span><Fmt Text="@(Tab.RowsLoaded == 1 ? GridText.Footer_RowsOne : GridText.Footer_RowsOther)"><Arg0><strong>@Tab.RowsLoaded.ToString("N0", CultureInfo.CurrentCulture)</strong></Arg0></Fmt></span>
    }
    else if (Tab.TotalCount is null)
    {
        <span><Fmt Text="@GridText.Footer_AtLeastRows"><Arg0><strong>@Tab.RowsLoaded.ToString("N0", CultureInfo.CurrentCulture)</strong></Arg0></Fmt></span>
    }
    @if (Tab.TotalCount is { } total && !Tab.AllRowsLoaded)
    {
        <span><Fmt Text="@GridText.Footer_Total"><Arg0><strong>@total.ToString("N0", CultureInfo.CurrentCulture)</strong></Arg0></Fmt></span>
    }
    else if (_countCts is not null)
    {
        <span><span class="spinner small"></span> @GridText.Footer_Counting <button class="status-btn" @onclick="CancelCount">@CommonText.Cancel</button></span>
    }
    else if (!Tab.AllRowsLoaded)
    {
        <button class="status-btn" @onclick="CountAsync">@GridText.Footer_CountRows</button>
    }
    @if (Tab.LastQueryTime is { } time)
    {
        <span>@time.TotalMilliseconds.ToString("N0", CultureInfo.CurrentCulture) ms</span>
    }
    @if (Tab.DataAsOf is { } asOf)
    {
        <span title="@TextFormat.Format(GridText.Footer_SnapshotTitle, Shortcuts.Label(ShortcutAction.Refresh) ?? CommonText.Reload)">
            @TextFormat.Format(GridText.Footer_Snapshot, asOf.ToString("T", CultureInfo.CurrentCulture))
        </span>
        @if (Tab.SnapshotMoved)
        {
            <span class="warn" title="@SnapshotTexts.Moved">@(Shortcuts.Label(ShortcutAction.Refresh) is { } key ? TextFormat.Format(GridText.Footer_SnapshotMovedKey, key) : GridText.Footer_SnapshotMoved)</span>
        }
    }
    <span>@SortText</span>
    @if (_countError is { } countError)
    {
        <span class="error">@countError.Display <button class="link-btn" @onclick="() => Shell.ShowError(countError)">@CommonText.Details</button></span>
    }
    <span class="spacer"></span>
    <span>@TextFormat.Format(GridText.Footer_RowKey, RowKeyText)</span>
</footer>

@code {
    private CancellationTokenSource? _countCts;
    private DatabaseException? _countError;

    [CascadingParameter]
    public ActiveConnection Active { get; set; } = null!;

    [CascadingParameter]
    public WorkspaceManager Workspaces { get; set; } = null!;

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [Parameter, EditorRequired]
    public TableTab Tab { get; set; } = null!;

    [Parameter, EditorRequired]
    public TableDetails Details { get; set; } = null!;

    /// <summary>Learns the counted total, so its scrollbar fits (null before the grid exists).</summary>
    [Parameter]
    public FerretGrid? Grid { get; set; }

    /// <summary>A new query (filter, sort, F5): a count still running belongs to the old one; its error goes too.</summary>
    public void Reset()
    {
        CancelCount();
        _countError = null;
    }

    private string SortText => Tab.Sorts.Count > 0
        ? TextFormat.Format(GridText.Footer_Sort, string.Join(", ", Tab.Sorts.Select(s => s.Column + (s.Descending ? " ↓" : " ↑"))))
        : QueryBuilder.RowKeyOf(Details) == RowKeyKind.None
            ? GridText.Footer_SortAllColumns
            : GridText.Footer_SortRowKey;

    private string RowKeyText => QueryBuilder.RowKeyOf(Details) switch
    {
        RowKeyKind.PrimaryKey => "PK " + string.Join(", ", Details.PrimaryKey),
        RowKeyKind.RowId => Details.IsIndexOrganized ? "UROWID" : "ROWID",
        _ => GridText.Footer_NoRowKey,
    };

    private async Task CountAsync()
    {
        var cts = _countCts = new CancellationTokenSource();
        _countError = null;
        var details = Details;
        var filters = Tab.AppliedFilters;
        var result = await Shell.RunDbAsync(Logger, Active, async () =>
        {
            var data = await Workspaces.GetDataAsync(Tab.WorkspaceId, cts.Token);
            return await data.CountAsync(details, filters, cts.Token);
        }, cts.Token);
        if (ReferenceEquals(_countCts, cts))
        {
            _countCts = null;
        }

        cts.Dispose();
        _countError = result.Error;
        if (result.Succeeded)
        {
            Tab.TotalCount = result.Value;
            if (Grid is not null)
            {
                await Grid.SetRowCountAsync(result.Value);
            }
        }
    }

    private void CancelCount() => _countCts?.Cancel();

    public void Dispose() => _countCts?.Cancel();
}
