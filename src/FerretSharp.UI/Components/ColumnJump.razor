@* Ctrl+F in the data view: find a column by name and scroll the grid to it. *@
@using FerretSharp.Core.Schema

<div class="coljump">
    <button class="btn ghost"title="Spalte suchen und hinspringen (Ctrl+F)" @onclick="Open">
        @Icons.Search Spalte <kbd>Ctrl F</kbd>
    </button>
    @if (_open)
    {
        <div class="popover-backdrop" @onclick="Close"></div>
        <div class="popover coljump-pop" @onkeydown="OnKeyDownAsync">
            <div class="popover-search">
                @Icons.Search
                <input @ref="_input" placeholder="Spalte suchen …" spellcheck="false" autocomplete="off"
                       @bind="_query" @bind:event="oninput" />
                <span class="coljump-count">@Details.Columns.Count Spalten</span>
            </div>
            <div class="popover-list">
                <ColumnList @ref="_list" Details="Details" Query="@_query" OnPick="PickAsync" />
            </div>
        </div>
    }
</div>

@code {
    private ElementReference _input;
    private ColumnList? _list;
    private bool _open;
    private bool _focus;
    private string _query = "";

    [Parameter, EditorRequired]
    public TableDetails Details { get; set; } = null!;

    /// <summary>The chosen column (index into <c>Details.Columns</c>); raised after the list has closed.</summary>
    [Parameter]
    public EventCallback<int> OnJump { get; set; }

    /// <summary>Opens the search (Ctrl+F); if it is open already, the input gets the focus again.</summary>
    public void Open()
    {
        _open = true;
        _focus = true;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focus && _open)
        {
            _focus = false;
            await _input.FocusAsync();
        }
    }

    private void Close()
    {
        _open = false;
        _query = "";
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown":
                _list?.Move(1);
                break;
            case "ArrowUp":
                _list?.Move(-1);
                break;
            case "PageDown":
                _list?.Move(10);
                break;
            case "PageUp":
                _list?.Move(-10);
                break;
            case "Enter" when _list is not null:
                await _list.PickHighlightedAsync();
                break;
            case "Escape":
                Close();
                break;
        }
    }

    private async Task PickAsync(int column)
    {
        Close();
        await OnJump.InvokeAsync(column);
    }
}
