@* Source of one part of a PL/SQL unit (WP-28): read-only Monaco with PL/SQL colouring and the compile errors as markers.
   Wrapped code and source the session may not see get a notice instead. *@
@using FerretSharp.Core.ClrModel
@using FerretSharp.Core.Schema
@inherits PlSqlViewBase<PlSqlSource>

<DetailStatus Loading="Loading && Data is null" Error="Error" Text="@SchemaViewText.PlSql_LoadingSource" />

@if (Data is { } source)
{
    @if (source.IsEmpty)
    {
        <div class="structure plsql-notice">
            <p class="muted">@EmptyText</p>
        </div>
    }
    else if (source.IsWrapped && !_showWrapped)
    {
        <div class="structure plsql-notice">
            <p><Fmt Text="@SchemaViewText.PlSql_Wrapped"><Arg0><strong>@SchemaViewText.PlSql_WrappedTitle</strong></Arg0></Fmt></p>
            <button class="btn" @onclick="() => _showWrapped = true">@SchemaViewText.PlSql_ShowWrapped</button>
        </div>
    }
    else
    {
        <div class="plsql-source">
            <MonacoEditor @ref="_editor" @key="source" Text="@source.Text" Language="@(source.IsWrapped ? "plaintext" : "plsql")" ReadOnly="true"
                          Class="plsql-code" Markers="_markers" />
        </div>
    }
}

@code {
    private MonacoEditor? _editor;
    private bool _showWrapped;
    private IReadOnlyList<LinqDiagnostic> _markers = [];
    private (PlSqlSource? Source, IReadOnlyList<PlSqlError>? Errors) _markersFor;

    [Parameter, EditorRequired]
    public PlSqlTab Tab { get; set; } = null!;

    [Parameter, EditorRequired]
    public PlSqlPart Part { get; set; }

    /// <summary>Compile errors of the unit (both parts), loaded by the tab.</summary>
    [Parameter]
    public IReadOnlyList<PlSqlError> Errors { get; set; } = [];

    private string EmptyText => Part == PlSqlPart.Body
        ? Unit.Owner == Active.Schema?.Owner
            ? SchemaViewText.PlSql_PackageHasNoBody
            : SchemaViewText.PlSql_BodyNotVisible
        : SchemaViewText.PlSql_SourceNotVisible;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        if (Data is { } source && (!ReferenceEquals(_markersFor.Source, source) || !ReferenceEquals(_markersFor.Errors, Errors)))
        {
            _markersFor = (source, Errors);
            _markers = PlSqlMarkers.For(Errors, Part, source.Lines);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Tab.Reveal is { } at && at.Part == Part && _editor is not null && Tab.View == PlSqlTab.SourceView(Part))
        {
            Tab.Reveal = null;
            await _editor.RevealAsync(at.Line, at.Column);
        }
    }

    /// <summary>Ctrl+F: the editor's find widget.</summary>
    public Task FindAsync() => _editor?.FindAsync() ?? Task.CompletedTask;

    protected override Task<PlSqlSource> LoadAsync(SchemaCache schema, CancellationToken cancellationToken) =>
        schema.GetSourceAsync(Unit, Part, cancellationToken);
}
