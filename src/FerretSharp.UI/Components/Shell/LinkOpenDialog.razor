@* A link from outside (WP-37, ADR 0026) is never opened without asking: any web page or mail can start ferretsharp://.
   Shows what the link opens and on which connection – the choice when several fit, a note when none does – and lets
   the user open it on another connection of their own (LinkTargetChoice, ADR 0026 addendum). *@
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Links
@inject ConnectionHub Hub
@inject ConnectionManager Connections
@inject AppSettingsService Settings
@inject ILogger<LinkOpenDialog> Logger

<ModalFrame Label="@ShellText.Link_Title" Class="link-dialog" Alert="true" OnCancel="Shell.CloseIncomingLink">
    <header><span>@ShellText.Link_Title</span></header>
    <div class="dialog-body">
        @if (Request.Link is not { } link)
        {
            <p>@ShellText.Link_Invalid</p>
            <p class="field-error">@Request.Error</p>
        }
        else
        {
            <dl class="link-facts">
                <dt>@ShellText.Link_Table</dt>
                <dd><span><code>@link.Owner.@link.Table</code>@if (link.Mode is { } mode) { <span class="muted"> · @ModeLabel(mode)</span> }</span></dd>
                <dt>@ShellText.Link_Filters</dt>
                <dd>
                    @if (link.Filters.Count == 0)
                    {
                        <span class="muted">@ShellText.Link_NoFilters</span>
                    }
                    @foreach (var line in FilterPresetText.FilterLines(link.Filters).Take(ShownFilters))
                    {
                        <code>@line</code>
                    }
                    @if (link.Filters.Count > ShownFilters)
                    {
                        <span class="muted">@TextFormat.Format(ShellText.Link_MoreFilters, link.Filters.Count - ShownFilters)</span>
                    }
                </dd>
                @if (link.Sorts.Count > 0)
                {
                    <dt>@ShellText.Link_Sort</dt>
                    <dd>@FilterPresetText.SortText(link.Sorts)</dd>
                }
                <dt>@ShellText.Link_Connection</dt>
                <dd>
                    @if (Request.Match.Profile is null && Request.Match.Candidates.Count == 0)
                    {
                        <div class="field-error">@ShellText.Link_NoConnection</div>
                        <div class="muted">@TextFormat.Format(ShellText.Link_NoConnectionNamed, link.Connection ?? "–", link.Address?.Display ?? "–")</div>
                    }

                    @if (Choice.Choosing)
                    {
                        <div class="muted">@ShellText.Link_ChooseConnection</div>
                        <SearchBox @ref="_search" Placeholder="@ShellText.Switcher_Search" @bind-Value="Choice.Query" />
                        <div class="link-choices">
                            @if (Choice.Suggested is { Count: > 0 } suggested)
                            {
                                <div class="group-head-btn static">@ShellText.Link_Suggested</div>
                                @foreach (var profile in suggested)
                                {
                                    @Option(profile, withGroup: true)
                                }
                            }
                            @foreach (var group in Choice.Others)
                            {
                                <div class="group-head-btn static">@(group.Name ?? ShellText.Connection_NoGroup)</div>
                                @foreach (var profile in group.Profiles)
                                {
                                    @Option(profile)
                                }
                            }
                            @if (Choice.Suggested.Count == 0 && Choice.Others.Count == 0)
                            {
                                <div class="popover-empty">@TextFormat.Format(ShellText.Connection_NoMatch, Choice.Query)</div>
                            }
                        </div>
                    }
                    else if (Request.Match.Profile is { } profile)
                    {
                        <div class="link-target">
                            @Connection(profile)
                            @if (Choice.CanChooseOther)
                            {
                                <button class="link-btn" @onclick="ChooseOther">@ShellText.Link_Change</button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="muted">@ShellText.Link_Ambiguous</div>
                        @foreach (var candidate in Request.Match.Candidates)
                        {
                            @Option(candidate, withGroup: true)
                        }
                        @if (Choice.CanChooseOther)
                        {
                            <div class="link-other"><button class="link-btn" @onclick="ChooseOther">@ShellText.Link_OtherConnection</button></div>
                        }
                    }
                </dd>
            </dl>
            @if (Choice.Elsewhere && Choice.Target is { } elsewhere)
            {
                <p class="hint">@TextFormat.Format(ShellText.Link_OpensElsewhere, link.Connection ?? "–", link.Address?.Display ?? "–", ConnectionLabel.Of(elsewhere, Settings.Current))</p>
            }
            @if (Choice.AddressDiffers && link.Address is { } linkAddress)
            {
                <p class="field-error">@TextFormat.Format(ShellText.Link_AddressDiffers, linkAddress.Display)</p>
            }
            @if (Target is { } target && NeedsConnect(target))
            {
                <p class="hint">@TextFormat.Format(ShellText.Link_WillConnect, target.Name)</p>
            }
        }
    </div>
    <footer>
        <span class="spacer"></span>
        @* Close when there is nothing to open: an invalid link, or no connection at all. *@
        <button class="btn ghost" @ref="_cancel" @onclick="Shell.CloseIncomingLink">@(CanOpen ? CommonText.Cancel : CommonText.Close)</button>
        @if (CanOpen)
        {
            <button class="btn primary" disabled="@(Target is null)" @onclick="OpenAsync">@ShellText.Link_Open</button>
        }
    </footer>
</ModalFrame>

@code {
    private const int ShownFilters = 8;

    private ElementReference _cancel;
    private SearchBox? _search;
    private bool _focusSearch;
    private LinkTargetChoice? _choice;
    private IncomingLink? _requestOfChoice;

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [Parameter, EditorRequired]
    public IncomingLink Request { get; set; } = null!;

    [Parameter, EditorRequired]
    public WorkspaceLifecycle Lifecycle { get; set; } = null!;

    /// <summary>The choice of the connection, for this request (a new link brings a new one).</summary>
    private LinkTargetChoice Choice => _choice ??= new(Request, Connections.Profiles);

    /// <summary>The connection the link opens on: the one found, or the one the user picked.</summary>
    private ConnectionProfile? Target => Choice.Target;

    private bool CanOpen => Request.Link is not null && Connections.Profiles.Count > 0;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_requestOfChoice, Request))
        {
            _choice = null;
            _requestOfChoice = Request;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _cancel.FocusAsync(); // the safe answer, also for Enter
        }
        else if (_focusSearch && _search is not null)
        {
            _focusSearch = false;
            await _search.FocusAsync(); // the button that asked for the list is gone
        }
    }

    private void ChooseOther()
    {
        Choice.ChooseOther();
        _focusSearch = true;
    }

    private bool NeedsConnect(ConnectionProfile profile) => Hub.Find(profile.Id) is not { } scope || ConnectionHub.NeedsConnect(scope);

    private async Task OpenAsync()
    {
        if (Request.Link is not { } link || Target is not { } profile)
        {
            return;
        }

        // Nothing of the link in the log: its filter values may come from Prod (decision of the user, like bind values).
        Logger.LogInformation("Opening a link on {Connection}", profile.Name);
        Shell.CloseIncomingLink();
        Shell.OpenLinkIn(profile.Id, link);
        await Lifecycle.ConnectAsync(profile);
    }

    private static string ModeLabel(FerretSharp.Core.Workspaces.TabMode mode) => TabModeLabels.Of(mode);

    /// <param name="withGroup">Not under its group's heading: the group goes in front of the name.</param>
    private RenderFragment Option(ConnectionProfile profile, bool withGroup = false) =>
        @<label class="check link-candidate">
            <input type="radio" name="link-connection" checked="@(Target?.Id == profile.Id)" @onchange="() => Choice.Choose(profile)" />
            @Connection(profile, withGroup)
        </label>;

    private RenderFragment Connection(ConnectionProfile profile, bool withGroup = true) =>
        @<span class="kind-@profile.Kind.ToString().ToLowerInvariant()"><span class="kind-badge">@ConnectionKindInfo.Short(profile.Kind)</span> @(withGroup ? ConnectionLabel.Of(profile, Settings.Current) : profile.Name) <span class="muted">· @profile.Address.Display</span></span>;
}
