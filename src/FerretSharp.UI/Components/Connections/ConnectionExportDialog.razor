@* Export connections (WP-35): pick them in their groups, then "Save as". Passwords are never part of the file; the paths of
   this computer (C# project, script folder) only on request. *@
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Connections.Transfer
@inject ConnectionGroups Groups
@inject ConnectionTransfer Transfer
@inject IFileSaveService Files
@inject ILogger<ConnectionExportDialog> Logger

<ModalFrame Label="@ConnectionViewText.Export_Title" Class="export-dialog" OnCancel="Shell.CloseExport">
    <header><span>@ConnectionViewText.Export_Title</span></header>
    <div class="dialog-body">
        <div class="export-head">
            <SearchBox @bind-Value="_selection.Query" Class="search grow" Placeholder="@ConnectionViewText.Connections_Search" />
            <button class="btn" @onclick="() => _selection.SetShown(true)">@ConnectionViewText.Export_All</button>
            <button class="btn" @onclick="() => _selection.SetShown(false)">@ConnectionViewText.Export_None</button>
        </div>
        <div class="export-list">
            @foreach (var group in _selection.Groups)
            {
                var g = group;
                var selected = _selection.SelectedIn(g);
                var count = _selection.CountOf(g);
                <div class="export-group">
                    <label class="export-group-head">
                        <input type="checkbox" checked="@(selected == count)" @onchange="() => _selection.ToggleGroup(g)" />
                        <span class="export-group-name">@(g.Name ?? ConnectionViewText.Connection_NoGroup)</span>
                        <span class="hint">@TextFormat.Format(ConnectionViewText.Export_GroupCount, selected, count)</span>
                    </label>
                    @foreach (var profile in g.Profiles)
                    {
                        var p = profile;
                        <label class="export-line @ConnectionKindInfo.CssClass(p.Kind)">
                            <input type="checkbox" checked="@_selection.IsSelected(p)" @onchange="e => _selection.Set(p, e.Value is true)" />
                            <span class="dot"></span>
                            <span class="name">@p.Name</span>
                            <span class="kind-badge">@ConnectionKindInfo.Short(p.Kind)</span>
                            <span class="addr">@p.Address.Display</span>
                            <span class="user">@p.User</span>
                        </label>
                    }
                </div>
            }
        </div>
        <label class="check export-option">
            <input type="checkbox" @bind="_selection.IncludeLocalPaths" />
            @ConnectionViewText.Export_LocalPaths
        </label>
        <div class="hint small">🔒 @ConnectionViewText.Export_NoPasswords</div>
    </div>
    <footer>
        <span class="spacer"></span>
        <button class="btn ghost" @onclick="Shell.CloseExport">@CommonText.Cancel</button>
        <button class="btn primary" disabled="@(_selection.SelectedCount == 0)" @onclick="ExportAsync">
            @TextFormat.Plural(_selection.SelectedCount, ConnectionViewText.Export_ExportOne, ConnectionViewText.Export_ExportOther)
        </button>
    </footer>
</ModalFrame>

@code {
    private ConnectionExportSelection _selection = null!;

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [Parameter, EditorRequired]
    public ConnectionExportRequest Request { get; set; } = null!;

    protected override void OnInitialized() => _selection = new ConnectionExportSelection(Transfer.Profiles, Request, Groups.Order);

    private async Task ExportAsync()
    {
        var profiles = _selection.Selected;
        if (profiles.Count == 0)
        {
            return;
        }

        var json = FerretSharpConnections.Export(profiles, _selection.IncludeLocalPaths);
        try
        {
            if (await Files.SaveTextAsync(FerretSharpConnections.FileName, ConnectionViewText.Export_FileFilter, json, utf8Bom: false) is { } path)
            {
                Shell.CloseExport();
                Shell.Notify(TextFormat.Plural(profiles.Count, ConnectionViewText.Export_DoneOne, ConnectionViewText.Export_DoneOther, Path.GetFileName(path)));
            }
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            Logger.LogWarning(ex, "Exporting connections failed");
            Shell.Notify(TextFormat.Format(ConnectionViewText.Export_Failed, ex.Message));
        }
    }
}
