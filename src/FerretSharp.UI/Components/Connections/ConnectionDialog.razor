@using FerretSharp.Core.ClrModel
@using FerretSharp.Core.Connections
@inherits FerretComponent
@implements IDisposable
@inject ConnectionManager Connections
@inject ConnectionHub Hub
@inject IConnectionTester Tester
@inject IFileOpenService Files
@inject FerretSharp.Core.Audit.AuditTemplateSource AuditTemplates
@inject ShortcutService Shortcuts
@inject ILogger<ConnectionDialog> Logger

@{
    // Once per render: validating builds the profile; what looks at the file system answers from the background (PathProbe).
    var errors = Errors;
}

<ModalFrame Label="@Title" OnCancel="CloseAsync">
    <header>
        <span>@Title</span>
        <button class="icon-btn ghost" title="@CommonText.Close" @onclick="CancelAsync">@Icons.Close</button>
    </header>

    <div class="dialog-body form-grid">
        <label for="cn-name">@ConnectionViewText.ConnectionDialog_Name</label>
        <div>
            <input id="cn-name" class="field @Invalid(errors, ConnectionField.Name)" @ref="_nameInput"
                   @bind="Form.Name" @bind:event="oninput" placeholder="@ConnectionViewText.ConnectionDialog_NamePlaceholder" />
            <FieldError Errors="errors" Field="@ConnectionField.Name" />
        </div>

        <label for="cn-group">@ConnectionViewText.ConnectionDialog_Group</label>
        <div>
            <input id="cn-group" class="field" list="cn-groups" @bind="Form.Group" @bind:event="oninput"
                   placeholder="@ConnectionViewText.ConnectionDialog_GroupPlaceholder" autocomplete="off" />
            <datalist id="cn-groups">
                @foreach (var group in ConnectionSearch.GroupNames(Connections.Profiles))
                {
                    <option value="@group"></option>
                }
            </datalist>
        </div>

        <label>@ConnectionViewText.ConnectionDialog_Environment</label>
        <div class="segmented">
            @foreach (var kind in ConnectionKindInfo.All)
            {
                <button class="seg @ConnectionKindInfo.CssClass(kind) @(Form.Kind == kind ? "active" : "")"
                        @onclick="() => Form.Kind = kind">
                    <span class="dot"></span>@ConnectionKindInfo.Label(kind)
                </button>
            }
        </div>

        <label>@ConnectionViewText.ConnectionDialog_Address</label>
        <div class="segmented">
            <button class="seg @(Form.Mode == AddressMode.HostPort ? "active" : "")" @onclick="() => Form.Mode = AddressMode.HostPort">Host / Port</button>
            <button class="seg @(Form.Mode == AddressMode.TnsAlias ? "active" : "")" @onclick="() => Form.Mode = AddressMode.TnsAlias">@ConnectionViewText.ConnectionDialog_TnsAlias</button>
        </div>

        @if (Form.Mode == AddressMode.HostPort)
        {
            <label for="cn-host">Host</label>
            <div>
                <div class="row">
                    <input id="cn-host" class="field grow @Invalid(errors, ConnectionField.Host)" @bind="Form.Host" @bind:event="oninput" placeholder="db01.example.com" />
                    <span class="row-label">Port</span>
                    <input class="field port @Invalid(errors, ConnectionField.Port)" @bind="Form.Port" @bind:event="oninput" />
                </div>
                <FieldError Errors="errors" Field="@ConnectionField.Host" />
                <FieldError Errors="errors" Field="@ConnectionField.Port" />
            </div>

            <label>@ConnectionViewText.ConnectionDialog_Database</label>
            <div>
                <div class="row">
                    <div class="segmented small">
                        <button class="seg @(!Form.UseSid ? "active" : "")" @onclick="() => Form.UseSid = false">Service Name</button>
                        <button class="seg @(Form.UseSid ? "active" : "")" @onclick="() => Form.UseSid = true">SID</button>
                    </div>
                    @if (Form.UseSid)
                    {
                        <input class="field grow @Invalid(errors, ConnectionField.ServiceOrSid)" @bind="Form.Sid" @bind:event="oninput" placeholder="ORCL" />
                    }
                    else
                    {
                        <input class="field grow @Invalid(errors, ConnectionField.ServiceOrSid)" @bind="Form.ServiceName" @bind:event="oninput" placeholder="ORCLPDB1" />
                    }
                </div>
                <FieldError Errors="errors" Field="@ConnectionField.ServiceOrSid" />
            </div>
        }
        else
        {
            <label for="cn-alias">@ConnectionViewText.ConnectionDialog_TnsAlias</label>
            <div>
                <input id="cn-alias" class="field @Invalid(errors, ConnectionField.Alias)" @bind="Form.Alias" @bind:event="oninput" placeholder="ERP_TEST" />
                <FieldError Errors="errors" Field="@ConnectionField.Alias" />
            </div>

            <label for="cn-tns">TNS_ADMIN</label>
            <input id="cn-tns" class="field mono" @bind="Form.TnsAdminPath" @bind:event="oninput"
                   placeholder="@ConnectionViewText.ConnectionDialog_TnsAdminPlaceholder" />
        }

        <label for="cn-user">@ConnectionViewText.ConnectionDialog_User</label>
        <div>
            <input id="cn-user" class="field @Invalid(errors, ConnectionField.User)" @bind="Form.User" @bind:event="oninput" autocomplete="off" />
            <FieldError Errors="errors" Field="@ConnectionField.User" />
        </div>

        <label for="cn-password">@ConnectionViewText.ConnectionDialog_Password</label>
        <div>
            <input id="cn-password" type="password" class="field @Invalid(errors, PasswordField)" @bind="Form.Password" @bind:event="oninput"
                   placeholder="@PasswordPlaceholder" autocomplete="new-password" />
            <FieldError Errors="errors" Field="@PasswordField" />
            <div class="hint small">@ConnectionViewText.ConnectionDialog_PasswordHint</div>
        </div>

        <label for="cn-schema">Schema</label>
        <input id="cn-schema" class="field" @bind="Form.DefaultSchema" @bind:event="oninput" placeholder="@ConnectionViewText.ConnectionDialog_SchemaPlaceholder" />

        <span></span>
        <label class="check">
            <input type="checkbox" checked="@Form.ReadOnly" @onchange="e => Form.SetReadOnly(e.Value is true)" />
            @ConnectionViewText.ConnectionDialog_ReadOnly
            <span class="hint">@ConnectionViewText.ConnectionDialog_ReadOnlyHint</span>
        </label>

        <label>@ConnectionViewText.ConnectionDialog_Shortcut</label>
        <div>
            <ConnectionShortcutField ProfileId="Form.Id" @bind-Value="_shortcut" />
            <div class="hint small">@ConnectionViewText.ConnectionDialog_ShortcutHint</div>
        </div>

        <div class="form-section">@ConnectionViewText.ConnectionDialog_ClrModel <span class="hint">@ConnectionViewText.ConnectionDialog_ClrModelHint</span></div>

        <label for="cn-clr">@ConnectionViewText.ConnectionDialog_Project</label>
        <div>
            <div class="field-with-button">
                <input id="cn-clr" class="field mono @Invalid(errors, ConnectionField.ClrProject)" @bind="Form.ClrProjectFile" @bind:event="oninput"
                       placeholder="@ConnectionViewText.ConnectionDialog_ProjectPlaceholder" spellcheck="false" />
                <button class="btn" title="@ConnectionViewText.ConnectionDialog_PickProject" @onclick="PickProjectAsync">…</button>
            </div>
            <FieldError Errors="errors" Field="@ConnectionField.ClrProject" />
            <div class="hint small">@(Form.IsModelFile ? ConnectionViewText.ConnectionDialog_ModelFileHint : ConnectionViewText.ConnectionDialog_ProjectHint)</div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Form.ClrProjectFile) && !Form.IsModelFile)
        {
            <label for="cn-clr-config">Build</label>
            <select id="cn-clr-config" class="field narrow" @bind="Form.ClrConfiguration">
                <option value="Debug">Debug</option>
                <option value="Release">Release</option>
            </select>

            <label for="cn-clr-context">DbContext</label>
            <input id="cn-clr-context" class="field mono" @bind="Form.ClrContextType" @bind:event="oninput"
                   placeholder="@ConnectionViewText.ConnectionDialog_ContextPlaceholder" spellcheck="false" />
        }

        <label for="cn-app-env">@ConnectionViewText.ConnectionDialog_AppEnvironment</label>
        <div>
            <input id="cn-app-env" class="field mono" @bind="Form.AppEnvironment" @bind:event="oninput"
                   placeholder="@ConnectionViewText.ConnectionDialog_AppEnvironmentPlaceholder" spellcheck="false" autocomplete="off" />
            <div class="hint small">@ConnectionViewText.ConnectionDialog_AppEnvironmentHint</div>
        </div>

        <div class="form-section">@SettingsViewText.Settings_Audit</div>

        <label for="cn-audit">@ConnectionViewText.ConnectionDialog_AuditTemplate</label>
        <div>
            <div class="field-with-button">
                <input id="cn-audit" class="field mono" @bind="Form.AuditTemplatePath" @bind:event="oninput"
                       placeholder="@ConnectionViewText.ConnectionDialog_AuditTemplatePlaceholder" spellcheck="false" autocomplete="off" />
                <button class="btn" title="@ConnectionViewText.ConnectionDialog_PickAuditTemplate" @onclick="PickAuditTemplateAsync">…</button>
            </div>
            @foreach (var error in AuditTemplateErrors())
            {
                <div class="field-error">@error</div>
            }
            <div class="hint small">@TextFormat.Format(ConnectionViewText.ConnectionDialog_AuditTemplateHint, AuditTemplateLabel.Of(AuditTemplates.For(Form.ToProfile().Profile with { AuditTemplatePath = null })))</div>
        </div>
    </div>

    @if (_testing || _testResult is not null || _testCancelled)
    {
        <div class="test-result @(_testResult switch { { Success: true } => "ok", { Success: false } => "error", _ => "" })">
            @if (_testing)
            {
                <span class="spinner"></span>
                <span>@ConnectionViewText.ConnectionDialog_Connecting</span>
            }
            else if (_testCancelled)
            {
                <span>@ConnectionViewText.ConnectionDialog_TestCanceled</span>
            }
            else if (_testResult is { Success: true } ok)
            {
                <span class="dot ok"></span>
                <span>@TextFormat.Format(ConnectionViewText.ConnectionDialog_TestOk, Milliseconds(ok.Elapsed), ok.ServerVersion)</span>
            }
            else if (_testResult is { } failed)
            {
                <span class="code">@(failed.ErrorCode ?? CommonText.Error)</span>
                <span>@failed.Message</span>
            }
        </div>
    }

    @if (_saveError is not null)
    {
        <div class="test-result error"><span>@_saveError</span></div>
    }

    <footer>
        @if (!Form.IsNew)
        {
            <button class="btn ghost danger" @onclick="DeleteAsync">@ConnectionViewText.Connection_DeleteEllipsis</button>
        }
        <span class="spacer"></span>
        @if (_testing)
        {
            <button class="btn" @onclick="CancelTest">@ConnectionViewText.ConnectionDialog_CancelTest</button>
        }
        else
        {
            <button class="btn" @onclick="TestAsync">@ConnectionViewText.ConnectionDialog_Test</button>
        }
        <button class="btn ghost" @onclick="CancelAsync">@CommonText.Cancel</button>
        <button class="btn primary" @onclick="SaveAsync" disabled="@_saving">@CommonText.Save</button>
    </footer>
</ModalFrame>

@code {
    private const string PasswordField = "Password";

    private ElementReference _nameInput;
    private bool _submitted;
    private bool _testing;
    private bool _testCancelled;
    private bool _saving;
    private string? _saveError;
    private ConnectionTestResult? _testResult;
    private readonly CancelableRun _test = new();

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [Parameter, EditorRequired]
    public ConnectionDialogRequest Request { get; set; } = new(ConnectionDialogMode.New, null);

    [Parameter]
    public EventCallback OnClose { get; set; }

    private ConnectionForm Form { get; set; } = new();

    private string Title => Request.Mode switch
    {
        ConnectionDialogMode.Edit => ConnectionViewText.ConnectionDialog_EditTitle,
        ConnectionDialogMode.Duplicate => ConnectionViewText.ConnectionDialog_DuplicateTitle,
        _ => ConnectionViewText.Connection_New,
    };

    /// <summary>The edited profile (edit) or the original (duplicate) has a stored password that can be reused.</summary>
    private bool HasStoredPassword { get; set; }

    private string PasswordPlaceholder => !HasStoredPassword ? ""
        : Request.Mode == ConnectionDialogMode.Duplicate ? ConnectionViewText.ConnectionDialog_PasswordAsOriginal : ConnectionViewText.ConnectionDialog_PasswordUnchanged;

    private IReadOnlyDictionary<string, string> Errors => _submitted ? Validate(_validateForTest) : EarlyErrors();

    /// <summary>The last button was "Test": the password is required then (see <see cref="Validate"/>).</summary>
    private bool _validateForTest;

    /// <summary>Before the first submit only the linked project is judged, and only once the file exists (not while typing the path).</summary>
    private Dictionary<string, string> EarlyErrors()
    {
        var errors = new Dictionary<string, string>();
        if (PathInput.Normalize(Form.ClrProjectFile) is { } project && ProjectExists.For(project) is (true, true) && Validate() is var all && all.TryGetValue(ConnectionField.ClrProject, out var message))
        {
            errors[ConnectionField.ClrProject] = message;
        }

        return errors;
    }

    protected override void OnInitialized()
    {
        Form = Request switch
        {
            { Mode: ConnectionDialogMode.Edit, Profile: { } p } => ConnectionForm.FromProfile(p),
            { Mode: ConnectionDialogMode.Duplicate, Profile: { } p } => ConnectionForm.Duplicate(p),
            _ => new ConnectionForm { Group = Request.Group ?? "" },
        };
        HasStoredPassword = Form.PasswordSourceId is { } source && Connections.GetStoredPassword(source) is not null;
        _shortcut = _savedShortcut = Shortcuts.Map.ConnectionChord(Form.Id); // a copy has a new id: no key
    }

    /// <summary>The connection's key as chosen in the dialog (WP-66) and as saved; written with the connection.</summary>
    private KeyChord? _shortcut;

    private KeyChord? _savedShortcut;

    /// <summary>The typed password, otherwise the stored one of the edited/original profile.</summary>
    private string? EffectivePassword() =>
        Form.Password.Length > 0 ? Form.Password
        : Form.PasswordSourceId is { } source ? Connections.GetStoredPassword(source)
        : null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _nameInput.FocusAsync();
        }
    }

    /// <param name="forTest">"Test" needs a password; saving an edited or duplicated connection does not (WP-35: it is asked for when connecting).</param>
    private Dictionary<string, string> Validate(bool forTest = false)
    {
        var errors = new Dictionary<string, string>(Form.ToProfile().Errors);
        if (Form.Password.Length == 0 && !HasStoredPassword && (forTest || Request.Mode == ConnectionDialogMode.New))
        {
            errors[PasswordField] = ConnectionViewText.ConnectionDialog_PasswordMissing;
        }

        // Reads the build output from disk: in the background, once per project/configuration (Validate runs on every render).
        if (errors.ContainsKey(ConnectionField.ClrProject) is false && Form.ToProfile().Profile.ClrProject is { } link && ClrCheck.For(link) is (true, { } problem))
        {
            errors[ConnectionField.ClrProject] = problem;
        }

        return errors;
    }

    // Review 3.40.0, A14: File.Exists, the build output and the audit template were read in the render – at every keystroke,
    // on the UI thread, also for a path on a share behind a silent VPN.
    private PathProbe<string, bool>? _projectExists;
    private PathProbe<ClrProjectLink, string?>? _clrCheck;
    private PathProbe<string, (bool Exists, IReadOnlyList<string> Errors)>? _templateCheck;

    private PathProbe<string, bool> ProjectExists => _projectExists ??= new(File.Exists, Apply);

    private PathProbe<ClrProjectLink, string?> ClrCheck => _clrCheck ??= new(BuildOutputLocator.Check, Apply);

    private PathProbe<string, (bool Exists, IReadOnlyList<string> Errors)> TemplateCheck =>
        _templateCheck ??= new(path => (File.Exists(path), AuditTemplates.Load(path).Errors), Apply);

    private void Apply(Action update) => Fire(() =>
    {
        update();
        StateHasChanged();
    });

    /// <summary>Before "Test" and "Save": the linked project's build output checked again and waited for – it decides.</summary>
    private async Task CheckProjectAsync()
    {
        if (Form.ToProfile().Profile.ClrProject is { } link)
        {
            await ClrCheck.FreshAsync(link);
        }
    }

    private static string Invalid(IReadOnlyDictionary<string, string> errors, string field) => errors.ContainsKey(field) ? "invalid" : "";

    private async Task PickProjectAsync()
    {
        if (await Files.PickAsync(ConnectionViewText.ConnectionDialog_ProjectFilter, ["csproj", "json"], Form.ClrProjectFile) is { } path)
        {
            Form.ClrProjectFile = path;
        }
    }

    /// <summary>
    /// Why the connection's own template cannot be used (WP-51) – judged for the saved path, once a typed file exists or
    /// after a submit, not while the path is typed. It does not block saving: the designer and the audit line report it too.
    /// </summary>
    private IReadOnlyList<string> AuditTemplateErrors()
    {
        if (PathInput.Normalize(Form.AuditTemplatePath) is not { } path || TemplateCheck.For(path) is not (true, var (exists, errors)))
        {
            return [];
        }

        return _submitted || path == Request.Profile?.AuditTemplatePath || exists ? errors : [];
    }

    private async Task PickAuditTemplateAsync()
    {
        if (await Files.PickAsync(SettingsViewText.Settings_AuditTemplateFilter, ["sql", "txt"], Form.AuditTemplatePath) is { } path)
        {
            Form.AuditTemplatePath = path;
        }
    }

    private async Task TestAsync()
    {
        _submitted = true;
        _validateForTest = true;
        // Spinner and "Cancel test" from the first render on: checking the linked project's build output already awaits, and
        // the dialog renders only then and at the end – with the flags set later, "Test" stayed clickable the whole test.
        _testing = true;
        _testCancelled = false;
        _testResult = null;
        try
        {
            await _test.TryRunAsync(async token =>
            {
                await CheckProjectAsync();
                if (Validate(forTest: true).Count > 0)
                {
                    return;
                }

                var profile = Form.ToProfile().Profile;
                var password = EffectivePassword() ?? "";
                _testResult = await Task.Run(() => Tester.TestAsync(profile, password, token), token);
            });
        }
        catch (OperationCanceledException)
        {
            _testCancelled = true;
        }
        finally
        {
            _testing = _test.Running;
        }
    }

    private void CancelTest() => _test.Cancel();

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        _submitted = true;
        _saveError = null;
        _validateForTest = false;
        // Before the first await, as with "Test": "Save" is disabled while the build output is checked, a second click saves nothing twice.
        _saving = true;
        try
        {
            await CheckProjectAsync();
            if (Validate().Count > 0)
            {
                return;
            }

            var profile = Form.ToProfile().Profile;
            // Edit: null keeps the stored password. New/duplicate: store the typed one, or the original's saved one (never
            // a password kept only for this run, WP-35); none: asked for when connecting.
            var newPassword = Form.IsNew ? EffectivePassword() : Form.Password.Length > 0 ? Form.Password : null;
            var open = Form.IsNew ? null : Hub.Find(profile.Id)?.Profile;
            await Connections.SaveAsync(profile, newPassword, CancellationToken.None);
            if (_shortcut != _savedShortcut)
            {
                // The connection is saved: a key that could not be saved applies until quitting, with a notice.
                var shortcut = _shortcut;
                await Shell.TrySaveSettingsAsync(() => Shortcuts.SetConnectionAsync(profile.Id, shortcut), Logger);
            }

            await CloseAsync();
            if (open is not null && (open.SessionDiffers(profile) || newPassword is not null))
            {
                Shell.OfferReconnect(profile); // the open sessions still work with the old settings (review 3.31.0, A8)
            }
        }
        // ExternalException: the Credential Manager refused the password (a policy, its size limit) – a message, not the
        // error bar (review 3.31.0, A48).
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or ArgumentException or InvalidOperationException
                                       or System.Runtime.InteropServices.ExternalException)
        {
            _saveError = TextFormat.Format(CommonText.SaveFailed, ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>
    /// Hands over to the shell's delete (as the "⋯" menu does): it confirms, disconnects first if this is the active
    /// connection (guarding open changes) and removes the connection's workspaces and SQL history too.
    /// </summary>
    private async Task DeleteAsync()
    {
        var profile = Connections.Profiles.FirstOrDefault(p => p.Id == Form.Id);
        await CloseAsync();
        if (profile is not null)
        {
            Shell.RequestDelete(profile);
        }
    }

    private async Task CancelAsync() => await CloseAsync();

    private async Task CloseAsync()
    {
        CancelTest();
        await OnClose.InvokeAsync();
    }

    private static string Milliseconds(TimeSpan elapsed) => elapsed.TotalMilliseconds.ToString("N0", CultureInfo.CurrentCulture);

    public void Dispose() => _test.Cancel();
}
