@* Import connections (WP-35): pick a found DBeaver/SQL Developer installation or a file, then decide per connection in the
   preview. Finding only looks at folders; nothing is read before a click. Passwords are never imported. *@
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Connections.Transfer
@implements IDisposable
@inject ConnectionTransfer Transfer
@inject IFileOpenService Files
@inject ILogger<ConnectionImportDialog> Logger

<ModalFrame Label="@ConnectionViewText.Import_Title" Class="import-dialog" OnCancel="Shell.CloseImport">
    <header><span>@ConnectionViewText.Import_Title</span></header>
    <div class="dialog-body">
        <div class="import-sources" role="group" aria-label="@ConnectionViewText.Import_Source">
            @foreach (var installation in _installations)
            {
                var found = installation;
                <button class="import-source @(_chosen == found ? "active" : "")" disabled="@_busy" @onclick="() => ReadInstallationAsync(found)"
                        title="@found.Folder">
                    <span class="import-source-name">@SourceName(found.Source)</span>
                    <span class="import-source-detail">@TextFormat.Format(ConnectionViewText.Import_Found, found.Detail)</span>
                </button>
            }
            <button class="import-source @(_chosen is null && _plan is not null ? "active" : "")" disabled="@_busy" @onclick="ChooseFileAsync">
                <span class="import-source-name">@ConnectionViewText.Import_ChooseFile</span>
                <span class="import-source-detail">.json, .dbp</span>
            </button>
        </div>
        @if (_installations.Count == 0)
        {
            <div class="hint small">@ConnectionViewText.Import_NothingFound</div>
        }

        @if (_busy)
        {
            <div class="import-state"><span class="spinner small"></span> @ConnectionViewText.Import_Reading</div>
        }
        else if (_error is not null)
        {
            <div class="import-state error">@_error</div>
        }
        else if (_plan is { } plan)
        {
            <div class="import-state">
                @TextFormat.Plural(plan.Rows.Count, ConnectionViewText.Import_FoundOne, ConnectionViewText.Import_FoundOther, SourceName(plan.File.Source))
                @if (plan.File.OtherDatabases > 0)
                {
                    <span class="hint"> @TextFormat.Plural(plan.File.OtherDatabases, ConnectionViewText.Import_OtherDatabasesOne, ConnectionViewText.Import_OtherDatabasesOther)</span>
                }
            </div>
            @if (plan.Rows.Count > 0)
            {
                <div class="import-table-wrap">
                    <table class="import-table">
                        <thead>
                            <tr>
                                <th class="sel"><input type="checkbox" checked="@AllSelected(plan)" @onchange="e => plan.SelectAll(e.Value is true)"
                                                       aria-label="@ConnectionViewText.Export_All" /></th>
                                <th>@ConnectionViewText.Import_ColName</th>
                                <th class="kind">@ConnectionViewText.Import_ColKind</th>
                                <th>@ConnectionViewText.Import_ColAddress</th>
                                <th class="user">@ConnectionViewText.ConnectionDialog_User</th>
                                <th class="status">@ConnectionViewText.Import_ColStatus</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in plan.Rows)
                            {
                                var r = row;
                                <tr class="@(r.CanImport ? "" : "unsupported") @(r.Selected && r.CanImport ? "" : "off")">
                                    <td class="sel"><input type="checkbox" checked="@(r.Selected && r.CanImport)" disabled="@(!r.CanImport)"
                                                           @onchange="e => r.Selected = e.Value is true" aria-label="@r.Candidate.Name" /></td>
                                    <td class="name" title="@r.Candidate.Name">
                                        @r.Candidate.Name
                                        @if (r.Candidate.Profile?.Group is { } group)
                                        {
                                            <span class="hint"> · @group</span>
                                        }
                                    </td>
                                    <td class="kind">
                                        @if (r.CanImport)
                                        {
                                            @* A guess is an option of its own (value ""), so picking the guessed kind is a change too and confirms it. *@
                                            <select class="field" @key="(r, r.KindGuessed)" value="@(r.KindGuessed ? "" : r.Kind.ToString())" @onchange="e => SetKind(r, e.Value)"
                                                    title="@(r.KindGuessed ? ConnectionViewText.Import_KindGuessedTitle : null)">
                                                @if (r.KindGuessed)
                                                {
                                                    <option value="">@ConnectionKindInfo.Label(r.Kind) (@ConnectionViewText.Import_KindGuessed)</option>
                                                }
                                                @foreach (var kind in ConnectionKindInfo.All)
                                                {
                                                    <option value="@kind">@ConnectionKindInfo.Label(kind)</option>
                                                }
                                            </select>
                                            @if (r.Overwrites is { } overwritten && overwritten.Kind != r.Kind)
                                            {
                                                <div class="import-sub">@TextFormat.Format(ConnectionViewText.Import_KindWas, ConnectionKindInfo.Label(overwritten.Kind))</div>
                                            }
                                        }
                                    </td>
                                    <td class="addr" title="@r.Candidate.Address">
                                        @r.Candidate.Address
                                        @if (r.CanImport && r.LocalPaths.Count > 0)
                                        {
                                            @* Review 3.31.0, A4: the paths of the source's computer, taken only when asked for. *@
                                            <div class="import-paths @(plan.TakeLocalPaths ? "" : "skipped")" title="@string.Join(Environment.NewLine, r.LocalPaths)">
                                                @string.Join(" · ", r.LocalPaths)
                                            </div>
                                        }
                                    </td>
                                    <td class="user">
                                        @if (r.CanImport && (string.IsNullOrEmpty(r.Candidate.Profile?.User) || r.UserMissing))
                                        {
                                            <input class="field @(r.UserMissing && r.Selected && _submitted ? "invalid" : "")" value="@r.User"
                                                   placeholder="@ConnectionViewText.ConnectionDialog_User" spellcheck="false" autocomplete="off"
                                                   @onchange="e => SetUser(r, e.Value as string)" />
                                        }
                                        else
                                        {
                                            @r.User
                                        }
                                    </td>
                                    <td class="status">
                                        @if (!r.CanImport)
                                        {
                                            <span class="hint" title="@r.Unsupported">@r.Unsupported</span>
                                        }
                                        else if (r.Duplicate is { } existing)
                                        {
                                            @if (r.Selected)
                                            {
                                                <select class="field" @key="(r, existing)" value="@r.Action" @onchange="e => SetAction(r, e.Value)"
                                                        title="@TextFormat.Format(ConnectionViewText.Import_ExistsTitle, existing.Name)">
                                                    <option value="@DuplicateAction.Overwrite">@ConnectionViewText.Import_Overwrite</option>
                                                    <option value="@DuplicateAction.Copy">@ConnectionViewText.Import_Copy</option>
                                                </select>
                                            }
                                            else
                                            {
                                                <span class="import-tag exists" title="@TextFormat.Format(ConnectionViewText.Import_ExistsTitle, existing.Name)">@ConnectionViewText.Import_Exists</span>
                                            }
                                        }
                                        else if (r.SameAsEarlier is { } twin)
                                        {
                                            <span class="import-tag exists" title="@TextFormat.Format(ConnectionViewText.Import_RepeatedTitle, twin.Candidate.Name)">@ConnectionViewText.Import_Repeated</span>
                                        }
                                        else
                                        {
                                            <span class="import-tag new">@ConnectionViewText.Import_New</span>
                                        }
                                        @if (r.CanImport && r.ReadOnly)
                                        {
                                            var lockTitle = r.Overwrites is { } kept && (kept.ReadOnly || kept.Kind == ConnectionKind.Prod) && !r.KindGuessed && r.Kind != ConnectionKind.Prod
                                                ? ConnectionViewText.Import_KeepsReadOnlyTitle
                                                : ConnectionViewText.Import_ReadOnlyTitle;
                                            <span class="import-lock" title="@lockTitle" aria-label="@lockTitle">@Icons.Locked</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="import-options">
                    <label>
                        <span>@ConnectionViewText.Import_DefaultGroup</span>
                        <input class="field" @bind="plan.DefaultGroup" spellcheck="false" autocomplete="off" />
                    </label>
                    <span class="hint">@ConnectionViewText.Import_NoPasswords</span>
                </div>
                @if (plan.HasLocalPaths)
                {
                    <label class="check import-paths-option">
                        <input type="checkbox" @bind="plan.TakeLocalPaths" />
                        @ConnectionViewText.Import_TakeLocalPaths
                    </label>
                    <div class="hint small">@ConnectionViewText.Import_TakeLocalPathsHint</div>
                }
            }
        }
    </div>
    <footer>
        @if (_saveError is not null)
        {
            <span class="field-error">@_saveError</span>
        }
        else if (_submitted && _plan?.Problem is { } problem)
        {
            <span class="field-error">@problem</span>
        }
        <span class="spacer"></span>
        <button class="btn ghost" @onclick="Shell.CloseImport">@CommonText.Cancel</button>
        @if (_plan is { } p)
        {
            var count = p.SelectedRows.Count();
            <button class="btn primary" disabled="@(_busy || count == 0)" @onclick="ImportAsync">
                @TextFormat.Plural(count, ConnectionViewText.Import_ImportOne, ConnectionViewText.Import_ImportOther)
            </button>
        }
    </footer>
</ModalFrame>

@code {
    private readonly CancellationTokenSource _cts = new();
    private IReadOnlyList<FoundInstallation> _installations = [];
    private FoundInstallation? _chosen;
    private ConnectionImportPlan? _plan;
    private string? _error;
    private string? _saveError;
    private bool _busy;
    private bool _submitted;

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    protected override void OnInitialized() => _installations = Transfer.FindInstallations();

    private static string SourceName(ConnectionImportSource source) => source switch
    {
        ConnectionImportSource.DBeaver => "DBeaver",
        ConnectionImportSource.SqlDeveloper => "SQL Developer",
        _ => "FerretSharp",
    };

    private Task ReadInstallationAsync(FoundInstallation installation)
    {
        _chosen = installation;
        return ReadAsync(() => Transfer.ReadAsync(installation, _cts.Token));
    }

    private async Task ChooseFileAsync()
    {
        if (await Files.PickAsync(ConnectionViewText.Import_FileFilter, ConnectionImportReader.Extensions) is not { } path)
        {
            return;
        }

        _chosen = null;
        await ReadAsync(() => Transfer.ReadFileAsync(path, _cts.Token));
    }

    private async Task ReadAsync(Func<Task<ImportFile>> read)
    {
        (_busy, _error, _plan, _submitted) = (true, null, null, false);
        try
        {
            _plan = Transfer.Plan(await read());
        }
        catch (ConnectionImportException ex)
        {
            _error = ex.Message;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            // Last resort: the dialog sits outside the shell's error boundary, nothing may escape it.
            Logger.LogWarning(ex, "Reading connections to import failed");
            _error = TextFormat.Format(ConnectionText.ImportUnreadable, ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>The "all" check box covers the plain rows; duplicates are picked one by one.</summary>
    private static bool AllSelected(ConnectionImportPlan plan) => plan.PlainRows.Any() && plan.PlainRows.All(r => r.Selected);

    private static void SetKind(ImportRow row, object? value)
    {
        if (Enum.TryParse<ConnectionKind>(value as string, out var kind))
        {
            row.SetKind(kind);
        }
    }

    private static void SetAction(ImportRow row, object? value)
    {
        if (Enum.TryParse<DuplicateAction>(value as string, out var action))
        {
            row.Action = action;
        }
    }

    /// <summary>A typed user may make the row a duplicate; the status column then offers overwrite or copy.</summary>
    private static void SetUser(ImportRow row, string? user) => row.User = user ?? "";

    private async Task ImportAsync()
    {
        _submitted = true;
        if (_plan is not { } plan || plan.Problem is not null)
        {
            return;
        }

        (_busy, _saveError) = (true, null);
        try
        {
            var count = await Transfer.ImportAsync(plan, _cts.Token);
            Shell.CloseImport();
            Shell.Notify(TextFormat.Plural(count, ConnectionViewText.Import_DoneOne, ConnectionViewText.Import_DoneOther));
        }
        catch (Exception ex) when (ex is IOException or ArgumentException or UnauthorizedAccessException)
        {
            Logger.LogWarning(ex, "Saving imported connections failed");
            _saveError = TextFormat.Format(CommonText.SaveFailed, ex.Message);
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
