@* "⋯" of a connection: its menu (ConnectionMenuBody, WP-66) below the button – Escape, focus, ↑ ↓, kept inside the
   window (near the bottom of the switcher "Delete…" was cut off, review 3.31.0 A22). *@
@using FerretSharp.Core.Connections

<MenuButton Title="@ShellText.Actions" Label="Dots" StopPropagation="true" Width="MenuWidth" EstimatedHeight="260" KeyNavigation="true">
    <ChildContent Context="menu">
        <ConnectionMenuBody Profile="Profile" OnClose="() => CloseAsync(menu)" />
    </ChildContent>
</MenuButton>

@code {
    /// <summary>The width of a connection's menu, also on a right-click.</summary>
    public const double MenuWidth = 340;

    private static readonly RenderFragment Dots = @<text>@Icons.More</text>;

    [Parameter, EditorRequired]
    public ConnectionProfile Profile { get; set; } = null!;

    /// <summary>Raised before an action runs, e.g. to close the surrounding popover.</summary>
    [Parameter]
    public EventCallback OnAction { get; set; }

    private async Task CloseAsync(MenuButton menu)
    {
        menu.Close();
        await OnAction.InvokeAsync();
    }
}
