@* The history beside a SQL tab (R3b, out of SqlView): the connection's last statements, searchable; a click adopts one
   into the script. *@
@using System.Text.RegularExpressions
@using FerretSharp.Core.Workspaces

<aside class="sql-history">
    <SearchBox @bind-Value="_search" Class="search" Placeholder="@SqlEditorText.SqlHistory_Search" />
    <div class="sql-history-list">
        @foreach (var entry in Filtered)
        {
            var e = entry;
            <button class="sql-history-item @(e.Error is null ? "" : "failed")" title="@e.Sql" @onclick="() => OnAdopt.InvokeAsync(e)">
                <span class="sql-history-sql">@OneLine(e.Sql)</span>
                <span class="sql-history-meta">@e.ExecutedAt.ToLocalTime().ToString("dd.MM. HH:mm", CultureInfo.CurrentCulture) · @Outcome(e)</span>
            </button>
        }
        @if (!Filtered.Any())
        {
            <div class="ctx-empty">@(Entries.Count == 0 ? SqlEditorText.SqlHistory_Empty : SqlEditorText.SqlHistory_NoMatch)</div>
        }
    </div>
</aside>

@code {
    private string _search = "";

    /// <summary>Newest first.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<SqlHistoryEntry> Entries { get; set; } = [];

    [Parameter]
    public EventCallback<SqlHistoryEntry> OnAdopt { get; set; }

    /// <summary>Every word must occur in the statement, in any order.</summary>
    private IEnumerable<SqlHistoryEntry> Filtered => Entries.Where(e =>
        _search.Split(' ', StringSplitOptions.RemoveEmptyEntries).All(w => e.Sql.Contains(w, StringComparison.OrdinalIgnoreCase)));

    private static string OneLine(string sql) => Regex.Replace(sql, @"\s+", " ").Trim();

    private static string Outcome(SqlHistoryEntry entry) => entry switch
    {
        { Error: { } error } => error.Split(':')[0],
        { Ddl: true } => SqlEditorText.Run_DdlDone,
        { Changed: true, Rows: { } rows } => TextFormat.Format(SqlEditorText.Run_Changed, rows),
        { Rows: 1, MoreRows: false } => SqlEditorText.Run_OneRow,
        { Rows: { } rows } => TextFormat.Format(entry.MoreRows ? SqlEditorText.Run_RowsAtLeast : SqlEditorText.Run_Rows, rows),
        _ => "",
    };
}
