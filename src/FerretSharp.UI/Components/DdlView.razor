@* "DDL" view: the CREATE statement from DBMS_METADATA (shown and copied, never executed). *@
@using FerretSharp.Core.Schema
@inherits DetailViewBase<string>

<DetailStatus Loading="Loading && Data is null" Error="Error" Text="@SchemaViewText.Ddl_Loading"
              Hint="@(Error?.ErrorCode == "ORA-31603" ? SchemaViewText.Ddl_NeedsCatalogRole : null)" />

@if (Data is { } ddl)
{
    <section>
        <h2>DDL</h2>
        <SqlCode Sql="@ddl" Class="ddl" />
        <p class="muted"><Fmt Text="@SchemaViewText.Ddl_Source"><Arg0><code>DBMS_METADATA.GET_DDL</code></Arg0></Fmt></p>
    </section>
}

@code {
    protected override Task<string> LoadAsync(SchemaCache schema, CancellationToken cancellationToken) =>
        schema.GetDdlAsync(Table, cancellationToken);
}
