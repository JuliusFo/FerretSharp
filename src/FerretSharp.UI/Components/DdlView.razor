@* "DDL" view: the CREATE statement from DBMS_METADATA (shown and copied, never executed). *@
@using FerretSharp.Core.Schema
@inherits DetailViewBase<string>

<DetailStatus Loading="Loading && Data is null" Error="Error" Text="Lade DDL …"
              Hint="@(Error?.ErrorCode == "ORA-31603" ? "Oracle liefert die DDL von Objekten anderer Schemas nur mit der Rolle SELECT_CATALOG_ROLE." : null)" />

@if (Data is { } ddl)
{
    <section>
        <h2>DDL</h2>
        <SqlCode Sql="@ddl" Class="ddl" />
        <p class="muted">Aus <code>DBMS_METADATA.GET_DDL</code> – Indizes, Trigger und Grants stehen nicht darin.</p>
    </section>
}

@code {
    protected override Task<string> LoadAsync(SchemaCache schema, CancellationToken cancellationToken) =>
        schema.GetDdlAsync(Table, cancellationToken);
}
