<div class="empty @(IsError ? "is-error" : "")">
    <div>
        <h2>@Title</h2>
        <p>@Text</p>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter]
    public string? Text { get; set; }

    [Parameter]
    public bool IsError { get; set; }
}
