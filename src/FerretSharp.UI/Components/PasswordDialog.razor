@* Asks for the password of a connection that has none saved (WP-35: imported connections), right before connecting.
   Saved in the Credential Manager by default; unchecked, it is kept only until FerretSharp ends. *@
@using FerretSharp.Core.Connections
@inject ConnectionManager Connections

<ModalFrame Label="@ShellText.Password_Title" Class="confirm password-dialog" OnCancel="Shell.ClosePassword">
    <header><span>@ShellText.Password_Title</span></header>
    <div class="dialog-body">
        <p>
            <Fmt Text="@ShellText.Password_Question">
                <Arg0><strong>@Profile.Name</strong></Arg0>
                <Arg1><code>@($"{Profile.User}@{Profile.Address.Display}")</code></Arg1>
            </Fmt>
        </p>
        <label class="password-field">
            <span>@ShellText.ConnectionDialog_Password</span>
            <input @ref="_input" type="password" class="field" autocomplete="off" @bind="_password" @bind:event="oninput"
                   @onkeydown="OnKeyDownAsync" />
        </label>
        <label class="check">
            <input type="checkbox" @bind="_remember" />
            @ShellText.Password_Remember
        </label>
        @if (!_remember)
        {
            <div class="hint small">@ShellText.Password_ForgetHint</div>
        }
    </div>
    <footer>
        <span class="spacer"></span>
        <button class="btn ghost" @onclick="Shell.ClosePassword">@CommonText.Cancel</button>
        <button class="btn primary" disabled="@(_password.Length == 0)" @onclick="ConnectAsync">@ShellText.ConnectionMenu_Connect</button>
    </footer>
</ModalFrame>

@code {
    private ElementReference _input;
    private string _password = "";
    private bool _remember = true;

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [Parameter, EditorRequired]
    public ConnectionProfile Profile { get; set; } = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _input.FocusAsync();
        }
    }

    private Task ConnectAsync()
    {
        if (_password.Length == 0)
        {
            return Task.CompletedTask;
        }

        Connections.SetPassword(Profile.Id, _password, _remember);
        _password = "";
        Shell.Connect(Profile); // closes this dialog
        return Task.CompletedTask;
    }

    private Task OnKeyDownAsync(KeyboardEventArgs e) => e.Key == "Enter" ? ConnectAsync() : Task.CompletedTask;
}
