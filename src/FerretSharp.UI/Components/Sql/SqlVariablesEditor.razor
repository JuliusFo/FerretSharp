@* The bind variables of a SQL tab (R3b, out of SqlView): type and value per variable; variables the script no longer uses
   are dimmed and can be removed. Values are bound, never put into the SQL. *@
@using FerretSharp.Core.Query

@if (Variables.Count > 0)
{
    <div class="linq-label">
        @SqlEditorText.Editor_Variables
        <span class="hint">@SqlEditorText.SqlVariables_Hint</span>
    </div>
    <div class="sql-variables">
        @foreach (var variable in Variables)
        {
            var v = variable;
            var used = Binds.Contains(v.Name, StringComparer.OrdinalIgnoreCase);
            <div class="sql-variable @(used ? "" : "unused")" title="@(used ? null : SqlEditorText.SqlVariables_Unused)">
                <code>:@v.Name</code>
                <select class="field" value="@v.Type" @onchange="e => SetAsync(v, Enum.Parse<SqlVariableType>((string)e.Value!), v.Value)">
                    @foreach (var type in Enum.GetValues<SqlVariableType>())
                    {
                        <option value="@type">@TypeText(type)</option>
                    }
                </select>
                @if (v.Type != SqlVariableType.Null)
                {
                    <input class="field" value="@v.Value" placeholder="@Placeholder(v.Type)" spellcheck="false"
                           @onchange="e => SetAsync(v, v.Type, (string?)e.Value ?? string.Empty)" />
                }
                @if (!used)
                {
                    <button class="icon-btn ghost" title="@SqlEditorText.SqlVariables_Remove" @onclick="() => RemoveAsync(v)">✕</button>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<SqlVariable> Variables { get; set; } = [];

    /// <summary>The binds of the whole script; variables not among them are shown dimmed.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<string> Binds { get; set; } = [];

    /// <summary>The variables after a change of type or value, or after removing one.</summary>
    [Parameter]
    public EventCallback<IReadOnlyList<SqlVariable>> OnChange { get; set; }

    private Task SetAsync(SqlVariable variable, SqlVariableType type, string value) =>
        OnChange.InvokeAsync(Variables.Select(v => ReferenceEquals(v, variable) ? v with { Type = type, Value = value } : v).ToList());

    private Task RemoveAsync(SqlVariable variable) =>
        OnChange.InvokeAsync(Variables.Where(v => !ReferenceEquals(v, variable)).ToList());

    private static string TypeText(SqlVariableType type) => type switch
    {
        SqlVariableType.Text => SqlEditorText.SqlVariables_TypeText,
        SqlVariableType.Char => SqlEditorText.SqlVariables_TypeChar,
        SqlVariableType.Number => SqlEditorText.SqlVariables_TypeNumber,
        SqlVariableType.Date => SqlEditorText.SqlVariables_TypeDate,
        SqlVariableType.Raw => SqlEditorText.SqlVariables_TypeRaw,
        _ => "NULL",
    };

    private static string Placeholder(SqlVariableType type) => type switch
    {
        SqlVariableType.Number => "4711",
        SqlVariableType.Date => "05.10.2026 14:00",
        SqlVariableType.Raw => "CAFE01",
        _ => "",
    };
}
