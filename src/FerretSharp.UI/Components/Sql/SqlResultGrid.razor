@* Result of a query FerretSharp did not build (LINQ console, ADR 0011; SQL editor, WP-17): read in the workspace's session page by page,
   shown with the same grid bridge as tables – read-only, unsorted (the query's own ORDER BY counts). *@
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Data
@using FerretSharp.Core.Query
@using FerretSharp.Core.Schema
@inherits FerretComponent
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<SqlResultGrid> Logger

<div id="@_id" class="ag-host"></div>

@if (_menu is { } menu)
{
    <ResultMenu Request="menu" Result="AsTable()" Sources="_presentation.Sources" ExportColumns="_presentation.ExportColumns()" WorkspaceId="WorkspaceId" InsertTarget="InsertTarget"
                ExportName="@ExportName" AllRows="@(ExportsAllRows ? AllRowsOf() : null)" OnClose="() => _menu = null" />
}

@code {
    [CascadingParameter]
    public WorkspaceManager Workspaces { get; set; } = null!;

    [CascadingParameter]
    public ActiveConnection Active { get; set; } = null!;

    [CascadingParameter]
    public PresentationService Presentations { get; set; } = null!;

    /// <summary>
    /// How long the grid waits for the tables behind the result columns (WP-48) before it shows the plain result; known
    /// structures come from the schema cache at once. Later they relabel the columns in place.
    /// </summary>
    private static readonly TimeSpan SourcesWait = TimeSpan.FromMilliseconds(300);

    private readonly CancellationTokenSource _cts = new();
    private SqlResultPresentation _presentation = SqlResultPresentation.Plain([]);

    /// <summary>Rows per block (BLOCK_SIZE in grid.js); a preloaded first page must have this size.</summary>
    public const int PageSize = 500;

    private readonly string _id = "sqlgrid-" + Guid.NewGuid().ToString("N");
    private readonly RowBlocks _blocks = new();
    private GridBridge _grid = null!;
    private IReadOnlyList<SqlColumn> _columns = [];
    private SqlPage? _firstPage;

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [Parameter, EditorRequired]
    public Guid WorkspaceId { get; set; }

    /// <summary>The query; a new instance runs it again.</summary>
    [Parameter, EditorRequired]
    public QuerySpec Query { get; set; } = null!;

    /// <summary>After every page or failure.</summary>
    [Parameter]
    public EventCallback<SqlGridStatus> OnStatus { get; set; }

    /// <summary>
    /// The first <see cref="PageSize"/> rows, already read (SQL editor: when the statement ran); null = read them here.
    /// Later pages are read when scrolled to.
    /// </summary>
    [Parameter]
    public SqlPage? FirstPage { get; set; }

    /// <summary>The single table the query reads: target of "Copy as INSERT" (WP-17); null disables it.</summary>
    [Parameter]
    public TableSummary? InsertTarget { get; set; }

    /// <summary>File name offered when saving the result as CSV.</summary>
    [Parameter]
    public string ExportName { get; set; } = SqlEditorText.Result_DefaultExportName;

    /// <summary>
    /// The menu offers to export all rows, running the query again (SQL editor, WP-54) – not for the LINQ console, whose
    /// queries come from the user's code.
    /// </summary>
    [Parameter]
    public bool ExportsAllRows { get; set; }

    private GridContextMenuRequest? _menu;

    private int _rowsLoaded;

    /// <summary>The last page was read: <see cref="_rowsLoaded"/> is the result's size.</summary>
    private bool _allLoaded;

    /// <summary>Snapshot of the first page (locked workspaces) and whether a later page came from another one.</summary>
    private DateTimeOffset? _dataAsOf;
    private bool _snapshotMoved;

    /// <summary>Set first thing in <see cref="DisposeAsync"/>: a start still awaiting must not report its status.</summary>
    private bool _disposed;

    protected override void OnInitialized() => _grid = new GridBridge(JS, _id, DotNetObjectReference.Create(this));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Replaced while grid.js loaded: the query need not run at all.
        if (firstRender && await _grid.LoadAsync())
        {
            await StartAsync();
        }
    }

    /// <summary>Runs the query: the first page gives the columns, then the grid is (re)built and fetches the rest itself.</summary>
    private async Task StartAsync()
    {
        _blocks.Clear();
        _rowsLoaded = 0;
        _allLoaded = false;
        await Status(new SqlGridStatus(true, 0, false, null, null, null));
        if (FirstPage is { } preloaded)
        {
            _firstPage = preloaded;
        }
        else
        {
            var query = Query;
            var result = await Shell.RunDbAsync(Logger, Active, async () =>
                await Workspaces.ReadSqlAsync(WorkspaceId, query, 0, PageSize, CancellationToken.None));
            if (result.Value is not { } first)
            {
                await Status(new SqlGridStatus(false, 0, false, null, null, result.Error));
                return;
            }

            _firstPage = first;
        }

        _columns = _firstPage.Columns;
        _presentation = SqlResultPresentation.Plain(_columns);
        var traced = TraceAsync(Query.Sql, _columns);
        await Task.WhenAny(traced, Task.Delay(SourcesWait));
        if (traced.IsCompletedSuccessfully)
        {
            _presentation = traced.Result;
        }

        // The result is shown whatever becomes of the tracing; a failure that is a bug reaches the error boundary afterwards.
        await _grid.CreateAsync(_presentation.Columns(), new GridOptions([], 0, Editable: false, _presentation.HeaderHeight, Table: false));
        if (!traced.IsCompletedSuccessfully)
        {
            Fire(() => RelabelAsync(traced));
        }
    }

    /// <summary>
    /// The result columns traced back to table columns (WP-48): C# names, enum members, FK badges and jumps. Plain if there
    /// is nothing to trace or the tables cannot be read (logged, and a lost connection reported, by <see cref="DbCalls"/>).
    /// </summary>
    private async Task<SqlResultPresentation> TraceAsync(string sql, IReadOnlyList<SqlColumn> columns)
    {
        if (Active.Schema is not { } schema || columns.All(c => c.Origin is null))
        {
            return SqlResultPresentation.Plain(columns);
        }

        var token = _cts.Token;
        var result = await Shell.RunDbAsync(Logger, Active, () => SqlResultSources.LoadAsync(sql, columns, schema, token), token);
        return result.Value is { } sources
            ? new SqlResultPresentation(columns, sources, Presentations.For, schema.OutgoingOf)
            : SqlResultPresentation.Plain(columns);
    }

    /// <summary>The tables came after the grid was built: relabel the columns and redraw the loaded rows in place.</summary>
    private async Task RelabelAsync(Task<SqlResultPresentation> traced)
    {
        var presentation = await traced;
        if (_disposed || presentation.Sources.Sources.Count == 0)
        {
            return;
        }

        _presentation = presentation;
        if (await _grid.CallAsync("updateColumns", presentation.Columns(), presentation.HeaderHeight))
        {
            await _grid.CallAsync("updateRows", _blocks.All().Select(r => new GridRowUpdate(r.Index, presentation.Row(r.Row.Values))).ToList());
        }
    }

    /// <summary>A grid already replaced reports nothing: its status would overwrite the one of the grid shown now.</summary>
    private Task Status(SqlGridStatus status) => _disposed ? Task.CompletedTask : OnStatus.InvokeAsync(status);

    /// <summary>Review 3.40.0, A29: a failure of the presentation went back to grid.js – an empty grid, nothing in the log.</summary>
    [JSInvokable]
    public Task<GridPage> GetRows(int startRow, int endRow, GridSort[] sortModel) =>
        GuardAsync(() => GetRowsCoreAsync(startRow, endRow), GridPage.Failure);

    private async Task<GridPage> GetRowsCoreAsync(int startRow, int endRow)
    {
        SqlPage page;
        if (startRow == 0 && _firstPage is { } first)
        {
            page = first;
            _firstPage = null;
        }
        else
        {
            var query = Query;
            var result = await Shell.RunDbAsync(Logger, Active, async () =>
                await Workspaces.ReadSqlAsync(WorkspaceId, query, startRow, endRow - startRow, CancellationToken.None));
            if (result.Value is not { } read)
            {
                await Status(new SqlGridStatus(false, _rowsLoaded, false, null, null, result.Error));
                return GridPage.Failure;
            }

            page = read;
        }

        _blocks.Keep(startRow, page.Rows.Select(values => new RowData(RowKey.None.Instance, values)).ToList());
        _rowsLoaded = Math.Max(_rowsLoaded, startRow + page.Rows.Count);
        _allLoaded |= page.IsLastPage;
        (_dataAsOf, _snapshotMoved) = Snapshots.Next(startRow, _dataAsOf, _snapshotMoved, page.DataAsOf);
        await Status(new SqlGridStatus(false, _rowsLoaded, page.IsLastPage, page.Elapsed, _dataAsOf, null, _snapshotMoved));
        var presentation = _presentation;
        var rows = page.Rows.Select(presentation.Row).ToList();
        return new GridPage(rows, page.IsLastPage ? startRow + page.Rows.Count : -1);
    }

    /// <summary>
    /// Ctrl+C: the focused cell, or the selected rows as a table (tab-separated, with a header line) – with the same notes as
    /// in a table's grid (review 3.31.0, A20: a CLOB of which only the preview was loaded was copied without a word).
    /// </summary>
    [JSInvokable]
    public Task OnCopy(int rowIndex, string colId, int[] selectedRows) => GuardAsync(async () =>
    {
        if (selectedRows.Length > 1)
        {
            await ExportActions.CopyRowsAsync(Shell, _grid, AsTable(), selectedRows.Order().Select(_blocks.At).ToList());
        }
        else if (_blocks.At(rowIndex) is { } row)
        {
            var column = GridColumn.IndexOf(colId);
            await ExportActions.CopyCellAsync(Shell, _grid, _columns[column].Column, row.Values[column]);
        }
    });

    /// <summary>All rows of the query, run again in the workspace's session (WP-54).</summary>
    private AllRowsExport AllRowsOf() =>
        AllRowsExports.ForResult(Query, _columns, _allLoaded ? _rowsLoaded : null, _presentation.ExportColumns(), WorkspaceId, Workspaces.GetDataAsync);

    /// <summary>The result as a table for the export helpers (columns only; it has no key).</summary>
    private TableDetails AsTable() => new(new TableSummary("", ExportName, TableKind.View), _columns.Select(c => c.Column).ToList(), [], [], false);

    /// <summary>Right click: the export menu for the clicked row, or for the selection if the row is part of it.</summary>
    [JSInvokable]
    public Task OnCellContextMenu(int rowIndex, string colId, int[] selectedRows, double x, double y, double viewportWidth, double viewportHeight) =>
        GuardAsync(() => OnCellContextMenuCoreAsync(rowIndex, colId, selectedRows, x, y, viewportWidth, viewportHeight));

    private Task OnCellContextMenuCoreAsync(int rowIndex, string colId, int[] selectedRows, double x, double y, double viewportWidth, double viewportHeight)
    {
        if (_blocks.At(rowIndex) is not { } row)
        {
            return Task.CompletedTask;
        }

        var column = GridColumn.IndexOf(colId);
        var indexes = selectedRows.Contains(rowIndex) ? selectedRows.Order().ToArray() : [rowIndex];
        var selected = indexes.Select(_blocks.At).OfType<RowData>().ToList();
        _menu = new GridContextMenuRequest(row, column, _presentation.Present(column, row.Values[column]).Text,
            selected, indexes.Length - selected.Count, x, y, viewportWidth, viewportHeight);
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await _cts.CancelAsync();
        _cts.Dispose();
        await _grid.DisposeAsync();
    }
}
