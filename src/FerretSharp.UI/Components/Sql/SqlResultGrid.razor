@* Result of a query FerretSharp did not build (LINQ console, ADR 0011; SQL editor, WP-17): read in the workspace's session page by page,
   shown with the same grid bridge as tables – read-only, in the query's own order until a header sorts it (in memory once
   every row is loaded, else by the database: ResultOrder). Beside it the form of the focused row, and the selected rows side
   by side (WP-56), both read-only. In the SQL editor a column header menu copies all values of the column (WP-57). Marked
   cells – and in the SQL editor whole columns – are copied as text (WP-58). *@
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Data
@using FerretSharp.Core.Forms
@using FerretSharp.Core.Query
@using FerretSharp.Core.Schema
@inherits FerretComponent
@implements IAsyncDisposable
@implements IFormGrid
@implements ISelectionGrid
@inject IJSRuntime JS
@inject ILogger<SqlResultGrid> Logger
@inject IClipboardService Clipboard

<div class="grid-split result-split">
    <div class="grid-host">
        <div id="@_id" class="ag-host"></div>
    </div>
    @if (FormTab is { FormOpen: true } formTab)
    {
        <ResultFormPanel @ref="_form" Tab="formTab" Grid="this" WorkspaceId="WorkspaceId" OnClose="CloseFormAsync" />
    }
</div>

@if (_menu is { } menu)
{
    <ResultMenu Request="menu" Result="AsTable()" Sources="_presentation.Sources" ExportColumns="_presentation.ExportColumns()" WorkspaceId="WorkspaceId" InsertTarget="InsertTarget"
                ExportName="@ExportName" AllRows="@(ExportsAllRows ? AllRowsOf() : null)" OnClose="() => _menu = null"
                OffersForm="@(FormTab is not null)" OnOpenForm="() => OpenFormAsync(menu.RowIndex, menu.Column)" OnCompare="Compare" />
}

@if (_columnMenu is { } columnMenu && columnMenu.Column < _columns.Count)
{
    <ResultColumnMenu @key="columnMenu" Request="columnMenu" Column="_columns[columnMenu.Column].Column" Presented="PresentedColumn(columnMenu.Column)"
                      All="@AllValuesOf([columnMenu.Column])" OnClose="() => _columnMenu = null"
                      OnMarkColumn="() => MarkColumnAsync(columnMenu.Column)" />
}

@if (_compare is { } compare)
{
    <RowCompareDialog Title="@ExportName" Presentation="_presentation" Order="@(Enumerable.Range(0, _columns.Count).ToList())" Rows="compare.Rows" Missing="compare.Missing" Note="@GridText.Compare_FooterNoteResult"
                      OnClose="() => _compare = null" OnShow="ShowComparedRowAsync" />
}

@code {
    [CascadingParameter]
    public WorkspaceManager Workspaces { get; set; } = null!;

    [CascadingParameter]
    public ActiveConnection Active { get; set; } = null!;

    [CascadingParameter]
    public PresentationService Presentations { get; set; } = null!;

    /// <summary>
    /// How long the grid waits for the tables behind the result columns (WP-48) before it shows the plain result; known
    /// structures come from the schema cache at once. Later they relabel the columns in place.
    /// </summary>
    private static readonly TimeSpan SourcesWait = TimeSpan.FromMilliseconds(300);

    private readonly CancellationTokenSource _cts = new();
    private SqlResultPresentation _presentation = SqlResultPresentation.Plain([]);

    /// <summary>Rows per block (BLOCK_SIZE in grid.js); a preloaded first page must have this size.</summary>
    public const int PageSize = 500;

    private readonly string _id = "sqlgrid-" + Guid.NewGuid().ToString("N");
    private readonly RowBlocks _blocks = new();
    private GridBridge _grid = null!;
    private IReadOnlyList<SqlColumn> _columns = [];
    private SqlPage? _firstPage;

    /// <summary>The order the headers ask for, and whether the rows for it are known in memory.</summary>
    private ResultOrder _order = new(new QuerySpec("", []), []);

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [Parameter, EditorRequired]
    public Guid WorkspaceId { get; set; }

    /// <summary>The query; a new instance runs it again.</summary>
    [Parameter, EditorRequired]
    public QuerySpec Query { get; set; } = null!;

    /// <summary>After every page or failure.</summary>
    [Parameter]
    public EventCallback<SqlGridStatus> OnStatus { get; set; }

    /// <summary>
    /// The first <see cref="PageSize"/> rows, already read (SQL editor: when the statement ran); null = read them here.
    /// Later pages are read when scrolled to.
    /// </summary>
    [Parameter]
    public SqlPage? FirstPage { get; set; }

    /// <summary>The single table the query reads: target of "Copy as INSERT" (WP-17); null disables it.</summary>
    [Parameter]
    public TableSummary? InsertTarget { get; set; }

    /// <summary>File name offered when saving the result (CSV, Excel), also the title of the row comparison.</summary>
    [Parameter]
    public string ExportName { get; set; } = SqlEditorText.Result_DefaultExportName;

    /// <summary>
    /// The menu offers to export all rows, running the query again (SQL editor, WP-54) – not for the LINQ console, whose
    /// queries come from the user's code.
    /// </summary>
    [Parameter]
    public bool ExportsAllRows { get; set; }

    /// <summary>The tab whose form shows the focused row (WP-56); null offers no form (the comparison still works).</summary>
    [Parameter]
    public IFormTab? FormTab { get; set; }

    /// <summary>The form was opened or closed here (Alt+Enter, menu, ✕): the view's switch shows it.</summary>
    [Parameter]
    public EventCallback OnFormChanged { get; set; }

    private GridContextMenuRequest? _menu;
    private ColumnMenuRequest? _columnMenu;
    private ResultFormPanel? _form;

    /// <summary>Ctrl+F: the form's field search if the focus is in the form; false otherwise (the editor searches).</summary>
    public Task<bool> FindInFormAsync() => _form?.FindInFormAsync() ?? Task.FromResult(false);
    private RowCompareRequest? _compare;

    /// <summary>The cell with the focus (click, arrow keys, the form's ▲ ▼); null before any.</summary>
    public GridCell? Focused { get; private set; }

    /// <summary>The focused cell moved: the form follows.</summary>
    public event Action? FocusChanged;

    /// <summary>Rows were loaded or the columns relabelled: the form may show its row now.</summary>
    public event Action? RowsChanged;

    /// <summary>How the result is shown (also in the form and the comparison).</summary>
    public SqlResultPresentation Presentation => _presentation;

    /// <summary>Rows read so far; with <see cref="AllLoaded"/> the result's size.</summary>
    public int RowsLoaded => _rowsLoaded;

    public bool AllLoaded => _allLoaded;

    private int _rowsLoaded;

    /// <summary>The last page was read: <see cref="_rowsLoaded"/> is the result's size.</summary>
    private bool _allLoaded;

    /// <summary>Snapshot of the first page (locked workspaces) and whether a later page came from another one.</summary>
    private DateTimeOffset? _dataAsOf;
    private bool _snapshotMoved;

    /// <summary>Set first thing in <see cref="DisposeAsync"/>: a start still awaiting must not report its status.</summary>
    private bool _disposed;

    /// <summary>Type and NOT NULL as the grid's headers show them (<see cref="PresentationService.Header"/> when built).</summary>
    private ColumnHeaderLines _header = ColumnHeaderLines.All;

    protected override void OnInitialized()
    {
        _grid = new GridBridge(JS, _id, DotNetObjectReference.Create(this));
        Presentations.HeaderChanged += OnHeaderChanged;
    }

    /// <summary>
    /// Type or NOT NULL in the headers switched on or off: relabel in place, the rows read as before. Not before the grid is
    /// created – <see cref="StartAsync"/> catches up afterwards, with the lines it was built with still in <see cref="_header"/>.
    /// </summary>
    private void OnHeaderChanged() => Fire(async () =>
    {
        var header = Presentations.Header;
        if (_disposed || !_grid.IsCreated || header == _header)
        {
            return;
        }

        _header = header;
        await _grid.CallAsync("updateColumns", GridColumns(_presentation), _presentation.HeaderHeight(header), true);
    });

    /// <summary>The columns for grid.js, with the headers that sort now.</summary>
    private IReadOnlyList<GridColumn> GridColumns(SqlResultPresentation presentation) => presentation.Columns(_header, _order);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Replaced while grid.js loaded: the query need not run at all.
        if (firstRender && await _grid.LoadAsync())
        {
            await StartAsync();
        }
    }

    /// <summary>Runs the query: the first page gives the columns, then the grid is (re)built and fetches the rest itself.</summary>
    private async Task StartAsync()
    {
        // A menu still open belongs to the result before: its row and column indexes would point into the new one.
        _menu = null;
        _columnMenu = null;
        _blocks.Clear();
        _rowsLoaded = 0;
        _allLoaded = false;
        await Status(new SqlGridStatus(true, 0, false, null, null, null));
        if (FirstPage is { } preloaded)
        {
            _firstPage = preloaded;
        }
        else
        {
            var query = Query;
            var result = await Shell.RunDbAsync(Logger, Active, async () =>
                await Workspaces.ReadSqlAsync(WorkspaceId, query, 0, PageSize, CancellationToken.None));
            if (result.Value is not { } first)
            {
                await Status(new SqlGridStatus(false, 0, false, null, null, result.Error));
                return;
            }

            _firstPage = first;
        }

        _columns = _firstPage.Columns;
        _order = new ResultOrder(Query, _columns);
        _presentation = SqlResultPresentation.Plain(_columns);
        var traced = TraceAsync(Query.Sql, _columns);
        await Task.WhenAny(traced, Task.Delay(SourcesWait));
        if (traced.IsCompletedSuccessfully)
        {
            _presentation = traced.Result;
        }

        // The result is shown whatever becomes of the tracing; a failure that is a bug reaches the error boundary afterwards.
        _header = Presentations.Header;
        await _grid.CreateAsync(GridColumns(_presentation), new GridOptions([], 0, Editable: false, _presentation.HeaderHeight(_header), Table: false) { Form = true, HeaderMenu = ExportsAllRows });
        OnHeaderChanged(); // header lines that came while the grid was created (R4a)
        if (!traced.IsCompletedSuccessfully)
        {
            Fire(() => RelabelAsync(traced));
        }
    }

    /// <summary>
    /// The result columns traced back to table columns (WP-48): C# names, enum members, FK badges and jumps. Plain if there
    /// is nothing to trace or the tables cannot be read (logged, and a lost connection reported, by <see cref="DbCalls"/>).
    /// </summary>
    private async Task<SqlResultPresentation> TraceAsync(string sql, IReadOnlyList<SqlColumn> columns)
    {
        if (Active.Schema is not { } schema || columns.All(c => c.Origin is null))
        {
            return SqlResultPresentation.Plain(columns);
        }

        var token = _cts.Token;
        var result = await Shell.RunDbAsync(Logger, Active, () => SqlResultSources.LoadAsync(sql, columns, schema, token), token);
        return result.Value is { } sources
            ? new SqlResultPresentation(columns, sources, Presentations.For, schema.OutgoingOf)
            : SqlResultPresentation.Plain(columns);
    }

    /// <summary>The tables came after the grid was built: relabel the columns and redraw the loaded rows in place.</summary>
    private async Task RelabelAsync(Task<SqlResultPresentation> traced)
    {
        var presentation = await traced;
        if (_disposed || presentation.Sources.Sources.Count == 0)
        {
            return;
        }

        _presentation = presentation;
        if (await _grid.CallAsync("updateColumns", GridColumns(presentation), presentation.HeaderHeight(_header)))
        {
            await _grid.CallAsync("updateRows", _blocks.All().Select(r => new GridRowUpdate(r.Index, presentation.Row(r.Row.Values))).ToList());
        }

        RowsChanged?.Invoke();
    }

    /// <summary>A grid already replaced reports nothing: its status would overwrite the one of the grid shown now.</summary>
    private Task Status(SqlGridStatus status) => _disposed ? Task.CompletedTask : OnStatus.InvokeAsync(status);

    /// <summary>Review 3.40.0, A29: a failure of the presentation went back to grid.js – an empty grid, nothing in the log.</summary>
    [JSInvokable]
    public Task<GridPage> GetRows(int startRow, int endRow, GridSort[] sortModel) =>
        GuardAsync(() => GetRowsCoreAsync(startRow, endRow, ResultOrder.Of(sortModel)), GridPage.Failure);

    private async Task<GridPage> GetRowsCoreAsync(int startRow, int endRow, IReadOnlyList<ResultSort> sorts)
    {
        if (_order.Apply(sorts))
        {
            // Another order: the kept blocks hold other rows at these indexes, and the first page is the query's own.
            _blocks.Clear();
            _firstPage = null;
            _rowsLoaded = 0;
            _allLoaded = false;
        }

        if (_order.Ordered is { } ordered)
        {
            return await FromMemoryAsync(ordered, startRow, endRow);
        }

        SqlPage page;
        if (startRow == 0 && _firstPage is { } first)
        {
            page = first;
            _firstPage = null;
        }
        else
        {
            var query = _order.Query;
            var result = await Shell.RunDbAsync(Logger, Active, async () =>
                await Workspaces.ReadSqlAsync(WorkspaceId, query, startRow, endRow - startRow, CancellationToken.None));
            if (result.Value is not { } read)
            {
                await Status(new SqlGridStatus(false, _rowsLoaded, false, null, null, result.Error));
                return GridPage.Failure;
            }

            page = read;
        }

        _blocks.Keep(startRow, page.Rows.Select(values => new RowData(RowKey.None.Instance, values)).ToList());
        _rowsLoaded = Math.Max(_rowsLoaded, startRow + page.Rows.Count);
        _allLoaded |= page.IsLastPage;
        (_dataAsOf, _snapshotMoved) = Snapshots.Next(startRow, _dataAsOf, _snapshotMoved, page.DataAsOf);
        await Status(new SqlGridStatus(false, _rowsLoaded, page.IsLastPage, page.Elapsed, _dataAsOf, null, _snapshotMoved));
        var presentation = _presentation;
        var rows = page.Rows.Select(presentation.Row).ToList();
        RowsChanged?.Invoke();
        if (_allLoaded && _order.Sorts.Count == 0 && LoadedRows() is { } all && _order.Loaded(all))
        {
            Fire(() => _grid.CallAsync("updateColumns", GridColumns(_presentation), _presentation.HeaderHeight(_header), true));
        }

        return new GridPage(rows, page.IsLastPage ? startRow + page.Rows.Count : -1);
    }

    /// <summary>A block of the rows sorted in memory: no read, the result's size is known (and the snapshot stays).</summary>
    private async Task<GridPage> FromMemoryAsync(IReadOnlyList<RowData> ordered, int startRow, int endRow)
    {
        var block = ordered.Skip(startRow).Take(endRow - startRow).ToList();
        _blocks.Keep(startRow, block);
        _rowsLoaded = ordered.Count;
        _allLoaded = true;
        await Status(new SqlGridStatus(false, _rowsLoaded, true, null, _dataAsOf, null, _snapshotMoved));
        var presentation = _presentation;
        var rows = block.Select(r => presentation.Row(r.Values)).ToList();
        RowsChanged?.Invoke();
        return new GridPage(rows, ordered.Count);
    }

    /// <summary>Every row of the result in grid order if they are all loaded and still kept; null otherwise.</summary>
    private IReadOnlyList<RowData>? LoadedRows()
    {
        if (_order.Ordered is { } ordered)
        {
            return ordered;
        }

        if (!_allLoaded)
        {
            return null;
        }

        var kept = _blocks.All();
        return kept.Count() == _rowsLoaded ? [.. kept.OrderBy(r => r.Index).Select(r => r.Row)] : null;
    }

    /// <summary>
    /// Ctrl+C: the focused cell, or the selected rows as a table (tab-separated, with a header line) – with the same notes as
    /// in a table's grid (review 3.31.0, A20: a CLOB of which only the preview was loaded was copied without a word).
    /// </summary>
    [JSInvokable]
    public Task OnCopy(int rowIndex, string colId, int[] selectedRows) => GuardAsync(async () =>
    {
        if (selectedRows.Length > 1)
        {
            await ExportActions.CopyRowsAsync(Shell, _grid, AsTable(), selectedRows.Order().Select(_blocks.At).ToList());
        }
        else if (_blocks.At(rowIndex) is { } row)
        {
            var column = GridColumn.IndexOf(colId);
            await ExportActions.CopyCellAsync(Shell, _grid, _columns[column].Column, row.Values[column]);
        }
    });

    /// <summary>The shortcut for the values of a column (WP-57): the focused cell's column from the selected rows, else its row.</summary>
    [JSInvokable]
    public Task OnCopyColumn(int rowIndex, string colId, int[] selectedRows) => GuardAsync(async () =>
    {
        var column = GridColumn.IndexOf(colId);
        if (column >= _columns.Count || !ColumnValues.CanCopy(_columns[column].Column))
        {
            return;
        }

        var rows = (selectedRows.Length > 0 ? selectedRows.Order().ToArray() : [rowIndex]).Select(_blocks.At).ToList();
        await ColumnValueCopies.CopyRowsAsync(Shell, text => _grid.CopyTextAsync(Shell, text), PresentedColumn(column), _columns[column].Name,
            ColumnValuesFormat.Lines, rows.OfType<RowData>().ToList(), rows.Count(r => r is null));
    });

    /// <summary>Right click on a column header (SQL editor only, <see cref="ExportsAllRows"/>): copy all its values.</summary>
    /// <param name="marks">What is marked (grid.js sends it for a table's menu, WP-61); a result's menu has no use for it.</param>
    [JSInvokable]
    public Task OnHeaderContextMenu(string colId, double x, double y, double viewportWidth, double viewportHeight, GridMarks? marks) => GuardAsync(() =>
    {
        _columnMenu = new ColumnMenuRequest(GridColumn.IndexOf(colId), x, y, viewportWidth, viewportHeight);
        return InvokeAsync(StateHasChanged);
    });

    /// <summary>
    /// All values of result columns: from the loaded rows if every row is loaded and still kept (WP-58), else the query runs
    /// again (WP-57) – in the order the headers sort.
    /// </summary>
    private AllColumnValues AllValuesOf(IReadOnlyList<int> columns) => LoadedRows() is { } rows
        ? ColumnValueCopies.ForLoaded(rows, columns, WorkspaceId)
        : ColumnValueCopies.ForResult(_order.Query, _columns, columns, _allLoaded ? _rowsLoaded : null, WorkspaceId, Workspaces.GetDataAsync);

    /// <summary>A column as the result presents it; the names of a traced foreign key follow it with the same source.</summary>
    private ExportColumn PresentedColumn(int column) => _presentation.ExportColumns().First(c => c.Source == column);

    /// <summary>All rows of the query, run again in the workspace's session (WP-54), sorted as the headers ask.</summary>
    private AllRowsExport AllRowsOf() =>
        AllRowsExports.ForResult(_order.Query, _columns, _allLoaded ? _rowsLoaded : null, _presentation.ExportColumns(), WorkspaceId, Workspaces.GetDataAsync);

    /// <summary>The result as a table for the export helpers (columns only; it has no key).</summary>
    private TableDetails AsTable() => new(new TableSummary("", ExportName, TableKind.View), _columns.Select(c => c.Column).ToList(), [], [], false);

    /// <summary>
    /// Right click: the export menu for the clicked row, or for the selection if the row is part of it; inside marked cells or
    /// columns (WP-58) with their own group.
    /// </summary>
    [JSInvokable]
    public Task OnCellContextMenu(
        int rowIndex, string colId, int[] selectedRows, GridMarks? marks, double x, double y, double viewportWidth, double viewportHeight) =>
        GuardAsync(() => OnCellContextMenuCoreAsync(rowIndex, colId, selectedRows, marks, x, y, viewportWidth, viewportHeight));

    private Task OnCellContextMenuCoreAsync(
        int rowIndex, string colId, int[] selectedRows, GridMarks? marks, double x, double y, double viewportWidth, double viewportHeight)
    {
        if (_blocks.At(rowIndex) is not { } row)
        {
            return Task.CompletedTask;
        }

        var column = GridColumn.IndexOf(colId);
        var indexes = selectedRows.Contains(rowIndex) ? selectedRows.Order().ToArray() : [rowIndex];
        var selected = indexes.Select(_blocks.At).OfType<RowData>().ToList();
        _menu = new GridContextMenuRequest(row, column, _presentation.Present(column, row.Values[column]).Text,
            selected, indexes.Length - selected.Count, x, y, viewportWidth, viewportHeight, indexes, rowIndex, marks is null ? null : MenuOf(marks));
        return InvokeAsync(StateHasChanged);
    }

    // ---------- marked cells and columns (WP-58) ----------

    /// <summary>What the cell menu offers for marked cells or columns.</summary>
    private MarksMenu MenuOf(GridMarks marks)
    {
        var columns = marks.ColumnIndexes;
        var inList = columns.Count != 1 ? GridText.GridMenu_CopyInListOneColumn
            : ColumnValues.CanCopy(_columns[columns[0]].Column) ? null : GridText.GridMenu_CopyColumnUnavailable;
        return new MarksMenu(marks, kind => CopyMarksAsync(marks, kind), inList, marks.Whole ? AllValuesOf(columns).Tooltip : null);
    }

    /// <summary>
    /// The grid's side of copying marked cells: columns as presented, the loaded rows, rows not loaded read by running the
    /// query for them like a block; whole columns only in the SQL editor (<see cref="ExportsAllRows"/>). A result has no
    /// pending changes.
    /// </summary>
    private MarkedCells Marked => new(
        PresentedColumn,
        _blocks.At,
        ReadRowsAsync,
        ExportsAllRows ? AllValuesOf : null,
        _ => 0);

    /// <summary>
    /// Rows of a marked range that are not loaded: from the rows sorted in memory, else the query read for them like a
    /// block; null if it failed or was cancelled (review 3.54.0, A5).
    /// </summary>
    private async Task<IReadOnlyList<RowData>?> ReadRowsAsync(int start, int count, CancellationToken cancellationToken)
    {
        if (_order.Ordered is { } ordered)
        {
            return ordered.Skip(start).Take(count).ToList();
        }

        var query = _order.Query;
        var result = await Shell.RunDbAsync(Logger, Active, async () =>
            await Workspaces.ReadSqlAsync(WorkspaceId, query, start, count, cancellationToken), cancellationToken);
        return Shell.ShowFailure(result) ? result.Value!.Rows.Select(values => new RowData(RowKey.None.Instance, values)).ToList() : null;
    }

    /// <summary>Marks a whole column (the header menu's "Select column").</summary>
    private Task MarkColumnAsync(int column) => _grid.CallAsync("markColumn", GridColumn.IdOf(column));

    /// <summary>Copies marked cells or columns (Ctrl+C, the cell menu).</summary>
    private Task CopyMarksAsync(GridMarks marks, MarksCopy kind) =>
        CellCopies.CopyAsync(Shell, text => _grid.CopyTextAsync(Shell, text), Clipboard, Logger, Active, Marked, marks, kind);

    /// <summary>Ctrl+C on marked cells or columns (WP-58); <paramref name="header"/> copies them as a table.</summary>
    [JSInvokable]
    public Task OnCopyCells(GridMarks marks, bool header) => GuardAsync(() => CopyMarksAsync(marks, header ? MarksCopy.Table : MarksCopy.Cells));

    /// <summary>The focused cell moved (grid.js reports the last position after a short pause).</summary>
    [JSInvokable]
    public void OnFocused(int rowIndex, string? newId, string? colId) => Guard(() =>
    {
        Focused = rowIndex < 0 ? null : new GridCell(rowIndex, null, colId is not null && colId.StartsWith('c') ? GridColumn.IndexOf(colId) : null);
        FocusChanged?.Invoke();
    });

    public GridSelection Selection { get; private set; } = GridSelection.None;

    public event Action? SelectionChanged;

    /// <summary>
    /// The selection or the marked cells changed (grid.js reports the last state after a short pause); the footer shows it.
    /// </summary>
    [JSInvokable]
    public void OnSelectionChanged(int count, bool toEnd, int markedRows, int markedColumns, bool wholeColumns) => Guard(() =>
    {
        Selection = new GridSelection(count, toEnd, markedRows, markedColumns, wholeColumns);
        SelectionChanged?.Invoke();
    });

    /// <summary>Alt+Enter in the grid: several selected rows are compared, otherwise the form opens or closes (as in a table, WP-21).</summary>
    [JSInvokable]
    public Task OnFormKey(int rowIndex, string? newId, int[] selectedRows) => GuardAsync(async () =>
    {
        if (selectedRows.Length > 1)
        {
            Compare(selectedRows.Order().ToList());
            await InvokeAsync(StateHasChanged);
        }
        else if (FormTab is { FormOpen: true })
        {
            await CloseFormAsync();
        }
        else if (FormTab is { } tab)
        {
            await SetFormOpenAsync(tab, true);
        }
    });

    public FormRow? RowOf(GridCell cell) => cell.IsNew ? null : RowAt(cell.RowIndex);

    public FormRow? RowAt(int rowIndex) => _blocks.At(rowIndex) is { } row ? new FormRow(row, null) : null;

    public int? RowCount => _allLoaded ? _rowsLoaded : null;

    /// <summary>Result rows have no key: the form follows the grid index.</summary>
    public int? IndexOf(RowKey key) => null;

    /// <summary>A result has no new rows.</summary>
    public GridCell? CellOf(RowChange newRow, int? column) => null;

    /// <summary>Moves the grid's focus to a row (the form's ▲ ▼); a block not loaded yet is fetched.</summary>
    public Task FocusRowAsync(GridCell cell, bool keepFocus, bool select = false)
    {
        Focused = cell;
        return _grid.CallAsync("focusRow", cell.RowIndex, cell.Column is { } column ? GridColumn.IdOf(column) : null, false, keepFocus, select);
    }

    /// <summary>The form's copy button: the whole value, with the notes of Ctrl+C.</summary>
    public Task CopyValueAsync(ColumnInfo column, object? value) => ExportActions.CopyCellAsync(Shell, _grid, column, value);

    private async Task SetFormOpenAsync(IFormTab tab, bool open)
    {
        tab.FormOpen = open;
        Shell.MarkDirty();
        await InvokeAsync(StateHasChanged);
        await OnFormChanged.InvokeAsync();
    }

    /// <summary>The context menu or a compared row's heading: the form on that row.</summary>
    private async Task OpenFormAsync(int rowIndex, int? column)
    {
        if (FormTab is not { } tab)
        {
            return;
        }

        if (!tab.FormOpen)
        {
            await SetFormOpenAsync(tab, true);
        }

        await FocusRowAsync(new GridCell(rowIndex, null, column), keepFocus: false, select: true);
    }

    /// <summary>The form's ✕ (or Alt+Enter in it): closed, the keyboard back in the grid.</summary>
    private async Task CloseFormAsync()
    {
        if (FormTab is not { } tab)
        {
            return;
        }

        await SetFormOpenAsync(tab, false);
        await FocusRowAsync(Focused ?? new GridCell(0, null, null), keepFocus: false);
    }

    /// <summary>The selected rows side by side; rows no longer loaded are counted, not compared.</summary>
    private void Compare(IReadOnlyList<int> selected)
    {
        var (request, refusal) = RowCompareRequest.Of(selected, RowAt);
        if (refusal is not null)
        {
            Shell.Notify(refusal);
        }

        _compare = request;
    }

    private Task ShowComparedRowAsync(int rowIndex)
    {
        _compare = null;
        return OpenFormAsync(rowIndex, null);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Presentations.HeaderChanged -= OnHeaderChanged;
        await _cts.CancelAsync();
        _cts.Dispose();
        await _grid.DisposeAsync();
    }
}
