@* Right-click menu of a query result (SQL editor, LINQ console), built like the grid's cell menu (WP-61): the cell as head,
   a quick bar to copy the value and for the form or the comparison of the selected rows (WP-56), a filter field, the group
   of marked cells (WP-58), the export as a matrix – the selected rows or all rows of the query, run again (SQL editor,
   WP-54) – with the clicked column's values as chips, and, for columns traced back to their tables (WP-48), the jumps along
   foreign keys like in a table grid. *@
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Data
@using FerretSharp.Core.Forms
@using FerretSharp.Core.Query
@using FerretSharp.Core.Schema
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IFileSaveService Files
@inject ShortcutService Shortcuts
@inject ILogger<ResultMenu> Logger

<PopoverMenu X="Request.X" Y="Request.Y" ViewportWidth="Request.ViewportWidth" ViewportHeight="Request.ViewportHeight"
             Width="MenuWidth" EstimatedHeight="EstimatedHeight" KeyNavigation="true" OnClose="CloseAsync">
    <CascadingValue Value="_filter">
        <div class="ctx-head">
            <span class="ctx-col">@Column.Name</span>
            <span class="ctx-value @(Request.CellText is null ? "fs-null" : "")">@(Request.CellText ?? "NULL")</span>
        </div>
        <QuickBar>
            <QuickAction Icon="Icons.Copy" Label="@CommonText.CopyValue" Unavailable="@(Request.CellText is null ? GridText.Quick_ValueIsNull : null)"
                         OnClick="() => Export.CopyValueAsync(Column, Request.Row.Values[Request.Column])" />
            <FormQuickAction Count="Request.Selected.Count" Indexes="Request.SelectedIndexes" OffersForm="OffersForm" Close="CloseAsync" OnOpenForm="OnOpenForm" OnCompare="OnCompare" />
        </QuickBar>
        <SearchBox Class="popover-search ctx-filter" Value="@_filter.Text" ValueChanged="text => _filter.Set(text)" Placeholder="@GridText.Menu_FilterPlaceholder" />

        <div class="ctx-body" data-empty="@GridText.Menu_NoMatch">
            @if (Request.Marks is { } marks)
            {
                <MarkedCellsMenuItems Menu="marks" OnClose="CloseAsync" />
            }
            <ExportMatrix Export="Export" Table="Result" Rows="Request.Selected" FileName="@ExportName" XlsxColumns="XlsxColumns" Marked="@(Request.Marks is not null)"
                          InsertTable="@(InsertTarget is { } target ? Result with { Table = target } : null)"
                          InsertTitle="@(InsertTarget is { } insert
                              ? TextFormat.Format(SqlEditorText.ResultMenu_CopyInsertTitle, insert.DisplayName)
                              : SqlEditorText.ResultMenu_CopyInsertUnavailable)"
                          AllRows="AllRows" Column="@XlsxColumns.First(c => c.Source == Request.Column)" />

            <FkJumpSection Outgoing="_jumps.Outgoing" Incoming="_jumps.Incoming" Related="Related" RowsText="@Request.JumpRowsText" MissingRows="Request.MissingRows"
                           WorkspaceId="WorkspaceId" OnJumped="CloseAsync" />
        </div>
    </CascadingValue>
</PopoverMenu>

@code {
    [CascadingParameter]
    public ActiveConnection Active { get; set; } = null!;

    private const double MenuWidth = 400;
    private const double LineHeight = 32;

    private readonly MenuFilter _filter = new();
    private FkJumpLists _jumps = FkJumpLists.None;

    /// <summary>The result's view of each jump: which row sources it starts from (for <see cref="Related"/>).</summary>
    private Dictionary<FkJump, SqlResultJump> _sources = new(ReferenceEqualityComparer.Instance);
    private DomModule? _dom;
    private ExportActions? _export;

    /// <summary>dom.js for the clipboard, imported on first use (<see cref="DomModule"/>).</summary>
    private DomModule Dom => _dom ??= new(JS);

    private ExportActions Export => _export ??= new(Shell, Dom, Files, Request.MissingRows, CloseAsync, Logger, Active);

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [Parameter, EditorRequired]
    public GridContextMenuRequest Request { get; set; } = null!;

    /// <summary>The result's columns as a table (for the export helpers).</summary>
    [Parameter, EditorRequired]
    public TableDetails Result { get; set; } = null!;

    /// <summary>The tables behind the result columns (WP-48); <see cref="SqlResultSources.None"/> offers no jumps.</summary>
    [Parameter]
    public SqlResultSources Sources { get; set; } = SqlResultSources.None;

    /// <summary>The workspace the result was read in: incoming jumps are counted there.</summary>
    [Parameter, EditorRequired]
    public Guid WorkspaceId { get; set; }

    /// <summary>The table the query reads, as target of "Copy as INSERT"; null if it reads several or none.</summary>
    [Parameter]
    public TableSummary? InsertTarget { get; set; }

    /// <summary>The columns of the Excel export as the result presents them (WP-53); null exports them as the driver reports them.</summary>
    [Parameter]
    public IReadOnlyList<ExportColumn>? ExportColumns { get; set; }

    /// <summary>File name (without extension) offered for CSV and Excel.</summary>
    [Parameter]
    public string ExportName { get; set; } = SqlEditorText.Result_DefaultExportName;

    /// <summary>All rows of the query, run again (SQL editor, WP-54); null offers no such entries.</summary>
    [Parameter]
    public AllRowsExport? AllRows { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>The result has a form beside it (WP-56): "Als Formular" for a single row.</summary>
    [Parameter]
    public bool OffersForm { get; set; }

    /// <summary>Shows the clicked row in the form beside the result.</summary>
    [Parameter]
    public EventCallback OnOpenForm { get; set; }

    /// <summary>Compares the selected rows (grid indexes) side by side.</summary>
    [Parameter]
    public EventCallback<IReadOnlyList<int>> OnCompare { get; set; }


    private ColumnInfo Column => Result.Columns[Request.Column];

    /// <summary>For the first placement; dom.js menuKeys corrects it once rendered, and whenever the menu grows.</summary>
    private double EstimatedHeight => 170 + LineHeight * (ExportMatrix.Lines(XlsxColumns, 0) + (Request.Marks is null ? 0 : MarkedCellsMenuItems.Entries)
                                                          + _jumps.Headings + Math.Min(_jumps.Count, 2 * FkJumpLists.ShownIncoming));

    protected override void OnInitialized()
    {
        if (Active.Schema is not { } schema || Sources.Sources.Count == 0)
        {
            return;
        }

        var jumps = Sources.JumpsFor(Request.JumpRows, schema.OutgoingOf, schema.IncomingOf, schema.InheritedIncomingOf);
        _sources = jumps.ToDictionary<SqlResultJump, FkJump>(j => j.Jump, ReferenceEqualityComparer.Instance);
        _jumps = FkJumpLists.Of(jumps.Select(j => j.Jump), Related);
    }

    private bool Related(FkJump jump) => _sources.TryGetValue(jump, out var source) && source.Involves(Request.Column);

    /// <summary>The result's columns as presented; a column traced to a foreign key is followed by its names (same <see cref="ExportColumn.Source"/>).</summary>
    private IReadOnlyList<ExportColumn> XlsxColumns => ExportColumns ?? ExportColumn.Raw(Result);

    private Task CloseAsync() => OnClose.InvokeAsync();

    public ValueTask DisposeAsync() => Dom.DisposeAsync();
}
