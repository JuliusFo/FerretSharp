@* Right-click menu of a query result (SQL editor, LINQ console): copy the value, export the selected rows. *@
@using FerretSharp.Core.Data
@using FerretSharp.Core.Query
@using FerretSharp.Core.Schema
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IFileSaveService Files

<PopoverMenu X="Request.X" Y="Request.Y" ViewportWidth="Request.ViewportWidth" ViewportHeight="Request.ViewportHeight" OnClose="CloseAsync">
    <div class="ctx-head">
        <span class="ctx-col">@Column.Name</span>
        <span class="ctx-value @(Request.CellText is null ? "fs-null" : "")">@(Request.CellText ?? "NULL")</span>
    </div>
    <button class="menu-item" disabled="@(Request.CellText is null)" @onclick="() => Export.CopyValueAsync(Column, Request.Row.Values[Request.Column])">@CommonText.CopyValue</button>

    <div class="group-head-btn static">@TextFormat.Format(SqlEditorText.ResultMenu_ExportHead, ExportActions.RowsText(Request.Selected.Count))</div>
    <button class="menu-item" title="@SqlEditorText.ResultMenu_CopyTableTitle" @onclick="CopyTableAsync">@SqlEditorText.ResultMenu_CopyTable</button>
    <button class="menu-item" disabled="@(InsertTarget is null)" @onclick="CopyInsertAsync"
            title="@(InsertTarget is { } target
                ? TextFormat.Format(SqlEditorText.ResultMenu_CopyInsertTitle, target.DisplayName)
                : SqlEditorText.ResultMenu_CopyInsertUnavailable)">
        @SqlEditorText.ResultMenu_CopyInsert
    </button>
    <button class="menu-item" title="@SqlEditorText.ResultMenu_SaveCsvTitle" @onclick="SaveCsvAsync">@SqlEditorText.ResultMenu_SaveCsv</button>
</PopoverMenu>

@code {
    private DomModule? _dom;
    private ExportActions? _export;

    /// <summary>dom.js for the clipboard, imported on first use (<see cref="DomModule"/>).</summary>
    private DomModule Dom => _dom ??= new(JS);

    private ExportActions Export => _export ??= new(Shell, Dom, Files, Request.MissingRows, CloseAsync);

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [Parameter, EditorRequired]
    public GridContextMenuRequest Request { get; set; } = null!;

    /// <summary>The result's columns as a table (for the export helpers).</summary>
    [Parameter, EditorRequired]
    public TableDetails Result { get; set; } = null!;

    /// <summary>The table the query reads, as target of "Copy as INSERT"; null if it reads several or none.</summary>
    [Parameter]
    public TableSummary? InsertTarget { get; set; }

    /// <summary>File name (without extension) offered for CSV.</summary>
    [Parameter]
    public string ExportName { get; set; } = SqlEditorText.Result_DefaultExportName;

    [Parameter]
    public EventCallback OnClose { get; set; }

    private ColumnInfo Column => Result.Columns[Request.Column];

    private Task CopyTableAsync() =>
        Export.CopyAsync(DelimitedExport.Build(Result, Request.Selected, DelimitedExport.ClipboardSeparator), SqlEditorText.ResultMenu_CopiedAsTable);

    private Task CopyInsertAsync() => InsertTarget is { } target
        ? Export.CopyAsync(InsertExport.Build(Result with { Table = target }, Request.Selected), SqlEditorText.ResultMenu_CopiedAsInsert)
        : Task.CompletedTask;

    private Task SaveCsvAsync() =>
        Export.SaveAsync(DelimitedExport.Build(Result, Request.Selected, DelimitedExport.CsvSeparator), ExportName + ".csv",
            SqlEditorText.ResultMenu_CsvFilter, utf8Bom: true);

    private Task CloseAsync() => OnClose.InvokeAsync();

    public ValueTask DisposeAsync() => Dom.DisposeAsync();
}
