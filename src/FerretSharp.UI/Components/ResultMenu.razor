@* Right-click menu of a query result (SQL editor, LINQ console): copy the value, export the selected rows. *@
@using FerretSharp.Core.Data
@using FerretSharp.Core.Query
@using FerretSharp.Core.Schema
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IFileSaveService Files

<div class="popover-backdrop" @onclick="CloseAsync" @oncontextmenu="CloseAsync" @oncontextmenu:preventDefault="true"></div>
<div id="@_id" class="popover ctx-menu" style="@Position" tabindex="-1" @onkeydown="OnKeyDown" @oncontextmenu:preventDefault="true">
    <div class="ctx-head">
        <span class="ctx-col">@Column.Name</span>
        <span class="ctx-value @(Request.CellText is null ? "fs-null" : "")">@(Request.CellText ?? "NULL")</span>
    </div>
    <button class="menu-item" disabled="@(Request.CellText is null)" @onclick="CopyValueAsync">Wert kopieren</button>

    <div class="group-head-btn static">Export · @RowsText(Request.Selected.Count)</div>
    <button class="menu-item" title="Tabulator-getrennt mit Kopfzeile – lässt sich direkt in Excel einfügen" @onclick="CopyTableAsync">Als Tabelle kopieren</button>
    <button class="menu-item" disabled="@(InsertTarget is null)" @onclick="CopyInsertAsync"
            title="@(InsertTarget is { } target
                ? $"INSERT INTO {target.DisplayName} mit den Spaltennamen des Ergebnisses als Zielspalten (wird nie ausgeführt)"
                : "Nur wenn die Abfrage genau eine Tabelle liest – sonst ist das Ziel unklar.")">
        Als INSERT kopieren
    </button>
    <button class="menu-item" title="Semikolon-getrennt, UTF-8 – öffnet sich direkt in Excel" @onclick="SaveCsvAsync">Als CSV speichern …</button>
</div>

@code {
    private const double MenuWidth = 320;

    private readonly string _id = "resultmenu-" + Guid.NewGuid().ToString("N");
    private DomModule? _dom;

    /// <summary>dom.js, imported on first use; does nothing once disposed (<see cref="DomModule"/>).</summary>
    private DomModule Dom => _dom ??= new(JS);

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [Parameter, EditorRequired]
    public GridContextMenuRequest Request { get; set; } = null!;

    /// <summary>The result's columns as a table (for the export helpers).</summary>
    [Parameter, EditorRequired]
    public TableDetails Result { get; set; } = null!;

    /// <summary>The table the query reads, as target of "Als INSERT kopieren"; null if it reads several or none.</summary>
    [Parameter]
    public TableSummary? InsertTarget { get; set; }

    /// <summary>File name (without extension) offered for CSV.</summary>
    [Parameter]
    public string ExportName { get; set; } = "Ergebnis";

    [Parameter]
    public EventCallback OnClose { get; set; }

    private ColumnInfo Column => Result.Columns[Request.Column];

    private string Position
    {
        get
        {
            var left = Math.Max(8, Math.Min(Request.X, Request.ViewportWidth - MenuWidth - 8));
            var top = Math.Max(8, Math.Min(Request.Y, Request.ViewportHeight - 230));
            return FormattableString.Invariant($"position: fixed; left: {left:0}px; top: {top:0}px; width: {MenuWidth:0}px;");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Dom.InvokeVoidAsync("focusById", _id); // Escape closes
            await Dom.InvokeVoidAsync("keepInViewport", _id);
        }
    }

    private static string RowsText(int rows) => rows == 1 ? "1 Zeile" : $"{rows:N0} Zeilen";

    private async Task CopyValueAsync()
    {
        var cell = DelimitedExport.CellText(Column, Request.Row.Values[Request.Column]);
        var copied = await Dom.CopyTextAsync(cell.Text);
        var shell = Shell;
        await CloseAsync();
        if (!copied || cell.Warnings.Count > 0)
        {
            shell.Notify(copied ? "Wert nicht vollständig kopiert." : "Die Zwischenablage ist nicht verfügbar.", cell.Warnings);
        }
    }

    private Task CopyTableAsync() =>
        CopyExportAsync(DelimitedExport.Build(Result, Request.Selected, DelimitedExport.ClipboardSeparator), "als Tabelle kopiert");

    private Task CopyInsertAsync() => InsertTarget is { } target
        ? CopyExportAsync(InsertExport.Build(Result with { Table = target }, Request.Selected), "als INSERT kopiert")
        : Task.CompletedTask;

    private async Task CopyExportAsync(ExportText export, string done)
    {
        var copied = await Dom.CopyTextAsync(export.Text);
        var shell = Shell;
        await CloseAsync();
        shell.Notify(copied ? $"{RowsText(export.Rows)} {done}." : "Die Zwischenablage ist nicht verfügbar.", Warnings(export));
    }

    /// <summary>The menu closes first; the native dialog is modal.</summary>
    private async Task SaveCsvAsync()
    {
        var export = DelimitedExport.Build(Result, Request.Selected, DelimitedExport.CsvSeparator);
        var shell = Shell;
        await CloseAsync();
        try
        {
            if (await Files.SaveTextAsync(ExportName + ".csv", "CSV (Semikolon)", export.Text, utf8Bom: true) is { } path)
            {
                shell.Notify($"{RowsText(export.Rows)} gespeichert: {path}", Warnings(export));
            }
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            shell.Notify($"Speichern fehlgeschlagen: {ex.Message}");
        }
    }

    private IReadOnlyList<string> Warnings(ExportText export) => Request.MissingRows == 0
        ? export.Warnings
        : [.. export.Warnings, $"{RowsText(Request.MissingRows)} der Auswahl nicht mehr geladen – nicht exportiert."];

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CloseAsync();
        }
    }

    private Task CloseAsync() => OnClose.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        await Dom.DisposeAsync();
    }
}
