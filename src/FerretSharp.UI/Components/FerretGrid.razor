@using FerretSharp.Core.ClrModel
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Data
@using FerretSharp.Core.Oracle
@using FerretSharp.Core.Query
@using FerretSharp.Core.Schema
@using FerretSharp.UI.State
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ActiveConnection Active
@inject WorkspaceManager Workspaces
@inject PresentationService Presentations
@inject ILogger<FerretGrid> Logger

<div id="@Tab.Id" class="ag-host"></div>

@code {
    private readonly RowBlocks _blocks = new();

    /// <summary>grid.js; does nothing once disposed, so queued change handlers cannot touch the released module.</summary>
    private GridBridge _grid = null!;
    private bool _editable;
    private TablePresentation? _presentation;
    private int _presentationVersion;

    /// <summary>Header height with the line for C# names (WP-12); the theme's 46 px otherwise.</summary>
    private const int ClrHeaderHeight = 62;

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [Parameter, EditorRequired]
    public TableTab Tab { get; set; } = null!;

    [Parameter, EditorRequired]
    public TableDetails Details { get; set; } = null!;

    /// <summary>Raised after every page (or failure), so the tab footer can update.</summary>
    [Parameter]
    public EventCallback OnPageLoaded { get; set; }

    [Parameter]
    public EventCallback<GridContextMenuRequest> OnContextMenu { get; set; }

    [Parameter]
    public EventCallback<ColumnMenuRequest> OnColumnMenu { get; set; }

    /// <summary>Double click (or Enter) on a LOB cell: open the LOB editor.</summary>
    [Parameter]
    public EventCallback<LobRequest> OnLobOpen { get; set; }

    /// <summary>Writing became possible or impossible (workspace unlocked or locked again).</summary>
    [Parameter]
    public EventCallback OnEditableChanged { get; set; }

    private static string ColumnId(int index) => GridColumn.IdOf(index);

    private static int ColumnIndex(string colId) => GridColumn.IndexOf(colId);

    protected override void OnInitialized() => _grid = new GridBridge(JS, Tab.Id, DotNetObjectReference.Create(this));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        Tab.PinnedColumns = ColumnPinning.Normalize(Details, Tab.PinnedColumns); // columns may have been dropped since
        _editable = CanEdit;
        if (_editable)
        {
            Tab.Changes ??= new ChangeTracker(Details);
        }

        Workspaces.Changed += OnWorkspacesChanged;
        Presentations.Changed += OnPresentationChanged;
        _presentationVersion = Presentations.Version;
        _presentation = Presentations.For(Details);
        var columns = ColumnPinning.DisplayOrder(Details, Tab.PinnedColumns).Select(ColumnMeta).ToList();
        var sorts = Tab.Sorts
            .Where(s => IndexOf(s.Column) >= 0)
            .Select(s => new GridSort(ColumnId(IndexOf(s.Column)), s.Descending ? "desc" : "asc"))
            .ToList();

        // Closed while grid.js loaded or the grid was created (closing the tab, switching connections): nothing to show.
        await _grid.CreateAsync(columns, new GridOptions(sorts, Tab.FirstVisibleRow ?? 0, _editable, HeaderHeight, Table: true));
        if (Tab.Changes?.NewRows.Count > 0)
        {
            await SetNewRowsAsync(); // the tab was mounted again (workspace switch) with new rows still unsaved
        }
    }

    /// <summary>How columns and values are shown: plain, or with the C# model (WP-12).</summary>
    public TablePresentation Presentation => _presentation ??= Presentations.For(Details);

    private int? HeaderHeight => Presentation.ShowsClrNames ? ClrHeaderHeight : null;

    /// <summary>What grid.js needs to know about a column (header, editing, member list).</summary>
    private GridColumn ColumnMeta(int i)
    {
        var c = Details.Columns[i];
        var category = ColumnCategories.Of(c);
        var label = Presentation.LabelOf(i);
        var values = Presentation.ValuesOf(i);
        var foreignKeys = Active.Schema?.OutgoingOf(Details.Table.Ref).Where(f => f.FromColumns.Contains(c.Name)).ToList() ?? [];
        var lob = OracleTypeMapper.IsLob(c);
        return new GridColumn(ColumnId(i), c.Name, label.Name, c.DisplayType, category.ToString(), c.Nullable)
        {
            Alternate = label.AlternateName,
            ClrType = label.ClrType,
            ClrLine = Presentation.ShowsClrNames,
            Pk = Details.PrimaryKey.Contains(c.Name),
            Fk = foreignKeys.Any(f => f.Source == FkSource.Declared),
            FkModel = foreignKeys.Any(f => f.Source == FkSource.ClrModel),
            Numeric = category == ColumnCategory.Number && values is null,
            Sortable = ColumnCategories.IsSortable(category),
            Pinned = ColumnPinning.IsPinned(Details, Tab.PinnedColumns, c.Name),
            Comment = c.Comment,
            // LOBs are not edited in the cell: they open the LOB editor (also to read them whole on a locked workspace).
            Editable = !lob && OracleTypeMapper.NotEditableReason(Details, c, newRow: false) is null,
            EditableNew = !lob && OracleTypeMapper.NotEditableReason(Details, c, newRow: true) is null,
            Lob = lob,
            Multiline = category == ColumnCategory.Text && (c.Length ?? 0) > 200,
            Options = values?.Options,
            UnknownText = values?.UnknownText,
        };
    }

    /// <summary>
    /// The C# model was loaded (or unlinked) or the name setting changed: relabel the columns in place and redraw the
    /// rows, whose values may now read differently. Model relationships may add FK badges too.
    /// </summary>
    private void OnPresentationChanged() => _ = InvokeAsync(async () =>
    {
        if (!_grid.IsCreated || Presentations.Version == _presentationVersion)
        {
            return;
        }

        _presentationVersion = Presentations.Version;
        _presentation = Presentations.For(Details);
        if (await _grid.CallAsync("updateColumns", Enumerable.Range(0, Details.Columns.Count).Select(ColumnMeta).ToList(), HeaderHeight))
        {
            await ReloadAsync();
        }
    });

    /// <summary>Fetches the loaded rows again where they are (after writing, commit, rollback) and redraws the new rows.</summary>
    public async Task ReloadAsync()
    {
        if (await _grid.CallAsync("reload"))
        {
            await SetNewRowsAsync();
        }
    }

    /// <summary>Reloads from the first row, e.g. after filters changed.</summary>
    public async Task RefreshAsync()
    {
        Tab.TotalCount = null;
        await _grid.CallAsync("refresh");
    }

    public Task SetRowCountAsync(long count) => _grid.CallAsync("setRowCount", (int)Math.Min(count, int.MaxValue));

    /// <summary>
    /// Editing is possible in workspaces that may write – connections without the read-only lock, or a workspace the
    /// user unlocked (WP-10) – for tables with a row key (v2, WP-09).
    /// </summary>
    public bool CanEdit => Workspaces.IsWritable(Tab.WorkspaceId)
                           && Details.Table.Kind == TableKind.Table
                           && QueryBuilder.RowKeyOf(Details) != RowKeyKind.None;

    /// <summary>Unlocking or locking the workspace switches editing in the grid on or off without reloading it.</summary>
    private void OnWorkspacesChanged() => _ = InvokeAsync(async () =>
    {
        if (!_grid.IsCreated || CanEdit == _editable)
        {
            return;
        }

        _editable = CanEdit;
        if (_editable)
        {
            Tab.Changes ??= new ChangeTracker(Details);
        }
        else if (Tab.Changes is { HasChanges: false })
        {
            Tab.Changes = null; // locked again (after commit or rollback): nothing to keep
        }

        if (await _grid.CallAsync("setEditable", _editable))
        {
            await OnEditableChanged.InvokeAsync();
        }
    });

    /// <summary>A LOB cell to open in the LOB editor: a loaded row (with its grid index) or a new row.</summary>
    public sealed record LobRequest(int RowIndex, RowData? Row, RowChange? NewRow, int Column);

    /// <summary>Double click or Enter on a LOB cell (grid.js).</summary>
    [JSInvokable]
    public async Task OnLobCell(int rowIndex, string? newId, string colId)
    {
        var column = ColumnIndex(colId);
        if (NewRow(newId) is { } added)
        {
            await OnLobOpen.InvokeAsync(new LobRequest(-1, null, added, column));
        }
        else if (_blocks.At(rowIndex) is { } row)
        {
            await OnLobOpen.InvokeAsync(new LobRequest(rowIndex, row, null, column));
        }
    }

    /// <summary>Opens the LOB editor for a cell of a loaded row (context menu).</summary>
    public Task OpenLobAsync(int rowIndex, int column) =>
        _blocks.At(rowIndex) is { } row ? OnLobOpen.InvokeAsync(new LobRequest(rowIndex, row, null, column)) : Task.CompletedTask;

    /// <summary>The LOB editor's result: the whole new value; <paramref name="loaded"/> is what it read from the database.</summary>
    public async Task<string?> SetLobAsync(LobRequest request, object? loaded, object? value)
    {
        if (Tab.Changes is not { } changes)
        {
            return "Diese Tabelle lässt sich hier nicht bearbeiten.";
        }

        EditResult result;
        if (request.NewRow is { } added)
        {
            result = changes.SetContent(added, request.Column, value);
            if (result.IsValid)
            {
                await SetNewRowsAsync();
            }
        }
        else
        {
            result = changes.SetContent(request.Row!, request.Column, loaded, value);
            if (result.IsValid)
            {
                await _grid.CallAsync("updateRows", new[] { new GridRowUpdate(request.RowIndex, GridRow(request.Row!)) });
            }
        }

        ChangesMade();
        return result.Error;
    }

    /// <summary>
    /// A grid row: display texts by column id, with pending/flushed values of the tab's changes laid over the loaded
    /// ones. Extra fields for grid.js: <c>__s</c> stage per column ("p" pending, "f" flushed), <c>__d</c> deleted
    /// ("p"/"f"), <c>__ro</c> columns whose value cannot be edited, <c>__u</c> columns whose value is no member of
    /// their enum (WP-12), <c>__t</c> extra tooltip per column (the C# member behind a display text), <c>__new</c> id
    /// of a new row.
    /// </summary>
    private Dictionary<string, object?> GridRow(RowData row) => GridRow(Tab.Changes?.Find(row.Key), row.Values);

    private Dictionary<string, object?> GridRow(RowChange? change, IReadOnlyList<object?>? values)
    {
        var cells = new Dictionary<string, object?>(Details.Columns.Count + 5);
        var stages = new Dictionary<string, string>();
        var readOnly = new List<string>();
        var unknown = new List<string>();
        Dictionary<string, string>? tooltips = null;
        for (var i = 0; i < Details.Columns.Count; i++)
        {
            var id = ColumnId(i);
            var value = change is not null ? change.ValueOf(i) : values?[i];
            var presented = Presentation.Present(i, value);
            cells[id] = presented.Text;
            if (presented.Unknown)
            {
                unknown.Add(id);
            }

            if (presented.Tooltip is { } tooltip)
            {
                (tooltips ??= [])[id] = tooltip;
            }

            if (change?.StageOf(i) is { } stage)
            {
                stages[id] = stage == ChangeStage.Pending ? "p" : "f";
            }

            if (!OracleTypeMapper.IsEditableValue(value))
            {
                readOnly.Add(id);
            }
        }

        if (stages.Count > 0)
        {
            cells["__s"] = stages;
        }

        if (change?.Deleted is { } deleted)
        {
            cells["__d"] = deleted == ChangeStage.Pending ? "p" : "f";
        }

        if (readOnly.Count > 0)
        {
            cells["__ro"] = readOnly;
        }

        if (unknown.Count > 0)
        {
            cells["__u"] = unknown;
        }

        if (tooltips is not null)
        {
            cells["__t"] = tooltips;
        }

        if (change is { IsNew: true, IsInserted: false })
        {
            cells["__new"] = change.Id.ToString("N");
        }

        return cells;
    }

    private RowChange? NewRow(string? newId) =>
        newId is null ? null : Tab.Changes?.NewRows.FirstOrDefault(r => r.Id.ToString("N") == newId);

    /// <summary>Full value of a cell for the editor (pending value if any); null if it cannot be edited.</summary>
    [JSInvokable]
    public string? GetEditText(int rowIndex, string? newId, string colId)
    {
        var column = ColumnIndex(colId);
        if (NewRow(newId) is { } added)
        {
            return EditText(column, added.ValueOf(column));
        }

        return _blocks.At(rowIndex) is { } row
            ? EditText(column, Tab.Changes?.Find(row.Key)?.ValueOf(column) ?? row.Values[column])
            : null;
    }

    /// <summary>The edit text; for enum and bool columns the member's database value as the member list has it.</summary>
    private string EditText(int column, object? value) =>
        Presentation.ValuesOf(column)?.OptionOf(value) is { } option
            ? option.Value
            : OracleTypeMapper.EditText(Details.Columns[column], value);

    /// <summary>Enter in the editor: the message if the text cannot be taken; the editor then stays open.</summary>
    [JSInvokable]
    public string? ValidateEdit(int rowIndex, string? newId, string colId, string text)
    {
        var column = Details.Columns[ColumnIndex(colId)];
        if (NewRow(newId) is not null)
        {
            // Empty stays allowed while filling a new row (see ChangeTracker.SetValue).
            return string.IsNullOrEmpty(text) ? null : OracleTypeMapper.Parse(column, text).Error;
        }

        return _blocks.At(rowIndex) is null
            ? "Die Zeile ist nicht mehr geladen – bitte neu laden (F5)."
            : OracleTypeMapper.Parse(column, text).Error;
    }

    /// <summary>The user finished editing a cell: check the text in .NET and keep it as a pending change.</summary>
    [JSInvokable]
    public GridEdit OnCellEdit(int rowIndex, string? newId, string colId, string text)
    {
        if (Tab.Changes is not { } changes)
        {
            return new GridEdit(null, "Diese Tabelle lässt sich hier nicht bearbeiten.");
        }

        var column = ColumnIndex(colId);
        EditResult result;
        if (NewRow(newId) is { } added)
        {
            result = changes.SetValue(added, column, text);
            ChangesMade();
            return new GridEdit(result.IsValid ? GridRow(added, null) : null, result.Error);
        }

        if (_blocks.At(rowIndex) is not { } row)
        {
            return new GridEdit(null, "Die Zeile ist nicht mehr geladen – bitte neu laden (F5).");
        }

        result = changes.SetValue(row, column, text);
        ChangesMade();
        return new GridEdit(result.IsValid ? GridRow(row) : null, result.Error);
    }

    /// <summary>Del in the grid: marks the selected loaded rows for deletion; new rows disappear.</summary>
    [JSInvokable]
    public async Task<GridRowUpdate[]> OnDeleteKey(int[] rowIndexes, string[] newIds)
    {
        if (Tab.Changes is not { } changes)
        {
            return [];
        }

        foreach (var added in newIds.Select(NewRow).OfType<RowChange>().ToList())
        {
            changes.Delete(added);
        }

        var updates = new List<GridRowUpdate>();
        foreach (var index in rowIndexes)
        {
            if (_blocks.At(index) is { } row)
            {
                changes.Delete(row);
                updates.Add(new GridRowUpdate(index, GridRow(row)));
            }
        }

        if (newIds.Length > 0)
        {
            await SetNewRowsAsync();
        }

        ChangesMade();
        return updates.ToArray();
    }

    /// <summary>Deletes or reverts rows from the context menu; redraws them.</summary>
    public async Task ChangeRowsAsync(IReadOnlyList<int> rowIndexes, bool delete)
    {
        if (Tab.Changes is not { } changes)
        {
            return;
        }

        var updates = new List<GridRowUpdate>();
        foreach (var index in rowIndexes)
        {
            if (_blocks.At(index) is not { } row)
            {
                continue;
            }

            if (delete)
            {
                changes.Delete(row);
            }
            else
            {
                changes.Revert(row.Key);
            }

            updates.Add(new GridRowUpdate(index, GridRow(row)));
        }

        await _grid.CallAsync("updateRows", updates);
        ChangesMade();
    }

    /// <summary>Adds an empty new row at the top and starts editing its first editable cell.</summary>
    public async Task AddRowAsync()
    {
        if (Tab.Changes is not { } changes || !_grid.IsCreated)
        {
            return;
        }

        changes.AddRow();
        await SetNewRowsAsync();
        var first = ColumnPinning.DisplayOrder(Details, Tab.PinnedColumns)
            .FirstOrDefault(i => OracleTypeMapper.NotEditableReason(Details, Details.Columns[i], newRow: true) is null, -1);
        if (first >= 0)
        {
            await _grid.CallAsync("startEditing", changes.NewRows.Count - 1, ColumnId(first), true);
        }

        ChangesMade();
    }

    /// <summary>The new (not yet inserted) rows, pinned at the top of the grid.</summary>
    public Task SetNewRowsAsync() => _grid.CallAsync("setNewRows", (Tab.Changes?.NewRows ?? []).Select(r => GridRow(r, null)).ToList());

    /// <summary>The changes of the tab changed: the status bar and the tab header show counts.</summary>
    private void ChangesMade() => Shell.NotifyChanged();

    /// <summary>Scrolls the column into view, highlights it briefly and focuses its cell in the first visible row.</summary>
    public Task JumpToColumnAsync(int column) => _grid.CallAsync("jumpToColumn", ColumnId(column));

    public bool IsPinned(int column) => ColumnPinning.IsPinned(Details, Tab.PinnedColumns, Details.Columns[column].Name);

    /// <summary>Pins or releases a column (from the column or cell menu); the primary key stays pinned.</summary>
    public async Task TogglePinAsync(int column)
    {
        Tab.PinnedColumns = ColumnPinning.Toggle(Details, Tab.PinnedColumns, Details.Columns[column].Name);
        Shell.MarkDirty();
        var pinned = ColumnPinning.DisplayOrder(Details, Tab.PinnedColumns)
            .Where(i => IsPinned(i))
            .Select(ColumnId)
            .ToList();
        await _grid.CallAsync("setPinned", pinned);
    }

    /// <summary>The user pinned, released or reordered pinned columns by dragging; <paramref name="colIds"/> in display order.</summary>
    [JSInvokable]
    public void OnPinnedChanged(string[] colIds)
    {
        Tab.PinnedColumns = ColumnPinning.Normalize(Details, colIds.Select(id => Details.Columns[ColumnIndex(id)].Name));
        Shell.MarkDirty();
    }

    [JSInvokable]
    public async Task OnHeaderContextMenu(string colId, double x, double y, double viewportWidth, double viewportHeight) =>
        await OnColumnMenu.InvokeAsync(new ColumnMenuRequest(ColumnIndex(colId), x, y, viewportWidth, viewportHeight));

    [JSInvokable]
    public async Task<GridPage> GetRows(int startRow, int endRow, GridSort[] sortModel)
    {
        Tab.Sorts = sortModel
            .Select(s => new SortSpec(Details.Columns[ColumnIndex(s.ColId)].Name, s.Sort == "desc"))
            .ToList();
        if (startRow == 0)
        {
            Tab.RowsLoaded = 0;
            Tab.AllRowsLoaded = false;
            _blocks.Clear(); // new query: blocks from an older filter or sort order are stale
            Shell.MarkDirty(); // sort order may have changed
        }

        var details = Details;
        var filters = Tab.AppliedFilters;
        var sorts = Tab.Sorts;
        var result = await Shell.RunDbAsync(Logger, Active.Profile, async () =>
        {
            var data = await Workspaces.GetDataAsync(Tab.WorkspaceId, CancellationToken.None);
            return await data.ReadPageAsync(details, filters, sorts, new PageSpec(startRow, endRow - startRow), CancellationToken.None);
        });
        if (result.Value is not { } page)
        {
            // The footer shows why ("Details" only for a statement that ran); grid.js fails the block.
            Tab.Error = result.Error?.Display;
            Tab.Failure = result.IsRefusal ? null : result.Error;
            await OnPageLoaded.InvokeAsync();
            return GridPage.Failure;
        }

        var rows = page.Rows.Select(GridRow).ToList();
        _blocks.Keep(startRow, page.Rows);
        Tab.RowsLoaded = Math.Max(Tab.RowsLoaded, startRow + page.Rows.Count);
        Tab.AllRowsLoaded |= page.IsLastPage;
        Tab.LastQueryTime = page.Elapsed;
        (Tab.DataAsOf, Tab.SnapshotMoved) = Snapshots.Next(startRow, Tab.DataAsOf, Tab.SnapshotMoved, page.DataAsOf);
        Tab.Error = null;
        Tab.Failure = null;
        await OnPageLoaded.InvokeAsync();

        return new GridPage(rows, page.IsLastPage ? startRow + page.Rows.Count : -1);
    }

    /// <summary>
    /// Right-click on a cell; the menu needs the raw row values, not the display text. <paramref name="selectedRows"/>
    /// are the selected row indexes (the clicked row is always among them); rows no longer cached are counted as missing.
    /// </summary>
    [JSInvokable]
    public async Task OnCellContextMenu(
        int rowIndex, string colId, int[] selectedRows, double x, double y, double viewportWidth, double viewportHeight)
    {
        if (_blocks.At(rowIndex) is not { } row || !colId.StartsWith('c'))
        {
            return;
        }

        var selected = selectedRows.Order().Select(_blocks.At).ToList();
        var column = ColumnIndex(colId);
        await OnContextMenu.InvokeAsync(new GridContextMenuRequest(
            row, column, Presentation.Present(column, row.Values[column]).Text,
            selected.OfType<RowData>().ToList(), selected.Count(r => r is null), x, y, viewportWidth, viewportHeight, selectedRows.Order().ToList(), rowIndex));
    }

    /// <summary>
    /// Ctrl+C in the grid: several selected rows are copied as a table (like "Als Tabelle kopieren"), otherwise the
    /// focused cell – always from the raw values, not the display text.
    /// </summary>
    [JSInvokable]
    public async Task OnCopy(int rowIndex, string colId, int[] selectedRows)
    {
        if (selectedRows.Length > 1)
        {
            var selected = selectedRows.Order().Select(_blocks.At).ToList();
            var rows = selected.OfType<RowData>().ToList();
            var table = DelimitedExport.Build(Details, rows, DelimitedExport.ClipboardSeparator);
            var missing = selected.Count - rows.Count;
            IReadOnlyList<string> warnings = missing == 0
                ? table.Warnings
                : [.. table.Warnings, $"{missing} der markierten Zeilen sind nicht mehr geladen – nicht kopiert."];
            if (await CopyTextAsync(table.Text))
            {
                Shell.Notify(rows.Count == 1 ? "1 Zeile als Tabelle kopiert." : $"{rows.Count:N0} Zeilen als Tabelle kopiert.", warnings);
            }

            return;
        }

        if (_blocks.At(rowIndex) is not { } row || !colId.StartsWith('c'))
        {
            return;
        }

        var index = ColumnIndex(colId);
        var cell = DelimitedExport.CellText(Details.Columns[index], row.Values[index]);
        if (await CopyTextAsync(cell.Text) && cell.Warnings.Count > 0)
        {
            Shell.Notify("Wert nicht kopiert.", cell.Warnings);
        }
    }

    private Task<bool> CopyTextAsync(string text) => _grid.CopyTextAsync(Shell, text);

    /// <summary>Remembers the first visible row (rough scroll position), but only rows that were actually loaded.</summary>
    [JSInvokable]
    public void OnScrolled(int firstVisibleRow)
    {
        if (firstVisibleRow < Tab.RowsLoaded)
        {
            Tab.FirstVisibleRow = firstVisibleRow > 0 ? firstVisibleRow : null;
            Shell.MarkDirty();
        }
    }

    private int IndexOf(string column)
    {
        for (var i = 0; i < Details.Columns.Count; i++)
        {
            if (Details.Columns[i].Name == column)
            {
                return i;
            }
        }

        return -1;
    }

    public ValueTask DisposeAsync()
    {
        Workspaces.Changed -= OnWorkspacesChanged;
        Presentations.Changed -= OnPresentationChanged;
        return _grid.DisposeAsync();
    }
}
