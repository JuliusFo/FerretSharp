@* Write, undo/redo, commit and rollback of a workspace's changes (R4b): the same buttons, titles and shortcuts in the status
   bar and the change overview – before, each had its own copy of them. *@
@using FerretSharp.Core.Data
@inject ShortcutService Shortcuts

<span class="status-group">
    <button class="status-btn" title="@TextFormat.Format(ShellText.Status_FlushTitle, Shortcuts.Hint(ShortcutAction.Flush))" disabled="@(Busy || Summary.Pending == 0)"
            @onclick="() => Editing.FlushAsync(Workspace)">@ShellText.Status_Flush</button>
    @if (UndoRedo)
    {
        var redoBlocker = Summary.CanRedo ? Editing.RedoBlocker(Workspace) : null;
        <button class="status-btn" title="@(Summary.Actions is [.., var last] ? TextFormat.Format(ShellText.Status_UndoTitle, last.Display, SourceOf(last)) : ShellText.Status_NothingToUndo)"
                disabled="@(Busy || !Summary.CanUndo)" @onclick="() => Editing.UndoLastAsync(Workspace, Summary.Actions is [.., var newest] ? newest.Id : null)">↶</button>
        <button class="status-btn" title="@(Summary.Undone is [var next, ..] ? redoBlocker ?? TextFormat.Format(ShellText.Status_RedoTitle, next.Display, SourceOf(next)) : ShellText.Status_NothingToRedo)"
                disabled="@(Busy || !Summary.CanRedo || redoBlocker is not null)" @onclick="() => Summary.Undone is [var redo, ..] ? Lifecycle.RequestRedo(Workspace, redo) : Task.CompletedTask">↷</button>
    }
    <button class="status-btn commit" title="@TextFormat.Format(ShellText.Status_CommitTitle, Shortcuts.Hint(ShortcutAction.Commit))" disabled="@Busy"
            @onclick="() => Lifecycle.RequestCommitAsync(Workspace)">Commit</button>
    <button class="status-btn danger" title="@ShellText.DiscardAll" disabled="@Busy" @onclick="() => Lifecycle.RequestRollback(Workspace)">Rollback</button>
</span>

@code {
    [Parameter, EditorRequired]
    public WorkspaceTabs Workspace { get; set; } = null!;

    /// <summary>The workspace's counts, as the caller read them for its own text.</summary>
    [Parameter, EditorRequired]
    public EditSummary Summary { get; set; } = null!;

    /// <summary>A parameter (not only cascaded), so the buttons render again whenever their bar does.</summary>
    [Parameter, EditorRequired]
    public WorkspaceLifecycle Lifecycle { get; set; } = null!;

    /// <summary>↶ and ↷ as well (the status bar; the change overview undoes up to an action itself).</summary>
    [Parameter]
    public bool UndoRedo { get; set; }

    private WorkspaceEditing Editing => Lifecycle.Editing;

    private bool Busy => Editing.IsBusy(Workspace.WorkspaceId);

    private static string SourceOf(WriteAction action) => action.Kind == WriteActionKind.Grid ? "Grid" : "SQL/LINQ";
}
