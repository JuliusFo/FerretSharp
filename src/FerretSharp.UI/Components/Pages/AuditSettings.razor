@* Settings › Audit tables: the template for all connections, one per connection group, and the connections with their own
   (WP-26, WP-51; R6b: a section of its own). *@
@using FerretSharp.Core.Settings
@implements IAsyncDisposable
@inject ConnectionGroups Groups
@inject AppSettingsService Settings
@inject FerretSharp.Core.Audit.AuditTemplateSource AuditTemplates
@inject FerretSharp.Core.Connections.ConnectionManager Connections
@inject IFileOpenService Files
@inject IJSRuntime JS

<section class="settings-section">
    <h2>@SettingsViewText.Settings_Audit</h2>
    <SettingsChoice TValue="bool" Filter="Filter" Key="SettingKey.AuditSyncInDesigner" Label="@SettingsViewText.Settings_AuditSyncInDesigner" Options="SettingsOptions.OnOff"
                    Value="Settings.Current.SyncAuditInDesigner" OnChange="on => UpdateAsync(s => s with { SyncAuditInDesigner = on })">
        <Hint>@SettingsViewText.Settings_AuditSyncInDesignerHint</Hint>
    </SettingsChoice>
    <SettingsChoice TValue="bool" Filter="Filter" Key="SettingKey.AuditCreateTables" Label="@SettingsViewText.Settings_AuditCreateTables" Options="SettingsOptions.OnOff"
                    Value="Settings.Current.CreateAuditTables" OnChange="on => UpdateAsync(s => s with { CreateAuditTables = on })">
        <Hint>@SettingsViewText.Settings_AuditCreateTablesHint</Hint>
    </SettingsChoice>
    <SettingsChoice TValue="bool" Filter="Filter" Key="SettingKey.AuditHighlightChanges" Label="@SettingsViewText.Settings_AuditHighlightChanges" Options="SettingsOptions.OnOff"
                    Value="Settings.Current.HighlightAuditChanges" OnChange="on => UpdateAsync(s => s with { HighlightAuditChanges = on })">
        <Hint>@SettingsViewText.Settings_AuditHighlightChangesHint</Hint>
    </SettingsChoice>
    <div class="settings-row @Filter.HideClass(SettingKey.AuditTemplate)">
        <div class="settings-label">
            <span>@SettingsViewText.Settings_AuditTemplate</span>
            <span class="hint">@SettingsViewText.Settings_AuditTemplateHint</span>
        </div>
        <div class="settings-path">
            <input class="field mono" spellcheck="false" placeholder="@ShellText.AuditTemplate_BuiltIn" value="@_auditPath"
                   @onchange="e => SetAuditTemplateAsync((string?)e.Value)" aria-label="@SettingsViewText.Settings_AuditTemplate" />
            <button class="btn" @onclick="PickAuditTemplateAsync">@CommonText.Choose</button>
            @if (!string.IsNullOrWhiteSpace(_auditPath))
            {
                <button class="btn ghost" title="@SettingsViewText.Settings_AuditTemplateResetTitle" @onclick="() => SetAuditTemplateAsync(null)">@SettingsViewText.Settings_AuditTemplateReset</button>
            }
        </div>
    </div>
    @{ var audit = AuditTemplates.Load(_auditPath); }
    <AuditTemplateCheck Load="audit" Filter="Filter" Key="SettingKey.AuditTemplate" />
    @if (audit.IsDefault)
    {
        <div class="settings-note @Filter.HideClass(SettingKey.AuditTemplate)">
            <button class="link-btn" title="@SettingsViewText.Settings_AuditTemplateCopyTitle" @onclick="CopyDefaultTemplateAsync">@SettingsViewText.Settings_AuditTemplateCopy</button>
        </div>
    }

    @* WP-51: each group of systems its own template; a group without one takes the template above. *@
    <div class="settings-row @Filter.HideClass(SettingKey.AuditTemplateGroups)">
        <div class="settings-label">
            <span>@SettingsViewText.Settings_AuditTemplateGroups</span>
            <span class="hint">@SettingsViewText.Settings_AuditTemplateGroupsHint</span>
        </div>
    </div>
    @{ var groups = AuditGroupTemplates.Of(Connections.Profiles, Settings.Current.AuditTemplateGroups, Groups.Order); }
    @if (groups.Count == 0)
    {
        <div class="settings-note @Filter.HideClass(SettingKey.AuditTemplateGroups)">@SettingsViewText.Settings_AuditTemplateNoGroups</div>
    }
    @foreach (var row in groups)
    {
        var group = row.Group;
        <div class="settings-row settings-subrow @Filter.HideClass(SettingKey.AuditTemplateGroups)" @key="group">
            <div class="settings-label">
                <span>@group</span>
                @if (row.Orphaned)
                {
                    <span class="hint">@SettingsViewText.Settings_AuditTemplateGroupOrphaned</span>
                }
            </div>
            <div class="settings-path">
                <input class="field mono" spellcheck="false" placeholder="@SettingsViewText.Settings_AuditTemplateAsGlobal" value="@row.Path"
                       @onchange="e => SetGroupTemplateAsync(group, (string?)e.Value)" aria-label="@TextFormat.Format(SettingsViewText.Settings_AuditTemplateOfGroup, group)" />
                <button class="btn" @onclick="() => PickGroupTemplateAsync(group, row.Path)">@CommonText.Choose</button>
                @if (row.Path is not null)
                {
                    <button class="btn ghost" title="@SettingsViewText.Settings_AuditTemplateAsGlobalTitle" @onclick="() => SetGroupTemplateAsync(group, null)">
                        @(row.Orphaned ? SettingsViewText.Settings_AuditTemplateRemove : SettingsViewText.Settings_AuditTemplateUseGlobal)
                    </button>
                }
            </div>
        </div>
        @if (row.Path is { } groupPath)
        {
            <AuditTemplateCheck Load="AuditTemplates.Load(groupPath)" Filter="Filter" Key="SettingKey.AuditTemplateGroups" />
        }
    }

    @* WP-51: a connection's own template is set in the connection dialog; listed here so it is not forgotten. *@
    <div class="settings-row @Filter.HideClass(SettingKey.AuditTemplateConnections)">
        <div class="settings-label">
            <span>@SettingsViewText.Settings_AuditTemplateConnections</span>
            <span class="hint">@SettingsViewText.Settings_AuditTemplateConnectionsHint</span>
        </div>
    </div>
    @{ var ownTemplates = Connections.Profiles.Where(p => !string.IsNullOrWhiteSpace(p.AuditTemplatePath)).ToList(); }
    @if (ownTemplates.Count == 0)
    {
        <div class="settings-note @Filter.HideClass(SettingKey.AuditTemplateConnections)">@SettingsViewText.Settings_AuditTemplateNoConnections</div>
    }
    @foreach (var profile in ownTemplates.OrderBy(p => ConnectionLabel.Of(p, Settings.Current), StringComparer.CurrentCultureIgnoreCase))
    {
        var edited = profile;
        <div class="settings-row settings-subrow @Filter.HideClass(SettingKey.AuditTemplateConnections)" @key="profile.Id">
            <div class="settings-label"><span>@ConnectionLabel.Of(profile, Settings.Current)</span></div>
            <div class="settings-path">
                <span class="mono grow" title="@profile.AuditTemplatePath">@profile.AuditTemplatePath</span>
                <button class="btn" @onclick="() => Shell.EditConnection(edited)">@SettingsViewText.Settings_AuditTemplateEditConnection</button>
            </div>
        </div>
        <AuditTemplateCheck Load="AuditTemplates.Load(profile.AuditTemplatePath)" Filter="Filter" Key="SettingKey.AuditTemplateConnections" />
    }
</section>

@code {
    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [Parameter, EditorRequired]
    public SettingsFilter Filter { get; set; } = null!;

    /// <summary>The template file as the field shows it: saved as typed (also when it has errors, which show below).</summary>
    private string? _auditPath;

    private DomModule? _dom;

    protected override void OnInitialized() => _auditPath = Settings.Current.AuditTemplatePath;

    private Task SetAuditTemplateAsync(string? path)
    {
        _auditPath = PathInput.Normalize(path);
        return UpdateAsync(s => s with { AuditTemplatePath = _auditPath });
    }

    private async Task PickAuditTemplateAsync()
    {
        if (await Files.PickAsync(SettingsViewText.Settings_AuditTemplateFilter, ["sql", "txt"], _auditPath) is { } path)
        {
            await SetAuditTemplateAsync(path);
        }
    }

    /// <summary>The template of a connection group (WP-51); empty takes the global one again (removes an orphaned entry).</summary>
    private Task SetGroupTemplateAsync(string group, string? path) =>
        UpdateAsync(s => s with { AuditTemplateGroups = AuditGroupTemplates.With(s.AuditTemplateGroups, group, path) });

    private async Task PickGroupTemplateAsync(string group, string? current)
    {
        if (await Files.PickAsync(SettingsViewText.Settings_AuditTemplateFilter, ["sql", "txt"], current ?? _auditPath) is { } path)
        {
            await SetGroupTemplateAsync(group, path);
        }
    }

    /// <summary>The built-in template as the start of an own one (its syntax is documented in it and in docs/audit-templates.md).</summary>
    private async Task CopyDefaultTemplateAsync()
    {
        if (await (_dom ??= new(JS)).CopyTextAsync(Shell, FerretSharp.Core.Audit.AuditTemplates.DefaultText))
        {
            Shell.Notify(SettingsViewText.Settings_AuditTemplateCopied);
        }
    }

    private Task UpdateAsync(Func<AppSettings, AppSettings> change) => Shell.TrySaveSettingsAsync(() => Settings.UpdateAsync(change, CancellationToken.None));

    public async ValueTask DisposeAsync()
    {
        if (_dom is not null)
        {
            await _dom.DisposeAsync();
        }
    }
}
