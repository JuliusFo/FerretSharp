@* Report page (WP-72, from the model page): properties whose column does not fit them – type, NULL, length, precision
   (ColumnTypeCheck). *@
@using FerretSharp.Core.Query
@using FerretSharp.Core.ClrModel
@using FerretSharp.Core.Schema

@if (Report.Mismatches.Count == 0)
{
    <div class="report-empty">@ModelViewText.Mismatches_None</div>
}
else
{
    var shown = View.Mismatches(Report);
    var slice = View.Slice(ReportPart.Mismatches, shown);
    <div class="report-tools">
        @foreach (var (severity, label) in Severities)
        {
            var count = Report.Mismatches.Count(m => m.Severity == severity);
            <label class="check">
                <input type="checkbox" checked="@View.Severities.Contains(severity)" disabled="@(count == 0)"
                       @onchange="e => Toggle(severity, e.Value is true)" />
                <span class="mismatch-sev @Css(severity)">@label</span> @count
            </label>
        }
        <SearchBox @bind-Value="View.MismatchSearch" Class="search" Placeholder="@ModelViewText.Mismatches_SearchPlaceholder" />
        <span class="grow"></span>
        <span class="muted">@TextFormat.Format(ModelViewText.Mismatches_Shown, shown.Count, Report.Mismatches.Count)</span>
    </div>
    <div class="report-empty">
        <Fmt Text="@ModelViewText.Mismatches_Note"><Arg0><code>HasMaxLength</code>, <code>HasPrecision</code>, <code>HasColumnType</code>, <code>IsRequired</code>/Nullable</Arg0></Fmt>
    </div>
    <table class="report-table mismatch-table">
        <thead><tr><th></th><th>@ModelViewText.Mismatches_HeadProperty</th><th>C#</th><th>@ModelViewText.Mismatches_HeadColumn</th><th>Oracle</th><th>@ModelViewText.Mismatches_HeadEffect</th></tr></thead>
        <tbody>
            @foreach (var mismatch in slice.Shown)
            {
                <tr>
                    <td><span class="mismatch-sev @Css(mismatch.Severity)" title="@Title(mismatch.Severity)">@KindText(mismatch.Kind)</span></td>
                    <td class="mono" title="@mismatch.Entity.ClrType">@($"{ClrModelMapping.ShortName(mismatch.Entity.ClrType)}.{mismatch.Property.Name}")</td>
                    <td class="mono">@ColumnTypeCheck.Describe(mismatch.Property)</td>
                    <td><button class="link-btn mono" @onclick="() => OnOpen.InvokeAsync(mismatch.Table)">@($"{mismatch.Table.DisplayName}.{mismatch.Column.Name}")</button></td>
                    <td class="mono">@mismatch.Column.DisplayType@(mismatch.Column.Nullable ? "" : " NOT NULL")</td>
                    <td>@mismatch.Message</td>
                </tr>
            }
        </tbody>
    </table>
    <ReportMore More="slice.More" OnShowAll="() => View.ShowAll(ReportPart.Mismatches)" />
}

@code {
    [Parameter, EditorRequired]
    public ModelReport Report { get; set; } = null!;

    [Parameter, EditorRequired]
    public ReportView View { get; set; } = null!;

    /// <summary>Opens the table's structure (the "Columns" view).</summary>
    [Parameter]
    public EventCallback<TableSummary> OnOpen { get; set; }

    // A property, not a static field: the labels follow the UI language.
    private static (MismatchSeverity Severity, string Label)[] Severities =>
    [
        (MismatchSeverity.Error, ModelViewText.Mismatches_Errors),
        (MismatchSeverity.Warning, ModelViewText.Mismatches_Warnings),
        (MismatchSeverity.Hint, ModelViewText.Mismatches_Hints),
    ];

    private void Toggle(MismatchSeverity severity, bool shown)
    {
        if (shown)
        {
            View.Severities.Add(severity);
        }
        else
        {
            View.Severities.Remove(severity);
        }
    }

    public static string Css(MismatchSeverity severity) => severity switch
    {
        MismatchSeverity.Error => "error",
        MismatchSeverity.Warning => "warn",
        _ => "hint",
    };

    public static string Title(MismatchSeverity severity) => severity switch
    {
        MismatchSeverity.Error => ModelViewText.Mismatches_ErrorTitle,
        MismatchSeverity.Warning => ModelViewText.Mismatches_WarningTitle,
        _ => ModelViewText.Mismatches_HintTitle,
    };

    public static string KindText(ColumnMismatchKind kind) => kind switch
    {
        ColumnMismatchKind.Type => ModelViewText.Mismatches_KindType,
        ColumnMismatchKind.Nullability => "NULL",
        ColumnMismatchKind.Length => ModelViewText.Mismatches_KindLength,
        _ => ModelViewText.Mismatches_KindPrecision,
    };
}
