@* Settings › Data view: how a new table tab opens (view, rows, filter bar or SQL condition), type and NOT NULL in the column headers (table grid and SQL
   result), and what "SQL" in the filter bar shows. *@
@using FerretSharp.Core.Workspaces
@inject AppSettingsService Settings

<section class="settings-section">
    <h2>@SettingsViewText.Settings_DataView</h2>
    @* Ten views: a list instead of segmented buttons, which pressed the hint into a narrow column. value, not selected= (ui.md). *@
    <div class="settings-row @Filter.HideClass(SettingKey.OpenView)">
        <div class="settings-label">
            <span>@SettingsViewText.Settings_OpenView</span>
            <span class="hint">@SettingsViewText.Settings_OpenViewHint</span>
        </div>
        <select class="field settings-select" aria-label="@SettingsViewText.Settings_OpenView" value="@Settings.Current.OpenView" @onchange="SetOpenViewAsync">
            @foreach (var (view, label) in SettingsOptions.OpenViews)
            {
                <option value="@view">@label</option>
            }
        </select>
    </div>
    <SettingsChoice TValue="RowLoadMode" Filter="Filter" Key="SettingKey.LoadRows" Label="@SettingsViewText.Settings_LoadRows" Options="SettingsOptions.LoadRows"
                    Value="Settings.Current.LoadRows" OnChange="mode => UpdateAsync(s => s with { LoadRows = mode })">
        <Hint>@SettingsViewText.Settings_LoadRowsHint</Hint>
    </SettingsChoice>
    <SettingsChoice TValue="FilterStart" Filter="Filter" Key="SettingKey.FilterStart" Label="@SettingsViewText.Settings_FilterStart" Options="SettingsOptions.FilterStarts"
                    Value="Settings.Current.FilterStart" OnChange="start => UpdateAsync(s => s with { FilterStart = start })">
        <Hint>@SettingsViewText.Settings_FilterStartHint</Hint>
    </SettingsChoice>
    <SettingsChoice TValue="bool" Filter="Filter" Key="SettingKey.HeaderTypes" Label="@SettingsViewText.Settings_HeaderTypes" Options="SettingsOptions.OnOff"
                    Value="Settings.Current.ShowColumnTypes" OnChange="on => UpdateAsync(s => s with { ShowColumnTypes = on })">
        <Hint><Fmt Text="@SettingsViewText.Settings_HeaderTypesHint"><Arg0><code>@SettingsCatalog.HeaderTypeExample</code></Arg0></Fmt></Hint>
    </SettingsChoice>
    <SettingsChoice TValue="bool" Filter="Filter" Key="SettingKey.HeaderNotNull" Label="@TextFormat.Format(SettingsViewText.Settings_HeaderNotNull, SettingsCatalog.NotNull)"
                    Options="SettingsOptions.OnOff" Value="Settings.Current.ShowNotNull" OnChange="on => UpdateAsync(s => s with { ShowNotNull = on })">
        <Hint>@SettingsViewText.Settings_HeaderNotNullHint</Hint>
    </SettingsChoice>
    <SettingsChoice TValue="FilterSqlColumns" Filter="Filter" Key="SettingKey.FilterSql" Label="@SettingsViewText.Settings_FilterSql" Options="SettingsOptions.FilterSql"
                    Value="Settings.Current.FilterSql" OnChange="columns => UpdateAsync(s => s with { FilterSql = columns })">
        <Hint><Fmt Text="@SettingsViewText.Settings_FilterSqlHint"><Arg0><code>@SettingsCatalog.FilterSqlStar</code></Arg0></Fmt></Hint>
    </SettingsChoice>
</section>

@code {
    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [Parameter, EditorRequired]
    public SettingsFilter Filter { get; set; } = null!;

    private Task SetOpenViewAsync(ChangeEventArgs e) =>
        Enum.TryParse<TabMode>(e.Value as string, out var view) ? UpdateAsync(s => s with { OpenView = view }) : Task.CompletedTask;

    private Task UpdateAsync(Func<AppSettings, AppSettings> change) => Shell.TrySaveSettingsAsync(() => Settings.UpdateAsync(change, CancellationToken.None));
}
