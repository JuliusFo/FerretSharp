@* DDL proposal of the schema comparison (WP-20) for the objects chosen in the matrix: which side to align to which, the
   script to copy – or to open in a SQL tab of the target connection and run there (WP-22). *@
@using FerretSharp.Core.Compare

<ModalFrame Label="@CompareViewText.CompareDdl_Title" Class="sql-dialog compare-ddl-dialog" OnCancel="OnClose" CloseOnBackdrop="true" FocusOnOpen="true">
    @* Title and buttons in the header like every dialog; the two sides in a row of their own below – with long
       connection names both selects together are wider than the dialog, and the header clipped Close away. *@
    <header>
        <span>@CompareViewText.CompareDdl_Title</span>
        <span class="spacer"></span>
        @if (_proposal is { Steps.Count: > 0 } runnable)
        {
            <button class="btn" title="@TextFormat.Format(CompareViewText.CompareDdl_OpenInEditorTitle, Labels[_target])"
                    @onclick="() => OnOpenInEditor.InvokeAsync(runnable)">@CommonText.OpenInSqlEditor</button>
        }
        <button class="icon-btn ghost" title="@CommonText.Close" @onclick="OnClose">@Icons.Close</button>
    </header>
    <div class="compare-ddl-sides">
        <Fmt Text="@CompareViewText.CompareDdl_AlignTo">
            <Arg0>
                <select title="@CompareViewText.CompareDdl_TargetTitle" @bind="_target" @bind:after="Build">
                    @for (var i = 0; i < Labels.Count; i++)
                    {
                        <option value="@i" disabled="@(i == _reference)">@Labels[i]</option>
                    }
                </select>
            </Arg0>
            <Arg1>
                <select title="@CompareViewText.CompareDdl_ReferenceTitle" @bind="_reference" @bind:after="Build">
                    @for (var i = 0; i < Labels.Count; i++)
                    {
                        <option value="@i" disabled="@(i == _target)">@Labels[i]</option>
                    }
                </select>
            </Arg1>
        </Fmt>
    </div>
    <div class="settings-note compare-ddl-note">
        @CompareViewText.CompareDdl_Note
    </div>
    @if (_error is { } error)
    {
        <div class="test-result error"><span>@error</span></div>
    }
    else if (_proposal is { } proposal)
    {
        @if (proposal.Steps.Count == 0)
        {
            <div class="compare-none">@(proposal.Selected is null ? CompareViewText.CompareDdl_NoDifferences : CompareViewText.CompareDdl_ChosenAlike)</div>
        }
        else
        {
            @if (proposal.Unchanged.Count > 0)
            {
                <div class="settings-note compare-ddl-note" title="@(proposal.Unchanged.Count > UnchangedShown ? string.Join(", ", proposal.Unchanged) : null)">
                    @TextFormat.Format(CompareViewText.CompareDdl_Unchanged, UnchangedList(proposal.Unchanged))
                </div>
            }
            <SqlCode Sql="@proposal.Script" />
        }
    }
</ModalFrame>

@code {
    /// <summary>Names of chosen objects without a step shown in the note; the rest only in its tooltip (review: hundreds via the header box).</summary>
    private const int UnchangedShown = 10;

    private static string UnchangedList(IReadOnlyList<string> names) =>
        names.Count <= UnchangedShown
            ? string.Join(", ", names)
            : TextFormat.Format(CompareViewText.CompareDdl_UnchangedMore, string.Join(", ", names.Take(UnchangedShown)), names.Count - UnchangedShown);

    private int _reference;
    private int _target = 1;
    private DdlProposal? _proposal;
    private string? _error;

    [Parameter, EditorRequired]
    public SchemaComparison Comparison { get; set; } = null!;

    /// <summary>The objects chosen in the matrix; the proposal covers only these.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<CompareRow> Rows { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<string> Labels { get; set; } = [];

    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>"Open in SQL editor": the proposal to run on its target side (WP-22).</summary>
    [Parameter]
    public EventCallback<DdlProposal> OnOpenInEditor { get; set; }

    protected override void OnInitialized()
    {
        // The reference of the comparison, aligning the first other side to it.
        _reference = Comparison.Options.Reference ?? 0;
        _target = _reference == 0 ? 1 : 0;
        Build();
    }

    private void Build()
    {
        try
        {
            _proposal = SchemaDdl.Align(Comparison, _reference, _target, Rows);
            _error = null;
        }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            // A bug in the proposal must not take the page down; the comparison itself stays usable.
            (_proposal, _error) = (null, TextFormat.Format(CompareViewText.CompareDdl_Failed, ex.Message));
        }
    }
}
