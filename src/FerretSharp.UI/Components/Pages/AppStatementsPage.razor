@* App statements (WP-33, ADR 0023): attaches to a local .NET app with EF Core and shows the statements it sends – by
   origin, the most frequent and most expensive ones, repeated statements (N+1) – and looks one up in the database of the
   app's connection (V$SQL, plan). Its own page like the schema comparison: the trace belongs to no connection and goes
   on while the user is elsewhere (AppTraceService). *@
@using FerretSharp.Core.AppTrace
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Query
@inherits FerretComponent
@implements IDisposable
@inject AppTraceService Trace
@inject ConnectionManager Connections
@inject ConnectionHub Hub
@inject AppSettingsService Settings
@inject ILogger<AppStatementsPage> Logger

<div class="settings-page compare-page app-statements-page">
    <div class="page-head">
        <h1>@AppStatementsText.AppStatements_Title</h1>
        <span class="grow"></span>
        <button class="btn ghost" @onclick="OnBack">@CommonText.Back</button>
    </div>

    <section class="settings-section">
        <h2>@AppStatementsText.AppStatements_App</h2>
        @if (Trace.Process is { } process && !Trace.ChoosingProcess)
        {
            <div class="app-trace-status">
                <span class="dot @StatusCss"></span>
                <span><b>@process.Name</b> <span class="muted">PID @process.Id</span></span>
                @if (process.Environment is { } environment)
                {
                    <span>@AppStatementsText.AppStatements_Environment <code>@environment</code></span>
                }
                <span class="muted">@StatusText</span>
                <span class="grow"></span>
                @{ var tracing = Trace.Status is TraceStatus.Recording or TraceStatus.Attaching; }
                @if (tracing)
                {
                    @if (Trace.Paused)
                    {
                        <button class="btn" @onclick="() => Trace.SetPaused(false)">@AppStatementsText.AppStatements_Resume</button>
                    }
                    else
                    {
                        <button class="btn" @onclick="() => Trace.SetPaused(true)" title="@AppStatementsText.AppStatements_PauseTitle">@AppStatementsText.AppStatements_Pause</button>
                    }
                }
                @* Also once the trace ended (app closed, detached, failed): the recording stays until cleared. *@
                @if (tracing || Trace.Snapshot.Count > 0)
                {
                    <button class="btn" @onclick="Trace.Reset" title="@AppStatementsText.AppStatements_ClearTitle">@AppStatementsText.AppStatements_Clear</button>
                }
                @if (tracing)
                {
                    <button class="btn" disabled="@Trace.Switching" @onclick="Trace.DetachAsync">@AppStatementsText.AppStatements_Detach</button>
                }
                else
                {
                    <button class="btn" disabled="@Trace.Switching" @onclick="() => Trace.AttachAsync(process)">@AppStatementsText.AppStatements_AttachAgain</button>
                }
                <button class="btn ghost" @onclick="ChooseProcessAsync">@AppStatementsText.AppStatements_OtherApp</button>
            </div>
            @if (Trace.TraceError is { } error)
            {
                <div class="test-result error"><span>@error</span></div>
            }
            <div class="app-trace-connection">
                <span class="settings-label">@AppStatementsText.AppStatements_Connection</span>
                @{ var match = Trace.Match; }
                @if (match.Profile is { } profile)
                {
                    <span class="kind-@profile.Kind.ToString().ToLowerInvariant()"><span class="kind-badge">@ConnectionKindInfo.Short(profile.Kind)</span> @ConnectionLabel.Of(profile, Settings.Current)</span>
                    <span class="muted">@MatchText(match.Kind)</span>
                    @if (match.Kind == MatchKind.Chosen && process.Environment is { } env && string.IsNullOrEmpty(profile.AppEnvironment))
                    {
                        <button class="btn ghost" @onclick="() => RememberAsync(profile)">@TextFormat.Format(AppStatementsText.AppStatements_RememberEnvironment, env)</button>
                    }
                    <button class="btn ghost" @onclick="() => _choosingConnection = !_choosingConnection">@AppStatementsText.AppStatements_ChangeConnection</button>
                }
                else
                {
                    <span class="muted">@(match.Candidates.Count > 0 ? AppStatementsText.AppStatements_SeveralConnections : AppStatementsText.AppStatements_NoConnection)</span>
                }
                @if (match.Profile is null || _choosingConnection)
                {
                    @* value, not selected=: the browser ignores the attribute once the user picked (.claude/rules/ui.md). *@
                    <select value="" @onchange="ChooseConnection" title="@AppStatementsText.AppStatements_ChooseConnectionTitle">
                        <option value="">@AppStatementsText.AppStatements_ChooseConnection</option>
                        @foreach (var p in match.Candidates.Concat(ConnectionSearch.InListOrder(Connections.Profiles.Except(match.Candidates))))
                        {
                            <option value="@p.Id">@ConnectionLabel.Of(p, Settings.Current)</option>
                        }
                    </select>
                }
            </div>
        }
        else
        {
            <p class="hint">@AppStatementsText.AppStatements_ProcessesHint</p>
            var tooling = Trace.Processes.Count(p => p.IsTooling);
            <div class="app-trace-processes-head">
                @if (tooling > 0)
                {
                    <label class="check" title="@AppStatementsText.AppStatements_ShowToolingTitle">
                        <input type="checkbox" checked="@Trace.ShowTooling" @onchange="e => Trace.ShowTooling = e.Value is true" />
                        @TextFormat.Format(AppStatementsText.AppStatements_ShowTooling, tooling)
                    </label>
                }
                <span class="grow"></span>
                @if (Trace.ListingProcesses)
                {
                    <span class="spinner small"></span>
                }
                <button class="btn" disabled="@Trace.ListingProcesses" @onclick="Trace.RefreshProcessesAsync">@AppStatementsText.AppStatements_Refresh</button>
                @if (Trace.ChoosingProcess)
                {
                    <button class="btn ghost" @onclick="() => Trace.ChoosingProcess = false">@CommonText.Cancel</button>
                }
            </div>
            @if (Trace.ListError is { } listError)
            {
                <div class="test-result error"><span>@listError</span></div>
            }
            var shown = Trace.Processes.Where(p => Trace.ShowTooling || !p.IsTooling).ToList();
            @if (shown.Count == 0)
            {
                <p class="hint">@(Trace.ListingProcesses ? AppStatementsText.AppStatements_Listing : AppStatementsText.AppStatements_NoProcesses)</p>
            }
            else
            {
                <table class="app-trace-table app-trace-processes">
                    <thead>
                        <tr>
                            <th>@AppStatementsText.AppStatements_ColumnApp</th>
                            <th class="num">PID</th>
                            <th>@AppStatementsText.AppStatements_ColumnEnvironment</th>
                            <th>@AppStatementsText.AppStatements_ColumnStarted</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in shown)
                        {
                            <tr class="@(p.IsTooling ? "tooling" : "")">
                                <td><b>@p.Name</b></td>
                                <td class="num muted">@p.Id</td>
                                <td class="mono">@p.Environment</td>
                                <td class="muted">@(p.StartTime?.LocalDateTime.ToString("g", CultureInfo.CurrentCulture))</td>
                                <td class="num"><button class="btn" disabled="@Trace.Switching" @onclick="() => AttachAsync(p)">@AppStatementsText.AppStatements_Attach</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    </section>

    @if (Trace.Process is not null && !Trace.ChoosingProcess)
    {
        var snapshot = Trace.Snapshot;
        <section class="settings-section">
            <h2>
                @AppStatementsText.AppStatements_Overview
                @if (snapshot.Since is { } since)
                {
                    <span class="count">@TextFormat.Plural(snapshot.Count, AppStatementsText.AppStatements_SummaryOne, AppStatementsText.AppStatements_SummaryOther, PlanTable.Time(snapshot.Time), since.ToLocalTime().ToString("T", CultureInfo.CurrentCulture))</span>
                }
            </h2>
            @if (snapshot.Count == 0)
            {
                <p class="hint">@AppStatementsText.AppStatements_Waiting</p>
            }
            else
            {
                <table class="app-trace-table app-trace-origins">
                    <thead>
                        <tr>
                            <th>@AppStatementsText.AppStatements_ColumnOrigin</th>
                            <th class="num">@AppStatementsText.AppStatements_ColumnCount</th>
                            <th class="num">@AppStatementsText.AppStatements_ColumnTime</th>
                            <th class="share">@AppStatementsText.AppStatements_ColumnShare</th>
                            <th class="num">@AppStatementsText.AppStatements_ColumnRows</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var origin in snapshot.Origins)
                        {
                            var share = snapshot.Share(origin);
                            <tr class="clickable @(Trace.OriginFilter == origin.Origin ? "selected" : "")" title="@AppStatementsText.AppStatements_FilterTitle"
                                @onclick="() => Trace.OriginFilter = Trace.OriginFilter == origin.Origin ? null : origin.Origin">
                                <td>@OriginText(origin.Origin)</td>
                                <td class="num">@PlanTable.Count(origin.Count)</td>
                                <td class="num">@PlanTable.Time(origin.Time)</td>
                                <td class="share">
                                    <span class="app-trace-bar"><span style="width: @((share * 100).ToString("0.#", CultureInfo.InvariantCulture))%"></span></span>
                                    <span class="num">@share.ToString("P0", CultureInfo.CurrentCulture)</span>
                                </td>
                                <td class="num">@PlanTable.Count(origin.Rows)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        @if (snapshot.Count > 0)
        {
            var statements = Trace.ShownStatements;
            <section class="settings-section">
                <h2>
                    @AppStatementsText.AppStatements_Statements
                    @if (Trace.OriginFilter is { } filtered)
                    {
                        <button class="btn ghost app-trace-filter" @onclick="() => Trace.OriginFilter = null">@TextFormat.Format(AppStatementsText.AppStatements_OnlyOrigin, OriginText(filtered)) @Icons.Close</button>
                    }
                </h2>
                @if (snapshot.Truncated)
                {
                    <p class="hint">@TextFormat.Format(AppStatementsText.AppStatements_Truncated, StatementRecording.MaxStatements)</p>
                }
                <table class="app-trace-table app-trace-statements">
                    <thead>
                        <tr>
                            <th>@AppStatementsText.AppStatements_ColumnOrigin</th>
                            <th>@AppStatementsText.AppStatements_ColumnStatement</th>
                            @SortHeader(StatementSort.Count, AppStatementsText.AppStatements_ColumnCount)
                            @SortHeader(StatementSort.Time, AppStatementsText.AppStatements_ColumnTime)
                            @SortHeader(StatementSort.Average, AppStatementsText.AppStatements_ColumnAverage)
                            @SortHeader(StatementSort.Max, AppStatementsText.AppStatements_ColumnMax)
                            @SortHeader(StatementSort.Rows, AppStatementsText.AppStatements_ColumnRows)
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in statements.Take(MaxRows))
                        {
                            <tr class="clickable @(IsSelected(s) ? "selected" : "")" @onclick="() => Trace.Select(IsSelected(s) ? null : s)">
                                <td class="nowrap">@OriginText(s.Origin)</td>
                                <td class="mono app-trace-sql">
                                    @if (s.Repeated)
                                    {
                                        <span class="plan-badge" title="@RepeatedTitle(s)">N+1</span>
                                    }
                                    @if (s.Errors > 0)
                                    {
                                        <span class="plan-badge" title="@s.LastError">@TextFormat.Format(AppStatementsText.AppStatements_ErrorsBadge, s.Errors)</span>
                                    }
                                    @SqlScript.OneLine(s.Text)
                                </td>
                                <td class="num">@PlanTable.Count(s.Count)</td>
                                <td class="num">@PlanTable.Time(s.Time)</td>
                                <td class="num">@PlanTable.Time(s.Average)</td>
                                <td class="num">@PlanTable.Time(s.Max)</td>
                                <td class="num">@PlanTable.Count(s.Rows)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (statements.Count > MaxRows)
                {
                    <p class="hint">@TextFormat.Format(AppStatementsText.AppStatements_MoreRows, statements.Count - MaxRows)</p>
                }
            </section>

            @if (SelectedStatement(snapshot) is { } selected)
            {
                <section class="settings-section app-trace-detail">
                    <h2>
                        @OriginText(selected.Origin)
                        <span class="count">@TextFormat.Plural(selected.Count, AppStatementsText.AppStatements_DetailCountOne, AppStatementsText.AppStatements_DetailCountOther, PlanTable.Time(selected.Time))</span>
                    </h2>
                    @if (selected.Repeated)
                    {
                        <div class="settings-note warn">@RepeatedText(selected)</div>
                    }
                    @if (selected.LastError is { } lastError)
                    {
                        <div class="test-result error"><span>@lastError</span></div>
                    }
                    <SqlCode Sql="@selected.Text" />
                    <div class="app-trace-actions">
                        <span class="muted">SQL_ID <code>@Plans.SqlId(selected.Text)</code></span>
                        <span class="grow"></span>
                        @{ var target = Trace.Match.Profile; }
                        <button class="btn" disabled="@(target is null || Trace.Lookup is { Loading: true })" title="@(target is null ? AppStatementsText.AppStatements_NeedsConnection : AppStatementsText.AppStatements_LookUpTitle)"
                                @onclick="() => LookUpAsync(selected, target!)">@AppStatementsText.AppStatements_LookUp</button>
                        <button class="btn" disabled="@(target is null)" title="@(target is null ? AppStatementsText.AppStatements_NeedsConnection : null)"
                                @onclick="() => OpenInEditorAsync(selected, target!)">@CommonText.OpenInSqlEditor</button>
                    </div>
                    @if (Trace.Lookup is { } lookup && lookup.Text == selected.Text)
                    {
                        @if (lookup.Loading)
                        {
                            <p class="hint"><span class="spinner small"></span> @AppStatementsText.AppStatements_LookingUp</p>
                        }
                        else if (lookup.Error is { } lookupError)
                        {
                            <div class="test-result error"><span>@lookupError</span></div>
                        }
                        else if (lookup.Cursor is not { } cursor)
                        {
                            <p class="hint">@AppStatementsText.AppStatements_NotInPool</p>
                        }
                        else
                        {
                            <div class="app-trace-figures">
                                <span>@AppStatementsText.AppStatements_Executions <b>@PlanTable.Count(cursor.Executions)</b></span>
                                <span>@AppStatementsText.AppStatements_RowsProcessed <b>@PlanTable.Count(cursor.RowsProcessed)</b></span>
                                <span>Buffer Gets <b>@PlanTable.Count(cursor.BufferGets)</b></span>
                                <span>Disk Reads <b>@PlanTable.Count(cursor.DiskReads)</b></span>
                                <span>@AppStatementsText.AppStatements_Elapsed <b>@PlanTable.Time(cursor.Elapsed)</b> (Ø @PlanTable.Time(cursor.AverageElapsed))</span>
                                <span>CPU <b>@PlanTable.Time(cursor.Cpu)</b></span>
                                <span>@AppStatementsText.AppStatements_Children <b>@cursor.Children</b></span>
                            </div>
                            <p class="hint">@AppStatementsText.AppStatements_InstanceWide</p>
                            @if (!cursor.HasActualFigures)
                            {
                                <p class="hint">@AppStatementsText.AppStatements_NoActualFigures</p>
                            }
                            <PlanTable Plan="cursor.Plan" ShowActual="cursor.HasActualFigures" Owner="@Hub.Find(lookup.ProfileId)?.Active.Schema?.Owner" />
                        }
                    }
                </section>
            }
        }
    }
</div>

@code {
    private const int MaxRows = 200;


    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    [CascadingParameter]
    public WorkspaceLifecycle Lifecycle { get; set; } = null!;

    [Parameter]
    public EventCallback OnBack { get; set; }

    private bool _choosingConnection;
    private static readonly TimeSpan ConnectTimeout = TimeSpan.FromMinutes(1);
    private static readonly TimeSpan StartTimeout = TimeSpan.FromSeconds(3);
    private static readonly TimeSpan PollInterval = TimeSpan.FromMilliseconds(100);
    private static readonly TimeSpan LookupTimeout = TimeSpan.FromSeconds(30);

    protected override async Task OnInitializedAsync()
    {
        Trace.Changed += OnChanged;
        Connections.Changed += OnChanged;
        if (Trace.Process is null && Trace.Processes.Count == 0)
        {
            await Trace.RefreshProcessesAsync();
        }
    }

    private void OnChanged() => Fire(StateHasChanged);

    private async Task ChooseProcessAsync()
    {
        Trace.ChoosingProcess = true;
        await Trace.RefreshProcessesAsync();
    }

    private async Task AttachAsync(TraceableProcess process)
    {
        Trace.ChoosingProcess = false;
        _choosingConnection = false;
        Trace.OriginFilter = null;
        await Trace.AttachAsync(process);
    }

    private void ChooseConnection(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value as string, out var id) && Connections.Profiles.FirstOrDefault(p => p.Id == id) is { } profile)
        {
            Trace.Choose(profile);
            _choosingConnection = false;
        }
    }

    private async Task RememberAsync(ConnectionProfile profile)
    {
        try
        {
            await Trace.RememberEnvironmentAsync(profile, CancellationToken.None);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or ConnectionStoreException)
        {
            Logger.LogWarning(ex, "Remembering the app environment failed");
            Shell.Notify(TextFormat.Format(AppStatementsText.AppStatements_RememberFailed, ex.Message));
        }
    }

    /// <summary>
    /// Looks the statement up in the database of the app's connection, connecting it first if needed. Connecting shows the
    /// connection, and the page is built anew for it: the look-up outlives this instance and reports to the service. A
    /// newer look-up (or a new trace) replaces it, its result is then dropped.
    /// </summary>
    private async Task LookUpAsync(StatementTotals statement, ConnectionProfile profile)
    {
        var pending = new CursorLookup(statement.Text, profile.Id, true, null, null);
        Trace.SetLookup(pending);
        void Finish(Core.Query.CursorInfo? cursor, string? error)
        {
            if (ReferenceEquals(Trace.Lookup, pending))
            {
                Trace.SetLookup(pending with { Loading = false, Cursor = cursor, Error = error });
            }
        }

        var active = await ConnectedAsync(profile);
        if (active?.Schema is not { } schema)
        {
            Finish(null, AppStatementsText.AppStatements_NotConnected);
            return;
        }

        using var timeout = new CancellationTokenSource(LookupTimeout);
        var result = await Shell.RunDbAsync(Logger, active, () => schema.GetCursorAsync(statement.Text, timeout.Token), timeout.Token);
        if (result.Cancelled)
        {
            // Cancelled by the limit – or the connection was closed meanwhile (review 3.31.0, A19).
            Finish(null, timeout.IsCancellationRequested ? AppStatementsText.AppStatements_LookupTimedOut : AppStatementsText.AppStatements_NotConnected);
            return;
        }

        Finish(result.Value, result.Error?.Display.Replace("<user>", profile.User.ToUpperInvariant(), StringComparison.Ordinal));
    }

    /// <summary>
    /// The connection, once connected; connecting shows it (the page stays). Null as soon as it is clear that it will not
    /// connect: it failed, a lost connection only shows its banner (reconnecting is the user's call), or it did not even
    /// start connecting within a moment.
    /// </summary>
    private async Task<ActiveConnection?> ConnectedAsync(ConnectionProfile profile)
    {
        if (Hub.Find(profile.Id) is { Active.IsConnected: true } open)
        {
            return open.Active;
        }

        await Lifecycle.ConnectAsync(profile);
        var started = false;
        for (var waited = TimeSpan.Zero; waited < ConnectTimeout; waited += PollInterval)
        {
            if (Hub.Find(profile.Id) is { } scope)
            {
                if (scope.Lost is not null || scope.Active.Status == ConnectionStatus.Failed)
                {
                    return null;
                }

                if (scope.Active.IsConnected)
                {
                    return scope.Active;
                }

                started |= scope.Active.Status == ConnectionStatus.Connecting;
                if (scope.Active.Status == ConnectionStatus.Disconnected && (started || waited >= StartTimeout))
                {
                    return null;
                }
            }
            else if (Shell.PendingPassword is null && waited >= StartTimeout)
            {
                // Nothing opened: the password prompt was cancelled (review 3.31.0, A19 – the page waited a minute). While
                // the prompt is open, the lookup waits for it.
                return null;
            }

            await Task.Delay(PollInterval, CancellationToken.None);
        }

        return null;
    }

    private async Task OpenInEditorAsync(StatementTotals statement, ConnectionProfile profile)
    {
        Shell.OpenSqlIn(profile.Id, statement.Text);
        await Lifecycle.ConnectAsync(profile);
    }

    private bool IsSelected(StatementTotals statement) => Trace.Selected == (statement.Origin, statement.Text);

    private StatementTotals? SelectedStatement(RecordingSnapshot snapshot) =>
        Trace.Selected is { } key ? snapshot.Statements.FirstOrDefault(s => s.Origin == key.Origin && s.Text == key.Text) : null;

    private RenderFragment SortHeader(StatementSort sort, string label) =>
        @<th class="num sortable @(Trace.Sort == sort ? "sorted" : "")" @onclick="() => Trace.Sort = sort">@label@(Trace.Sort == sort ? " ↓" : "")</th>;

    private bool IsPaused => Trace.Paused && Trace.Status is TraceStatus.Attaching or TraceStatus.Recording;

    private string StatusCss => IsPaused ? "paused" : Trace.Status switch
    {
        TraceStatus.Recording => "ok",
        TraceStatus.Failed => "err",
        _ => "",
    };

    private string StatusText => IsPaused ? AppStatementsText.AppStatements_StatusPaused : Trace.Status switch
    {
        TraceStatus.Attaching => AppStatementsText.AppStatements_StatusAttaching,
        TraceStatus.Recording => AppStatementsText.AppStatements_StatusRecording,
        TraceStatus.Detached => AppStatementsText.AppStatements_StatusDetached,
        TraceStatus.Ended => AppStatementsText.AppStatements_StatusEnded,
        TraceStatus.Failed => AppStatementsText.AppStatements_StatusFailed,
        _ => "",
    };

    private static string MatchText(MatchKind kind) => kind switch
    {
        MatchKind.Environment => AppStatementsText.AppStatements_ByEnvironment,
        MatchKind.DataSource => AppStatementsText.AppStatements_ByDataSource,
        MatchKind.Chosen => AppStatementsText.AppStatements_Chosen,
        _ => "",
    };

    public static string OriginText(StatementOrigin origin) => origin switch
    {
        StatementOrigin.Linq => "LINQ",
        StatementOrigin.LazyLoading => "Lazy Loading",
        StatementOrigin.FromSql => "FromSql",
        StatementOrigin.ExecuteSql => "ExecuteSql",
        StatementOrigin.SaveChanges => "SaveChanges",
        StatementOrigin.ExecuteUpdate => "ExecuteUpdate/-Delete",
        StatementOrigin.Other => AppStatementsText.AppStatements_OriginOther,
        _ => AppStatementsText.AppStatements_OriginUnknown,
    };

    private string RepeatedTitle(StatementTotals s) => TextFormat.Format(AppStatementsText.AppStatements_RepeatedTitle, s.Burst, RepeatRule.Default.Window.TotalSeconds);

    private string RepeatedText(StatementTotals s) => s.Origin == StatementOrigin.LazyLoading && s.Navigation is { Length: > 0 } navigation
        ? TextFormat.Format(AppStatementsText.AppStatements_RepeatedLazy, s.Burst, RepeatRule.Default.Window.TotalSeconds, navigation)
        : TextFormat.Format(AppStatementsText.AppStatements_RepeatedLoop, s.Burst, RepeatRule.Default.Window.TotalSeconds);

    public void Dispose()
    {
        Trace.Changed -= OnChanged;
        Connections.Changed -= OnChanged;
    }
}
