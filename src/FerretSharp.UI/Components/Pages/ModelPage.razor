@* The C# model of the active connection's linked project (WP-11) or model file (WP-64): where it comes from,
   reload/rebuild, export as a file, and the counts of how it matches the database – the lists are on the report (WP-72). *@
@using FerretSharp.Core.ClrModel
@using FerretSharp.Core.Connections
@using FerretSharp.Core.Schema
@implements IDisposable
@inject ConnectionManager Connections
@inject IFileSaveService SaveFiles

<div class="settings-page model-page">
    <div class="page-head">
        <h1>@ModelViewText.Model_Title</h1>
        @if (State.Link is { } headLink)
        {
            <span class="hint mono ellipsis" title="@headLink.ProjectFile">@headLink.ProjectName</span>
        }
        else if (State.ModelFile is { } headFile)
        {
            <span class="hint mono ellipsis" title="@headFile">@Path.GetFileName(headFile)</span>
        }
        <span class="grow"></span>
        @if (State.IsLinked)
        {
            <button class="btn" disabled="@(Busy)" @onclick="Models.LoadAsync">@CommonText.Reload</button>
        }
        @if (State is { Link: not null, Mapping: not null })
        {
            <button class="btn" disabled="@(Busy || _exporting)" title="@ModelViewText.Model_ExportTitle" @onclick="ExportAsync">
                @if (_exporting)
                {
                    <span class="spinner small"></span>
                }
                @ModelViewText.Model_Export
            </button>
        }
        @if (State.Link is not null)
        {
            <button class="btn" disabled="@(Busy)" title="@ModelViewText.Model_BuildTitle" @onclick="BuildAsync">
                @if (Models.IsBuilding)
                {
                    <span class="spinner small"></span>
                }
                @ModelViewText.Model_Build
            </button>
        }
        @if (Profile is { } profile)
        {
            <button class="btn ghost" @onclick="() => Shell.EditConnection(profile)">@ModelViewText.Model_EditConnection</button>
        }
        <button class="btn ghost" @onclick="Shell.ShowExplorer">@CommonText.Back</button>
    </div>

    @if (!State.IsLinked)
    {
        <section class="settings-section">
            <h2>@ModelViewText.Model_NoProject</h2>
            <div class="settings-note">
                <Fmt Text="@ModelViewText.Model_NoProjectHint"><Arg0><code>.csproj</code></Arg0></Fmt>
            </div>
        </section>
    }
    else
    {
        var link = State.Link;
        <section class="settings-section">
            <h2>@(link is null ? ModelViewText.Model_ModelFile : ModelViewText.Model_Project)</h2>
            <dl class="model-facts">
                @if (link is null)
                {
                    <dt>@ModelViewText.Model_File</dt>
                    <dd class="mono">@State.ModelFile</dd>
                    @if (State.Origin is { } origin)
                    {
                        <dt>@ModelViewText.Model_Exported</dt>
                        <dd>
                            @TextFormat.Format(ModelViewText.Model_ExportedInfo, origin.ExportedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm", CultureInfo.CurrentCulture), origin.AppVersion)
                            <div class="hint">@ModelFileText.Source(origin)</div>
                        </dd>
                    }
                    @if (State.Mapping?.Model.Culture is { Length: > 0 } culture)
                    {
                        <dt>@ModelViewText.Model_DisplayLanguage</dt>
                        <dd>@CultureName(culture)</dd>
                    }
                }
                else
                {
                    <dt>@ModelViewText.Model_Project</dt>
                    <dd class="mono">@link.ProjectFile</dd>
                }
                @if (link is not null && State.Output is { } output)
                {
                    <dt>@ModelViewText.Model_BuildLabel</dt>
                    <dd>
                        @TextFormat.Format(ModelViewText.Model_BuildInfo, link.Configuration, output.TargetFramework, output.BuiltAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm", CultureInfo.CurrentCulture))
                        <div class="hint mono ellipsis" title="@output.Assembly">@output.Assembly</div>
                    </dd>
                }
                @if (State.Mapping?.Model is { } model)
                {
                    <dt>DbContext</dt>
                    <dd>
                        <span class="mono">@model.ContextType</span> · EF Core @model.EfVersion
                        <div class="hint">@TextFormat.Format(ModelViewText.Model_CreatedByHint, CreatedBy(model.CreatedBy))</div>
                    </dd>
                }
                @if (State.Phase != ClrModelPhase.Loading && State.Steps is { Count: > 0 } steps)
                {
                    <dt>@ModelViewText.Model_LoadTime</dt>
                    <dd>
                        @Duration(TimeSpan.FromTicks(steps.Sum(s => s.Duration.Ticks)))
                        @if (State.CachedAt is { } cachedAt)
                        {
                            <span class="model-chip" title="@ModelViewText.Model_CachedTitle">
                                @TextFormat.Format(ModelViewText.Model_Cached, cachedAt.ToString("dd.MM.yyyy HH:mm", CultureInfo.CurrentCulture))
                            </span>
                        }
                        <div class="hint">@string.Join(" · ", steps.Select(s => $"{s.Name} {Duration(s.Duration)}"))</div>
                    </dd>
                }
            </dl>

            @if (link is null)
            {
                <div class="settings-note">@ModelViewText.Model_FileLimits</div>
            }

            @if (link is not null && State.Output is { IsStale: true } stale)
            {
                <div class="settings-note warn">
                    <Fmt Text="@ModelViewText.Model_Stale"><Arg0><span class="mono">@Path.GetFileName(stale.NewerSource)</span></Arg0></Fmt>
                </div>
            }

            @if (State.Phase == ClrModelPhase.Loading)
            {
                <div class="model-status">
                    <span class="spinner small"></span>
                    <span>@TextFormat.Format(State.BuildChanged ? ModelViewText.Model_BuildChangedStep : ModelViewText.Model_Step, State.Step ?? ModelViewText.Model_ReadingModel)</span>
                    <span class="hint">@(State.LoadStartedAt is { } started ? TextFormat.Format(CommonText.ElapsedTotal, Elapsed(State.StepStartedAt), Elapsed(started)) : Elapsed(State.StepStartedAt))</span>
                </div>
            }
            else if (State is { Phase: ClrModelPhase.Failed, Error: { } error })
            {
                <div class="test-result error model-error">
                    <span>@error.Message</span>
                    @if (error.Detail is { Length: > 0 })
                    {
                        <button class="link-btn" @onclick="() => _showDetail = !_showDetail">@(_showDetail ? ModelViewText.Model_HideDetails : CommonText.Details)</button>
                    }
                </div>
                @if (_showDetail && error.Detail is { } detail)
                {
                    <pre class="model-log">@detail</pre>
                }
            }

            @if (Models.LastBuild is { Succeeded: false } build && !Models.IsBuilding)
            {
                <div class="test-result error model-error"><span>@(build.Error ?? TextFormat.Format(ModelViewText.Model_BuildFailed, build.ExitCode))</span></div>
                <pre class="model-log">@build.Output</pre>
            }
        </section>

        @if (State.Mapping is { } mapping)
        {
            var entities = mapping.Model.Entities.Count(e => e.Table is not null || e.View is not null);
            var first = mapping.Entities.DistinctBy(e => e.Entity).ToList();
            var properties = first.Sum(e => e.Entity.Properties.Count(p => p.Column is not null));
            var mapped = first.Sum(e => e.Properties.Count);
            <section class="settings-section">
                <h2>@ModelViewText.Model_Matching</h2>
                <div class="model-summary">
                    <span class="model-chip">@TextFormat.Format(ModelViewText.Model_EntitiesMapped, mapping.MappedEntityCount, entities)</span>
                    <span class="model-chip">@TextFormat.Format(ModelViewText.Model_PropertiesMapped, mapped, properties)</span>
                    <span class="model-chip @(Count(mapping, MappingIssueKind.ColumnWithoutProperty) > 0 ? "warn" : "")">@TextFormat.Plural(Count(mapping, MappingIssueKind.ColumnWithoutProperty), ModelViewText.Model_ColumnsWithoutPropertyOne, ModelViewText.Model_ColumnsWithoutPropertyOther)</span>
                    @{
                        var serious = mapping.ColumnMismatches.Count(m => m.Severity != MismatchSeverity.Hint);
                    }
                    <span class="model-chip @(serious > 0 ? "warn" : "")" title="@ModelViewText.Model_MismatchesTitle">@TextFormat.Plural(serious, ModelViewText.Model_MismatchesOne, ModelViewText.Model_MismatchesOther)</span>
                    @if (State.LoadedAt is { } loadedAt)
                    {
                        <span class="hint">@TextFormat.Format(CommonText.AsOf, loadedAt.ToString("HH:mm:ss", CultureInfo.CurrentCulture))</span>
                    }
                </div>
                @* WP-72: the lists moved to the report; the model page keeps where the model comes from. *@
                <div class="model-report-link">
                    <span class="hint">@ModelViewText.Report_ModelSummary</span>
                    <span class="grow"></span>
                    <button class="btn primary" @onclick="() => Shell.ShowReport()">@Icons.Report @ModelViewText.Report_OpenReport</button>
                </div>
            </section>
        }
    }
</div>

@code {
    [CascadingParameter]
    public ClrModelManager Models { get; set; } = null!;

    [CascadingParameter]
    public ActiveConnection Active { get; set; } = null!;

    private bool _showDetail;
    private bool _exporting;

    [CascadingParameter]
    public ShellState Shell { get; set; } = null!;

    private ClrModelState State => Models.State;

    private bool Busy => Models.IsBuilding || State.Phase == ClrModelPhase.Loading;

    private ConnectionProfile? Profile => Active.Profile is { } active ? Connections.Profiles.FirstOrDefault(p => p.Id == active.Id) ?? active : null;

    private Timer? _ticker;

    protected override void OnInitialized()
    {
        Models.Changed += OnChanged;
        Active.Changed += OnChanged;
        // The seconds while loading.
        _ticker = new Timer(_ =>
        {
            if (Models.State.Phase == ClrModelPhase.Loading)
            {
                OnChanged();
            }
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private static string Elapsed(DateTimeOffset? since) => since is { } start ? Duration(DateTimeOffset.Now - start) : "";

    private static string Duration(TimeSpan duration) => TimeText.Duration(duration);

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private Task BuildAsync() => Models.BuildAsync();

    /// <summary>The loaded model as a file to pass on (WP-64): asked where first, written in the background.</summary>
    private async Task ExportAsync()
    {
        if (State.Link is not { } link
            || await SaveFiles.AskPathAsync(ModelFile.SuggestedName(link), ModelViewText.Model_ExportFilter) is not { Length: > 0 } path)
        {
            return;
        }

        _exporting = true;
        try
        {
            await Models.ExportAsync(path, AppVersion.Current, CancellationToken.None);
            Shell.Notify(TextFormat.Format(ModelViewText.Model_ExportDone, Path.GetFileName(path)));
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidOperationException)
        {
            Shell.Notify(TextFormat.Format(CommonText.SaveFailed, ex.Message));
        }
        finally
        {
            _exporting = false;
        }
    }

    /// <summary>"Deutsch (Deutschland)" for <c>de-DE</c>; the name itself if this Windows does not know it.</summary>
    private static string CultureName(string name)
    {
        try
        {
            return CultureInfo.GetCultureInfo(name).DisplayName;
        }
        catch (CultureNotFoundException)
        {
            return name;
        }
    }

    private static int Count(ClrModelMapping mapping, MappingIssueKind kind) => mapping.Issues.Count(i => i.Kind == kind);

    private static string CreatedBy(string createdBy) => createdBy switch
    {
        "factory" => ModelViewText.Model_CreatedByFactory,
        "options" => ModelViewText.Model_CreatedByOptions,
        "parameterless" => ModelViewText.Model_CreatedByParameterless,
        _ => createdBy,
    };

    public void Dispose()
    {
        _ticker?.Dispose();
        Models.Changed -= OnChanged;
        Active.Changed -= OnChanged;
    }
}
