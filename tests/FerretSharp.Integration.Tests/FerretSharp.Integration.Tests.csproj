<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- LibraryImport for NtSuspendProcess (AppTraceSourceTests: an app halted like at a breakpoint). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" />
    <PackageReference Include="Testcontainers.Oracle" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- At most 4 test classes at once, as on the CI runner: with one per core (32 locally) the Oracle Free container refuses
         new sessions (ORA-12516), WP-26. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\TestFolder.cs" Link="Shared\TestFolder.cs" />
    <Compile Include="..\Shared\UiCulture.cs" Link="Shared\UiCulture.cs" />
    <Compile Include="..\Shared\ResourceChecks.cs" Link="Shared\ResourceChecks.cs" />
    <Compile Include="..\Shared\FakeDatabase.cs" Link="Shared\FakeDatabase.cs" />
    <Compile Include="..\Shared\Repository.cs" Link="Shared\Repository.cs" />
    <Using Include="FerretSharp.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Builds comparisons by hand for the DDL proposal tests (shared with the unit tests). -->
    <Compile Include="..\FerretSharp.Core.Tests\Compare\TestComparison.cs" Link="Compare\TestComparison.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FerretSharp.Core\FerretSharp.Core.csproj" />
    <ProjectReference Include="..\..\src\FerretSharp.AppTrace\FerretSharp.AppTrace.csproj" />
    <!-- Built first, not referenced: a stand-in for a user's app that the trace tests attach to (WP-33). -->
    <ProjectReference Include="..\FerretSharp.FakeEfApp\FerretSharp.FakeEfApp.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <!-- Built first, not referenced: the model host runs against the sample project in a process of its own (ModelHostTests). -->
    <ProjectReference Include="..\..\src\FerretSharp.ModelHost\FerretSharp.ModelHost.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\..\samples\FerretSharp.SampleModel.Data\FerretSharp.SampleModel.Data.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <!-- Built first, not referenced: contexts with their own connection string for the LINQ console (LinqConsoleOptionsTests). -->
    <ProjectReference Include="..\FerretSharp.FakeEfModel\FerretSharp.FakeEfModel.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

</Project>
