<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" />
    <PackageReference Include="Testcontainers.Oracle" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Builds comparisons by hand for the DDL proposal tests (shared with the unit tests). -->
    <Compile Include="..\FerretSharp.Core.Tests\Compare\TestComparison.cs" Link="Compare\TestComparison.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FerretSharp.Core\FerretSharp.Core.csproj" />
    <!-- Built first, not referenced: the model host runs against the sample project in a process of its own (ModelHostTests). -->
    <ProjectReference Include="..\..\src\FerretSharp.ModelHost\FerretSharp.ModelHost.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\..\samples\FerretSharp.SampleModel.Data\FerretSharp.SampleModel.Data.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

</Project>
