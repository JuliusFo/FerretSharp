<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\TestFolder.cs" Link="Shared\TestFolder.cs" />
    <Compile Include="..\Shared\UiCulture.cs" Link="Shared\UiCulture.cs" />
    <Compile Include="..\Shared\ResourceChecks.cs" Link="Shared\ResourceChecks.cs" />
    <Using Include="FerretSharp.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- The in-memory stores of the Core tests, shared instead of copied. -->
    <Compile Include="..\FerretSharp.Core.Tests\Fakes\*.cs" Link="Fakes\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FerretSharp.UI\FerretSharp.UI.csproj" />
  </ItemGroup>

</Project>
