    <Compile Include="..\Shared\FakeDatabase.cs" Link="Shared\FakeDatabase.cs" />
    <Compile Include="..\Shared\Repository.cs" Link="Shared\Repository.cs" />
    <Compile Include="..\Shared\ReleaseWorkflow.cs" Link="Shared\ReleaseWorkflow.cs" />
    <Compile Include="..\Shared\InMemorySecretStore.cs" Link="Shared\InMemorySecretStore.cs" />
