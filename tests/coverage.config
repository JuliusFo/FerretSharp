<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage of the test runs (Microsoft.Testing.Extensions.CodeCoverage), passed to dotnet test as the
     coverage settings. Used by CI (coverage badge) and tools/coverage/Get-Coverage.ps1.
     No double hyphen in these comments: it is invalid XML, and the test platform then rejects the whole file. -->
<Configuration>
  <CodeCoverage>
    <!-- Only the libraries the tests are meant for. FerretSharp.App (WPF host) and FerretSharp.ModelHost (separate
         process) have no unit tests, the tests and samples/ are not product code. -->
    <ModulePaths>
      <Include>
        <ModulePath>.*[\\/]FerretSharp\.Core\.dll$</ModulePath>
        <ModulePath>.*[\\/]FerretSharp\.UI\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <!-- Generated code: the resource classes of the resx files (*Text.g.cs) carry GeneratedCodeAttribute. -->
    <Attributes>
      <Exclude>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
        <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
      </Exclude>
    </Attributes>
    <!-- Razor components: the UI tests check the state classes without rendering (CLAUDE.md, section 4), the components
         are tested end to end (docs/e2e-testing.md). Their code-behind (*.razor.cs) stays in. -->
    <Sources>
      <Exclude>
        <Source>.*\.g\.cs$</Source>
        <Source>.*\.razor$</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
