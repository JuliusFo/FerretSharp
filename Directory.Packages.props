<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="UI">
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.110" />
  </ItemGroup>

  <ItemGroup Label="Windows">
    <PackageVersion Include="Meziantou.Framework.Win32.CredentialManager" Version="3.0.4" />
  </ItemGroup>

  <ItemGroup Label="Hosting">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup Label="Oracle">
    <PackageVersion Include="Oracle.ManagedDataAccess.Core" Version="23.26.301" />
  </ItemGroup>

  <!-- FerretSharp.ModelHost compiles against the lowest supported EF Core (ADR 0009): at run time it uses the user's
       project's EF Core, and .NET binds to a higher assembly version, never to a lower one. -->
  <ItemGroup Label="ModelHost">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.0" />
    <!-- LINQ console (WP-13): C# scripting in the user's project. Shipped with the host (the project does not bring it). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.11.0" />
  </ItemGroup>

  <!-- Tracing a running app (WP-33): EventPipe client and reader, only in FerretSharp.AppTrace. -->
  <ItemGroup Label="AppTrace">
    <PackageVersion Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.750501" />
    <PackageVersion Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <!-- tests/FerretSharp.FakeEfApp stands in for a user's app with EF Core 8 (WP-33). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Proxies" Version="8.0.31" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.31" />
    <PackageVersion Include="Oracle.EntityFrameworkCore" Version="8.23.26301" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Testcontainers.Oracle" Version="4.15.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

</Project>
